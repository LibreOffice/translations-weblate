#. 9KHB8
#. = common strings
#: connectivity/inc/strings.hrc:25
msgctxt "STR_NO_CONNECTION_GIVEN"
msgid "No connection to the database exists."
msgstr "ڈیٹا بیس نال کوئی کنکشن کائنی۔"

#. 72Mjc
#: connectivity/inc/strings.hrc:26
msgctxt "STR_WRONG_PARAM_INDEX"
msgid "You tried to set a parameter at position “$pos$” but there is/are only “$count$” parameter(s) allowed. One reason may be that the property “ParameterNameSubstitution” is not set to TRUE in the data source."
msgstr "تساں “$pos$” مقام تے ہک پیرامیٹر مقرر کرݨ دی کوشش کیتی پر صرف “$count$” پیرامیٹر دی اجازت ہے۔ ہک وجہ ایندا ہو سڳدی ہے جو ڈیٹا ماخذ وچ “ParameterNameSubstitution” خصوصیت TRUE تے مقرر کائنی۔"

#. 6FnrV
#: connectivity/inc/strings.hrc:27
msgctxt "STR_NO_INPUTSTREAM"
msgid "The input stream was not set."
msgstr "ان پٹ اسٹریم مقرر کائنی۔"

#. PtsET
#: connectivity/inc/strings.hrc:28
msgctxt "STR_NO_ELEMENT_NAME"
msgid "There is no element named “$name$”."
msgstr "“$name$” ناں آلا کوئی عنصر کائنی۔"

#. CWktu
#: connectivity/inc/strings.hrc:29
msgctxt "STR_INVALID_BOOKMARK"
msgid "Invalid bookmark value"
msgstr "غلط نشانی قیمت"

#. VXSEP
#: connectivity/inc/strings.hrc:30
msgctxt "STR_PRIVILEGE_NOT_GRANTED"
msgid "Privilege not granted: Only table privileges can be granted."
msgstr "اختیار ݙتا نہ ڳیا: صرف ٹیبل دے اختیارات ݙتے ونڄ سڳدے ہن۔"

#. DZf3v
#: connectivity/inc/strings.hrc:31
msgctxt "STR_PRIVILEGE_NOT_REVOKED"
msgid "Privilege not revoked: Only table privileges can be revoked."
msgstr "اختیار واپس نہ گھدا ڳیا: صرف ٹیبل دے اختیارات واپس گھدے ونڄ سڳدے ہن۔"

#. qTZj7
#: connectivity/inc/strings.hrc:32
msgctxt "STR_ERRORMSG_SEQUENCE"
msgid "Function sequence error."
msgstr "فنکشن ترتیب غلطی۔"

#. scUDb
#: connectivity/inc/strings.hrc:33
msgctxt "STR_INVALID_INDEX"
msgid "Invalid descriptor index."
msgstr "غلط ڈسکرپٹر انڈیکس۔"

#. YyBDi
#: connectivity/inc/strings.hrc:34
msgctxt "STR_UNSUPPORTED_FUNCTION"
msgid "The driver does not support the function “$functionname$”."
msgstr "ڈرائیور “$functionname$” فنکشن دی سپورٹ کائنی کریندا۔"

#. GW3L8
#: connectivity/inc/strings.hrc:35
msgctxt "STR_UNSUPPORTED_FEATURE"
msgid "The driver does not support the functionality for “$featurename$”. It is not implemented."
msgstr "ڈرائیور “$featurename$” کیتے فنکشنلٹی دی سپورٹ کائنی کریندا۔ ایندا لاگو کائنی کیتی ڳئی۔"

#. zXVCV
#: connectivity/inc/strings.hrc:36
msgctxt "STR_FORMULA_WRONG"
msgid "The formula for TypeInfoSettings is wrong!"
msgstr "TypeInfoSettings کیتے فارمولا غلط ہے!"

#. vA6FB
#: connectivity/inc/strings.hrc:37
msgctxt "STR_STRING_LENGTH_EXCEEDED"
msgid "The string “$string$” exceeds the maximum length of $maxlen$ characters when converted to the target character set “$charset$”."
msgstr "“$string$” سٹرنگ $maxlen$ حرفاں دی ودھ توں ودھ لمبائی توں ودھ ویندی ہے جڈاں اینکوں “$charset$” ہدف حرف سیٹ وچ تبدیل کیتی ونڄے۔"

#. THhEu
#: connectivity/inc/strings.hrc:38
msgctxt "STR_CANNOT_CONVERT_STRING"
msgid "The string “$string$” cannot be converted using the encoding “$charset$”."
msgstr "“$string$” سٹرنگ “$charset$” انکوڈنگ ورت تے تبدیل کائنی کیتی ونڄ سڳدی۔"

#. sSzsJ
#: connectivity/inc/strings.hrc:39
msgctxt "STR_URI_SYNTAX_ERROR"
msgid "The connection URL is invalid."
msgstr "کنکشن URL غلط ہے۔"

#. aihGj
#: connectivity/inc/strings.hrc:40
msgctxt "STR_QUERY_TOO_COMPLEX"
msgid "The query cannot be executed. It is too complex."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ ایندا ٻہوں پیچیدہ ہے۔"

#. ADy4t
#: connectivity/inc/strings.hrc:41
msgctxt "STR_OPERATOR_TOO_COMPLEX"
msgid "The query cannot be executed. The operator is too complex."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ آپریٹر ٻہوں پیچیدہ ہے۔"

#. XZGaK
#: connectivity/inc/strings.hrc:42
msgctxt "STR_QUERY_INVALID_LIKE_COLUMN"
msgid "The query cannot be executed. You cannot use “LIKE” with columns of this type."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ تساں ایندا قسم دے کالماں نال “LIKE” ورت کائنی سڳدے۔"

#. SsqWz
#: connectivity/inc/strings.hrc:43
msgctxt "STR_QUERY_INVALID_LIKE_STRING"
msgid "The query cannot be executed. “LIKE” can be used with a string argument only."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ “LIKE” صرف ہک سٹرنگ دلیل نال ورتیا ونڄ سڳدا ہے۔"

#. ZFFrf
#: connectivity/inc/strings.hrc:44
msgctxt "STR_QUERY_NOT_LIKE_TOO_COMPLEX"
msgid "The query cannot be executed. The “NOT LIKE” condition is too complex."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ “NOT LIKE” شرط ٻہوں پیچیدہ ہے۔"

#. AaZzs
#: connectivity/inc/strings.hrc:45
msgctxt "STR_QUERY_LIKE_WILDCARD"
msgid "The query cannot be executed. The “LIKE” condition contains wildcard in the middle."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ “LIKE” شرط وچکار وائلڈ کارڈ رکھدی ہے۔"

#. GN6F9
#: connectivity/inc/strings.hrc:46
msgctxt "STR_QUERY_LIKE_WILDCARD_MANY"
msgid "The query cannot be executed. The “LIKE” condition contains too many wildcards."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ “LIKE” شرط ٻہوں ودھ وائلڈ کارڈ رکھدی ہے۔"

#. LreLr
#: connectivity/inc/strings.hrc:47
msgctxt "STR_INVALID_COLUMNNAME"
msgid "The column name “$columnname$” is not valid."
msgstr "“$columnname$” کالم دا ناں درست کائنی۔"

#. FT3Zb
#: connectivity/inc/strings.hrc:48
msgctxt "STR_INVALID_COLUMN_SELECTION"
msgid "The statement contains an invalid selection of columns."
msgstr "بیان کالماں دی غلط چُݨ رکھدا ہے۔"

#. iLNAb
#: connectivity/inc/strings.hrc:49
msgctxt "STR_COULD_NOT_LOAD_FILE"
msgid "The file $filename$ could not be loaded."
msgstr "$filename$ فائل لوڈ کائنی تھئی۔"

#. jq62z
#: connectivity/inc/strings.hrc:50
msgctxt "STR_LOAD_FILE_ERROR_MESSAGE"
msgid ""
"The attempt to load the file resulted in the following error message ($exception_type$):\n"
"\n"
"$error_message$"
msgstr ""
"فائل لوڈ کرݨ دی کوشش دا نتیجہ ہیٹھ ݙتا ڳیا غلطی پیغام ہے ($exception_type$):\n"
"\n"
"$error_message$"

#. sbrdS
#. = the ado driver's resource strings
#: connectivity/inc/strings.hrc:52
msgctxt "STR_TYPE_NOT_CONVERT"
msgid "The type could not be converted."
msgstr "قسم تبدیل کائنی کیتی ونڄ سڳی۔"

#. 3L6uG
#: connectivity/inc/strings.hrc:53
msgctxt "STR_INVALID_COLUMN_DESCRIPTOR_ERROR"
msgid "Could not append column: invalid column descriptor."
msgstr "کالم شامل کائنی کیتا ونڄ سڳیا: غلط کالم ڈسکرپٹر۔"

#. 4GMmY
#: connectivity/inc/strings.hrc:54
msgctxt "STR_INVALID_GROUP_DESCRIPTOR_ERROR"
msgid "Could not create group: invalid object descriptor."
msgstr "گروپ بݨایا کائنی ونڄ سڳیا: غلط آبجیکٹ ڈسکرپٹر۔"

#. MDKgr
#: connectivity/inc/strings.hrc:55
msgctxt "STR_INVALID_INDEX_DESCRIPTOR_ERROR"
msgid "Could not create index: invalid object descriptor."
msgstr "انڈیکس بݨایا کائنی ونڄ سڳیا: غلط آبجیکٹ ڈسکرپٹر۔"

#. jPjxi
#: connectivity/inc/strings.hrc:56
msgctxt "STR_INVALID_KEY_DESCRIPTOR_ERROR"
msgid "Could not create key: invalid object descriptor."
msgstr "کلید بݨائی کائنی ونڄ سڳی: غلط آبجیکٹ ڈسکرپٹر۔"

#. jaDH3
#: connectivity/inc/strings.hrc:57
msgctxt "STR_INVALID_TABLE_DESCRIPTOR_ERROR"
msgid "Could not create table: invalid object descriptor."
msgstr "ٹیبل بݨائی کائنی ونڄ سڳی: غلط آبجیکٹ ڈسکرپٹر۔"

#. utNzu
#: connectivity/inc/strings.hrc:58
msgctxt "STR_INVALID_USER_DESCRIPTOR_ERROR"
msgid "Could not create user: invalid object descriptor."
msgstr "ورتکار بݨایا کائنی ونڄ سڳیا: غلط آبجیکٹ ڈسکرپٹر۔"

#. 4TE9R
#: connectivity/inc/strings.hrc:59
msgctxt "STR_INVALID_VIEW_DESCRIPTOR_ERROR"
msgid "Could not create view: invalid object descriptor."
msgstr "منظر بݨایا کائنی ونڄ سڳیا: غلط آبجیکٹ ڈسکرپٹر۔"

#. BrHQp
#: connectivity/inc/strings.hrc:60
msgctxt "STR_VIEW_NO_COMMAND_ERROR"
msgid "Could not create view: no command object."
msgstr "منظر بݨایا کائنی ونڄ سڳیا: کوئی کمانڈ آبجیکٹ کائنی۔"

#. F6ygP
#: connectivity/inc/strings.hrc:61
msgctxt "STR_NO_CONNECTION"
msgid "The connection could not be created. Maybe the necessary data provider is not installed."
msgstr "کنکشن بݨایا کائنی ونڄ سڳیا۔ شاید ضروری ڈیٹا پرووائیڈر نصب کائنی ہے۔"

#. GRZEu
#. dbase
#: connectivity/inc/strings.hrc:63
msgctxt "STR_COULD_NOT_DELETE_INDEX"
msgid "The index could not be deleted. An unknown error while accessing the file system occurred."
msgstr "انڈیکس مٹایا کائنی ونڄ سڳیا۔ فائل سسٹم تائیں رسائی دے دوران ہک نامعلوم غلطی تھئی۔"

#. JbDnu
#: connectivity/inc/strings.hrc:64
msgctxt "STR_ONL_ONE_COLUMN_PER_INDEX"
msgid "The index could not be created. Only one column per index is allowed."
msgstr "انڈیکس بݨایا کائنی ونڄ سڳیا۔ ہر انڈیکس کیتے صرف ہک کالم دی اجازت ہے۔"

#. rB3XE
#: connectivity/inc/strings.hrc:65
msgctxt "STR_COULD_NOT_CREATE_INDEX_NOT_UNIQUE"
msgid "The index could not be created. The values are not unique."
msgstr "انڈیکس بݨایا کائنی ونڄ سڳیا۔ قیمتاں منفرد کائنی۔"

#. f8DTu
#: connectivity/inc/strings.hrc:66
msgctxt "STR_COULD_NOT_CREATE_INDEX"
msgid "The index could not be created. An unknown error appeared."
msgstr "انڈیکس بݨایا کائنی ونڄ سڳیا۔ ہک نامعلوم غلطی سامݨے آئی۔"

#. 9eEjK
#: connectivity/inc/strings.hrc:67
msgctxt "STR_COULD_NOT_CREATE_INDEX_NAME"
msgid "The index could not be created. The file “$filename$” is used by another index."
msgstr "انڈیکس بݨایا کائنی ونڄ سڳیا۔ “$filename$” فائل ٻئے انڈیکس ولوں ورتی ویندی ہے۔"

#. GcK7B
#: connectivity/inc/strings.hrc:68
msgctxt "STR_COULD_NOT_CREATE_INDEX_KEYSIZE"
msgid "The index could not be created. The size of the chosen column is too big."
msgstr "انڈیکس بݨایا کائنی ونڄ سڳیا۔ چُݨے ڳئے کالم دا سائز ٻہوں وڈا ہے۔"

#. NGwFW
#: connectivity/inc/strings.hrc:69
msgctxt "STR_SQL_NAME_ERROR"
msgid "The name “$name$” does not match SQL naming constraints."
msgstr "“$name$” ناں SQL ناں رکھݨ دیاں پابندیاں نال میل کائنی کھاندا۔"

#. wv2Cx
#: connectivity/inc/strings.hrc:70
msgctxt "STR_COULD_NOT_DELETE_FILE"
msgid "The file $filename$ could not be deleted."
msgstr "$filename$ فائل مٹائی کائنی ونڄ سڳی۔"

#. PiFvx
#: connectivity/inc/strings.hrc:71
msgctxt "STR_INVALID_COLUMN_TYPE"
msgid "Invalid column type for column “$columnname$”."
msgstr "“$columnname$” کالم دی قسم غلط ہے۔"

#. wB2gE
#: connectivity/inc/strings.hrc:72
msgctxt "STR_INVALID_COLUMN_PRECISION"
msgid "Invalid precision for column “$columnname$”."
msgstr "“$columnname$” کالم دی درستگی غلط ہے۔"

#. v67fT
#: connectivity/inc/strings.hrc:73
msgctxt "STR_INVALID_PRECISION_SCALE"
msgid "Precision is less than scale for column “$columnname$”."
msgstr "“$columnname$” کالم کیتے درستگی پیمانے توں گھٹ ہے۔"

#. J3KEu
#: connectivity/inc/strings.hrc:74
msgctxt "STR_INVALID_COLUMN_NAME_LENGTH"
msgid "Invalid column name length for column “$columnname$”."
msgstr "“$columnname$” کالم دے ناں دی لمبائی غلط ہے۔"

#. ZQUww
#: connectivity/inc/strings.hrc:75
msgctxt "STR_DUPLICATE_VALUE_IN_COLUMN"
msgid "Duplicate value found in column “$columnname$”."
msgstr "“$columnname$” کالم وچ دوہری قیمت لبھی ڳئی۔"

#. zSeBJ
#: connectivity/inc/strings.hrc:76
msgctxt "STR_INVALID_COLUMN_DECIMAL_VALUE"
msgid ""
"The “$columnname$” column has been defined as a “Decimal” type, the maximum length is $precision$ characters (with $scale$ decimal places).\n"
"\n"
"The specified value “$value$” is longer than the number of digits allowed."
msgstr ""
"“$columnname$” کالم “Decimal” قسم دے طور تے مقرر کیتا ڳیا ہے، ودھ توں ودھ لمبائی $precision$ حرف ہے ($scale$ اعشاریہ تھاں نال)۔\n"
"\n"
"مقرر قیمت “$value$” اجازت ݙتے ڳئے ہندسیاں دی گݨتی توں لمبی ہے۔"

#. M6CvC
#: connectivity/inc/strings.hrc:77
msgctxt "STR_COLUMN_NOT_ALTERABLE"
msgid "The column “$columnname$” could not be altered. Maybe the file system is write-protected."
msgstr "“$columnname$” کالم بدلیا کائنی ونڄ سڳیا۔ شاید فائل سسٹم لکھݨ توں محفوظ ہے۔"

#. st6hA
#: connectivity/inc/strings.hrc:78
msgctxt "STR_INVALID_COLUMN_VALUE"
msgid "The column “$columnname$” could not be updated. The value is invalid for that column."
msgstr "“$columnname$” کالم اپ ڈیٹ کائنی کیتا ونڄ سڳیا۔ اوہ قیمت اوں کالم کیتے غلط ہے۔"

#. 5rH5W
#: connectivity/inc/strings.hrc:79
msgctxt "STR_COLUMN_NOT_ADDABLE"
msgid "The column “$columnname$” could not be added. Maybe the file system is write-protected."
msgstr "“$columnname$” کالم شامل کائنی کیتا ونڄ سڳیا۔ شاید فائل سسٹم لکھݨ توں محفوظ ہے۔"

#. B9ACk
#: connectivity/inc/strings.hrc:80
msgctxt "STR_COLUMN_NOT_DROP"
msgid "The column at position “$position$” could not be dropped. Maybe the file system is write-protected."
msgstr "“$position$” مقام تے کالم ہٹایا کائنی ونڄ سڳیا۔ شاید فائل سسٹم لکھݨ توں محفوظ ہے۔"

#. KfedE
#: connectivity/inc/strings.hrc:81
msgctxt "STR_TABLE_NOT_DROP"
msgid "The table “$tablename$” could not be dropped. Maybe the file system is write-protected."
msgstr "“$tablename$” ٹیبل ہٹائی کائنی ونڄ سڳی۔ شاید فائل سسٹم لکھݨ توں محفوظ ہے۔"

#. R3BGx
#: connectivity/inc/strings.hrc:82
msgctxt "STR_COULD_NOT_ALTER_TABLE"
msgid "The table could not be altered."
msgstr "ٹیبل بدلی کائنی ونڄ سڳی۔"

#. DijyA
#: connectivity/inc/strings.hrc:83
msgctxt "STR_INVALID_DBASE_FILE"
msgid "The file “$filename$” is an invalid (or unrecognized) dBASE file."
msgstr "“$filename$” فائل غلط (یا ناپچھاݨی ڳئی) dBASE فائل ہے۔"

#. LhHTA
#. Evoab2
#: connectivity/inc/strings.hrc:85
msgctxt "STR_CANNOT_OPEN_BOOK"
msgid "Cannot open Evolution address book."
msgstr "ایوولوشن پتہ کتاب کھولی کائنی ونڄ سڳدی۔"

#. sxbEF
#: connectivity/inc/strings.hrc:86
msgctxt "STR_SORT_BY_COL_ONLY"
msgid "Can only sort by table columns."
msgstr "صرف ٹیبل کالماں دے حساب نال ترتیب ݙتی ونڄ سڳدی ہے۔"

#. 7R6eC
#. File
#: connectivity/inc/strings.hrc:88
msgctxt "STR_QUERY_COMPLEX_COUNT"
msgid "The query cannot be executed. It is too complex. Only “COUNT(*)” is supported."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ ایندا ٻہوں پیچیدہ ہے۔ صرف “COUNT(*)” دی سپورٹ کیتی ویندی ہے۔"

#. PJivi
#: connectivity/inc/strings.hrc:89
msgctxt "STR_QUERY_INVALID_BETWEEN"
msgid "The query cannot be executed. The “BETWEEN” arguments are not correct."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ “BETWEEN” دلیلاں درست کائنی۔"

#. CHRju
#: connectivity/inc/strings.hrc:90
msgctxt "STR_QUERY_FUNCTION_NOT_SUPPORTED"
msgid "The query cannot be executed. The function is not supported."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ فنکشن دی سپورٹ کائنی کیتی ویندی۔"

#. mnc5r
#: connectivity/inc/strings.hrc:91
msgctxt "STR_TABLE_READONLY"
msgid "The table cannot be changed. It is read only."
msgstr "ٹیبل بدلی کائنی ونڄ سڳدی۔ ایندا صرف پڑھݨ جوڳا ہے۔"

#. TUUpf
#: connectivity/inc/strings.hrc:92
msgctxt "STR_DELETE_ROW"
msgid "The row could not be deleted. The option “Display inactive records” is set."
msgstr "قطار مٹائی کائنی ونڄ سڳی۔ “Display inactive records” آپشن مقرر ہے۔"

#. TZTfv
#: connectivity/inc/strings.hrc:93
msgctxt "STR_ROW_ALREADY_DELETED"
msgid "The row could not be deleted. It is already deleted."
msgstr "قطار مٹائی کائنی ونڄ سڳی۔ ایندا پہلے ہی مٹائی ڳئی ہے۔"

#. NK9AX
#: connectivity/inc/strings.hrc:94
msgctxt "STR_QUERY_MORE_TABLES"
msgid "The query cannot be executed. It contains more than one table."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ ایندا وچ ہک توں ودھ ٹیبل ہے۔"

#. L4Ffm
#: connectivity/inc/strings.hrc:95
msgctxt "STR_QUERY_NO_TABLE"
msgid "The query cannot be executed. It contains no valid table."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ ایندا وچ کوئی درست ٹیبل کائنی۔"

#. 3KADk
#: connectivity/inc/strings.hrc:96
msgctxt "STR_QUERY_NO_COLUMN"
msgid "The query cannot be executed. It contains no valid columns."
msgstr "کوری چلائی کائنی ونڄ سڳدی۔ ایندا وچ کوئی درست کالم کائنی۔"

#. WcpZM
#: connectivity/inc/strings.hrc:97
msgctxt "STR_INVALID_PARA_COUNT"
msgid "The count of the given parameter values does not match the parameters."
msgstr "ݙتے ڳئے پیرامیٹر قیمتاں دی گݨتی پیرامیٹرز نال میل کائنی کھاندی۔"

#. CFcjS
#: connectivity/inc/strings.hrc:98
msgctxt "STR_NO_VALID_FILE_URL"
msgid "The URL “$URL$” is not valid. A connection cannot be created."
msgstr "“$URL$” URL درست کائنی۔ کنکشن بݨایا کائنی ونڄ سڳدا۔"

#. YFjkG
#: connectivity/inc/strings.hrc:99
msgctxt "STR_NO_CLASSNAME"
msgid "The driver class “$classname$” could not be loaded."
msgstr "“$classname$” ڈرائیور کلاس لوڈ کائنی کیتی ڳئی۔"

#. jbnZZ
#: connectivity/inc/strings.hrc:100
msgctxt "STR_NO_JAVA"
msgid "No Java installation could be found. Please check your installation."
msgstr "کوئی جاوا انسٹالیشن کائنی لبھی۔ مہربانی کر تے آپݨی انسٹالیشن چیک کرو۔"

#. GdN4i
#: connectivity/inc/strings.hrc:101
msgctxt "STR_NO_RESULTSET"
msgid "The execution of the query does not return a valid result set."
msgstr "کوری دا عمل ہک درست نتیجہ سیٹ واپس کائنی کریندا۔"

#. JGxgF
#: connectivity/inc/strings.hrc:102
msgctxt "STR_NO_ROWCOUNT"
msgid "The execution of the update statement does not affect any rows."
msgstr "اپ ڈیٹ بیان دا عمل کہیں قطار تے اثر کائنی کریندا۔"

#. yCACF
#: connectivity/inc/strings.hrc:103
msgctxt "STR_NO_CLASSNAME_PATH"
msgid "The additional driver class path is “$classpath$”."
msgstr "اضافی ڈرائیور کلاس پاتھ “$classpath$” ہے۔"

#. sX2NM
#: connectivity/inc/strings.hrc:104
msgctxt "STR_UNKNOWN_PARA_TYPE"
msgid "The type of parameter at position “$position$” is unknown."
msgstr "“$position$” مقام تے پیرامیٹر دی قسم نامعلوم ہے۔"

#. gSPCX
#: connectivity/inc/strings.hrc:105
msgctxt "STR_UNKNOWN_COLUMN_TYPE"
msgid "The type of column at position “$position$” is unknown."
msgstr "“$position$” مقام تے کالم دی قسم نامعلوم ہے۔"

#. 3FmFX
#. KAB
#: connectivity/inc/strings.hrc:107
msgctxt "STR_PARA_ONLY_PREPARED"
msgid "Parameters can appear only in prepared statements."
msgstr "پیرامیٹرز صرف تیار بیاناں وچ ظاہر تھی سڳدے ہن۔"

#. CB7pj
#. MACAB
#: connectivity/inc/strings.hrc:109
msgctxt "STR_NO_TABLE"
msgid "No such table!"
msgstr "ایہو جیہی کوئی ٹیبل کائنی!"

#. LUQBc
#: connectivity/inc/strings.hrc:110
msgctxt "STR_NO_MAC_OS_FOUND"
msgid "No suitable macOS installation was found."
msgstr "کوئی موزوں macOS انسٹالیشن کائنی لبھی۔"

#. HNSzq
#. hsqldb
#: connectivity/inc/strings.hrc:112
msgctxt "STR_NO_STORAGE"
msgid "The connection can not be established. No storage or URL was given."
msgstr "کنکشن قائم کائنی کیتا ونڄ سڳدا۔ کوئی اسٹوریج یا URL کائنی ݙتا ڳیا۔"

#. SZSmZ
#: connectivity/inc/strings.hrc:113
msgctxt "STR_INVALID_FILE_URL"
msgid "The given URL contains no valid local file system path. Please check the location of your database file."
msgstr "ݙتے ڳئے URL وچ کوئی درست مقامی فائل سسٹم پاتھ کائنی۔ مہربانی کر تے آپݨی ڈیٹا بیس فائل دی جاہ چیک کرو۔"

#. MgCH9
#: connectivity/inc/strings.hrc:114
msgctxt "STR_NO_TABLE_CONTAINER"
msgid "An error occurred while obtaining the connection’s table container."
msgstr "کنکشن دے ٹیبل کنٹینر گھݨݨ دے دوران ہک غلطی تھئی۔"

#. uxoGW
#: connectivity/inc/strings.hrc:115
msgctxt "STR_NO_TABLENAME"
msgid "There is no table named “$tablename$”."
msgstr "“$tablename$” ناں آلی کوئی ٹیبل کائنی۔"

#. 3BxCF
#: connectivity/inc/strings.hrc:116
msgctxt "STR_NO_DOCUMENTUI"
msgid "The provided DocumentUI is not allowed to be NULL."
msgstr "ݙتا ڳیا DocumentUI NULL ہووݨ دی اجازت کائنی۔"

#. VLEMM
#: connectivity/inc/strings.hrc:117
msgctxt "STR_ERROR_NEW_VERSION"
msgid "The connection could not be established. The database was created by a newer version of %PRODUCTNAME."
msgstr "کنکشن قائم کائنی کیتا ونڄ سڳیا۔ ڈیٹا بیس %PRODUCTNAME دے نویں تر ورژن ولوں بݨایا ڳیا ہے۔"

#. 3BKTP
#: connectivity/inc/strings.hrc:119
msgctxt "STR_ROW_SET_OPERATION_VETOED"
msgid "The record operation has been vetoed."
msgstr "ریکارڈ آپریشن ویٹو کیتا ڳیا ہے۔"

#. VEbfy
#: connectivity/inc/strings.hrc:120
msgctxt "STR_PARSER_CYCLIC_SUB_QUERIES"
msgid "The statement contains a cyclic reference to one or more subqueries."
msgstr "بیان ہک یا ودھ ذیلی کوریاں دا چکری حوالہ رکھدا ہے۔"

#. jDAGJ
#: connectivity/inc/strings.hrc:121
msgctxt "STR_DB_OBJECT_NAME_WITH_SLASHES"
msgid "The name must not contain any slashes (“/”)."
msgstr "ناں وچ کوئی سلیش (“/”) کائنی ہووݨا چاہیدا۔"

#. 5Te4k
#: connectivity/inc/strings.hrc:122
msgctxt "STR_DB_INVALID_SQL_NAME"
msgid "$1$ is no SQL conform identifier."
msgstr "$1$ کوئی SQL دے مطابق شناخت کنندہ کائنی۔"

#. kvvjL
#: connectivity/inc/strings.hrc:123
msgctxt "STR_DB_QUERY_NAME_WITH_QUOTES"
msgid "Query names must not contain quote characters."
msgstr "کوری ناواں وچ کوئی حوالہ حرف کائنی ہووݨا چاہیدا۔"

#. oftHX
#: connectivity/inc/strings.hrc:124
msgctxt "STR_DB_OBJECT_NAME_IS_USED"
msgid "The name “$1$” is already in use in the database."
msgstr "“$1$” ناں ڈیٹا بیس وچ پہلے ہی ورتیا ونڄ رہیا ہے۔"

#. gD8xU
#: connectivity/inc/strings.hrc:125
msgctxt "STR_DB_NOT_CONNECTED"
msgid "No connection to the database exists."
msgstr "ڈیٹا بیس نال کوئی کنکشن کائنی۔"

#. Dpdod
#: connectivity/inc/strings.hrc:126
msgctxt "STR_AB_ADDRESSBOOK_NOT_FOUND"
msgid "No $1$ exists."
msgstr "کوئی $1$ کائنی۔"

#. e7kHo
#: connectivity/inc/strings.hrc:127
msgctxt "STR_DATA_CANNOT_SELECT_UNFILTERED"
msgid "Unable to display the complete table content. Please apply a filter."
msgstr "پورا ٹیبل مواد ݙکھایا کائنی ونڄ سڳدا۔ مہربانی کر تے ہک فلٹر لاؤ۔"

