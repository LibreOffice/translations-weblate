#. FAMGa
#: dbaccess/inc/strings.hrc:27
msgctxt "RID_STR_CONNECTION_INVALID"
msgid "No connection could be established."
msgstr "کوئی کنکشن قائم کائنی تھیا۔"

#. y8rYj
#: dbaccess/inc/strings.hrc:28
msgctxt "RID_STR_TABLE_IS_FILTERED"
msgid "The table $name$ already exists. It is not visible because it has been filtered out."
msgstr "ٹیبل $name$ پہلے توں موجود ہے۔ ایہ نظر کائنی آندا کیوں جو ایہنوں فلٹر کیتا ڳیا ہے۔"

#. ZfmVR
#: dbaccess/inc/strings.hrc:29
msgctxt "RID_STR_COULDNOTCONNECT_UNSPECIFIED"
msgid "The connection to the external data source could not be established. An unknown error occurred. The driver is probably defective."
msgstr "بیرونی ڈیٹا ماخذ نال کنکشن قائم کائنی تھیا۔ ہک نامعلوم غلطی تھئی ہے۔ ڈرائیور شاید خراب ہے۔"

#. XdFHe
#: dbaccess/inc/strings.hrc:30
msgctxt "RID_STR_COULDNOTCONNECT_NODRIVER"
msgid "The connection to the external data source could not be established. No SDBC driver was found for the URL '$name$'."
msgstr "بیرونی ڈیٹا ماخذ نال کنکشن قائم کائنی تھیا۔ URL '$name$' کیتے کوئی SDBC ڈرائیور کائنی ملیا۔"

#. yAwff
#: dbaccess/inc/strings.hrc:31
msgctxt "RID_STR_COULDNOTCONNECT_UNTRUSTED"
msgid "The connection to the external data source could not be established. The database document is not in a trusted location."
msgstr "بیرونی ڈیٹا ماخذ نال کنکشن قائم کائنی تھیا۔ ڈیٹا بیس دستاویز بھروسے والی جگہ تے کائنی ہے۔"

#. HFLkw
#: dbaccess/inc/strings.hrc:32
msgctxt "RID_STR_COULDNOTLOAD_MANAGER"
msgid "The connection to the external data source could not be established. The SDBC driver manager could not be loaded."
msgstr "بیرونی ڈیٹا ماخذ نال کنکشن قائم کائنی تھیا۔ SDBC ڈرائیور مینیجر لوڈ کائنی تھیا۔"

#. PzEVD
#: dbaccess/inc/strings.hrc:33
msgctxt "RID_STR_FORM"
msgid "Form"
msgstr "فارم"

#. nkamB
#: dbaccess/inc/strings.hrc:34
msgctxt "RID_STR_REPORT"
msgid "Report"
msgstr "رپورٹ"

#. bYjEz
#: dbaccess/inc/strings.hrc:35
msgctxt "RID_STR_DATASOURCE_NOT_STORED"
msgid "The data source was not saved. Please use the interface XStorable to save the data source."
msgstr "ڈیٹا ماخذ محفوظ کائنی تھیا۔ ڈیٹا ماخذ نوں محفوظ کرݨ کیتے انٹرفیس XStorable ورتو۔"

#. BuEPn
#: dbaccess/inc/strings.hrc:36
msgctxt "RID_STR_ONLY_QUERY"
msgid ""
"The given command is not a SELECT statement.\n"
"Only queries are allowed."
msgstr ""
"ݙتی ڳئی کمانڈ SELECT سٹیٹمنٹ کائنی ہے۔\n"
"صرف کوئریاں دی اجازت ہے۔"

#. 4CSx9
#: dbaccess/inc/strings.hrc:37
msgctxt "RID_STR_NO_VALUE_CHANGED"
msgid "No values were modified."
msgstr "کوئی قدراں وٹائیاں کائنی ڳئیاں۔"

#. TFFGN
#: dbaccess/inc/strings.hrc:38
msgctxt "RID_STR_NO_XROWUPDATE"
msgid "Values could not be inserted. The XRowUpdate interface is not supported by ResultSet."
msgstr "قدراں شامل کائنی کیتیاں ونڄ سڳیاں۔ ResultSet XRowUpdate انٹرفیس دی حمایت کائنی کریندا۔"

#. PQPVY
#: dbaccess/inc/strings.hrc:39
msgctxt "RID_STR_NO_XRESULTSETUPDATE"
msgid "Values could not be inserted. The XResultSetUpdate interface is not supported by ResultSet."
msgstr "قدراں شامل کائنی کیتیاں ونڄ سڳیاں۔ ResultSet XResultSetUpdate انٹرفیس دی حمایت کائنی کریندا۔"

#. EAkm5
#: dbaccess/inc/strings.hrc:40
msgctxt "RID_STR_NO_UPDATE_MISSING_CONDITION"
msgid "Values could not be modified, due to a missing condition statement."
msgstr "قدراں وٹائیاں کائنی ونڄ سڳیاں، کیوں جو شرط والا سٹیٹمنٹ موجود کائنی ہے۔"

#. 7Jns7
#: dbaccess/inc/strings.hrc:41
msgctxt "RID_STR_NO_COLUMN_ADD"
msgid "The adding of columns is not supported."
msgstr "کالماں نوں شامل کرݨ دی حمایت کائنی ہے۔"

#. BGMPE
#: dbaccess/inc/strings.hrc:42
msgctxt "RID_STR_NO_COLUMN_DROP"
msgid "The dropping of columns is not supported."
msgstr "کالماں نوں کڈھݨ دی حمایت کائنی ہے۔"

#. e2SUr
#: dbaccess/inc/strings.hrc:43
msgctxt "RID_STR_NO_CONDITION_FOR_PK"
msgid "The WHERE condition could not be created for the primary key."
msgstr "پرائمری کی کیتے WHERE شرط بݨائی کائنی ونڄ سڳی۔"

#. NPDCA
#: dbaccess/inc/strings.hrc:44
msgctxt "RID_STR_COLUMN_UNKNOWN_PROP"
msgid "The column does not support the property '%value'."
msgstr "کالم '%value' خصوصیت دی حمایت کائنی کریندا۔"

#. MDPRn
#: dbaccess/inc/strings.hrc:45
msgctxt "RID_STR_COLUMN_NOT_SEARCHABLE"
msgid "The column is not searchable!"
msgstr "کالم ڳولݨ یوگ کائنی ہے!"

#. s9iVh
#: dbaccess/inc/strings.hrc:46
msgctxt "RID_STR_NOT_SEQUENCE_INT8"
msgid "The value of the columns is not of the type Sequence<sal_Int8>."
msgstr "کالماں دی قدر Sequence<sal_Int8> قسم دی کائنی ہے۔"

#. Mrizz
#: dbaccess/inc/strings.hrc:47
msgctxt "RID_STR_COLUMN_NOT_VALID"
msgid "The column is not valid."
msgstr "کالم درست کائنی ہے۔"

#. CyL8V
#: dbaccess/inc/strings.hrc:48
msgctxt "RID_STR_COLUMN_MUST_VISIBLE"
msgid "The column '%name' must be visible as a column."
msgstr "کالم '%name' نوں کالم دے طور تے نظر آوݨا چاہیدا ہے۔"

#. kZnJD
#: dbaccess/inc/strings.hrc:49
msgctxt "RID_STR_NO_XQUERIESSUPPLIER"
msgid "The interface XQueriesSupplier is not available."
msgstr "انٹرفیس XQueriesSupplier دستیاب کائنی ہے۔"

#. fBeqP
#: dbaccess/inc/strings.hrc:50
msgctxt "RID_STR_NO_ABS_ZERO"
msgid "An 'absolute(0)' call is not allowed."
msgstr "'absolute(0)' کال دی اجازت کائنی ہے۔"

#. GXMTQ
#: dbaccess/inc/strings.hrc:51
msgctxt "RID_STR_NO_RELATIVE"
msgid "Relative positioning is not allowed in this state."
msgstr "ایں حالت وچ نسبتی پوزیشننگ دی اجازت کائنی ہے۔"

#. LgS5s
#: dbaccess/inc/strings.hrc:52
msgctxt "RID_STR_NO_REFRESH_AFTERLAST"
msgid "A row cannot be refreshed when the ResultSet is positioned after the last row."
msgstr "جݙاں ResultSet چھیکڑی قطار توں بعد رکھی ڳئی ہووے تاں ہک قطار نوں تازہ کائنی کیتا ونڄ سڳدا۔"

#. TqUZX
#: dbaccess/inc/strings.hrc:53
msgctxt "RID_STR_NO_MOVETOINSERTROW_CALLED"
msgid "A new row cannot be inserted when the ResultSet is not first moved to the insert row."
msgstr "جݙاں ResultSet نوں پہلے انسرٹ قطار تے منتقل کائنی کیتا ونڄے تاں نویں قطار شامل کائنی کیتی ونڄ سڳدی۔"

#. aGfUX
#: dbaccess/inc/strings.hrc:54
msgctxt "RID_STR_NO_UPDATEROW"
msgid "A row cannot be modified in this state"
msgstr "ایں حالت وچ ہک قطار وٹائی کائنی ونڄ سڳدی۔"

#. uaxsC
#: dbaccess/inc/strings.hrc:55
msgctxt "RID_STR_NO_DELETEROW"
msgid "A row cannot be deleted in this state."
msgstr "ایں حالت وچ ہک قطار مٹائی کائنی ونڄ سڳدی۔"

#. 6aAaN
#: dbaccess/inc/strings.hrc:56
msgctxt "RID_STR_NO_TABLE_RENAME"
msgid "The driver does not support table renaming."
msgstr "ڈرائیور ٹیبل دا ناں وٹاو݊ݨ دی حمایت کائنی کریندا۔"

#. Q8ADk
#: dbaccess/inc/strings.hrc:57
msgctxt "RID_STR_COLUMN_ALTER_BY_NAME"
msgid "The driver does not support the modification of column descriptions by changing the name."
msgstr "ڈرائیور کالم دیاں تفصیلاں نوں ناں وٹاو݊ݨ نال وٹاو݊ݨ دی حمایت کائنی کریندا۔"

#. tZWaL
#: dbaccess/inc/strings.hrc:58
msgctxt "RID_STR_COLUMN_ALTER_BY_INDEX"
msgid "The driver does not support the modification of column descriptions by changing the index."
msgstr "ڈرائیور کالم دیاں تفصیلاں نوں انڈیکس وٹاو݊ݨ نال وٹاو݊ݨ دی حمایت کائنی کریندا۔"

#. Z5gGE
#: dbaccess/inc/strings.hrc:59
msgctxt "RID_STR_FILE_DOES_NOT_EXIST"
msgid "The file \"$file$\" does not exist."
msgstr "فائل \"$file$\" موجود کائنی ہے۔"

#. XMAYD
#: dbaccess/inc/strings.hrc:60
msgctxt "RID_STR_TABLE_DOES_NOT_EXIST"
msgid "There exists no table named \"$table$\"."
msgstr "\"$table$\" ناں دی کوئی ٹیبل موجود کائنی ہے۔"

#. XcJvN
#: dbaccess/inc/strings.hrc:61
msgctxt "RID_STR_QUERY_DOES_NOT_EXIST"
msgid "There exists no query named \"$table$\"."
msgstr "\"$table$\" ناں دی کوئی کوئری موجود کائنی ہے۔"

#. anFDx
#: dbaccess/inc/strings.hrc:62
msgctxt "RID_STR_CONFLICTING_NAMES"
msgid "There are tables in the database whose names conflict with the names of existing queries. To make full use of all queries and tables, make sure they have distinct names."
msgstr "ڈیٹا بیس وچ کجھ ٹیبلاں ہن جِنھاں دے ناں موجودہ کوئریاں دے ناواں نال ٹکراݨدے ہن۔ ساریاں کوئریاں تے ٹیبلاں دا پورا فائدہ چاو݊ݨ کیتے، یقینی بݨاؤ جو اُنھاں دے ناں وکھرے ہووݨ۔"

#. e2YrR
#: dbaccess/inc/strings.hrc:63
msgctxt "RID_STR_COMMAND_LEADING_TO_ERROR"
msgid ""
"The SQL command leading to this error is:\n"
"\n"
"$command$"
msgstr ""
"ایں غلطی تائیں ونڄݨ والی SQL کمانڈ ایہ ہے:\n"
"\n"
"$command$"

#. s3B76
#: dbaccess/inc/strings.hrc:64
msgctxt "RID_STR_STATEMENT_WITHOUT_RESULT_SET"
msgid "The SQL command does not describe a result set."
msgstr "SQL کمانڈ نتیجہ سیٹ دی وضاحت کائنی کریندی۔"

#. o8AAh
#: dbaccess/inc/strings.hrc:65
msgctxt "RID_STR_NAME_MUST_NOT_BE_EMPTY"
msgid "The name must not be empty."
msgstr "ناں خالی کائنی ہووݨا چاہیدا۔"

#. EDBgs
#: dbaccess/inc/strings.hrc:66
msgctxt "RID_STR_NO_NULL_OBJECTS_IN_CONTAINER"
msgid "The container cannot contain NULL objects."
msgstr "کنٹینر وچ NULL چیزاں کائنی رکھیاں ونڄ سڳدیاں۔"

#. BADJn
#: dbaccess/inc/strings.hrc:67
msgctxt "RID_STR_NAME_ALREADY_USED"
msgid "There already is an object with the given name."
msgstr "ݙتے ڳئے ناں والی چیز پہلے توں موجود ہے۔"

#. VdEjV
#: dbaccess/inc/strings.hrc:68
msgctxt "RID_STR_OBJECT_CONTAINER_MISMATCH"
msgid "This object cannot be part of this container."
msgstr "ایہ چیز ایں کنٹینر دا حصہ کائنی بݨ سڳدی۔"

#. DFQvz
#: dbaccess/inc/strings.hrc:69
msgctxt "RID_STR_OBJECT_ALREADY_CONTAINED"
msgid "The object already is, with a different name, part of the container."
msgstr "چیز پہلے توں وکھرے ناں نال کنٹینر دا حصہ ہے۔"

#. CjNwC
#: dbaccess/inc/strings.hrc:70
msgctxt "RID_STR_NAME_NOT_FOUND"
msgid "Unable to find the document '$name$'."
msgstr "دستاویز '$name$' کائنی لبھی۔"

#. LM7dF
#: dbaccess/inc/strings.hrc:71
msgctxt "RID_STR_ERROR_WHILE_SAVING"
msgid ""
"Could not save the document to $location$:\n"
"$message$"
msgstr ""
"دستاویز نوں $location$ تے محفوظ کائنی کیتا ونڄ سڳیا:\n"
"$message$"

#. tHzew
#: dbaccess/inc/strings.hrc:72
msgctxt "RID_NO_SUCH_DATA_SOURCE"
msgid ""
"Error accessing data source '$name$':\n"
"$error$"
msgstr ""
"ڈیٹا ماخذ '$name$' تائیں رسائی وچ غلطی:\n"
"$error$"

#. ALTav
#: dbaccess/inc/strings.hrc:73
msgctxt "RID_STR_NO_SUB_FOLDER"
msgid "There exists no folder named \"$folder$\"."
msgstr "\"$folder$\" ناں دا کوئی فولڈر موجود کائنی ہے۔"

#. Fhh7V
#: dbaccess/inc/strings.hrc:74
msgctxt "RID_STR_NO_DELETE_BEFORE_AFTER"
msgid "Cannot delete the before-first or after-last row."
msgstr "پہلی توں پہلاں والی یا چھیکڑی توں بعد والی قطار مٹائی کائنی ونڄ سڳدی۔"

#. nqVfA
#: dbaccess/inc/strings.hrc:75
msgctxt "RID_STR_NO_DELETE_INSERT_ROW"
msgid "Cannot delete the insert-row."
msgstr "انسرٹ قطار مٹائی کائنی ونڄ سڳدی۔"

#. 9BUGj
#: dbaccess/inc/strings.hrc:76
msgctxt "RID_STR_RESULT_IS_READONLY"
msgid "Result set is read only."
msgstr "نتیجہ سیٹ صرف پڑھݨ یوگ ہے۔"

#. 47GAs
#: dbaccess/inc/strings.hrc:77
msgctxt "RID_STR_NO_DELETE_PRIVILEGE"
msgid "DELETE privilege not available."
msgstr "DELETE استحقاق دستیاب کائنی ہے۔"

#. SsHD3
#: dbaccess/inc/strings.hrc:78
msgctxt "RID_STR_ROW_ALREADY_DELETED"
msgid "Current row is already deleted."
msgstr "موجودہ قطار پہلے توں مٹائی ڳئی ہے۔"

#. DkbQp
#: dbaccess/inc/strings.hrc:79
msgctxt "RID_STR_UPDATE_FAILED"
msgid "Current row could not be updated."
msgstr "موجودہ قطار نوں اپ ڈیٹ کائنی کیتا ونڄ سڳیا۔"

#. ccyRu
#: dbaccess/inc/strings.hrc:80
msgctxt "RID_STR_NO_INSERT_PRIVILEGE"
msgid "INSERT privilege not available."
msgstr "INSERT استحقاق دستیاب کائنی ہے۔"

#. RyCJt
#: dbaccess/inc/strings.hrc:81
msgctxt "RID_STR_INTERNAL_ERROR"
msgid "Internal error: no statement object provided by the database driver."
msgstr "اندرونی غلطی: ڈیٹا بیس ڈرائیور ولوں کوئی سٹیٹمنٹ چیز کائنی ݙتی ڳئی۔"

#. SMWJi
#: dbaccess/inc/strings.hrc:82
msgctxt "RID_STR_EXPRESSION1"
msgid "Expression1"
msgstr ""

#. 32Lgg
#: dbaccess/inc/strings.hrc:83
msgctxt "RID_STR_NO_SQL_COMMAND"
msgid "No SQL command was provided."
msgstr "کوئی SQL کمانڈ کائنی ݙتی ڳئی۔"

#. bvez7
#: dbaccess/inc/strings.hrc:84
msgctxt "RID_STR_INVALID_INDEX"
msgid "Invalid column index."
msgstr "غلط کالم انڈیکس۔"

#. uAGCJ
#: dbaccess/inc/strings.hrc:85
msgctxt "RID_STR_INVALID_CURSOR_STATE"
msgid "Invalid cursor state."
msgstr "غلط کرسر حالت۔"

#. Dqrzw
#: dbaccess/inc/strings.hrc:86
msgctxt "RID_STR_CURSOR_BEFORE_OR_AFTER"
msgid "The cursor points to before the first or after the last row."
msgstr "کرسر پہلی قطار توں پہلاں یا چھیکڑی قطار توں بعد دی طرف اشارہ کریندا ہے۔"

#. z9fkj
#: dbaccess/inc/strings.hrc:87
msgctxt "RID_STR_NO_BOOKMARK_BEFORE_OR_AFTER"
msgid "The rows before the first and after the last row don't have a bookmark."
msgstr "پہلی قطار توں پہلاں والیاں تے چھیکڑی قطار توں بعد والیاں قطاراں کول کوئی نشانی کائنی ہے۔"

#. uYeyd
#: dbaccess/inc/strings.hrc:88
msgctxt "RID_STR_NO_BOOKMARK_DELETED"
msgid "The current row is deleted, and thus doesn't have a bookmark."
msgstr "موجودہ قطار مٹائی ڳئی ہے، تے ایں وجہ توں ایندی کوئی نشانی کائنی ہے۔"

#. 935sJ
#: dbaccess/inc/strings.hrc:89
msgctxt "RID_STR_CONNECTION_REQUEST"
msgid "A connection for the following URL was requested \"$name$\"."
msgstr "ہیٹھلے URL کیتے \"$name$\" دا کنکشن منگیا ڳیا ہے۔"

#. UgP8s
#: dbaccess/inc/strings.hrc:90
msgctxt "RID_STR_MISSING_EXTENSION"
msgid "The extension is not installed."
msgstr "ایکسٹینشن انسٹال کائنی ہے۔"

#. CvFBA
#: dbaccess/inc/strings.hrc:92
msgctxt "STR_QUERY_AND_TABLE_DISTINCT_NAMES"
msgid "You cannot give a table and a query the same name. Please use a name which is not yet used by a query or table."
msgstr "تُساں ہک ٹیبل تے ہک کوئری نوں ہکو ناں کائنی ݙے سڳدے۔ مہربانی کرکے اوہ ناں ورتو جیہڑا ہݨے تائیں کہیں کوئری یا ٹیبل ولوں کائنی ورتیا ڳیا۔"

#. bT6Um
#: dbaccess/inc/strings.hrc:93
msgctxt "STR_BASENAME_TABLE"
msgid "Table"
msgstr "ٹیبل"

#. Qw69D
#: dbaccess/inc/strings.hrc:94
msgctxt "STR_BASENAME_QUERY"
