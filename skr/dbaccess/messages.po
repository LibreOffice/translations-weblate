msgctxt "STR_HELP_BOOL_DEFAULT"
msgid ""
"Select a value that is to appear in all new records as default.\n"
"If the field is not to have a default value, select the empty string."
msgstr ""
"ہک قدر چݨو جیڑھی سارے نوویں ریکارڈاں وچ ڈیفالٹ دے طور تے نظر آوے۔\n"
"جے فیلڈ دی کوئی ڈیفالٹ قدر نہ ہووے تاں خالی تند چݨو۔"

#. AbZU4
#: dbaccess/inc/strings.hrc:249
msgctxt "STR_HELP_DEFAULT_VALUE"
msgid ""
"Enter a default value for this field.\n"
"\n"
"When you later enter data in the table, this string will be used in each new record for the field selected. It should, therefore, correspond to the cell format that needs to be entered below."
msgstr ""
"ایں فیلڈ کیتے ہک ڈیفالٹ قدر داخل کرو۔\n"
"\n"
"جݙاں تُساں بعد وچ ٹیبل وچ ڈیٹا داخل کریسو تاں ایہ تند چݨی ڳئی فیلڈ کیتے ہر نوویں ریکارڈ وچ ورتی ونڄسی۔ ایس کیتے، ایہنوں ہیٹھاں داخل کرݨ والے سیل فارمیٹ نال میل کھاو݊ݨا چاہیدا ہے۔"

