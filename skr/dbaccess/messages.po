msgstr "متن دیاں لائناں CR+LF نال ختم کرو۔"

#. vjCZB
#: dbaccess/uiconfig/ui/specialsettingspage.ui:222
msgctxt "specialsettingspage|extended_tip|eol"
msgid "Select to use the CR + LF code pair to end every text line (preferred for DOS and Windows operating systems)."
msgstr "ہر متن دی لائن ختم کرݨ کیتے CR + LF کوڈ جوڑا ورتݨ کیتے چݨو (DOS تے Windows آپریٹنگ سسٹمز کیتے ترجیحی)۔"

#. XFM7x
#: dbaccess/uiconfig/ui/specialsettingspage.ui:233
msgctxt "specialsettingspage|ignorecurrency"
msgid "Ignore currency field information"
msgstr "کرنسی فیلڈ دی معلومات نظر انداز کرو۔"

#. yQkEn
#: dbaccess/uiconfig/ui/specialsettingspage.ui:241
msgctxt "specialsettingspage|extended_tip|ignorecurrency"
msgid "Only for Oracle JDBC connections. When enabled it specifies that no column is treated as a currency field. The field type returned from the database driver is discarded."
msgstr "صرف Oracle JDBC کنکشنز کیتے۔ جݙاں ایہ فعال ہووے تاں ایہ مخصوص کریندا ہے جو کوئی کالم کرنسی فیلڈ دے طور تے نہ ورتیا ونڄے۔ ڈیٹا بیس ڈرائیور توں واپس ملݨ آلی فیلڈ دی قسم رد کر ݙتی ویندی ہے۔"

#. 2tRzG
#: dbaccess/uiconfig/ui/specialsettingspage.ui:252
msgctxt "specialsettingspage|inputchecks"
msgid "Form data input checks for required fields"
msgstr "فارم ڈیٹا ان پٹ لوڑھیندے فیلڈز دی جانچ کریندا ہے۔"

#. NyABn
#: dbaccess/uiconfig/ui/specialsettingspage.ui:260
msgctxt "specialsettingspage|extended_tip|inputchecks"
msgid "When you enter a new record or update an existing record in a form, and you leave a field empty which is bound to a database column which requires input, then you will see a message complaining about the empty field."
msgstr "جݙاں تساں ہک فارم وچ ہک نواں ریکارڈ داخل کریندے او یا ہک موجودہ ریکارڈ کوں اپڈیٹ کریندے او، تے تساں ہک فیلڈ کوں خالی چھوڑ ݙیندے او جیہڑی ڈیٹا بیس کالم نال جڑی ہوئی ہے جیندے کیتے ان پٹ لوڑھیندا ہے، تاں تساں خالی فیلڈ بارے شکایت کرݨ والا ہک سنیہا ݙیکھسو۔"

#. jEgvf
#: dbaccess/uiconfig/ui/specialsettingspage.ui:271
msgctxt "specialsettingspage|useodbcliterals"
