#. DG6Yn
#: cui/inc/uimode.hrc:23
msgctxt "RID_CUI_UIMODES"
msgid "Standard user interface with menu, toolbar, and collapsed sidebar. Intended for users who are familiar with the classic interface."
msgstr "معیاری یوزر انٹرفیس جیندے وچ مینیو، ٹول بار تے بند شدہ سائیڈ بار ہووے۔ ایہ اونہاں ورتکاراں کیتے ہے جیڑھے کلاسک انٹرفیس توں واقف ہن۔"

#. zqKTz
#: cui/inc/uimode.hrc:24
msgctxt "RID_CUI_UIMODES"
msgid "The Tabbed user interface is the most similar to the Ribbons used in Microsoft Office. It organizes functions in tabs and makes the main menu obsolete."
msgstr "ٹیب والا یوزر انٹرفیس Microsoft Office وچ ورتے ون٘ڄݨ آلے Ribbons دے سب توں ملدا جلدا ہے۔ ایہ فنکشنز کوں ٹیبز وچ ترتیب ݙیندا ہے تے مرکزی مینیو کوں غیر ضروری بݨا ݙیندا ہے۔"

#. xLKc9
#: cui/inc/uimode.hrc:25
msgctxt "RID_CUI_UIMODES"
msgid "Standard user interface but with single-line toolbar. Intended for use on small screens."
msgstr "معیاری یوزر انٹرفیس پر ہک لائن آلا ٹول بار۔ ایہ نِکیاں سکرینز تے ورتݨ کیتے ہے۔"

#. Z5HBF
#: cui/inc/uimode.hrc:26
msgctxt "RID_CUI_UIMODES"
msgid "Standard user interface with expanded sidebar. Expert users who want to quickly change many different properties are advised to use this UI."
msgstr "معیاری یوزر انٹرفیس جیندے وچ کھلا ہویا سائیڈ بار ہووے۔ ماہر ورتکار جیڑھے ٻہوں ساریاں مختلف خصوصیات کوں جلدی بدلݨا چاہندے ہن، اونہاں کوں ایہ UI ورتݨ دی صلاح ݙتی ویندی ہے۔"

#. Ux9Ct
#: cui/inc/uimode.hrc:27
msgctxt "RID_CUI_UIMODES"
msgid "The Tabbed Compact variant aims to be familiar with the Microsoft Office interface, yet occupying less space for smaller screens."
msgstr "Tabbed Compact ویرینٹ دا مقصد Microsoft Office انٹرفیس توں واقف ہووݨا ہے، پر نِکیاں سکرینز کیتے گھٹ جاہ گھندا ہے۔"

#. TmdAD
#: cui/inc/uimode.hrc:28
msgctxt "RID_CUI_UIMODES"
msgid "The Groupedbar interface provides access to functions in groups, with icons for most-frequently used features, and dropdown menus for others. This full variant favors functions and is slightly larger than others."
msgstr "Groupedbar انٹرفیس گروپاں وچ فنکشنز تائیں رسائی ݙیندا ہے، سب توں ودھ ورتے ون٘ڄݨ آلے خصوصیات کیتے آئیکنز دے نال، تے ٻئیاں کیتے ڈراپ ڈاؤن مینیوز۔ ایہ مکمل ویرینٹ فنکشنز کوں ترجیح ݙیندا ہے تے ٻئیاں توں تھوڑا وݙا ہے۔"

#. ssDDn
#: cui/inc/uimode.hrc:29
msgctxt "RID_CUI_UIMODES"
msgid "The Groupedbar interface provides access to functions in groups, with icons for most-frequently used features, and dropdown menus for others. This compact variant favors vertical space."
msgstr "Groupedbar انٹرفیس گروپاں وچ فنکشنز تائیں رسائی ݙیندا ہے، سب توں ودھ ورتے ون٘ڄݨ آلے خصوصیات کیتے آئیکنز دے نال، تے ٻئیاں کیتے ڈراپ ڈاؤن مینیوز۔ ایہ چھوٹا ویرینٹ عمودی جاہ کوں ترجیح ݙیندا ہے۔"

#. LHEdi
#: cui/inc/uimode.hrc:30
msgctxt "RID_CUI_UIMODES"
msgid "The Contextual Single interface shows functions in a single-line toolbar with context-dependent content."
msgstr "Contextual Single انٹرفیس ہک لائن آلے ٹول بار وچ سیاق و سباق تے مبنی مواد دے نال فنکشنز ݙکھیندا ہے۔"

#. EcfBf
#: cui/inc/uimode.hrc:31
msgctxt "RID_CUI_UIMODES"
msgid "The Contextual Groups interface focuses on beginners. It exposes the most frequently used functions on groups with the core action as large icon and a couple of small additional features. All functions have a label. Depending on the context, an additional section provides access to those functions."
msgstr "Contextual Groups انٹرفیس نویں ورتکاراں تے توجہ ݙیندا ہے۔ ایہ سب توں ودھ ورتے ون٘ڄݨ آلے فنکشنز کوں گروپاں وچ ݙکھیندا ہے، بنیادی کارروائی وݙے آئیکن دے طور تے تے کجھ نِکیاں اضافی خصوصیات۔ سارے فنکشنز دا لیبل ہوندا ہے۔ سیاق و سباق دے مطابق، ہک اضافی حصہ اونہاں فنکشنز تائیں رسائی ݙیندا ہے۔"

