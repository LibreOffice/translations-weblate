msgstr "مہربانی کر تے میکرو دا ناں بدلݨ کیتے ہک ناں درج کرو:"

#. vhsBj
#: cui/inc/strings.hrc:616
msgctxt "STR_LIBISREADONLY"
msgid "This library is read-only."
msgstr "ایندا لائبریری صرف پڑھݨ آلی ہے۔"

#. xCErR
#: cui/inc/strings.hrc:617
msgctxt "STR_SBXNAMEALLREADYUSED"
msgid "Name already exists"
msgstr "ناں پہلے توں موجود ہے"

#. sDhSi
#: cui/inc/strings.hrc:619
msgctxt "STR_SELECTEDENTRYNOTFOUND"
msgid "The selected entry doesn't exist. It will be removed from the list."
msgstr "چُݨا ڳیا اندراج موجود کائنی۔ اوہ تندیر توں ہٹایا ونڄسی۔"

#. mpS3V
#: cui/inc/tipoftheday.hrc:54
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME offers a variety of user interface options to make you feel at home"
msgstr "%PRODUCTNAME تہاکوں گھر جیہا محسوس کراوݨ کیتے ورتکار انٹرفیس دے مختلف اختیارات پیش کریندا ہے"

#. m8rYd
#: cui/inc/tipoftheday.hrc:55
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to allow changes to parts of a read-only document in Writer? Insert frames or sections that can authorize changes."
msgstr "کیا رائٹر وچ صرف پڑھݨ جوڳی دستاویز دے کجھ حصیاں وچ تبدیلیاں دی اجازت ݙیوݨی ہے؟ تبدیلیاں دی اجازت ݙیوݨ آلے فریماں یا سیکشنز داخل کرو۔"

#. BFjAp
#. local help missing
#: cui/inc/tipoftheday.hrc:56
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To print the notes of your slides go to File ▸ Print ▸ %PRODUCTNAME Impress tab and select Notes under Document ▸ Type."
msgstr "اپݨیاں سلائیڈاں دے نوٹس چھاپݨ کیتے File ▸ Print ▸ %PRODUCTNAME Impress ٹیب تے ونڄو تے دستاویز • قسم دے تھلے نوٹس چُݨو۔"

#. TWjA5
#: cui/inc/tipoftheday.hrc:57
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To start temporarily with a fresh user profile, or to restore a non-working %PRODUCTNAME, use Help ▸ Restart in Safe Mode."
msgstr ""

#. Hv5Ff
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/shared/01/profile_safe_mode.html
#: cui/inc/tipoftheday.hrc:58
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Writing a book? %PRODUCTNAME master document lets you manage large documents as a container for individual %PRODUCTNAME Writer files."
msgstr "کتاب لکھ رہے ہو؟ %PRODUCTNAME ماسٹر دستاویز تہاکوں وڈے دستاویزاں کوں انفرادی %PRODUCTNAME رائٹر فائلاں کیتے ہک کنٹینر دے طور تے سنبھالݨ دی اجازت ݙیندی ہے۔"

#. GQABP
#. local help missing
#: cui/inc/tipoftheday.hrc:59
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can create editable Hybrid PDFs with %PRODUCTNAME."
msgstr "تساں %PRODUCTNAME نال بدلݨ جوڳے ہائبرڈ PDFs بݨا سڳدے ہو۔"

#. LBkjN
#: cui/inc/tipoftheday.hrc:60
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Explore the ten different functions in the status bar (at the bottom of the document window). Place the cursor over each field for an explanation. If not visible, use View ▸ Status Bar."
msgstr "اسٹیٹس بار وچ ݙاہ وکھرے فنکشنز ڳولو (دستاویز ونڈو دے تھلے)۔ ہر فیلڈ تے وضاحت کیتے کرسر رکھو۔ جے نظر نہ آوے تاں View • Status Bar ورتو۔"

#. EZRSF
#: cui/inc/tipoftheday.hrc:61
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to sum a cell through several sheets? Refer to the range of sheets e.g. =SUM(Sheet1.A1:Sheet2.A3)."
msgstr "کیا تساں کئی شیٹاں وچ ہک سیل دا جمع کرݨا چاہندے ہو؟ شیٹاں دی رینج دا حوالہ ݙیو، مثال دے طور تے =SUM(Sheet1.A1:Sheet2.A3)۔"

#. AxXYW
#: cui/inc/tipoftheday.hrc:62
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can create fillable form documents (even PDFs) with %PRODUCTNAME."
msgstr "تساں %PRODUCTNAME نال بھرݨ جوڳیاں فارم دستاویزاں (PDFs وی) بݨا سڳدے ہو۔"

#. BSUoN
#: cui/inc/tipoftheday.hrc:63
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Cannot see all the text in a cell? Expand the input line in the formula bar and you can scroll."
msgstr "سیل وچ سارا متن ݙیکھ کائنی سڳدے؟ فارمولا بار وچ ان پٹ لائن پھیلاؤ تے تساں سکرول کر سڳدے ہو۔"

#. 3JyGD
#: cui/inc/tipoftheday.hrc:64
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Optimize your table layout with Table ▸ Size ▸ Distribute Rows / Columns Evenly."
msgstr "Table ▸ Size ▸ Distribute Rows / Columns Evenly نال آپݨے ٹیبل دی ترتیب بہتر بݨاؤ۔"

#. prXEA
#: cui/inc/tipoftheday.hrc:65
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Find all expressions in brackets per Edit ▸ Find and Replace ▸ Find ▸ \\([^)]+\\) (check “Regular expressions”)"
msgstr "Edit ▸ Find and Replace ▸ Find ▸ \\([^)]+\\) نال بریکٹاں وچ سارے اظہاراں ڳولو (“Regular expressions” چیک کرو)"

#. 95VGx
#: cui/inc/tipoftheday.hrc:66
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Select a different icon set from Tools ▸ Options ▸ %PRODUCTNAME ▸ View ▸ Icon Theme."
msgstr ""

#. Udk4L
#: cui/inc/tipoftheday.hrc:67
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can display a number as a fraction (0.125 = 1/8): Format ▸ Cells, under Numbers tab in the Category select Fraction."
msgstr "تساں ہک نمبر کوں کسر دے طور تے ݙکھا سڳدے ہو (0.125 = 1/8): Format ▸ Cells، نمبراں والے ٹیب دے تھلے ونکی وچ کسر چُݨو۔"

#. VxuFm
#: cui/inc/tipoftheday.hrc:68
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To remove a hyperlink but keep its text, right-click on the hyperlink, and use “Remove Hyperlink”."
msgstr "ہک ہائپر لنک ہٹاوݨ کیتے پر اوندا متن رکھݨ کیتے، ہائپر لنک تے سڄا کلک کرو تے “Remove Hyperlink” ورتو۔"

#. FeNXF
#: cui/inc/tipoftheday.hrc:69
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To remove several hyperlinks at once, select the text with the hyperlinks, then right-click and use “Remove Hyperlink”."
msgstr "ہک ویلے کئی ہائپر لنکس ہٹاوݨ کیتے، ہائپر لنکس آلا متن چُݨو، ول سڄا کلک کرو تے “Remove Hyperlink” ورتو۔"

#. VnFnz
#: cui/inc/tipoftheday.hrc:70
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To zoom a selection to fit the entire window in Draw, use the / (divide key) on the number pad."
msgstr "ڈرا وچ چُݨ کوں پوری ونڈو وچ فٹ کرݨ کیتے زوم کرݨ کیتے، نمبر پیڈ تے / (تقسیم کلید) ورتو۔"

#. xfHwX
#: cui/inc/tipoftheday.hrc:71
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Click a column field (row) PivotTable and press F12 to group data. Choices adapt to content: Date (month, quarter, year), number (classes)"
msgstr "ہک کالم فیلڈ (قطار) پیوٹ ٹیبل تے کلک کرو تے ڈیٹا کوں گروپ کرݨ کیتے F12 دباؤ۔ چوݨاں مواد دے مطابق بدلدیاں ہن: تاریخ (مہینہ، سہ ماہی، سال)، نمبر (کلاسز)"

#. Dvh2U
#: cui/inc/tipoftheday.hrc:72
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can restart the slide show after a pause specified at Slide Show ▸ Slide Show Settings ▸ Loop and repeat after."
msgstr "تساں Slide Show ▸ Slide Show Settings ▸ Loop and repeat after تے مقرر کیتے ڳئے وقفے توں بعد سلائیڈ شو ولا شروع کر سڳدے ہو۔"

#. 5SoBD
#: cui/inc/tipoftheday.hrc:73
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To distribute some text in multi-columns select the text and apply Format ▸ Columns."
msgstr "کجھ متن کوں کئی کالماں وچ ونڈݨ کیتے، متن چُݨو تے Format ▸ Columns لاوو۔"

#. hr7ym
#: cui/inc/tipoftheday.hrc:74
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use View ▸ Value Highlighting to display cell contents in colors: Text/black, Formulas/green, Numbers/blue, Protected cells/grey background."
msgstr "سیل مواد کوں رنگاں وچ ݙکھاوݨ کیتے View ▸ Value Highlighting ورتو: متن/کالا، فارمولے/سبز، نمبر/نیلا، محفوظ سیلاں/سرمئی پس منظر۔"

#. kKdqp
#. local help missing
#: cui/inc/tipoftheday.hrc:75
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can create different master pages in a presentation template: View ▸ Master Slide and Slide ▸ New Master (or per toolbar or right click in slide pane)."
msgstr "تساں ہک پریزنٹیشن سانچے وچ وکھرے ماسٹر ورقے بݨا سڳدے ہو: View ▸ Master Slide تے Slide ▸ New Master (یا ٹول بار راہیں یا سلائیڈ پین وچ سڄا کلک کرکے)۔"

#. b3KPF
#: cui/inc/tipoftheday.hrc:76
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to sort a pivot table? Click on drop-list’s arrow in the row/col header and select sort method: ascending, descending, or custom."
msgstr "کیا تساں ہک پیوٹ ٹیبل کوں ترتیب ݙیوݨا چاہندے ہو؟ قطار/کالم ہیڈر وچ ڈراپ لسٹ دے تیر تے کلک کرو تے ترتیب ݙیوݨ دا طریقہ چُݨو: چڑھدا، لہندا، یا حسب ضرورت۔"

#. CvgZt
#: cui/inc/tipoftheday.hrc:77
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Display photos or images with different shapes in Writer. Insert and select shape, then Insert ▸ Image. To adjust image, right-click on selected shape and choose Area."
msgstr "رائٹر وچ وکھریاں شکلاں نال فوٹو یا تصویراں ݙکھاؤ۔ شکل داخل کرو تے چُݨو، ول Insert ▸ Image ورتو۔ تصویر کوں ایڈجسٹ کرݨ کیتے، چُݨی ڳئی شکل تے سڄا کلک کرو تے Area چُݨو۔"

#. si5Y9
#: cui/inc/tipoftheday.hrc:78
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use Page/Slide ▸ Properties ▸ “Fit object to paper format” in Draw/Impress to resize the objects so that they fit on your chosen paper format."
msgstr "ڈرا/امپریس وچ آبجیکٹس دا سائز بدلݨ کیتے تاں جو اوہ تہاݙے چُݨے ڳئے کاغذ فارمیٹ تے فٹ آون، Page/Slide ▸ Properties ▸ “Fit object to paper format” ورتو۔"

#. hj7H4
#: cui/inc/tipoftheday.hrc:79
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Fit the entire page in a Draw window, use * on the number pad."
msgstr "ڈرا ونڈو وچ پورا ورقہ فٹ کرݨ کیتے، نمبر پیڈ تے * ورتو۔"

#. pESS4
#: cui/inc/tipoftheday.hrc:80
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "In a Draw page, use “-” to zoom out; “+” to zoom in."
msgstr "ڈرا ورقے وچ، زوم آؤٹ کرݨ کیتے “-” ورتو؛ زوم ان کرݨ کیتے “+” ورتو۔"

#. PJFH2
#: cui/inc/tipoftheday.hrc:81
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to show the contents of another document within your document? Use Insert ▸ Section and select Link."
msgstr "کیا تساں آپݨے دستاویز وچ ٻئے دستاویز دا مواد ݙکھاوݨا چاہندے ہو؟ Insert ▸ Section ورتو تے لنک چُݨو۔"

#. 6uYph
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/swriter/guide/section_insert.html#par_id3153404
#: cui/inc/tipoftheday.hrc:82
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To automatically number table rows in Writer, select the relevant column, then apply a List Style."
msgstr "رائٹر وچ ٹیبل قطاراں کوں خودکار طور تے نمبر ݙیوݨ کیتے، متعلقہ کالم چُݨو، ول ہک تندیر انداز لاوو۔"

#. AzNEm
#. no local help URI
#: cui/inc/tipoftheday.hrc:83
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME allows you to use assistive tools, such as external screen readers, Braille devices or speech recognition input devices."
msgstr "%PRODUCTNAME تہاکوں معاون اوزار ورتݨ دی اجازت ݙیندا ہے، جیویں بیرونی اسکرین ریڈرز، بریل ڈیوائسز یا تقریر دی پچھاݨ آلے ان پٹ ڈیوائسز۔"

#. SiwUL
#: cui/inc/tipoftheday.hrc:84
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to sort a series in %PRODUCTNAME Calc such as A1, A2, A3, A11, A15, not in alphabetical order but on the number? Enable natural sort in the Options tab."
msgstr "کیا تساں %PRODUCTNAME Calc وچ A1، A2، A3، A11، A15 جیہی سلسلہ کوں حروف تہجی دی ترتیب وچ نہ بلکہ نمبر تے ترتیب ݙیوݨا چاہندے ہو؟ اختیارات ٹیب وچ قدرتی ترتیب فعال کرو۔"

#. Wx8QG
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/scalc/01/12030200.html
#: cui/inc/tipoftheday.hrc:85
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can change the default function in the status bar: right click on the area."
msgstr "تساں اسٹیٹس بار وچ ڈیفالٹ فنکشن بدل سڳدے ہو: علاقے تے سڄا کلک کرو۔"

#. 6soFJ
#: cui/inc/tipoftheday.hrc:86
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to add many of the same shapes in Draw/Impress? Double-click a tool in the drawing toolbar to use it for repeated tasks."
msgstr "کیا تساں ڈرا/امپریس وچ اوہو ہی شکلاں وچوں کئی شامل کرݨا چاہندے ہو؟ دہرائے ڳئے کماں کیتے ورتݨ کیتے ڈرائنگ ٹول بار وچ ہک ٹول تے ݙوہرا کلک کرو۔"

#. DDGnC
#: cui/inc/tipoftheday.hrc:87
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%MOD1+Shift+F9 recalculates all formulas in all spreadsheets."
msgstr ""

#. U5wE4
#: cui/inc/tipoftheday.hrc:88
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to keep a part of an editable document as read-only? Insert ▸ Section. Add text to the section, then right-click “Edit Section” and check “Protect”."
msgstr "کیا تساں بدلݨ جوڳی دستاویز دا ہک حصہ صرف پڑھݨ جوڳا رکھݨا چاہندے ہو؟ Insert ▸ Section۔ سیکشن وچ متن شامل کرو، ول “Edit Section” تے سڄا کلک کرو تے “Protect” چیک کرو۔"

#. KtRU8
#: cui/inc/tipoftheday.hrc:89
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use the Backspace key instead of Delete in Calc. You can choose what to delete."
msgstr "کیلک وچ Delete دی بجائے Backspace کلید ورتو۔ تساں چُݨ سڳدے ہو جو کیا مٹاوݨا ہے۔"

#. YDDzE
#: cui/inc/tipoftheday.hrc:90
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "The best way to fix bad-looking MS Word table cells is via Table ▸ Size ▸ Optimal Row Height / Column Width."
msgstr "MS Word دیاں بدصورت ٹیبل سیلاں کوں ٹھیک کرݨ دا بہترین طریقہ Table ▸ Size ▸ Optimal Row Height / Column Width راہیں ہے۔"

#. HEfCq
#: cui/inc/tipoftheday.hrc:91
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To repeat a table heading when a table spans over a page, use Table ▸ Table Properties ▸ Text Flow ▸ Repeat heading."
msgstr ""

#. 7rb58
#: cui/inc/tipoftheday.hrc:92
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to quickly insert or delete rows? Select the desired number of rows (or columns) and press %MOD1+Plus sign (+) to add or %MOD1+Minus sign (-) to delete."
msgstr "کیا تساں قطاراں جلدی داخل کرݨا یا مٹاوݨا چاہندے ہو؟ قطاراں (یا کالماں) دی مطلوبہ گݨتی چُݨو تے شامل کرݨ کیتے %MOD1+Plus sign (+) دباؤ یا مٹاوݨ کیتے %MOD1+Minus sign (-) دباؤ۔"

#. gEysu
#: cui/inc/tipoftheday.hrc:93
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To repeat rows/columns on every pages use Format ▸ Print Ranges ▸ Edit."
msgstr "ہر ورقے تے قطاراں/کالماں دہراوݨ کیتے، Format ▸ Print Ranges ▸ Edit ورتو۔"

#. HEdbh
#: cui/inc/tipoftheday.hrc:94
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Insert images and photos into shapes in Draw and Impress. Right-click on a shape, choose Area ▸ Image ▸ Add / Import, and use Options to adjust appearance."
msgstr "ڈرا تے امپریس وچ شکلاں وچ تصویراں تے فوٹو داخل کرو۔ ہک شکل تے سڄا کلک کرو، Area ▸ Image ▸ Add / Import چُݨو، تے ظاہری شکل کوں ایڈجسٹ کرݨ کیتے اختیارات ورتو۔"

#. W6E2A
#: cui/inc/tipoftheday.hrc:95
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to insert the date in a spreadsheet cell? Type %MOD1+; or Shift+%MOD1+; to insert the time."
msgstr ""

#. vAFKt
#: cui/inc/tipoftheday.hrc:96
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Insert your metadata in your document with Insert ▸ Fields ▸ More Fields… ▸ Document or DocInformation."
msgstr "Insert ▸ Fields ▸ More Fields… ▸ Document or DocInformation نال آپݨے دستاویز وچ آپݨا میٹا ڈیٹا داخل کرو۔"

#. FHorg
#: cui/inc/tipoftheday.hrc:97
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Get help from the community via the Ask portal."
msgstr "Ask پورٹل راہیں کمیونٹی توں مدد ڳھنو۔"

#. qnAAh
#: cui/inc/tipoftheday.hrc:98
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use Shift+Space to select the current row and %MOD1+Space to select the current column."
msgstr ""

#. MFv5S
#: cui/inc/tipoftheday.hrc:99
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can move an object to another layer by holding it until its edges flash, then drag it to the tab of the layer you want to move it to."
msgstr "تساں ہک آبجیکٹ کوں ٻئی پرت تے منتقل کر سڳدے ہو، اونکوں پھڑ کے رکھو جتھاں تائیں اوندے کنارے چمکݨ، ول اونکوں اوس پرت دے ٹیب تے گھسیٹو جتھاں تساں اونکوں منتقل کرݨا چاہندے ہو۔"

#. 3NRDt
#: cui/inc/tipoftheday.hrc:100
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Data ▸ Validity allows you to create drop-down lists where the user selects a value instead of typing."
msgstr "Data ▸ Validity تہاکوں ڈراپ ڈاؤن تندیراں بݨاوݨ دی اجازت ݙیندا ہے جتھاں ورتکار ٹائپ کرݨ دی بجائے ہک قیمت چُݨدا ہے۔"

#. uikxZ
#. local help missing
#: cui/inc/tipoftheday.hrc:101
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Hold down %MOD1 and turn the mouse wheel to change the zoom factor."
msgstr "زوم فیکٹر بدلݨ کیتے %MOD1 دبائی رکھو تے ماؤس وہیل گھماؤ۔"

#. 7QLxF
#: cui/inc/tipoftheday.hrc:102
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME has great extensions to increase your productivity—check them out."
msgstr "%PRODUCTNAME کول شاندار ایکسٹینشنز ہن تہاݙی پیداواری صلاحیت ودھاوݨ کیتے — اوہناں کوں ݙیکھو۔"

#. DyoMt
#: cui/inc/tipoftheday.hrc:103
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to count words for just one particular paragraph style? Use Edit ▸ Find and Replace, click Paragraph Styles, select the style in Find, and click Find All. Read the result in the status bar."
msgstr "کیا تساں صرف ہک خاص پیراگراف انداز کیتے لفظ گݨݨا چاہندے ہو؟ Edit ▸ Find and Replace ورتو، Paragraph Styles تے کلک کرو، Find وچ انداز چُݨو، تے Find All تے کلک کرو۔ اسٹیٹس بار وچ نتیجہ پڑھو۔"

#. CFkRA
#: cui/inc/tipoftheday.hrc:104
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Generate fully customized PDF documents with the exact format, image compression, comments, access rights, password, etc., you specify via File ▸ Export as PDF."
msgstr "File ▸ Export as PDF راہیں تساں جیہڑے بالکل درست فارمیٹ، تصویر کمپریشن، تبصرے، رسائی دے حقوق، پاس ورڈ، وغیرہ مقرر کریندے ہو، اوہناں نال پوری طرحاں حسب ضرورت PDF دستاویزاں بݨاؤ۔"

#. XWchY
#: cui/inc/tipoftheday.hrc:106
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Writer includes LibreLogo: simple Logo-like programming environment with turtle vector graphics, DTP and graphic design."
msgstr "رائٹر وچ LibreLogo شامل ہے: کچھوے ویکٹر گرافکس، DTP تے گرافک ڈیزائن نال سادہ Logo جیہا پروگرامنگ ماحول۔"

#. 8x8QZ
#: cui/inc/tipoftheday.hrc:108
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Construct your own 2D shapes in Draw. Select two or more objects, and explore possibilities with Shape ▸ Combine, Shape ▸ Merge, Shape ▸ Subtract, and Shape ▸ Intersect."
msgstr "ڈرا وچ آپݨیاں 2D شکلاں بݨاؤ۔ ݙو یا ودھ آبجیکٹس چُݨو، تے Shape ▸ Combine، Shape ▸ Merge، Shape ▸ Subtract، تے Shape ▸ Intersect نال امکانات ڳولو۔"

#. f6Lan
#: cui/inc/tipoftheday.hrc:109
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Do you plan to change your computer and want to recover your customizations? See:"
msgstr "کیا تساں آپݨا کمپیوٹر بدلݨ دا ارادہ رکھدے ہو تے آپݨیاں حسب ضرورت سیٹنگز واپس گھݨݨا چاہندے ہو؟ ݙیکھو:"

#. EkpTG
#: cui/inc/tipoftheday.hrc:110
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can toggle between the field names and the actual value with View ▸ Fields Names (or %MOD1+F9)."
msgstr "تساں View ▸ Fields Names (یا %MOD1+F9) نال فیلڈ ناواں تے اصل قیمت دے وچکار بدل سڳدے ہو۔"

#. 5ZVTy
#: cui/inc/tipoftheday.hrc:111
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Show or hide comments in Writer by clicking the comment toggle button in the ruler."
msgstr "رائٹر دے رولر وچ تبصرہ ٹوگل بٹن تے کلک کرکے تبصرے ݙکھاؤ یا لکاؤ۔"

#. YQ8cC
#: cui/inc/tipoftheday.hrc:112
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To enable macro recording, check Tools ▸ Options ▸ %PRODUCTNAME ▸ Advanced ▸ Enable macro recording."
msgstr "میکرو ریکارڈنگ فعال کرݨ کیتے، Tools ▸ Options ▸ %PRODUCTNAME ▸ Advanced ▸ Enable macro recording چیک کرو۔"

#. EnQur
#: cui/inc/tipoftheday.hrc:113
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to insert a placeholder for an image in a Writer template? Use Insert ▸ Fields ▸ More fields, click Functions tab, choose PlaceHolder for Type and Image for Format."
msgstr "کیا تساں ہک رائٹر سانچے وچ ہک تصویر کیتے پلیس ہولڈر داخل کرݨا چاہندے ہو؟ Insert ▸ Fields ▸ More fields ورتو، Functions ٹیب تے کلک کرو، قسم کیتے PlaceHolder تے فارمیٹ کیتے Image چُݨو۔"

#. sSeTz
#: cui/inc/tipoftheday.hrc:114
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME supports four macro security levels (from low to very high) and trusted sources."
msgstr "%PRODUCTNAME چار میکرو سیکیورٹی سطحاں (گھٹ توں ٻہوں ودھ تائیں) تے بھروسے جوڳے ذرائع دی سپورٹ کریندا ہے۔"

#. SNTbc
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/shared/optionen/01030300.html
#: cui/inc/tipoftheday.hrc:115
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Did you know that you can attach comments to portions of text? Just use the shortcut %MOD1+%MOD2+C."
msgstr "کیا تہاکوں پتا ہے جو تساں متن دے حصیاں نال تبصرے جوڑ سڳدے ہو؟ صرف %MOD1+%MOD2+C شارٹ کٹ ورتو۔"

#. wZDsJ
#: cui/inc/tipoftheday.hrc:116
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to move one or more paragraphs? No need to cut and paste: Use the keyboard shortcut %MOD1+%MOD2+Arrow (Up/Down)"
msgstr "کیا ہک یا ودھ پیراگرافاں منتقل کرݨے ہن؟ کٹݨ تے پیسٹ کرݨ دی کوئی لوڑ کائنی: %MOD1+%MOD2+Arrow (Up/Down) کی بورڈ شارٹ کٹ ورتو۔"

#. JDGDc
#: cui/inc/tipoftheday.hrc:117
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Change the basic fonts for the predefined template or current document per Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ Basic Fonts."
msgstr "Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ Basic Fonts دے مطابق پہلے توں مقرر سانچے یا موجودہ دستاویز کیتے بنیادی فونٹاں بدلو۔"

#. 9B2EN
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/shared/optionen/01040300.html
#: cui/inc/tipoftheday.hrc:118
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to find words containing 10 or more characters? Edit ▸ Find and Replace ▸ Search ▸ \\w{10,} ▸ Other Options ▸ check Regular expressions."
msgstr "کیا تساں 10 یا ودھ حرفاں آلے لفظ ڳولݨا چاہندے ہو؟ Edit ▸ Find and Replace ▸ Search ▸ \\w{10,} ▸ Other Options ▸ “Regular expressions” چیک کرو۔"

#. 7dDjc
#: cui/inc/tipoftheday.hrc:119
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Open a CSV file as a new sheet in the current spreadsheet via Sheet ▸ Sheet from file."
msgstr "موجودہ سپریڈ شیٹ وچ ہک نویں شیٹ دے طور تے CSV فائل Sheet ▸ Sheet from file راہیں کھولو۔"

#. 72N2Q
#: cui/inc/tipoftheday.hrc:120
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can continue writing with the default formatting attributes after manually applying bold, italic or underline by pressing %MOD1+M."
msgstr "تساں %MOD1+M دباکے بولڈ، اٹالک یا انڈر لائن دستی طور تے لاوݨ توں بعد ڈیفالٹ فارمیٹنگ خصوصیات نال لکھݨا جاری رکھ سڳدے ہو۔"

#. iXjDF
#: cui/inc/tipoftheday.hrc:121
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use %MOD1+%MOD2+Shift+V to paste the contents of the clipboard as unformatted text."
msgstr ""

#. yv67G
#: cui/inc/tipoftheday.hrc:122
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Customize footnote appearance with Tools ▸ Footnote/Endnote Settings…"
msgstr "Tools ▸ Footnote/Endnote Settings… نال فٹ نوٹ دی ظاہری شکل حسب ضرورت بݨاؤ۔"

#. muc5F
#: cui/inc/tipoftheday.hrc:123
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "With Slide Show ▸ Custom Slide Show, reorder and pick slides to fit a slideshow to the needs of your viewers."
msgstr "Slide Show ▸ Custom Slide Show نال، آپݨے ناظرین دیاں لوڑاں دے مطابق سلائیڈ شو کوں فٹ کرݨ کیتے سلائیڈاں کوں ولا ترتیب ݙیو تے چُݨو۔"

#. ZZZZo
#: cui/inc/tipoftheday.hrc:124
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to change spell checking for some part of the text? Click in the language zone of the status bar or better, apply a style."
msgstr "کیا تساں متن دے کجھ حصے کیتے املا دی جانچ بدلݨا چاہندے ہو؟ اسٹیٹس بار دے زبان آلے علاقے وچ کلک کرو یا بہتر، ہک انداز لاوو۔"

#. oTX4L
#: cui/inc/tipoftheday.hrc:125
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Writer can insert a blank page between two odd (even) pages that follow. Check “Print automatically inserted blank pages” in the print dialog’s %PRODUCTNAME Writer tab."
msgstr "رائٹر جیہڑے ݙو طاق (جفت) ورقے بعد وچ آوندے ہن، اوہناں دے وچکار ہک خالی ورقہ داخل کر سڳدا ہے۔ پرنٹ ڈائیلاگ دے %PRODUCTNAME Writer ٹیب وچ “Print automatically inserted blank pages” چیک کرو۔"

#. YVF2y
#: cui/inc/tipoftheday.hrc:126
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You do not want to print all columns? Hide or group the ones you do not need."
msgstr "کیا تساں سارے کالماں چھاپݨا کائنی چاہندے؟ اوہناں کوں لکاؤ یا گروپ کرو جیہڑے تہاکوں کائنی چاہیدے۔"

#. pZZxV
#: cui/inc/tipoftheday.hrc:127
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To modify an AutoPlay presentation, open it and after it starts, right click and select Edit in the context menu."
msgstr "آٹو پلے پریزنٹیشن بدلݨ کیتے، اونکوں کھولو تے اوہدے شروع تھیوݨ توں بعد، سڄا کلک کرو تے سیاق و سباق مینیو وچ Edit چُݨو۔"

#. zbD2D
#: cui/inc/tipoftheday.hrc:128
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to position precisely? %MOD2+arrow keys move objects (shapes, pictures, formulas) by one pixel."
msgstr "کیا درست مقام تے رکھݨا ہے؟ %MOD2+تیر کلیداں آبجیکٹس (شکلاں، تصویراں، فارمولے) کوں ہک پکسل نال منتقل کریندیاں ہن۔"

#. FhocH
#: cui/inc/tipoftheday.hrc:129
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Embedded help is available by pressing F1, if you have installed it. Otherwise check online at:"
msgstr "ایمبیڈڈ مدد F1 دباکے دستیاب ہے، جے تساں اونکوں نصب کیتا ہے۔ ورنہ آن لائن چیک کرو:"

#. n3b6P
#: cui/inc/tipoftheday.hrc:130
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Right-click in the status bar in %PRODUCTNAME Calc and select “Selection count” to display the number of selected cells."
msgstr "%PRODUCTNAME Calc وچ اسٹیٹس بار وچ سڄا کلک کرو تے چُݨے ڳئے سیلاں دی گݨتی ݙکھاوݨ کیتے “Selection count” چُݨو۔"

#. h7afF
#: cui/inc/tipoftheday.hrc:131
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to have two or more columns for just a part of a %PRODUCTNAME Writer page? Insert ▸ Section, set with Columns tab, and place text in that section."
msgstr "کیا تساں %PRODUCTNAME رائٹر ورقے دے صرف ہک حصے کیتے ݙو یا ودھ کالماں رکھݨا چاہندے ہو؟ Insert ▸ Section ورتو، Columns ٹیب نال مقرر کرو، تے اوس سیکشن وچ متن رکھو۔"

#. DmbfV
#: cui/inc/tipoftheday.hrc:132
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use Data ▸ Statistics for sampling, descriptive statistics, analysis of variance, correlation, and much more in %PRODUCTNAME Calc."
msgstr "%PRODUCTNAME Calc وچ نمونہ گیری، وضاحتی شماریات، تغیر دا تجزیہ، ارتباط، تے ٻہوں کجھ بیا کیتے Data ▸ Statistics ورتو۔"

#. cVaQ3
#: cui/inc/tipoftheday.hrc:133
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can copy from one sheet to another without the clipboard. Select the area to copy, %MOD1+click the target sheet’s tab and use Sheet ▸ Fill Cells ▸ Fill Sheets."
msgstr "تساں کلپ بورڈ دے بغیر ہک شیٹ توں ٻئی شیٹ وچ نقل کر سڳدے ہو۔ نقل کرݨ آلا علاقہ چُݨو، ہدف شیٹ دے ٹیب تے %MOD1+کلک کرو تے Sheet ▸ Fill Cells ▸ Fill Sheets ورتو۔"

#. FFetE
#: cui/inc/tipoftheday.hrc:134
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can change the look of %PRODUCTNAME via View ▸ User Interface."
msgstr "تساں View ▸ User Interface راہیں %PRODUCTNAME دی ظاہری شکل بدل سڳدے ہو۔"

#. J853i
#: cui/inc/tipoftheday.hrc:135
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "In %PRODUCTNAME Impress, use Insert ▸ Media ▸ Photo Album to create a slideshow from a series of pictures with the “Photo Album” feature."
msgstr "%PRODUCTNAME امپریس وچ، تصویراں دی ہک لڑی توں “Photo Album” خصوصیت نال ہک سلائیڈ شو بݨاوݨ کیتے Insert ▸ Media ▸ Photo Album ورتو۔"

#. DFo3H
#: cui/inc/tipoftheday.hrc:136
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can show formulas instead of results with View ▸ Show Formulas (or Tools ▸ Options ▸ %PRODUCTNAME Calc ▸ View ▸ Display ▸ Formulas)."
msgstr "تساں View ▸ Show Formulas (یا Tools ▸ Options ▸ %PRODUCTNAME Calc ▸ View ▸ Display ▸ Formulas) نال نتیجیاں دی بجائے فارمولے ݙکھا سڳدے ہو۔"

#. bY8ve
#: cui/inc/tipoftheday.hrc:137
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME is developed by a friendly community, made up of hundreds of contributors around the world. Join us with your skills beyond coding."
msgstr "%PRODUCTNAME ہک دوست کمیونٹی ولوں تیار کیتا ویندا ہے، جیہڑی دنیا بھر وچ سینکڑیاں حصہ داراں توں بݨی ہوئی ہے۔ کوڈنگ توں اڳے آپݨیاں صلاحیتاں نال ساݙے نال شامل تھیوو۔"

#. FqEQs
#: cui/inc/tipoftheday.hrc:138
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Left-handed? Enable Tools ▸ Options ▸ Languages and Locales ▸ General ▸ Asian and check Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ View ▸ Ruler ▸ Right-aligned, which displays the scrollbar to the left."
msgstr "کیا تساں کھبے ہتھ آلے ہو؟ Tools ▸ Options ▸ Languages and Locales ▸ General ▸ Asian فعال کرو تے Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ View ▸ Ruler ▸ Right-aligned چیک کرو، جیہڑا سکرول بار کوں کھبے پاسے ݙکھیندا ہے۔"

#. KgRse
#: cui/inc/tipoftheday.hrc:139
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want headings to always begin a page? Edit the paragraph style applied to the headings. Check “Insert” on the “Text Flow” tab, with Type “Page” and Position “Before”."
msgstr "کیا تساں چاہندے ہو جو سرخیاں ہمیشہ ہک ورقے توں شروع تھیون؟ سرخیاں تے لایا ڳیا پیراگراف انداز بدلو۔ “عبارت دا بہاؤ” ٹیب تے “Insert” چیک کرو، قسم “Page” تے مقام “Before” نال۔"

#. UVRgV
#: cui/inc/tipoftheday.hrc:140
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Date/time value is just a number of days since a chosen day zero; in the number, integer part represents date, and fractional part is time (elapsed part of a day), with 0.5 representing noon."
msgstr "تاریخ/ویلہ قیمت صرف چُݨے ڳئے صفر ݙینہہ توں ݙینہاں دی ہک گݨتی ہے؛ نمبر وچ، صحیح حصہ تاریخ کوں ظاہر کریندا ہے، تے کسری حصہ ویلہ ہے (ݙینہہ دا گزریا ہویا حصہ)، 0.5 ݙوپہر کوں ظاہر کریندا ہے۔"

#. o2fy3
#: cui/inc/tipoftheday.hrc:141
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Shift+%MOD1+Del deletes from cursor to the end of the current sentence."
msgstr ""

#. XDhNo
#: cui/inc/tipoftheday.hrc:142
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use column or row labels in formulas. For example, if you have two columns, “Time” and “KM”, use =Time/KM to get minutes per kilometer."
msgstr "فارمولیاں وچ کالم یا قطار لیبلز ورتو۔ مثال دے طور تے، جے تہاݙے کول ݙو کالماں ہن، “Time” تے “KM”، تاں منٹ فی کلومیٹر گھݨݨ کیتے =Time/KM ورتو۔"

#. E7GZz
#: cui/inc/tipoftheday.hrc:143
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Annoyed by the “marching ants” around cells in Calc? Press escape to stop them; the copied content will remain available for pasting."
msgstr "کیا کیلک وچ سیلاں دے آلے دوالے “مارچنگ اینٹس” توں تنگ آئے ہو؟ اوہناں کوں روکݨ کیتے escape دباؤ؛ نقل کیتا ڳیا مواد پیسٹ کرݨ کیتے دستیاب رہسی۔"

#. fsDVc
#: cui/inc/tipoftheday.hrc:144
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to become a %PRODUCTNAME Ambassador? There are certifications for developers, admins, and trainers."
msgstr "کیا تساں %PRODUCTNAME سفیر بݨݨا چاہندے ہو؟ ڈویلپرز، ایڈمنز، تے ٹرینرز کیتے سرٹیفیکیشناں ہن۔"

#. VWNyB
#: cui/inc/tipoftheday.hrc:145
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Mix portrait and landscape orientations in a Calc spreadsheet by applying different page styles on sheets."
msgstr "کیلک سپریڈ شیٹ وچ شیٹاں تے وکھرے ورقہ انداز لاکے پورٹریٹ تے لینڈ اسکیپ سمتاں ملاؤ۔"

#. eRzRG
#: cui/inc/tipoftheday.hrc:146
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Click on the special character icon in the toolbar to get quick access to favorite and recent characters to insert."
msgstr "داخل کرݨ کیتے پسندیدہ تے حالیہ حرفاں تائیں جلدی رسائی گھݨݨ کیتے ٹول بار وچ خاص حرف آئیکن تے کلک کرو۔"

#. 7UE7V
#: cui/inc/tipoftheday.hrc:147
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Choose “Hierarchical View” in the Styles sidebar to see the relation between styles."
msgstr "اندازاں دے وچکار تعلق ݙیکھݨ کیتے Styles سائیڈ بار وچ “Hierarchical View” چُݨو۔"

#. ikpFK
#: cui/inc/tipoftheday.hrc:148
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can use styles to make the tables in your document consistent. Choose one from the predefined per Styles (F11) or via Table ▸ AutoFormat Styles..."
msgstr "تساں اندازاں ورت کے آپݨے دستاویز دیاں ٹیبلاں کوں یکساں بݨا سڳدے ہو۔ Styles (F11) یا Table ▸ AutoFormat Styles… راہیں پہلے توں مقرر وچوں ہک چُݨو۔"

#. XBYtT
#: cui/inc/tipoftheday.hrc:149
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to open hyperlinks without pressing the %MOD1 key? Uncheck “%MOD1+click required to open hyperlinks” in Tools ▸ Options ▸ %PRODUCTNAME ▸ Security ▸ Options ▸ Security Options."
msgstr "کیا تساں %MOD1 کلید دبائے بغیر ہائپر لنکس کھولݨا چاہندے ہو؟ Tools ▸ Options ▸ %PRODUCTNAME ▸ Security ▸ Options ▸ Security Options وچ “%MOD1+click required to open hyperlinks” ان چیک کرو۔"

#. cCnpG
#: cui/inc/tipoftheday.hrc:150
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You would like to view the calculation of individual elements of a formula, select the respective elements and press F9."
msgstr "تساں فارمولے دے انفرادی عنصراں دے حساب کوں ݙیکھݨا چاہندے ہو تاں متعلقہ عنصراں چُݨو تے F9 دباؤ۔"

#. 9HtDt
#: cui/inc/tipoftheday.hrc:151
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can protect cells with Format ▸ Cells ▸ Protection. To prevent insert, delete, rename, move/copy of sheets use Tools ▸ Protect Sheet."
msgstr "تساں Format ▸ Cells ▸ Protection نال سیلاں کوں محفوظ کر سڳدے ہو۔ شیٹاں دے داخل کرݨ، مٹاوݨ، ناں بدلݨ، منتقل کرݨ/نقل کرݨ کوں روکݨ کیتے Tools ▸ Protect Sheet ورتو۔"

#. nBdPx
#. local help missing
#: cui/inc/tipoftheday.hrc:152
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can make text follow the shape of a curve. Draw the curve, double-click it, type the text, and choose Format ▸ Text along Path. Select one of the alignment options: Rotate, Upright, Slant Horizontal or Slant Vertical."
msgstr "تساں متن کوں وکر دی شکل دے مطابق چلا سڳدے ہو۔ وکر بݨاؤ، اونکوں ݙوہرا کلک کرو، متن لکھو، تے Format ▸ Text along Path چُݨو۔ الائنمنٹ اختیارات وچوں ہک چُݨو: Rotate، Upright، Slant Horizontal یا Slant Vertical۔"

#. ZE6D5
#: cui/inc/tipoftheday.hrc:153
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to display only the highest values in a spreadsheet? Select menu Data ▸ AutoFilter, click the drop-down arrow, and choose “Top10”."
msgstr "کیا تساں سپریڈ شیٹ وچ صرف ودھ توں ودھ قیمتاں ݙکھاوݨا چاہندے ہو؟ Data ▸ AutoFilter مینیو چُݨو، ڈراپ ڈاؤن تیر تے کلک کرو، تے “Top10” چُݨو۔"

#. F4CEp
#: cui/inc/tipoftheday.hrc:154
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To remove the page number from your table of contents go to Insert ▸ Table of Contents and Index (or right-click and Edit Index to edit a previously inserted index). In the Entries tab delete the page number (#) from Structure line."
msgstr "آپݨے مواد دی تندیر توں ورقہ نمبر ہٹاوݨ کیتے Insert ▸ Table of Contents and Index تے ونڄو (یا سڄا کلک کرو تے پہلے توں داخل کیتے ڳئے انڈیکس کوں بدلݨ کیتے Edit Index چُݨو)۔ Entries ٹیب وچ Structure لائن توں ورقہ نمبر (#) مٹاؤ۔"

#. JPu6C
#: cui/inc/tipoftheday.hrc:155
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "With the Navigator you can select & move up/down headings and the text below the heading, in the Navigator and in the document."
msgstr "نیویگیٹر نال تساں سرخیاں تے سرخی دے تھلے آلے متن کوں چُݨ تے اُتے/تھلے منتقل کر سڳدے ہو، نیویگیٹر وچ تے دستاویز وچ۔"

#. y8B2s
#: cui/inc/tipoftheday.hrc:156
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to get a math object into Writer quickly? Type your formula, select it, and use Insert ▸ OLE Object ▸ Formula to convert the text."
msgstr "کیا تساں رائٹر وچ جلدی ہک ریاضی آبجیکٹ گھݨݨا چاہندے ہو؟ آپݨا فارمولا لکھو، اونکوں چُݨو، تے متن کوں تبدیل کرݨ کیتے Insert ▸ OLE Object ▸ Formula ورتو۔"

#. Zj7NA
#: cui/inc/tipoftheday.hrc:157
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "With %PRODUCTNAME it is very easy to install a new dictionary: they are supplied as extensions."
msgstr "%PRODUCTNAME نال ہک نویں لغت نصب کرݨا ٻہوں سوکھا ہے: اوہ ایکسٹینشنز دے طور تے فراہم کیتیاں ویندیاں ہن۔"

#. 7kaMQ
#: cui/inc/tipoftheday.hrc:158
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME has a portable version which gives you mobility. Even without administrator rights on your computer you can install %PRODUCTNAME Portable to your hard drive too."
msgstr "%PRODUCTNAME دا ہک پورٹیبل ورژن ہے جیہڑا تہاکوں نقل و حرکت ݙیندا ہے۔ آپݨے کمپیوٹر تے ایڈمنسٹریٹر دے حقوق دے بغیر وی تساں %PRODUCTNAME Portable کوں آپݨی ہارڈ ڈرائیو تے وی نصب کر سڳدے ہو۔"

#. zkswJ
#: cui/inc/tipoftheday.hrc:159
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Writer lets you number your footnotes per page, chapter, document: Tools ▸ Footnote/Endnote Settings ▸ Footnotes tab ▸ Counting."
msgstr "رائٹر تہاکوں آپݨے فٹ نوٹس کوں ورقے، باب، دستاویز دے حساب نال نمبر ݙیوݨ دی اجازت ݙیندا ہے: Tools ▸ Footnote/Endnote Settings ▸ Footnotes ٹیب ▸ Counting۔"

#. gpVRV
#: cui/inc/tipoftheday.hrc:160
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Your Writer document does not reopen with the text cursor at the same editing position it was when you saved it? Add First or Last name in Tools ▸ Options ▸ %PRODUCTNAME ▸ User Data ▸ First/last name."
msgstr "کیا آپݨا رائٹر دستاویز اوسے بدلݨ آلے مقام تے متن کرسر نال ولا کائنی کھلدا جتھاں اوہ سی جڈاں تساں اونکوں محفوظ کیتا ہیا؟ Tools ▸ Options ▸ %PRODUCTNAME ▸ User Data ▸ First/last name وچ پہلا یا چھیکڑی ناں شامل کرو۔"

#. jEYXp
#: cui/inc/tipoftheday.hrc:161
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to do citation? You can use third-party citation managers such as Zotero."
msgstr "کیا حوالہ ݙیوݨا ہے؟ تساں Zotero جیہے تیجے فریق دے حوالہ منتظمین ورت سڳدے ہو۔"

#. ALczh
#: cui/inc/tipoftheday.hrc:162
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to insert a value in the same place on several sheets? Select the sheets: hold down %MOD1 key and click their tabs before entering."
msgstr "کیا تساں کئی شیٹاں تے اوہو ہی جاہ تے ہک قیمت داخل کرݨا چاہندے ہو؟ شیٹاں چُݨو: داخل کرݨ توں پہلاں %MOD1 کلید دبائی رکھو تے اوہناں دے ٹیباں تے کلک کرو۔"

#. XsdGx
#: cui/inc/tipoftheday.hrc:163
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to hide some text in a document? Select the text. Insert ▸ Section, and select “Hide”."
msgstr "کیا تساں ہک دستاویز وچ کجھ متن لکاوݨا چاہندے ہو؟ متن چُݨو۔ Insert ▸ Section ورتو، تے “Hide” چُݨو۔"

#. eAcm7
#. online help is different https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/swriter/guide/hidden_text.html#hd_id3148675
#: cui/inc/tipoftheday.hrc:164
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can customize the middle mouse button by going to Tools ▸ Options ▸ %PRODUCTNAME ▸ View ▸ Mouse ▸ Middle button."
msgstr "تساں Tools ▸ Options ▸ %PRODUCTNAME ▸ View ▸ Mouse ▸ Middle button تے ونڄ کے وچکارلے ماؤس بٹن کوں حسب ضرورت بݨا سڳدے ہو۔"

#. qQsXD
#: cui/inc/tipoftheday.hrc:165
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to print two portrait pages on a landscape one (reducing A4 to A5)? File ▸ Print and select 2 at “Pages per sheet”."
msgstr "کیا تساں ہک لینڈ اسکیپ ورقے تے ݙو پورٹریٹ ورقے چھاپݨا چاہندے ہو (A4 کوں A5 تائیں گھٹا کے)؟ File ▸ Print ورتو تے “Pages per sheet” تے 2 چُݨو۔"

#. GmBZk
#: cui/inc/tipoftheday.hrc:166
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "For quick access to your document bookmarks, right-click on the page number of the status bar (lower-left corner of document window)."
msgstr "آپݨے دستاویز دیاں نشانیاں تائیں جلدی رسائی کیتے، اسٹیٹس بار دے ورقہ نمبر تے سڄا کلک کرو (دستاویز ونڈو دے تھلے کھبے کونے وچ)۔"

#. Eb85a
#: cui/inc/tipoftheday.hrc:167
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Select an object in the document background via the Select tool in the Drawing toolbar to surround the object to select."
msgstr "چُݨݨ آلے آبجیکٹ کوں گھیرݨ کیتے ڈرائنگ ٹول بار وچ Select ٹول راہیں دستاویز دے پس منظر وچ ہک آبجیکٹ چُݨو۔"

#. T3RSB
#: cui/inc/tipoftheday.hrc:168
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Define texts that you often use as AutoText. You will be able to insert them by their name, shortcut or toolbar in any Writer document."
msgstr "اوہ متن مقرر کرو جیہڑے تساں اکثر آٹو ٹیکسٹ دے طور تے ورتدے ہو۔ تساں کہیں وی رائٹر دستاویز وچ اوہناں دے ناں، شارٹ کٹ یا ٹول بار راہیں اوہناں کوں داخل کر سڳسو۔"

#. 7CjmG
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/swriter/guide/autotext.html
#: cui/inc/tipoftheday.hrc:169
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Play music throughout a slideshow by assigning the sound to the first slide transition without clicking the “Apply to All Slides” button."
msgstr "“Apply to All Slides” بٹݨ تے کلک کیتے بغیر آواز پہلی سلائیڈ ٹرانزیشن تے مقرر کر کے سلائیڈ شو دوران موسیقی چلاؤ۔"

#. Xrnns
#: cui/inc/tipoftheday.hrc:170
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME Calc does not calculate from left to right but respects the order Parentheses – Exponents – Multiplication – Division – Addition – Subtraction."
msgstr "%PRODUCTNAME Calc کھٻے توں سڄے تائیں حساب کائنی کریندا بلکہ ترتیب قوسین – قوت نما – ضرب – تقسیم – جمع – تفریق دا احترام کریندا ہے۔"

#. heb7V
#: cui/inc/tipoftheday.hrc:171
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Get %PRODUCTNAME documentation and free user guide books at:"
msgstr "%PRODUCTNAME دی دستاویزات تے مفت ورتکار گائیڈ کتاباں اتھاں حاصل کرو:"

#. T6uNP
#: cui/inc/tipoftheday.hrc:172
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to remove all <> at once and keep the text inside? Edit ▸ Find and Replace: Search = [<>], Replace = blank and check “Regular expressions” under Other options."
msgstr "کیا تساں سارے <> ہک واری مٹا کے اندر آلا متن رکھݨا چاہندے ہو؟ Edit ▸ Find and Replace: Search = [<>], Replace = خالی تے “Regular expressions” کوں Other options دے تھلے چیک کرو۔"

#. e3dfT
#. local help missing
#: cui/inc/tipoftheday.hrc:173
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to present a report written with Writer? File ▸ Send ▸ Outline to Presentation automatically creates a slideshow from the outline."
msgstr "کیا تہاکوں رائٹر نال لکھی ہوئی رپورٹ پیش کرݨی ہے؟ File ▸ Send ▸ Outline to Presentation خود بخود خاکے توں ہک سلائیڈ شو بݨیندا ہے۔"

#. ZdyGi
#: cui/inc/tipoftheday.hrc:174
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to manage the presentation of hyperlinks in a spreadsheet? Insert them with the HYPERLINK function."
msgstr "کیا تساں اسپریڈ شیٹ وچ ہائپر لنکس دی پیشکش دا انتظام کرݨا چاہندے ہو؟ اوہناں کوں HYPERLINK فنکشن نال داخل کرو۔"

#. qyyJ4
#. local help missing
#: cui/inc/tipoftheday.hrc:175
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Uncheck Tools ▸ Options ▸ %PRODUCTNAME Calc ▸ View ▸ Zoom: “Synchronize sheets” so that each sheet in Calc has its own zoom factor."
msgstr "Tools ▸ Options ▸ %PRODUCTNAME Calc ▸ View ▸ Zoom: “Synchronize sheets” کوں ان چیک کرو تاں جو کیلک وچ ہر شیٹ دا اپݨا زوم فیکٹر ہووے۔"

#. qK7Xz
#: cui/inc/tipoftheday.hrc:176
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can set a color for each tab: right-click the tab or use Sheet ▸ Sheet Tab Color."
msgstr "تساں ہر ٹیب کیتے رنگ مقرر کر سڳدے او: ٹیب تے سڄا کلک کرو یا Sheet ▸ Sheet Tab Color ورتو۔"

#. YGUAo
#: cui/inc/tipoftheday.hrc:177
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Trace cells used in a formula, precedents (Shift+F9) or dependents (Shift+F5) (or use Tools ▸ Detective). For each hit you go one more step in the chain."
msgstr ""

#. mJ6Gu
#. local help missing
#: cui/inc/tipoftheday.hrc:178
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Insert and number your formulas in one step: type fn then F3. An AutoText is inserted with formula and number aligned in a table."
msgstr "اپݨے فارمولیاں کوں ہک قدم وچ پاؤ تے نمبر لاؤ: fn ٹائپ کرو ولا F3 دباؤ۔ ہک آٹو ٹیکسٹ فارمولے تے نمبر دے نال ٹیبل وچ سیدھا کر کے پاتا ویندا ہے۔"

#. 8rA8u
#: cui/inc/tipoftheday.hrc:179
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can create an illustration index from object names, not only from captions."
msgstr "تساں صرف کیپشنز توں کائنی، آبجیکٹاں دے ناواں توں وی تصویراں دا انڈیکس بݨا سڳدے او۔"

#. Bqtz5
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/shared/01/05190000.html
#: cui/inc/tipoftheday.hrc:180
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use your Android or iPhone to remotely control your Impress presentation."
msgstr "اپݨے Android یا iPhone توں آپݨی Impress پیشکش کوں دوروں کنٹرول کرو۔"

#. GgzTh
#. local help missing
#: cui/inc/tipoftheday.hrc:181
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to know how many days there are in the current month? Use the DAYSINMONTH(TODAY()) function."
msgstr "ڄاݨݨا چاہندے او بھلا ایں مہینے وچ کتنے ݙینہہ ہن؟ DAYSINMONTH(TODAY()) فنکشن ورتو۔"

#. z72JP
#: cui/inc/tipoftheday.hrc:182
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Your numbers are displayed as ### in your spreadsheet? The column is too narrow to display all digits."
msgstr "تہاݙے نمبر تہاݙی سپریڈ شیٹ وچ ### دے طور تے ݙکھائے ویندے ہن؟ کالم سارے ہندسیاں کوں ݙکھاوݨ کیتے ٻہوں تنگ ہے۔"

#. otWmK
#: cui/inc/tipoftheday.hrc:183
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Enable massive parallel calculations of formula cells via Tools ▸ Options ▸ %PRODUCTNAME Calc ▸ Calculate ▸ OpenCL Options."
msgstr ""

#. zAqfX
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/shared/optionen/opencl.html
#: cui/inc/tipoftheday.hrc:184
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use the Connector tool from the Drawing toolbar in Draw/Impress to create nice flow charts and optionally copy/paste the object into Writer."
msgstr "Draw/Impress وچ Drawing ٹول بار توں Connector ٹول ورتو تاں جو چنگے فلو چارٹس بݨا سڳو تے چاہو تاں آبجیکٹ کوں Writer وچ کاپی/پیسٹ کر سڳو۔"

#. Uq3tZ
#: cui/inc/tipoftheday.hrc:185
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Your donations support our worldwide community."
msgstr "تہاݙے عطیات ساݙی دنیا بھر دی برادری دی مدد کریندے ہن۔"

#. V2QjS
#: cui/inc/tipoftheday.hrc:186
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You want to add x months to a date? Use =EDATE(date;months)."
msgstr "تساں کہیں تاریخ وچ x مہینے ودھاوݨا چاہندے او؟ =EDATE(date;months) ورتو۔"

#. uYpVp
#. local help missing
#: cui/inc/tipoftheday.hrc:187
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To select a contiguous range of cells containing data and bounded by empty row and columns use %MOD1+* (numeric key pad)."
msgstr "ڈیٹا آلے سیلز دی لڳاتار رینج کوں منتخب کرݨ کیتے، جیڑھی خالی قطار تے کالمز نال گھری ہوئی ہووے، %MOD1+* ورتو (نمبر کی پیڈ)۔"

#. rZTBa
#: cui/inc/tipoftheday.hrc:188
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Your date acceptance pattern is inappropriate? Use Tools ▸ Options ▸ Languages and Locales ▸ General ▸ Date acceptance patterns to tweak the pattern."
msgstr "تہاݙا تاریخ قبول کرݨ دا نمونہ مناسب کائنی؟ Tools ▸ Options ▸ Languages and Locales ▸ General ▸ Date acceptance patterns ورت تے نمونے کوں درست کرو۔"

#. MZyXB
#: cui/inc/tipoftheday.hrc:189
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to export formulas to CSV? File ▸ Save As ▸ Type:Text CSV, check “Edit filter settings”, and check “Save cell formulas” in the next dialog."
msgstr "فارمولیاں کوں CSV وچ ایکسپورٹ کرݨا چاہندے او؟ File ▸ Save As ▸ Type:Text CSV کرو، “Edit filter settings” تے نشان لاؤ، تے اڳلے ڈائیلاگ وچ “Save cell formulas” تے نشان لاؤ۔"

#. XLN9z
#: cui/inc/tipoftheday.hrc:190
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "The presenter console is a great feature when working with %PRODUCTNAME Impress. Have you checked it out?"
msgstr "%PRODUCTNAME Impress دے نال کم کرݨ ویلے presenter console ہک بہترین خصوصیت ہے۔ کیا تساں اینکوں چیک کیتا ہے؟"

#. PFGhM
#. local help missing
#: cui/inc/tipoftheday.hrc:191
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To delete multiple comments, select cells with comments and use Sheet ▸ Cell Comments ▸ Delete Comment."
msgstr "کئی تبصرے مٹاوݨ کیتے، تبصریاں آلے سیلز منتخب کرو تے Sheet ▸ Cell Comments ▸ Delete Comment ورتو۔"

#. SMLUg
#: cui/inc/tipoftheday.hrc:192
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Easily convert your documents to PDF with one click by clicking on the PDF icon in the toolbar."
msgstr "ٹول بار وچ PDF آئیکن تے کلک کر تے آپݨے دستاویزاں کوں ہک کلک نال آسانی نال PDF وچ بدل گھنو۔"

#. UwBoZ
#: cui/inc/tipoftheday.hrc:193
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to select a large range of cells without scrolling? Type the range reference (e.g. A1:A1000) in the name box then Enter."
msgstr "سکرول کرݨ دے بغیر سیلز دی وݙی رینج منتخب کرݨا چاہندے او؟ رینج دا حوالہ (مثلاً A1:A1000) ناں آلے خانے وچ ٹائپ کرو ولا Enter دباؤ۔"

#. Tc7Nf
#: cui/inc/tipoftheday.hrc:194
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to know the valid command line parameters? Start soffice with --help or -h or -?"
msgstr "درست کمانڈ لائن پیرامیٹرز ڄاݨݨا چاہندے او؟ soffice کوں --help یا -h یا -? نال شروع کرو۔"

#. pmP5i
#. local help missing
#: cui/inc/tipoftheday.hrc:195
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Fit your sheet or print ranges to a page with Format ▸ Page ▸ Sheet Tab ▸ Scaling Mode."
msgstr "اپݨی شیٹ یا پرنٹ رینجز کوں Format ▸ Page ▸ Sheet Tab ▸ Scaling Mode نال ہک ورقے تے فٹ کرو۔"

#. KPLPC
#: cui/inc/tipoftheday.hrc:196
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to include a list item without a bullet or number? Use “Insert Unnumbered Entry” in the Bullets and Numbering toolbar."
msgstr "بلٹ یا نمبر دے بغیر تندیر دی شے شامل کرݨی ہے؟ Bullets and Numbering ٹول بار وچ “Insert Unnumbered Entry” ورتو۔"

#. ZacQo
#: cui/inc/tipoftheday.hrc:197
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can rotate cells table orientation with Table ▸ Properties… ▸ Text Flow ▸ Text orientation."
msgstr "تساں سیلز دی ٹیبل دی سمت کوں Table ▸ Properties… ▸ Text Flow ▸ Text orientation نال گھما سڳدے او۔"

#. Vi6L8
#: cui/inc/tipoftheday.hrc:198
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "In %PRODUCTNAME Draw to change the 0/0 point of the rulers, drag the intersection of the two rulers in the top left corner into the workspace."
msgstr "%PRODUCTNAME Draw وچ رولرز دے 0/0 نقطے کوں بدلݨ کیتے، ݙوہاں رولرز دے آپس وچ ملݨ آلی جاہ کوں اُتے کھٻے کونے توں ورک اسپیس وچ گھسیٹو۔"

#. Fcnsr
#: cui/inc/tipoftheday.hrc:199
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Move a column in Calc between two others in one step? Click the header then a cell in the column, keep mouse button and move to the target with %MOD2 key."
msgstr "Calc وچ ہک کالم کوں ݙو ٻئے کالمز دے وچکار ہک قدم وچ منتقل کرݨا چاہندے او؟ ہیڈر تے کلک کرو ولا کالم وچ کہیں سیل تے کلک کرو، ماؤس دا بٹن دٻائی رکھو تے %MOD2 کی نال ہدف تائیں منتقل کرو۔"

#. 3xJeA
#: cui/inc/tipoftheday.hrc:200
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Automatically mark alphabetical index entries using a concordance file."
msgstr "کنکورڈینس فائل ورت تے حروف تہجی دے انڈیکس اندراجاں تے آپݨے آپ نشان لاؤ۔"

#. DBfad
#. local help missing
#: cui/inc/tipoftheday.hrc:201
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use Format ▸ Align Objects in Impress or Shape ▸ Align Objects in Draw (or the context menu) for precise positioning of objects: it centers on the page if one object is selected or works on the group respectively."
msgstr "آبجیکٹاں دی درست جاہ تے رکھݨ کیتے Impress وچ Format ▸ Align Objects یا Draw وچ Shape ▸ Align Objects ورتو (یا سیاق و سباق مینیو): جے ہک آبجیکٹ منتخب ہووے تاں اینکوں ورقے دے وچکار رکھدا ہے، تے گروپ تے وی ایں طرح کم کریندا ہے۔"

#. TijVG
#: cui/inc/tipoftheday.hrc:202
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Do not use tabs to space items on a Writer document. Depending on what you are trying to do, a borderless table can be a better choice."
msgstr "Writer دستاویز وچ شئیں کوں فاصلہ ݙیوݨ کیتے ٹیبز ورتو نہ۔ تساں جیڑھا کم کرݨ دی کوشش کریندے او، این٘دے مطابق بغیر بارڈر آلی ٹیبل ہک بہتر انتخاب ہو سڳدی ہے۔"

#. 6GtGH
#: cui/inc/tipoftheday.hrc:203
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "No need to scroll through the list at Tools ▸ Customize ▸ Keyboard to find a shortcut: just type it."
msgstr "شارٹ کٹ لبھݨ کیتے Tools ▸ Customize ▸ Keyboard تے تندیر وچ سکرول کرݨ دی ضرورت کائنی: بس اینکوں ٹائپ کرو۔"

#. 63noP
#: cui/inc/tipoftheday.hrc:204
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME can automatically add a numbered caption when you insert objects. See Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ AutoCaption."
msgstr "%PRODUCTNAME جڈاں تساں آبجیکٹ پاؤ تاں آپݨے آپ نمبر آلا کیپشن پا سڳدا ہے۔ Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ AutoCaption ݙیکھو۔"

#. 8kpGG
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/shared/optionen/01041100.html
#: cui/inc/tipoftheday.hrc:205
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "With %PRODUCTNAME you can use your Google Mail account to do a mail merge. Fill in Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ Mail Merge Email."
msgstr "%PRODUCTNAME نال تساں آپݨا Google Mail اکاؤنٹ میل مرج کرݨ کیتے ورت سڳدے او۔ Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ Mail Merge Email بھرو۔"

#. 87ozj
#. local help missing
#: cui/inc/tipoftheday.hrc:206
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Keep column headers of a sheet visible when scrolling lines via View ▸ Freeze Cells ▸ Freeze First Row."
msgstr "لائناں سکرول کرݨ ویلے شیٹ دے کالم ہیڈرز کوں نظر آوݨ آلے رکھو، View ▸ Freeze Cells ▸ Freeze First Row دے ذریعے۔"

#. mCfdK
#: cui/inc/tipoftheday.hrc:207
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You want to start working with Basic macros? Take a look at the examples under Tools ▸ Macros ▸ Edit Macros."
msgstr "تساں Basic میکروز نال کم شروع کرݨا چاہندے او؟ Tools ▸ Macros ▸ Edit Macros دے تحت مثالاں ݙیکھو۔"

#. 5fYgo
#: cui/inc/tipoftheday.hrc:208
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Apply Heading paragraph styles in Writer with shortcut keys: %MOD1+1 applies Heading 1, %MOD1+2 applies Heading 2, etc."
msgstr "Writer وچ شارٹ کٹ کیز نال Heading پیراگراف انداز لاؤ: %MOD1+1 نال Heading 1 لڳدا ہے، %MOD1+2 نال Heading 2 لڳدا ہے، وغیرہ۔"

#. DA82R
#: cui/inc/tipoftheday.hrc:209
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Do not get lost in large documents. Use the Navigator (F5) to find your way through the content."
msgstr "وݙے دستاویزاں وچ گم نہ تھیوو۔ مواد وچ آپݨا رستہ لبھݨ کیتے Navigator (F5) ورتو۔"

#. naXEz
#: cui/inc/tipoftheday.hrc:210
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Edit ▸ Find and Replace lets you insert special characters directly: right click in input fields or press Shift+%MOD1+S."
msgstr ""

#. vNBR3
#: cui/inc/tipoftheday.hrc:211
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need custom contents for metadata properties? File ▸ Properties ▸ Custom Properties tab lets you create what you want."
msgstr "میٹا ڈیٹا خصوصیات کیتے حسب ضرورت مواد چاہیدا ہے؟ File ▸ Properties ▸ Custom Properties ٹیب تہاکوں جیڑھا چاہو بݨاوݨ ݙیندی ہے۔"

#. beSc7
#: cui/inc/tipoftheday.hrc:212
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to see, but not print, an object in Draw? Draw it on a layer for which the “Printable” flag is not set (right-click the layer’s tab and choose “Modify Layer”)."
msgstr "Draw وچ کہیں آبجیکٹ کوں ݙیکھݨا چاہندے او، پر پرنٹ کرݨا کائنی؟ اینکوں اوں تہہ تے بݨاؤ جیندے کیتے “Printable” جھنڈا مقرر کائنی (تہہ دے ٹیب تے سڄا کلک کرو تے “Modify Layer” چݨو)۔"

#. CGQaY
#: cui/inc/tipoftheday.hrc:213
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To insert the current date in your document, use Insert ▸ Field ▸ Date."
msgstr "آپݨے دستاویز وچ موجودہ تاریخ پاوݨ کیتے، Insert ▸ Field ▸ Date ورتو۔"

#. vGKBe
#: cui/inc/tipoftheday.hrc:214
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Got many images in your Writer document? Speed up the display by disabling View ▸ Images and charts."
msgstr "تہاݙے Writer دستاویز وچ ٻہوں ساریاں تصویراں ہن؟ View ▸ Images and charts کوں بند کر تے ݙکھاوݨ کوں تیز کرو۔"

#. Y85ij
#: cui/inc/tipoftheday.hrc:215
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use Sheet ▸ Fill Cells ▸ Random Number to generate a random series based on various distributions."
msgstr "مختلف ونڈاں دی بنیاد تے بے ترتیب سلسلہ بݨاوݨ کیتے Sheet ▸ Fill Cells ▸ Random Number ورتو۔"

#. Y24mZ
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/scalc/01/02140700.html
#: cui/inc/tipoftheday.hrc:216
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Rename your slides in Impress to help you define “Go to page” interactions and to have a summary more explicit than Slide1, Slide2…"
msgstr "Impress وچ آپݨیاں سلائیڈز دے ناں بدل گھنو تاں جو تساں “Go to page” تعامل طے کر سڳو تے Slide1, Slide2… توں ودھ واضح خلاصہ حاصل کر سڳو۔"

#. iLWEo
#: cui/inc/tipoftheday.hrc:217
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to display text before a heading number? Open the Numbering tab of the “Heading Numbering” dialog and enter the desired text in “Before”. For example, type “Chapter ” to display “Chapter 1”."
msgstr "سرخی دے نمبر توں پہلے متن ݙکھاوݨا چاہندے او؟ “Heading Numbering” ڈائیلاگ دا Numbering ٹیب کھولو تے “Before” وچ مطلوبہ متن لکھو۔ مثلاً، “Chapter 1” ݙکھاوݨ کیتے “Chapter ” ٹائپ کرو۔"

#. z3rPd
#: cui/inc/tipoftheday.hrc:218
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Transpose a Writer table? Copy and paste in Calc, transpose with copy/paste special then copy/paste special ▸ Formatted text in Writer."
msgstr "Writer ٹیبل کوں الٹاوݨا چاہندے او؟ Calc وچ کاپی تے پیسٹ کرو، کاپی/پیسٹ اسپیشل نال الٹاؤ ولا کاپی/پیسٹ اسپیشل • Writer وچ فارمیٹ شدہ متن۔"

#. mmG7g
#: cui/inc/tipoftheday.hrc:219
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To quickly zoom in on range selection, right click on the zoom part of the status bar and choose Optimal."
msgstr "رینج دے انتخاب تے جلدی زوم کرݨ کیتے، اسٹیٹس بار دے زوم والے حصے تے سڄا کلک کرو تے Optimal چݨو۔"

#. FDNiA
#: cui/inc/tipoftheday.hrc:220
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can sign existing PDF files and also verify those signatures."
msgstr "تساں موجودہ PDF فائلاں تے دستخط کر سڳدے او تے اونہاں دستخطاں دی تصدیق وی کر سڳدے او۔"

#. hDiRV
#. local help missing
#: cui/inc/tipoftheday.hrc:221
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Often create one document from another? Consider using a template."
msgstr "اکثر ہک دستاویز توں ٻیا دستاویز بݨیندے او؟ سانچہ ورتݨ تے غور کرو۔"

#. nESeG
#: cui/inc/tipoftheday.hrc:222
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use Format ▸ Conditional Formatting ▸ Manage in Calc to find out which cells have been defined with conditional formatting."
msgstr "Calc وچ Format ▸ Conditional Formatting ▸ Manage ورت تے ڄاݨو بھلا کیڑھے سیلز تے مشروط فارمیٹنگ مقرر کیتی ڳئی ہے۔"

#. tWQPD
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/scalc/01/05120000.html
#: cui/inc/tipoftheday.hrc:223
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Tools ▸ Detective ▸ Mark Invalid Data highlights all cells in the sheet that contain values outside the validation rules."
msgstr "Tools ▸ Detective ▸ Mark Invalid Data شیٹ دے سارے سیلز کوں نمایاں کریندا ہے جیڑھے توثیق دے قاعدیاں توں ٻاہر قدران رکھدے ہن۔"

#. 4V4Vw
#. local help missing
#: cui/inc/tipoftheday.hrc:224
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Use font embedding for greater interoperability with other office suites at File ▸ Properties ▸ Font."
msgstr "ٻئے آفس سوئیٹس نال ودھ مطابقت کیتے فونٹ ایمبیڈنگ ورتو، File ▸ Properties ▸ Font تے۔"

#. 9Uy9Q
#: cui/inc/tipoftheday.hrc:225
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To convert a formula into static values you do not need to copy/paste; use Data ▸ Calculate ▸ Formula to Value."
msgstr "فارمولے کوں مستقل قدران وچ بدلݨ کیتے تہاکوں کاپی/پیسٹ کرݨ دی ضرورت کائنی؛ Data ▸ Calculate ▸ Formula to Value ورتو۔"

#. rxKUR
#: cui/inc/tipoftheday.hrc:226
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can reformat all comments in a document by clicking the down arrow in a comment and choose “Format all Comments”."
msgstr "تساں دستاویز دے سارے تبصرے کوں دوبارہ فارمیٹ کر سڳدے او، کہیں تبصرے وچ تھلے آلا تیر کلک کر تے “Format all Comments” چݨ تے۔"

#. zD57W
#: cui/inc/tipoftheday.hrc:227
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Writer helps you to make backups: with File ▸ Save a Copy you create a new document continuing to work on the original."
msgstr ""

#. fkvVZ
#: cui/inc/tipoftheday.hrc:228
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "When you have created a Style based on another, you can enter a percentage value or a point value (e.g. 110% or −2pt or +5pt)."
msgstr "جڈاں تساں کہیں ٻئے انداز تے مبنی ہک انداز بݨا گھنو، تاں تساں فیصد قدر یا پوائنٹ قدر لکھ سڳدے او (مثلاً 110% یا –2pt یا +5pt)۔"

#. PBjFr
#: cui/inc/tipoftheday.hrc:229
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To copy a comment without losing the content of the target cell you should use Paste Special and uncheck everything except “Comments” in dialog. Use Operations “Add” to not override existing content."
msgstr "ہدف سیل دے مواد کوں گم کرݨ دے بغیر تبصرہ کاپی کرݨ کیتے تہاکوں Paste Special ورتݨا چاہیدا ہے تے ڈائیلاگ وچ “Comments” توں علاوہ ہر شے توں نشان ہٹا ݙیوݨا چاہیدا ہے۔ موجودہ مواد کوں اوور رائڈ نہ کرݨ کیتے Operations “Add” ورتو۔"

#. rexFB
#: cui/inc/tipoftheday.hrc:230
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Batch-convert your Microsoft Office documents to the OpenDocument format by using the Document Converter wizard in menu File ▸ Wizards ▸ Document Converter."
msgstr "File ▸ Wizards ▸ Document Converter مینیو وچ Document Converter وزرد ورت تے آپݨے Microsoft Office دستاویزاں کوں OpenDocument فارمیٹ وچ بیچ وچ بدل گھنو۔"

#. WMueE
#: cui/inc/tipoftheday.hrc:231
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "When editing a cell in place, you can right click and Insert fields: Date, Sheet name, Document title, etc."
msgstr "سیل وچ بدلݨا کرݨ ویلے، تساں سڄا کلک کر تے فیلڈز پا سڳدے او: Date, Sheet name, Document title، وغیرہ۔"

#. qAVmk
#: cui/inc/tipoftheday.hrc:232
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Need to move a Writer table? Table ▸ Select ▸ Table and Insert ▸ Frame ▸ Frame and move where you want."
msgstr "Writer ٹیبل کوں منتقل کرݨا ہے؟ Table ▸ Select ▸ Table تے Insert ▸ Frame ▸ Frame منتخب کرو تے جتھاں چاہو منتقل کرو۔"

#. TmaSP
#: cui/inc/tipoftheday.hrc:233
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "With Tools ▸ AutoText ▸ AutoText ▸ Import you can select a Word document or a template containing the AutoText entries that you want to import."
msgstr "Tools ▸ AutoText ▸ AutoText ▸ Import نال تساں Word دستاویز یا سانچہ منتخب کر سڳدے او جیڑھا او AutoText اندراجاں رکھدا ہووے جیڑھے تساں امپورٹ کرݨا چاہندے او۔"

#. kwxqQ
#: cui/inc/tipoftheday.hrc:234
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Do not insert manual breaks to separate two paragraphs. Rather change Indents & Spacing ▸ Spacing ▸ Below paragraph at the style/paragraph properties."
msgstr "ݙو پیراگرافاں کوں وکھ کرݨ کیتے دستی بریکس نہ پاؤ۔ ایندی بجائے انداز/پیراگراف خصوصیات وچ Indents & Spacing ▸ Spacing ▸ Below paragraph بدل گھنو۔"

#. rxTGc
#: cui/inc/tipoftheday.hrc:235
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Keep the zeros before a number by using the “leading zeroes” cell format option or format the cell as text before entering the number."
msgstr "نمبر توں پہلے صفر برقرار رکھو، “leading zeroes” سیل فارمیٹ آپشن ورت تے یا نمبر پاوݨ توں پہلے سیل کوں متن دے طور تے فارمیٹ کرو۔"

#. jkXFE
#: cui/inc/tipoftheday.hrc:236
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to return to default after applying a list style? Click Bullets or Numbering On/Off tool on the Formatting toolbar."
msgstr "تندیر دا انداز لاؤݨ دے بعد ڈیفالٹ تے واپس آوݨا چاہندے او؟ Formatting ٹول بار تے Bullets یا Numbering On/Off ٹول کلک کرو۔"

#. wAFRP
#: cui/inc/tipoftheday.hrc:237
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Delete all of your printing areas in one step: select all sheets, then Format ▸ Print Ranges ▸ Clear."
msgstr "ہک قدم وچ آپݨے سارے پرنٹنگ ایریاز مٹاؤ: ساریاں شیٹاں منتخب کرو، ولا Format ▸ Print Ranges ▸ Clear۔"

#. Cqtjg
#: cui/inc/tipoftheday.hrc:238
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Add background images to spreadsheets via Insert ▸ Image or drag a background from the Gallery, then Format ▸ Arrange ▸ To Background."
msgstr "Insert ▸ Image دے ذریعے یا Gallery توں پس منظر گھسیٹ تے سپریڈ شیٹس وچ پس منظر تصویراں پاؤ، ولا Format ▸ Arrange ▸ To Background۔"

#. khFDu
#: cui/inc/tipoftheday.hrc:239
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Having trouble pasting text from PDF files or webpages into documents? Try to paste as unformatted text (%MOD1+%MOD2+Shift+V)."
msgstr ""

#. BtaBD
#: cui/inc/tipoftheday.hrc:240
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "In Calc use TRIMMEAN() to return the mean of a data set excluding the highest and lowest values."
msgstr "Calc وچ TRIMMEAN() ورت تے ڈیٹا سیٹ دے سب توں وݙے تے سب توں نِکے قدران کوں چھوڑ تے اوسط حاصل کرو۔"

#. U2cxc
#. local help missing
#: cui/inc/tipoftheday.hrc:241
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "The 4th optional parameter of VLOOKUP Calc function indicates whether the first column of data is sorted. If not, enter FALSE or zero."
msgstr "VLOOKUP Calc فنکشن دا چوتھا اختیاری پیرامیٹر ݙسیندا ہے بھلا ڈیٹا دا پہلا کالم ترتیب شدہ ہے یا کائنی۔ جے کائنی تاں FALSE یا صفر لکھو۔"

#. LThNS
#: cui/inc/tipoftheday.hrc:242
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Toolbars are contextual—they open depending on the context. If you do not want that, uncheck them from View ▸ Toolbars."
msgstr "ٹول بارز سیاق و سباق دے مطابق ہوندے ہن — او سیاق و سباق دے مطابق کھلدے ہن۔ جے تساں ایہ کائنی چاہندے تاں View ▸ Toolbars توں اونہاں توں نشان ہٹا ݙیوو۔"

#. WjXyE
#: cui/inc/tipoftheday.hrc:243
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can create a master document from the current Writer document by using File ▸ Send ▸ Create Master Document."
msgstr "تساں موجودہ Writer دستاویز توں File ▸ Send ▸ Create Master Document ورت تے ہک ماسٹر دستاویز بݨا سڳدے او۔"

#. cPNVv
#: cui/inc/tipoftheday.hrc:244
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to center cells on a printed page in Calc? Format ▸ Page, Page ▸ Layout settings ▸ Table alignment."
msgstr "Calc وچ چھپے ہوئے ورقے تے سیلز کوں وچکار رکھݨا چاہندے او؟ Format ▸ Page, Page ▸ Layout settings ▸ Table alignment۔"

#. dpyeU
#: cui/inc/tipoftheday.hrc:245
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Frames can be linked so that the text can flow from one to the other as in desktop publishing."
msgstr "فریماں کوں این٘ویں جوڑیا ون٘ڄ سڳدا ہے تاں جو متن ہک توں ٻئے وچ وڳے، جیویں ڈیسک ٹاپ پبلشنگ وچ ہوندا ہے۔"

#. AjBA3
#. local help missing
#: cui/inc/tipoftheday.hrc:246
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can create a chart based on a Writer table by clicking in the table and choosing Insert ▸ Chart."
msgstr "تساں Writer ٹیبل تے مبنی چارٹ بݨا سڳدے او، ٹیبل وچ کلک کر تے Insert ▸ Chart منتخب کر تے۔"

#. cU6JB
#: cui/inc/tipoftheday.hrc:247
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Select options in Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ Formatting Aids ▸ Display Formatting to specify which non-printing characters are displayed."
msgstr "Tools ▸ Options ▸ %PRODUCTNAME Writer ▸ Formatting Aids ▸ Display Formatting وچ آپشنز منتخب کرو تاں جو طے کر سڳو بھلا کیڑھے غیر پرنٹنگ حروف ݙکھائے ویندے ہن۔"

#. 9cyVB
#: cui/inc/tipoftheday.hrc:248
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to jump to a particular page by its number? Click the left-most statusbar entry or use Edit ▸ Go To Page… or press %MOD1+G."
msgstr "کہیں خاص ورقے تے این٘دے نمبر نال ونڄݨا چاہندے او؟ اسٹیٹس بار دی سب توں کھٻے آلی انٹری کلک کرو یا Edit ▸ Go To Page… ورتو یا %MOD1+G دباؤ۔"

#. ULATG
#: cui/inc/tipoftheday.hrc:249
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME supports over 150 languages."
msgstr "%PRODUCTNAME 150 توں ودھ زباناں دی مدد کریندا ہے۔"

#. SLU8G
#: cui/inc/tipoftheday.hrc:250
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Uncheck Slide Show ▸ Settings ▸ Presentation always on top if you need another program displays its window to the front of your presentation."
msgstr "جے تہاکوں کہیں ٻئے پروگرام دی ونڈو کوں آپݨی پیشکش دے سامݨے ݙکھاوݨ دی ضرورت ہووے تاں Slide Show ▸ Settings ▸ Presentation always on top توں نشان ہٹا ݙیوو۔"

#. sogyj
#: cui/inc/tipoftheday.hrc:251
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to find the words in bold in a Writer document? Edit ▸ Find and Replace ▸ Other options ▸ Attributes ▸ Font weight."
msgstr "Writer دستاویز وچ بولڈ آلے الفاظ لبھݨا چاہندے او؟ Edit ▸ Find and Replace ▸ Other options ▸ Attributes ▸ Font weight۔"

#. ppAeT
#. local help missing
#: cui/inc/tipoftheday.hrc:252
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You can sort paragraphs or table rows alphabetically or numerically per Tools ▸ Sort."
msgstr "تساں Tools ▸ Sort دے مطابق پیراگرافاں یا ٹیبل قطاراں کوں حروف تہجی دے مطابق یا عددی طور تے ترتیب ݙے سڳدے او۔"

#. 26HAu
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/swriter/01/06100000.html
#: cui/inc/tipoftheday.hrc:253
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To insert a paragraph before (after) a section, press %MOD2+Enter at the beginning (end) of the section."
msgstr "کہیں حصے توں پہلے (بعد وچ) پیراگراف پاوݨ کیتے، حصے دے شروع (انت) وچ %MOD2+Enter دباؤ۔"

#. 7dGQR
#: cui/inc/tipoftheday.hrc:254
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME has a template center to create good looking documents—check it out."
msgstr "%PRODUCTNAME کول چنگے ݙکھݨ آلے دستاویز بݨاوݨ کیتے سانچہ مرکز ہے — اینکوں چیک کرو۔"

#. tvpFN
#: cui/inc/tipoftheday.hrc:255
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Calculate loan repayments with Calc: eg. PMT(2%/12;36;2500) interest rate per payment period 2%/12, 36 months, loan amount 2500."
msgstr "Calc نال قرض دی قسطاں دا حساب لاؤ: مثلاً PMT(2%/12;36;2500) ہر قسط دی مدت تے سود دی شرح 2%/12، 36 مہینے، قرض دی رقم 2500۔"

#. QZAFw
#. local help missing
#: cui/inc/tipoftheday.hrc:256
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Cannot find what you want with the VLOOKUP function in Calc? With INDEX and MATCH you can do anything!"
msgstr "Calc وچ VLOOKUP فنکشن نال جیڑھا چاہندے او اونکوں لبھݨ وچ ناکام او؟ INDEX تے MATCH نال تساں کجھ وی کر سڳدے او!"

#. ARJgA
#. local help missing
#: cui/inc/tipoftheday.hrc:257
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to show hidden column A? Click a cell in column B, press the left mouse button, move the mouse to the left, release. Then switch it on via Format ▸ Columns ▸ Show."
msgstr "لکی ہوئی کالم A ݙکھاوݨی چاہندے او؟ کالم B وچ کہیں سیل تے کلک کرو، کھٻا ماؤس بٹن دباؤ، ماؤس کوں کھٻے پاسے منتقل کرو، چھوڑ ݙیوو۔ ولا Format ▸ Columns ▸ Show دے ذریعے اینکوں آن کرو۔"

#. Wzpbw
#: cui/inc/tipoftheday.hrc:258
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To change the number of a page in Writer, go to the properties of the first paragraph and at the Text Flow tab check Break ▸ Insert and enter the number."
msgstr "Writer وچ کہیں ورقے دا نمبر بدلݨ کیتے، پہلے پیراگراف دی خصوصیات تے ونڄو تے Text Flow ٹیب تے Break ▸ Insert تے نشان لاؤ تے نمبر لکھو۔"

#. AgQyA
#: cui/inc/tipoftheday.hrc:259
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Run %PRODUCTNAME in any browser via rollApp."
msgstr "rollApp دے ذریعے %PRODUCTNAME کوں کہیں وی براؤزر وچ چلاؤ۔"

#. mPz5B
#: cui/inc/tipoftheday.hrc:260
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Strange error code in Calc, Err: followed by a number? This page gives the explanation:"
msgstr "Calc وچ عجیب غلطی دا کوڈ، Err: دے بعد نمبر؟ ایہ ورقہ وضاحت ݙیندا ہے:"

#. GFgmh
#. local help missing
#: cui/inc/tipoftheday.hrc:261
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Include a paragraph that is not a heading in the “Table of Contents” by giving a numerical outline level to the paragraph in the “Outline & List” tab in the paragraph settings."
msgstr "کہیں پیراگراف کوں، جیڑھا سرخی کائنی، “Table of Contents” وچ شامل کرو، پیراگراف سیٹنگز وچ “Outline & List” ٹیب تے پیراگراف کوں عددی آؤٹ لائن سطح ݙے تے۔"

#. Jx7Fr
#: cui/inc/tipoftheday.hrc:262
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Apart from table of contents, %PRODUCTNAME can create Alphabetical, Illustrations, Tables, Objects, Bibliography, User-Defined indexes."
msgstr "مواد دی تندیر توں علاوہ، %PRODUCTNAME حروف تہجی، تصویراں، ٹیبلز، آبجیکٹس، کتابیات، صارف دی طرفوں طے شدہ انڈیکسز بݨا سڳدا ہے۔"

#. 2DrYx
#. https://help.libreoffice.org/%PRODUCTVERSION/%LANGUAGENAME/text/swriter/guide/indices_toc.html
#: cui/inc/tipoftheday.hrc:263
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Unable to modify or delete a custom cell style? Check all sheets, none should be protected."
msgstr "کہیں حسب ضرورت سیل انداز کوں بدلݨ یا مٹاوݨ وچ ناکام او؟ ساریاں شیٹاں چیک کرو، کہیں وی تے حفاظت کائنی ہووݨی چاہیدی۔"

#. 55Nfb
#: cui/inc/tipoftheday.hrc:264
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "You need to fill a series? Select the cell range and Sheet ▸ Fill Cells ▸ Fill Series and choose between Linear, Growth, Date and AutoFill."
msgstr "تساں کوں کہیں سلسلے کوں بھرݨا ہے؟ سیل رینج منتخب کرو تے Sheet ▸ Fill Cells ▸ Fill Series تے Linear، Growth، Date تے AutoFill وچوں چݨو۔"

#. BiSJM
#. local help missing
#: cui/inc/tipoftheday.hrc:265
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to know if a cell is referred in formulas of other cells? Tools ▸ Detective ▸ Trace Dependents (Shift+F5)."
msgstr ""

#. QeBjt
#: cui/inc/tipoftheday.hrc:266
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "In the replace input field of auto correct options you can use the wildcards .*"
msgstr "آٹو درست آپشنز دے بدلݨ آلے ان پٹ فیلڈ وچ تساں وائلڈ کارڈز .* ورت سڳدے او۔"

#. G7J8m
#: cui/inc/tipoftheday.hrc:267
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want to duplicate the above line? Press %MOD1+D or use Sheet ▸ Fill Cells ▸ Fill Down."
msgstr "اُتے آلی لائن دی نقل بݨاوݨا چاہندے او؟ %MOD1+D دباؤ یا Sheet ▸ Fill Cells ▸ Fill Down ورتو۔"

#. MG7Pu
#: cui/inc/tipoftheday.hrc:268
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To search in several spreadsheets, select them before you start the search."
msgstr "کئی سپریڈ شیٹس وچ تلاش کرݨ کیتے، تلاش شروع کرݨ توں پہلے اونہاں کوں منتخب کرو۔"

#. Jd6KJ
#: cui/inc/tipoftheday.hrc:269
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Drag & drop cells from Calc into the normal view of a slide creates a table; into the outline view, each cell creates a line in the outline."
msgstr "Calc توں سیلز کوں گھسیٹ تے سلائیڈ دے عام منظر وچ سٹݨ نال ٹیبل بݨدی ہے؛ آؤٹ لائن منظر وچ، ہر سیل آؤٹ لائن وچ ہک لائن بݨیندا ہے۔"

#. DgSwJ
#: cui/inc/tipoftheday.hrc:270
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "%PRODUCTNAME helps you not to enter two or more spaces in Writer. Check Tools ▸ AutoCorrect ▸ AutoCorrect Options ▸ Options ▸ Ignore double spaces."
msgstr "%PRODUCTNAME Writer وچ تہاکوں ݙو یا ودھ خالی جاہواں پاوݨ توں بچاوݨ وچ مدد کریندا ہے۔ Tools ▸ AutoCorrect ▸ AutoCorrect Options ▸ Options ▸ Ignore double spaces چیک کرو۔"

#. 3Fjtd
#: cui/inc/tipoftheday.hrc:271
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Want the cursor to go into the cell to the right, after entering a value in Calc? Use the Tab key instead of Enter."
msgstr "Calc وچ قدر پاوݨ دے بعد کرسر کوں سڄے آلے سیل وچ ونڄݨا چاہندے او؟ Enter دی بجائے Tab کی ورتو۔"

#. By2BE
#: cui/inc/tipoftheday.hrc:272
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "To display the scrollbar to the left, enable Tools ▸ Options ▸ Languages and Locales ▸ General ▸ Complex text and right click a sheet in Sheet tabs above Status bar ▸ Right-To-Left."
msgstr "سکرول بار کوں کھٻے پاسے ݙکھاوݨ کیتے، Tools ▸ Options ▸ Languages and Locales ▸ General ▸ Complex text فعال کرو تے اسٹیٹس بار دے اُتے Sheet tabs وچ کہیں شیٹ تے سڄا کلک کرو ▸ Right-To-Left۔"

#. gqs9W
#: cui/inc/tipoftheday.hrc:273
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Drag a formatted object to the Styles and Formatting window. A dialog box opens, just enter the name of the new style."
msgstr "کہیں فارمیٹ شدہ آبجیکٹ کوں Styles and Formatting ونڈو تے گھسیٹو۔ ہک ڈائیلاگ باکس کھلدا ہے، بس نویں انداز دا ناں لکھو۔"

#. EabEN
#: cui/inc/tipoftheday.hrc:274
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "New versions of %PRODUCTNAME provide new features, bug fixes, and security patches. Keep your software updated!"
msgstr "%PRODUCTNAME دے نویں ورژن نویاں خصوصیات، بگ فکسز تے حفاظتی پیچ ݙیندے ہن۔ آپݨا سافٹ ویئر اپ ڈیٹ رکھو!"

#. cmz6r
#: cui/inc/tipoftheday.hrc:275
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Developing new XSLT and XML filters?"
msgstr "نویں XSLT تے XML فلٹرز بݨا رہے او؟"

#. C7Ya2
#: cui/inc/tipoftheday.hrc:276
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Press Shift+F1 to see any available extended tooltips in dialog boxes, when \"Extended tips\" is not enabled in Tools ▸ Options ▸ %PRODUCTNAME ▸ General."
msgstr ""

#. CqfWV
#: cui/inc/tipoftheday.hrc:277
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Never use certain arrow styles? Remove them by using the Delete button on the Format ▸ Text Box and Shape ▸ Line ▸ Arrow Styles tab."
msgstr "کہیں خاص تیر اندازاں کوں کدی ورتو نہ؟ Format ▸ Text Box and Shape ▸ Line ▸ Arrow Styles ٹیب تے Delete بٹن ورت تے اونہاں کوں ہٹا ݙیوو۔"

#. q5M6P
#: cui/inc/tipoftheday.hrc:278
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Don’t like the position of some icons on your toolbar? Change it with Tools ▸ Customize ▸ Toolbars tab ▸ Target."
msgstr "آپݨے ٹول بار تے کہیں آئیکنز دی جاہ پسند کائنی؟ Tools ▸ Customize ▸ Toolbars ٹیب ▸ Target نال اینکوں بدل گھنو۔"

#. jFitB
#: cui/inc/tipoftheday.hrc:279
msgctxt "RID_CUI_TIPOFTHEDAY"
msgid "Can’t find a command in the menus? Try Shift+ESC."
msgstr ""

