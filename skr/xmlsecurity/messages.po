#. YFxBG
#: xmlsecurity/inc/strings.hrc:39
msgctxt "STR_XMLSECDLG_OLD_ODF_FORMAT"
msgid ""
"This document contains signatures in ODF 1.1 (OpenOffice.org 2.x) format. Signing documents in %PRODUCTNAME %PRODUCTVERSION requires ODF 1.2 format version. Thus no signatures can be added or removed to this document.\n"
"\n"
"Save document in ODF 1.2 format and add all desired signatures again."
msgstr ""
"ایں دستاویز وچ ODF 1.1 (OpenOffice.org 2.x) فارمیٹ وچ دستخطاں موجود ہن۔ %PRODUCTNAME %PRODUCTVERSION وچ دستاویزاں تے دستخط کرݨ کیتے ODF 1.2 فارمیٹ ورژن دی لوڑ ہے۔ ایں واسطے ایں دستاویز وچ کوئی دستخط شامل یا ہٹائے نئیں ونج سڳدے۔\n"
"\n"
"دستاویز نوں ODF 1.2 فارمیٹ وچ محفوظ کرو تے سارے مطلوبہ دستخط ولا شامل کرو۔"

#. cfswe
#: xmlsecurity/inc/strings.hrc:43
msgctxt "STR_XMLSECDLG_QUERY_REMOVEDOCSIGNBEFORESIGN"
msgid ""
"Adding or removing a macro signature will remove all document signatures.\n"
"Do you really want to continue?"
msgstr ""
"ہک میکرو دستخط شامل کرݨ یا ہٹاوݨ نال دستاویز دے سارے دستخط ہٹ ونج سݨ۔\n"
"کیا تسیں واقعی اڳے ودھݨا چاہندے ہؤ؟"

#. CgnGz
#: xmlsecurity/inc/strings.hrc:45
msgctxt "STR_XMLSECDLG_QUERY_REALLYREMOVE"
msgid ""
"Document signature cannot be restored, once removed.\n"
"Do you really want to remove selected signature?"
msgstr ""
"دستاویز دا دستخط ہک واری ہٹاوݨ دے بعد بحال نئیں کیتا ونج سڳدا۔\n"
"کیا تسیں واقعی چُݨیا گیا دستخط ہٹاوݨا چاہندے ہؤ؟"

