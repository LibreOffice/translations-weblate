#. m4G3E
#: uui/inc/ids.hrc:41
msgctxt "RID_UUI_ERRHDL"
msgid ""
"You are saving a password protected Basic library containing the following large module(s): \n"
"$(ARG1)\n"
"Storing those large module(s) in binary format, which is necessary for password protection, makes them unreadable in versions older than LibreOffice 5.0.3. If you want to avoid this please split the module into smaller pieces."
msgstr ""
"تساں پاس ورڈ نال محفوظ کیتی گئی Basic لائبریری محفوظ کریندے پئے ہو جیندے وچ ہیٹھلے وݙے ماڈیول ہن:\n"
"$(ARG1)\n"
"اوہناں وݙے ماڈیولاں کوں بائنری فارمیٹ وچ محفوظ کرݨا، جیہڑا پاس ورڈ دی حفاظت کیتے ضروری ہے، اوہناں کوں LibreOffice 5.0.3 توں پرانی ورژن وچ پڑھݨ دے قابل کائنی بݨایندا۔ جے تساں ایں توں بچݨا چاہندے ہو تاں مہربانی کرکے ماڈیول کوں نکیاں ٹکڑاں وچ ونڈو۔"

#. 3rNDF
#: uui/inc/ids.hrc:43
msgctxt "RID_UUI_ERRHDL"
msgid ""
"Beware!\n"
"\n"
"You are about to load a very unusual sort of file ($(ARG2)) from the URL:\n"
"\n"
"$(ARG1)\n"
"\n"
"Are you certain that this file is a legacy document created many years ago?"
msgstr ""
"خبردار!\n"
"\n"
"تساں URL توں ہک بہت غیر معمولی قسم دی فائل ($(ARG2)) لوڈ کرݨ والے ہو:\n"
"\n"
"$(ARG1)\n"
"\n"
"کیا تساں یقین رکھدے ہو جو ایہ فائل ہک پرانی دستاویز ہے جیہڑی کئی سال پہلے بݨائی گئی ہئی؟"

