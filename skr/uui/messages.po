#. cSCj6
#: uui/inc/ids.hrc:137
msgctxt "RID_UUI_ERRHDL"
msgid "%PRODUCTNAME cannot keep files from being overwritten when this transmission protocol is used. Do you want to continue anyway?"
msgstr "%PRODUCTNAME فائلاں کوں اوور رائٹ تھیݨ توں کائنی روک سڳدا جدوں ایہ ٹرانسمیشن پروٹوکول استعمال کیتا ونجے۔ کیا تساں فیر وی جاری رکھݨا چاہندے ہو؟"

#. CUbSR
#: uui/inc/ids.hrc:139
msgctxt "RID_UUI_ERRHDL"
msgid ""
"The file '$(ARG1)' is corrupt and therefore cannot be opened. %PRODUCTNAME can try to repair the file.\n"
"\n"
"The corruption could be the result of document manipulation or of structural document damage due to data transmission.\n"
"\n"
"We recommend that you do not trust the content of the repaired document.\n"
"Execution of macros is disabled for this document.\n"
"\n"
"Should %PRODUCTNAME repair the file?\n"
msgstr ""
"فائل '$(ARG1)' خراب ہے تے ایں وجہ توں کھولی کائنی ونج سڳدی۔ %PRODUCTNAME فائل دی مرمت کرݨ دی کوشش کر سڳدا ہے۔\n"
"\n"
"خرابی دستاویز نال چھیڑ چھاڑ یا ڈیٹا دی ترسیل دی وجہ توں دستاویز دے ساختی نقصان دا نتیجہ ہو سڳدی ہے۔\n"
"\n"
"اساں سفارش کریندے ہیں جو تساں مرمت شدہ دستاویز دے مواد تے بھروسہ نہ کرو۔\n"
"میکروز دا عمل ایں دستاویز کیتے بند ہے۔\n"
"\n"
"کیا %PRODUCTNAME فائل دی مرمت کرے؟\n"

#. KeFss
#: uui/inc/ids.hrc:141
msgctxt "RID_UUI_ERRHDL"
msgid "The file '$(ARG1)' could not be repaired and therefore cannot be opened."
msgstr "فائل '$(ARG1)' دی مرمت کائنی کیتی ونج سڳی تے ایں وجہ توں کھولی کائنی ونج سڳدی۔"

#. JCpTn
#: uui/inc/ids.hrc:143
msgctxt "RID_UUI_ERRHDL"
msgid ""
"Configuration data in '$(ARG1)' is corrupted. Without this data some functions may not operate correctly.\n"
"Do you want to continue startup of %PRODUCTNAME without the corrupted configuration data?"
msgstr ""
"'$(ARG1)' وچ کنفیگریشن ڈیٹا خراب ہے۔ ایں ڈیٹا توں بغیر کجھ فنکشنز صحیح طریقے نال کم کائنی کر سڳدے۔\n"
"کیا تساں خراب کنفیگریشن ڈیٹا توں بغیر %PRODUCTNAME دا سٹارٹ اپ جاری رکھݨا چاہندے ہو؟"

#. QCACp
#: uui/inc/ids.hrc:145
msgctxt "RID_UUI_ERRHDL"
msgid ""
"The personal configuration file '$(ARG1)' is corrupted and must be deleted to continue. Some of your personal settings may be lost.\n"
"Do you want to continue startup of %PRODUCTNAME without the corrupted configuration data?"
msgstr ""
"ذاتی کنفیگریشن فائل '$(ARG1)' خراب ہے تے جاری رکھݨ کیتے ایں کوں مٹاوݨا ضروری ہے۔ تہاݙیاں کجھ ذاتی سیٹنگز گم ہو سڳدیاں ہن۔\n"
"کیا تساں خراب کنفیگریشن ڈیٹا توں بغیر %PRODUCTNAME دا سٹارٹ اپ جاری رکھݨا چاہندے ہو؟"

#. e5Rft
#: uui/inc/ids.hrc:147
msgctxt "RID_UUI_ERRHDL"
msgid "The configuration data source '$(ARG1)' is unavailable. Without this data some functions may not operate correctly."
msgstr "کنفیگریشن ڈیٹا سورس '$(ARG1)' دستیاب کائنی۔ ایں ڈیٹا توں بغیر کجھ فنکشنز صحیح طریقے نال کم کائنی کر سڳدے۔"

#. 4gRCA
#: uui/inc/ids.hrc:149
msgctxt "RID_UUI_ERRHDL"
msgid ""
"The configuration data source '$(ARG1)' is unavailable. Without this data some functions may not operate correctly.\n"
"Do you want to continue startup of %PRODUCTNAME without the missing configuration data?"
msgstr ""
"کنفیگریشن ڈیٹا سورس '$(ARG1)' دستیاب کائنی۔ ایں ڈیٹا توں بغیر کجھ فنکشنز صحیح طریقے نال کم کائنی کر سڳدے۔\n"
"کیا تساں گم شدہ کنفیگریشن ڈیٹا توں بغیر %PRODUCTNAME دا سٹارٹ اپ جاری رکھݨا چاہندے ہو؟"

#. DAUhe
#: uui/inc/ids.hrc:151
msgctxt "RID_UUI_ERRHDL"
msgid "The form contains invalid data. Do you still want to continue?"
msgstr "فارم وچ غلط ڈیٹا ہے۔ کیا تساں فیر وی جاری رکھݨا چاہندے ہو؟"

#. DSoD4
#: uui/inc/ids.hrc:153
