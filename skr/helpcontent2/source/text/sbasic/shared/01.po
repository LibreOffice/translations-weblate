msgctxt ""
"06130500.xhp\n"
"hd_id3145071\n"
"help.text"
msgid "Replace existing libraries"
msgstr "موجودہ لائبریریاں کوں وٹاؤ"

#. iBdnG
#: 06130500.xhp
msgctxt ""
"06130500.xhp\n"
"par_id3149812\n"
"help.text"
msgid "<ahelp hid=\"modules/BasicIDE/ui/importlibdialog/replace\">Replaces a library that has the same name with the current library.</ahelp>"
msgstr "<ahelp hid=\"modules/BasicIDE/ui/importlibdialog/replace\">ہک ایجھی لائبریری کوں وٹائیندا ہے جیندا ناں موجودہ لائبریری وانگوں ہے۔</ahelp>"
