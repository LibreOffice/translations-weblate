msgctxt ""
"06130000.xhp\n"
"par_id3153190\n"
"help.text"
msgid "<ahelp hid=\"modules/BasicIDE/ui/basicmacrodialog/libraries\">Lists the libraries and the modules where you can open or save your macros. To save a macro with a particular document, open the document, and then open this dialog.</ahelp>"
msgstr "<ahelp hid=\"modules/BasicIDE/ui/basicmacrodialog/libraries\">لائبریریاں تے ماڈیولز دی تندیر ݙیندا ہے جتھاں تسیں آپݨے میکروز کوں کھول یا محفوظ کر سڳدے ہو۔ ہک خاص دستاویز نال میکرو کوں محفوظ کرݨ کیتے، دستاویز کوں کھولو، تے ول ایہ ڈائیلاگ کھولو۔</ahelp>"

