#. m2569
#: 06130500.xhp
msgctxt ""
"06130500.xhp\n"
"hd_id3147226\n"
"help.text"
msgid "Insert as reference (read-only)"
msgstr "حوالے طور تے داخل کرو (صرف پڑھݨ کیتے)"

#. q3kaa
#: 06130500.xhp
msgctxt ""
"06130500.xhp\n"
"par_id3155892\n"
"help.text"
msgid "<ahelp hid=\"modules/BasicIDE/ui/importlibdialog/ref\">Adds the selected library as a read-only file. The library is reloaded each time you start <item type=\"productname\">%PRODUCTNAME</item>.</ahelp>"
msgstr "<ahelp hid=\"modules/BasicIDE/ui/importlibdialog/ref\">چُݨی ڳئی لائبریری کوں صرف پڑھݨ کیتے فائل طور تے شامل کریندا ہے۔ لائبریری کوں ہر واری ولا لوڈ کیتا ونڄدا ہے جݙاں تسیں <item type=\"productname\">%PRODUCTNAME</item> شروع کریندے ہو۔</ahelp>"

#. kuDaX
