#. 75XUC
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id121689595522630\n"
"help.text"
msgid "In general, all methods of the <literal>FileSystem</literal> service can be used to manipulate files in the document's virtual file system. However, the following restrictions apply:"
msgstr "عام طور تے، <literal>FileSystem</literal> سروس دے سارے طریقے دستاویز دے ورچوئل فائل سسٹم وچ فائلاں دی ہیرا پھیری کرݨ کیتے ورتے ونڄ سڳدن۔ البتہ، تھلے ݙتیاں ڳئیاں حداں لاگو ہن:"

#. Du7UF
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321689595825516\n"
"help.text"
msgid "It is not possible to create files in the root folder. Use existing subfolders or create new folders to store files in the document's file system."
msgstr "جڑھ فولڈر وچ فائلاں بݨاوݨا ممکن کائنی۔ دستاویز دے فائل سسٹم وچ فائلاں محفوظ کرݨ کیتے موجودہ ذیلی فولڈر ورتو یا نویں فولڈر بݨاؤ۔"

#. vsqoB
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id861689595826432\n"
"help.text"
msgid "The <literal>FileNaming</literal> notation is always considered to be \"URL\"."
msgstr "<literal>FileNaming</literal> لکھݨ دا طریقہ ہر ویلے \"URL\" سمجھیا ویندا ہے۔"

#. CbqEb
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id181689595826743\n"
"help.text"
msgid "The methods <literal>CompareFiles</literal>, <literal>GetFileModified</literal>, <literal>HashFile</literal>, <literal>PickFile</literal> and <literal>PickFolder</literal> are not applicable."
msgstr "<literal>CompareFiles</literal>، <literal>GetFileModified</literal>، <literal>HashFile</literal>، <literal>PickFile</literal> تے <literal>PickFolder</literal> طریقے لاگو کائنی ہن۔"

#. AuBgo
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id361689595827152\n"
"help.text"
msgid "The method <literal>GetFileLen</literal> always returns zero."
msgstr "<literal>GetFileLen</literal> طریقہ ہر ویلے صفر واپس کریندا ہے۔"

#. WJsDa
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id131689596237329\n"
"help.text"
msgid "The method <literal>Normalize</literal> always returns the input string unchanged."
msgstr "<literal>Normalize</literal> طریقہ ہر ویلے ان پٹ سٹرنگ کوں بے وٹا واپس کریندا ہے۔"

#. GJMuQ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id51689595641705\n"
"help.text"
msgid "The path to the virtual file system is not a physical address on the computer's hard drive. It can only be accessed from within a %PRODUCTNAME script and it only exists while the document file is open."
msgstr "ورچوئل فائل سسٹم دی راہ کمپیوٹر دی ہارڈ ڈرائیو تے ہک جسمانی پتا کائنی ہے۔ ایہ صرف ہک %PRODUCTNAME سکرپٹ اندر توں رسائی حاصل کیتا ونڄ سڳدا ہے تے ایہ صرف اوں ویلے موجود ہوندا ہے جݙاں دستاویز فائل کھلی ہوئی ہووے۔"

