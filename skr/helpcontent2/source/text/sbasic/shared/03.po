msgstr "تھلے ݙتی ڳئی مثال \"Standard\" لائبریری وچ محفوظ \"MyDialog\" ڈائیلاگ توں ساریاں تنداں کڈھدی ہے تے اونکوں ہک POT فائل وچ برآمد کریندی ہے:"

#. DqFBf
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id281586102707242\n"
"help.text"
msgid "Exports a set of untranslated strings as a POT file."
msgstr "بغیر ترجمہ کیتیاں ڳئیاں تنداں دے ہک سیٹ کوں ہک POT فائل دے طور تے برآمد کریندا ہے۔"

#. NABBq
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id711586102939257\n"
"help.text"
msgid "To build a set of strings you can use either a succession of <literal>AddText</literal> method calls, or by a successful invocation of the <literal>L10N</literal> service with the <literal>foldername</literal> argument present. It is also possible to use a combination of both techniques."
msgstr "تنداں دا ہک سیٹ بݨاوݨ کیتے تسیں یا تاں <literal>AddText</literal> طریقے دیاں ہک دے بعد ہک کالاں ورت سڳدے ہو، یا <literal>L10N</literal> سروس دی کامیاب طلب دے ذریعے جیندے وچ <literal>foldername</literal> دلیل موجود ہووے۔ ݙوہاں تکنیکاں دا مجموعہ ورتݨا وی ممکن ہے۔"

#. Pb4VF
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id641625855725141\n"
"help.text"
msgid "The method returns <literal>True</literal> if successful."
msgstr "جے کامیاب تھیا ہووے تاں طریقہ <literal>True</literal> واپس کریندا ہے۔"

#. 9ewFc
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id31586102707537\n"
"help.text"
msgid "<emph>filename</emph>: The full output file name in <literal>FileSystem.FileNaming</literal> notation."
msgstr "<emph>filename</emph>: <literal>FileSystem.FileNaming</literal> لکھݨ دے طریقے وچ مکمل آؤٹ پٹ فائل ناں۔"

#. jQV77
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id851586102707579\n"
"help.text"
msgid "<emph>header</emph>: Comments that will be added on top of the generated POT file."
msgstr "<emph>header</emph>: اوہ تبصرے جیڑھے بݨائی ڳئی POT فائل دے اُتے شامل کیتے ونڄݨے ہن۔"

#. YhYbQ
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id111614364686973\n"
"help.text"
msgid "Do not include any leading \"#\" characters. If you want the header to be broken into multiple lines, insert escape sequences (\\n) where relevant. A standard header will be added alongside the text specified in the <literal>header</literal> argument."
msgstr "شروع وچ کوئی \"#\" حرف شامل نہ کرو۔ جے تسیں چاہندے ہو جو ہیڈر کئی لکیراں وچ ونڈیا ونڄے تاں جتھاں مناسب ہووے اُتھاں ایسکیپ ترتیباں (\\n) داخل کرو۔ ہک معیاری ہیڈر اون عبارت دے نال شامل کیتا ونڄسی جیڑھی <literal>header</literal> دلیل وچ بیان کیتی ڳئی ہے۔"

#. E2Loj
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id5158610270728\n"
"help.text"
msgid "<emph>encoding</emph>: The character set to be used (Default = \"UTF-8\")."
msgstr "<emph>encoding</emph>: ورتݨ آلا حرف سیٹ (طے شدہ = \"UTF-8\")۔"

#. uDu7z
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id581614364494235\n"
"help.text"
msgid "The generated file should successfully pass the <literal>msgfmt --check</literal> GNU command."
msgstr "بݨائی ڳئی فائل کوں <literal>msgfmt --check</literal> GNU کمانڈ وچوں کامیابی نال گزرݨا چاہیدا ہے۔"

#. 32fPj
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id891586165768715\n"
"help.text"
msgid "Gets the translated string corresponding to the given <literal>msgid</literal> argument."
msgstr "ݙتی ڳئی <literal>msgid</literal> دلیل نال تعلق رکھݨ آلی ترجمہ کیتی ڳئی تند حاصل کریندا ہے۔"

#. NzGZC
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id291614365296959\n"
"help.text"
msgid "A list of arguments may be specified to replace the placeholders (%1, %2, ...) in the string."
msgstr "تند وچ پلیس ہولڈرز (%1، %2، ...) کوں بدلݨ کیتے دلیلاں دی ہک تندیر بیان کیتی ونڄ سڳدی ہے۔"

#. 9DBFa
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id231586166181909\n"
"help.text"
msgid "If no translated string is found, the method returns the untranslated string after replacing the placeholders with the specified arguments."
msgstr "جے کوئی ترجمہ کیتی ڳئی تند نہ مِلے تاں طریقہ بیان کیتیاں ڳئیاں دلیلاں نال پلیس ہولڈرز کوں بدلݨ دے بعد بغیر ترجمہ کیتی ڳئی تند واپس کریندا ہے۔"

#. bAcmJ
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id871586352505927\n"
"help.text"
msgid "This method can be called either by the full name <literal>GetText</literal> or by the shortcut <literal>_</literal> (a single underscore):"
msgstr "ایہ طریقہ یا تاں پورے ناں <literal>GetText</literal> نال یا شارٹ کٹ <literal>_</literal> (ہک انڈر اسکور) نال طلب کیتا ونڄ سڳدا ہے:"

#. mvB66
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id421614967136502\n"
"help.text"
msgid "In the ScriptForge library, all methods starting with the \"_\" character are reserved for internal use only. However, the shortcut <literal>_</literal> used for <literal>GetText</literal> is the only exception to this rule, hence it can be safely used in Basic and Python scripts."
msgstr "ScriptForge لائبریری وچ، \"_\" حرف نال شروع تھیوݨ آلے سارے طریقے صرف اندرونی ورتݨ کیتے مخصوص ہن۔ البتہ، <literal>GetText</literal> کیتے ورتیا ونڄݨ آلا شارٹ کٹ <literal>_</literal> ایں اصول دی ہکلو استثنا ہے، ایں کیتے ایہ Basic تے Python سکرپٹس وچ محفوظ طریقے نال ورتیا ونڄ سڳدا ہے۔"

#. 2ZVAQ
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id51586165768525\n"
"help.text"
msgid "<emph>msgid</emph>: The untranslated string, which is the text appearing in the program code. It must not be empty. It may contain any number of placeholders (%1 %2 %3 ...) that can be used to dynamically insert text at runtime."
msgstr "<emph>msgid</emph>: بغیر ترجمہ کیتی ڳئی تند، جیڑھی پروگرام کوڈ وچ ظاہر تھیوݨ آلی عبارت ہے۔ ایہ خالی کائنی ہووݨی چاہیدی۔ ایندے وچ کہیں وی گݨتری وچ پلیس ہولڈرز (%1 %2 %3 ...) ہو سڳدے ہن جیڑھے رن ٹائم تے عبارت کوں متحرک طور تے داخل کرݨ کیتے ورتے ونڄ سڳدے ہن۔"

#. dALxK
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id11614365537450\n"
"help.text"
msgid "Besides using a single <literal>msgid</literal> string, this method also accepts the following formats:"
msgstr "ہک <literal>msgid</literal> تند ورتݨ دے علاوہ، ایہ طریقہ تھلے ݙتے ڳئے فارمیٹس کوں وی قبول کریندا ہے:"

#. Q7Bbm
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id961614365557277\n"
"help.text"
msgid "The <literal>context</literal> string with which the method will retrieve the <literal>msgid</literal> in the PO file, or;"
msgstr "اوہ <literal>context</literal> تند جیندے نال طریقہ PO فائل وچ <literal>msgid</literal> کوں حاصل کریسی، یا؛"

#. rTDrq
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id981614365589866\n"
"help.text"
msgid "A combination <literal>context|msgid</literal>, instructing the method to retrieve the <literal>msgid</literal> using specified <literal>context</literal> value. The second part of the argument is used to improve code readability."
msgstr "ہک مجموعہ <literal>context|msgid</literal>، جیڑھا طریقے کوں ہدایت کریندا ہے جو بیان کیتی ڳئی <literal>msgid</literal> کوں <literal>context</literal> قیمت ورت کے حاصل کرے۔ دلیل دا ݙوجھا حصہ کوڈ دی پڑھݨ دی اہلیت کوں بہتر بݨاوݨ کیتے ورتیا ویندا ہے۔"

#. dW6RE
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id571586165768106\n"
"help.text"
msgid "<emph>args</emph>: Values to be inserted into the placeholders. Any variable type is allowed, however only strings, numbers and dates will be considered."
msgstr "<emph>args</emph>: پلیس ہولڈرز وچ داخل کیتیاں ونڄݨ آلیاں قیمتاں۔ کہیں وی متغیر قسم دی اجازت ہے، البتہ صرف تنداں، عدد تے تریخاں تے غور کیتا ونڄسی۔"

