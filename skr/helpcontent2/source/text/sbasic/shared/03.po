msgid "doc.DecorateFont('SheetX.A1:J30', fontsize = 15, decoration = 'Bold,Underline', filterformula = '=IsNumeric(A1)', filterscope = 'CELL')"
msgstr ""

#. F7gfF
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id471779055753462\n"
"help.text"
msgid "Define a new name in the worksheet, at global or sheet level. If the name exists already, it is overwritten without warning. After creation, the new name can be used in formulas. Returns <literal>True</literal> when successful."
msgstr "ورک شیٹ وچ ہک نواں ناں بیان کرو، عالمی یا شیٹ سطح تے۔ اگر ناں پہلے توں موجود ہووے، تاں ایں کوں بغیر خبرداری دے وٹا ݙتا ویندا ہے۔ بݨاوݨ توں بعد، نواں ناں فارمولےآں وچ ورتیا ونڄ سڳدا ہے۔ کامیابی تے <literal>True</literal> واپس کریندا ہے۔"

#. eXCbC
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id991779055771625\n"
"help.text"
msgid "Use <literal>DefinedNames</literal> property to examine existing named ranges."
msgstr "<literal>DefinedNames</literal> خصوصیت ورت کے موجودہ ناں رکھے ڳئے رینجاں دی جانچ کرو۔"

#. hpBBA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id871768164133127\n"
"help.text"
msgid "<emph>definedname</emph>: The name to be created or modified without warning. Note that homonyms may exist, but not in the same sheet and not at global level."
msgstr "<emph>definedname</emph>: بݨایا یا وٹایا ونڄݨ آلا ناں بغیر خبرداری دے۔ نوٹ کرو کہ ہم ناں موجود ہو سڳدے ہن، پر ہکو شیٹ وچ کو تے عالمی سطح تے کو۔"

#. Cpfip
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id671768067295921\n"
"help.text"
msgid "<emph>value</emph>: The new name as:"
msgstr "<emph>value</emph>: نواں ناں ایں طرح:"

#. GJ9KG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id281769156503337\n"
"help.text"
msgid "a range reference as a string, often a single cell"
msgstr "ہک رینج دا حوالہ سٹرنگ طور تے، اکثر ہک اکیلا سیل"

#. Byy9B
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id281768067503337\n"
"help.text"
msgid "a scalar value as a number or a string"
msgstr "ہک سکیلر قیمت عدد یا سٹرنگ طور تے"

#. kH4xH
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id281768056613337\n"
"help.text"
msgid "a formula starting with the \"=\" sign"
msgstr "ہک فارمولا جیڑھا \"=\" نشان نال شروع تھیندا ہے"

#. 3d92T
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id501769173466354\n"
"help.text"
msgid "When <literal>Value</literal> is a range, the top-left cell is set as reference cell."
msgstr "جݙاں <literal>Value</literal> ہک رینج ہووے، تاں اُتے کھٻا سیل حوالہ سیل طور تے سیٹ کیتا ویندا ہے۔"

#. ZKAmj
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id971768167327357\n"
"help.text"
msgid "<emph>sheetname</emph>: The defined name scope is that of the specified sheet. The \"~\" shortcut is accepted."
msgstr "<emph>sheetname</emph>: بیان کیتے ڳئے ناں دا دائرہ بیان کیتی ڳئی شیٹ دا ہے۔ \"~\" شارٹ کٹ قبول کیتا ویندا ہے۔"

#. Nr7S4
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id601768068422683\n"
"help.text"
msgid "doc.DefineName(\"NewName\", Sheet := \"Sheet3\", Value := \"H2\")"
msgstr ""

#. WKzbJ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id721768068170406\n"
"help.text"
msgid "doc.DefineName('NewName', sheet = 'Sheet3', value = 'H2')"
msgstr ""

#. S6JvC
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id501623063693113\n"
"help.text"
msgid "Exports the specified range as an image or PDF file."
msgstr "بیان کیتی ڳئی رینج کوں تصویر یا PDF فائل طور تے برآمد کریندا ہے۔"

#. eKaCo
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id401655654738754\n"
"help.text"
msgid "This method returns <literal>True</literal> if the destination file was successfully saved."
msgstr "ایہ طریقہ <literal>True</literal> واپس کریندا ہے اگر منزل فائل کامیابی نال محفوظ کیتی ڳئی ہووے۔"

#. p6Hg5
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id871655655302952\n"
"help.text"
msgid "Hidden rows or columns in the specified range are not exported to the destination file."
msgstr "بیان کیتی ڳئی رینج وچ لکیاں ڳئیاں قطاراں یا کالم منزل فائل تائیں برآمد کائنی کیتے ویندے۔"

#. DpqDV
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id441623090896470\n"
"help.text"
msgid "<emph>range</emph>: A sheet name or a cell range to be exported, as a string."
msgstr "<emph>range</emph>: ہک شیٹ دا ناں یا برآمد کیتی ونڄݨ آلی سیل رینج، سٹرنگ طور تے۔"

#. v5QXP
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id451623063452651\n"
"help.text"
msgid "<emph>filename</emph>: The name of the file to be saved. It must follow the <literal>SF_FileSystem.FileNaming</literal> notation."
msgstr "<emph>filename</emph>: محفوظ کیتی ونڄݨ آلی فائل دا ناں۔ ایں کوں <literal>SF_FileSystem.FileNaming</literal> اشارے دی پیروی کرݨی چاہیدی ہے۔"

#. 3nTsB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id441623090895310\n"
"help.text"
msgid "<emph>imagetype</emph>: Identifies the destination file type. Possible values are \"jpeg\", \"pdf\" (default) and \"png\"."
msgstr "<emph>imagetype</emph>: منزل فائل دی قسم دی شناخت کریندا ہے۔ ممکنہ قیمتاں ہن \"jpeg\"، \"pdf\" (طے شدہ) تے \"png\"۔"

#. Wx3ea
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id441623090896317\n"
"help.text"
msgid "<emph>overwrite</emph>: When set to <literal>True</literal>, the destination file may be overwritten (Default = <literal>False</literal>)."
msgstr "<emph>overwrite</emph>: جݙاں ایں کوں <literal>True</literal> تے سیٹ کیتا ونڄے، تاں منزل فائل کوں وٹایا ونڄ سڳدا ہے (طے شدہ = <literal>False</literal>)۔"

#. twaNW
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id561655655121456\n"
"help.text"
msgid "' Exports the entire sheet as a PDF file"
msgstr ""

#. RRxag
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id991655655060661\n"
"help.text"
msgid "' Exports the range as a PNG file and overwrites the destination file if it exists"
msgstr ""

#. t9CxJ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id551768059444915\n"
"help.text"
msgid "Apply a given number format to a cell or a range of cells."
msgstr "ہک سیل یا سیلاں دی رینج تے ݙتا ڳیا عدد فارمیٹ لاوو۔"

#. GvPT2
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id411768059580525\n"
"help.text"
msgid "The impacted cells may be determined with a filter formula and its scope."
msgstr "متاثر تھیوݨ آلے سیلاں کوں فلٹر فارمولے تے ایں دے دائرے نال طے کیتا ونڄ سڳدا ہے۔"

#. gWTJA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id841768060290225\n"
"help.text"
msgid "<emph>targetrange</emph>: The cell or the range as a string that should receive the format."
msgstr "<emph>targetrange</emph>: سیل یا رینج سٹرنگ طور تے جیں کوں فارمیٹ ملݨا چاہیدا ہے۔"

#. BvGDV
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id991768060908752\n"
"help.text"
msgid "<emph>numberformat</emph>: The format to apply, as a string."
msgstr "<emph>numberformat</emph>: لائے ونڄݨ آلا فارمیٹ، سٹرنگ طور تے۔"

#. mBEwe
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id951768060527854\n"
"help.text"
msgid "<emph>locale</emph>: A la-CO (language-COUNTRY) combination to indicate the used locale. The default locale is the output of the <literal>platform.FormatLocale</literal> property"
msgstr "<emph>locale</emph>: ورتے ونڄݨ آلے لوکیل کوں ظاہر کرݨ کیتے ہک la-CO (زبان-ملک) مجموعہ۔ طے شدہ لوکیل <literal>platform.FormatLocale</literal> خصوصیت دا آؤٹ پٹ ہے۔"

#. 6b8nb
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id3176806070882\n"
"help.text"
msgid "' Format only the cells containing a numeric value."
msgstr ""

#. FgFri
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id741768060809331\n"
"help.text"
msgid "doc.FormatRange(\"SheetX.A1:J30\", \"0,00E+00\", filterformula := \"=IsNumeric(A1)\", filterscope := \"CELL\")"
msgstr ""

#. fiKDA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id281768060928971\n"
"help.text"
msgid "# Format only the cells containing a numeric value."
msgstr ""

#. CSsEU
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id641768060943953\n"
"help.text"
msgid "doc.FormatRange('SheetX.A1:J30', '0,00E+00', filterformula = '=IsNumeric(A1)', filterscope = 'CELL')"
msgstr ""

#. BVKEy
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id501623063693649\n"
"help.text"
msgid "Depending on the parameters provided this method will return:"
msgstr "ݙتے ڳئے پیرامیٹرز تے منحصر، ایہ طریقہ واپس کریسی:"

#. pBZm6
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id611623063742045\n"
"help.text"
msgid "A zero-based Array (or a tuple in Python) with the names of all the forms contained in a given sheet (if the <literal>form</literal> argument is absent)"
msgstr "ݙتی ڳئی شیٹ وچ موجود سارے فارماں دے ناواں آلی صفر توں شروع تھیوݨ آلی صف (یا Python وچ ٹیوپل) (اگر <literal>form</literal> دلیل موجود کو)"

#. FHWZs
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id641623063744536\n"
"help.text"
msgid "A <literal>SFDocuments.Form</literal> service instance representing the form specified as argument."
msgstr "دلیل طور تے بیان کیتے ڳئے فارم کوں ݙکھیندی ہوئی ہک <literal>SFDocuments.Form</literal> سروس مثال۔"

#. YdQaD
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id441623090893210\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the sheet, as a string, from which the form will be retrieved."
msgstr "<emph>sheetname</emph>: اُس شیٹ دا ناں، سٹرنگ طور تے، جتھوں فارم حاصل کیتا ویسی۔"

#. BV8GH
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id451623063459286\n"
"help.text"
msgid "<emph>form</emph>: The name or index corresponding to a form stored in the specified sheet. If this argument is absent, the method will return a list with the names of all forms available in the sheet."
msgstr "<emph>form</emph>: بیان کیتی ڳئی شیٹ وچ محفوظ کیتے ڳئے فارم نال مطابقت رکھݨ آلا ناں یا انڈیکس۔ اگر ایہ دلیل موجود کو، تاں طریقہ شیٹ وچ دستیاب سارے فارماں دے ناواں آلی تندیر واپس کریسی۔"

#. sFFyE
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id251623063305557\n"
"help.text"
msgid "In the following examples, the first line gets the names of all forms stored in \"Sheet1\" and the second line retrieves the <literal>Form</literal> object of the form named \"Form_A\" which is stored in \"Sheet1\"."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ، پہلی سطر \"Sheet1\" وچ محفوظ کیتے ڳئے سارے فارماں دے ناں حاصل کریندی ہے تے ٻئی سطر \"Form_A\" ناں آلے فارم دا <literal>Form</literal> آبجیکٹ حاصل کریندی ہے جیڑھا \"Sheet1\" وچ محفوظ ہے۔"

#. y9kCE
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id401591632726431\n"
"help.text"
msgid "Converts a column number ranging between 1 and 1024 into its corresponding letter (column 'A', 'B', ..., 'AMJ'). If the given column number is outside the allowed range, a zero-length string is returned."
msgstr "1 تے 1024 دے وچکار کالم دے نمبر کوں ایں دے مطابقت رکھݨ آلے حرف وچ بدل ݙیندا ہے (کالم 'A'، 'B'، ...، 'AMJ')۔ اگر ݙتا ڳیا کالم دا نمبر اجازت ݙتی ڳئی حد توں ٻاہر ہووے، تاں صفر لمبائی آلی سٹرنگ واپس کیتی ویندی ہے۔"

#. xi3Ex
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id83159163272628\n"
"help.text"
msgid "<emph>columnnumber</emph>: The column number as an integer value in the interval 1 ... 16384."
msgstr "<emph>columnnumber</emph>: 1 ... 16384 وقفے وچ عددی قیمت طور تے کالم دا نمبر۔"

#. 6yjtp
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id11621539831303\n"
"help.text"
msgid "Displays a message box with the name of the third column, which by default is \"C\"."
msgstr "تیسرے کالم دا ناں رکھݨ آلا سنیہا بکس ݙکھیندا ہے، جیڑھا طے شدہ طور تے \"C\" ہے۔"

#. SyQ5w
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id451611753568778\n"
"help.text"
msgid "The maximum number of columns allowed on a Calc sheet is 16384."
msgstr "Calc شیٹ تے اجازت ݙتے ڳئے کالماں دی ودھ توں ودھ تعداد 16384 ہے۔"

#. ksYoG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id921593880142573\n"
"help.text"
msgid "Get the formula(s) stored in the given range of cells as a single string, a 1D or a 2D array of strings."
msgstr "ݙتی ڳئی سیلاں دی رینج وچ محفوظ کیتے ڳئے فارمولے (فارمولےآں) کوں ہک اکیلی سٹرنگ، 1D یا 2D سٹرنگاں دی صف طور تے حاصل کرو۔"

#. P4bPd
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id291658146319931\n"
"help.text"
msgid "The names of Calc functions used in the returned formulas are expressed in English. Visit the Wiki page <link href=\"https://wiki.documentfoundation.org/Documentation/Calc_Functions/List_of_Functions\">List of Calc Functions</link> for a complete list of Calc functions in English."
msgstr "واپس کیتے ڳئے فارمولےآں وچ ورتے ڳئے Calc فنکشنز دے ناں انگریزی وچ بیان کیتے ویندے ہن۔ انگریزی وچ Calc فنکشنز دی مکمل تندیر کیتے Wiki ورقہ <link href=\"https://wiki.documentfoundation.org/Documentation/Calc_Functions/List_of_Functions\">List of Calc Functions</link> تے ونڄو۔"

#. KDFkQ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id891593880142588\n"
"help.text"
msgid "<emph>range</emph>: The range where to get the formulas from, as a string."
msgstr "<emph>range</emph>: اُس رینج، سٹرنگ طور تے، جتھوں فارمولے حاصل کیتے ونڄݨے ہن۔"

#. tBeSN
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id461611755257141\n"
"help.text"
msgid "The following example returns a 3 by 2 array with the formulas in the range \"A1:B3\" (3 rows by 2 columns):"
msgstr "تھلے ݙتی ڳئی مثال رینج \"A1:B3\" وچ فارمولےآں آلی 3 بائی 2 صف واپس کریندی ہے (3 قطاراں بائی 2 کالم):"

#. AoHGB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id331592231156425\n"
"help.text"
msgid "Get the value(s) stored in the given range of cells as a single value, a 1D array or a 2D array. All values are either doubles or strings."
msgstr "ݙتی ڳئی سیلاں دی رینج وچ محفوظ کیتی ڳئی قیمت (قیمتاں) کوں ہک اکیلی قیمت، 1D صف یا 2D صف طور تے حاصل کرو۔ ساریاں قیمتاں یا تاں ڈبلز ہن یا سٹرنگاں۔"

#. XACNZ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id91592231156434\n"
"help.text"
msgid "<emph>range</emph>: The range where to get the values from, as a string."
msgstr "<emph>range</emph>: اُس رینج، سٹرنگ طور تے، جتھوں قیمتاں حاصل کیتیاں ونڄݨیاں ہن۔"

#. dw2RT
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id991611756492772\n"
"help.text"
msgid "If a cell contains a date, the number corresponding to that date will be returned. To convert numeric values to dates in Basic scripts, use the Basic <link href=\"text/sbasic/shared/03100300.xhp\"><literal>CDate</literal> builtin function</link>. In Python scripts, use the <link href=\"text/sbasic/shared/03/sf_basic.xhp#CDate\"><literal>CDate</literal> function from the <literal>Basic</literal> service.</link>"
msgstr "اگر سیل وچ تریخ موجود ہووے، تاں اُس تریخ نال مطابقت رکھݨ آلا نمبر واپس کیتا ویسی۔ Basic سکرپٹس وچ عددی قیمتاں کوں تریخاں وچ بدلݨ کیتے Basic <link href=\"text/sbasic/shared/03100300.xhp\"><literal>CDate</literal> بلٹ ان فنکشن</link> ورتو۔ Python سکرپٹس وچ <literal>Basic</literal> سروس توں <link href=\"text/sbasic/shared/03/sf_basic.xhp#CDate\"><literal>CDate</literal> فنکشن</link> ورتو۔"

#. YYMuH
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id771593685490395\n"
"help.text"
msgid "Imports the contents of a CSV-formatted text file and places it on a given destination cell."
msgstr "CSV فارمیٹ آلی عبارت فائل دے مواد کوں درآمد کریندا ہے تے ایں کوں ݙتی ڳئی منزل سیل تے رکھیندا ہے۔"

#. cxrHr
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id751611756909199\n"
"help.text"
msgid "The destination area is cleared of all contents and formats before inserting the contents of the CSV file. The size of the modified area is fully determined by the contents of the input file."
msgstr "CSV فائل دے مواد کوں داخل کرݨ توں پہلے منزل علاقے کوں سارے مواد تے فارمیٹاں توں صاف کیتا ویندا ہے۔ وٹائے ڳئے علاقے دا سائز مکمل طور تے ان پٹ فائل دے مواد نال طے تھیندا ہے۔"

#. D2w2A
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id911593685490873\n"
"help.text"
msgid "The method returns a string representing the modified range of cells."
msgstr "ایہ طریقہ وٹائے ڳئے سیلاں دی رینج کوں ݙکھیندی ہوئی سٹرنگ واپس کریندا ہے۔"

#. GrquM
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id851593685490824\n"
"help.text"
msgid "<emph>filename</emph>: Identifies the file to open. It must follow the <literal>SF_FileSystem.FileNaming</literal> notation."
msgstr "<emph>filename</emph>: کھولی ونڄݨ آلی فائل دی شناخت کریندا ہے۔ ایں کوں <literal>SF_FileSystem.FileNaming</literal> اشارے دی پیروی کرݨی چاہیدی ہے۔"

#. VdTtY
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id641593685490936\n"
"help.text"
msgid "<emph>destinationcell</emph>: The destination cell to insert the imported data, as a string. If instead a range is given, only its top-left cell is considered."
msgstr "<emph>destinationcell</emph>: درآمد کیتا ڳیا ڈیٹا داخل کرݨ آلا منزل سیل، سٹرنگ طور تے۔ اگر ایں دی جاء تے رینج ݙتی ونڄے، تاں صرف ایں دا اُتے کھٻا سیل گھدا ویندا ہے۔"

#. BrTfu
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id641593685863838\n"
"help.text"
msgid "<emph>filteroptions</emph>: The arguments for the CSV input filter. The default filter makes following assumptions:"
msgstr "<emph>filteroptions</emph>: CSV ان پٹ فلٹر کیتے دلیلاں۔ طے شدہ فلٹر تھلے ݙتے ڳئے مفروضے بݨیندا ہے:"

#. Mb4c6
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id661593686250471\n"
"help.text"
msgid "The input file encoding is UTF8."
msgstr "ان پٹ فائل دی انکوڈنگ UTF8 ہے۔"

#. CEpDn
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id161593686260876\n"
"help.text"
msgid "The field separator is a comma, a semi-colon or a Tab character."
msgstr "فیلڈ وکھرا کرݨ آلا کوما، سیمی کولن یا Tab حرف ہے۔"

#. CDfys
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id711593686274293\n"
"help.text"
msgid "The string delimiter is the double quote (\")."
msgstr "سٹرنگ وکھرا کرݨ آلا ڈبل واوین (\") ہے۔"

#. qowXx
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id171593686280838\n"
"help.text"
msgid "All lines are included."
msgstr "ساریاں سطراں شامل ہن۔"

#. MBwZg
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id881593686287161\n"
"help.text"
msgid "Quoted strings are formatted as text."
msgstr "واوین رکھݨ آلیاں سٹرنگاں کوں عبارت طور تے فارمیٹ کیتا ویندا ہے۔"

#. bujFG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id161593686293473\n"
"help.text"
msgid "Special numbers are detected."
msgstr "خاص نمبراں کوں پਛاݨیا ویندا ہے۔"

#. TYXKD
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id791593686300499\n"
"help.text"
msgid "All columns are presumed to be texts, except if recognized as valid numbers."
msgstr "سارے کالم عبارتاں سمجھے ویندے ہن، سوائے اگر درست نمبراں طور تے پਛاݨے ونڄن۔"

#. Byno7
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id381593686307406\n"
"help.text"
msgid "The language is English/US, which implies that the decimal separator is \".\" and the thousands separator is \",\"."
msgstr "زبان انگریزی/US ہے، جیں دا مطلب ہے کہ اعشاریہ وکھرا کرݨ آلا \".\" ہے تے ہزاراں وکھرا کرݨ آلا \",\" ہے۔"

#. AXK5G
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id531611757154931\n"
"help.text"
msgid "To learn more about the CSV Filter Options, refer to the <link href=\"text/shared/guide/csv_params.xhp\">CSV Filter Options help page</link>."
msgstr "CSV Filter Options بارے مزید سکھݨ کیتے <link href=\"text/shared/guide/csv_params.xhp\">CSV Filter Options مدد ورقہ</link> دا حوالہ ݙیکھو۔"

#. vPPYx
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id881599568986824\n"
"help.text"
msgid "Imports the contents of a database table, query or resultset, i.e. the result of a SELECT SQL command, inserting it on a destination cell."
msgstr "ڈیٹا بیس ٹیبل، استفسار یا نتیجہ سیٹ دے مواد کوں درآمد کریندا ہے، یعنی SELECT SQL کمانڈ دا نتیجہ، ایں کوں منزل سیل تے داخل کر کے۔"

#. DorV6
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id81611763957509\n"
"help.text"
msgid "The destination area is cleared of all contents and formats before inserting the imported contents. The size of the modified area is fully determined by the contents in the table or query."
msgstr "درآمد کیتے ڳئے مواد کوں داخل کرݨ توں پہلے منزل علاقے کوں سارے مواد تے فارمیٹاں توں صاف کیتا ویندا ہے۔ وٹائے ڳئے علاقے دا سائز مکمل طور تے ٹیبل یا استفسار وچ موجود مواد نال طے تھیندا ہے۔"

#. tfp3o
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id51599568986387\n"
"help.text"
msgid "The method returns <literal>True</literal> when the import was successful."
msgstr "ایہ طریقہ <literal>True</literal> واپس کریندا ہے جݙاں درآمد کامیاب تھیندی ہے۔"

#. rgoAd
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id311599568986784\n"
"help.text"
msgid "<emph>filename</emph>: Identifies the file to open. It must follow the <literal>SF_FileSystem.FileNaming</literal> notation."
msgstr "<emph>filename</emph>: کھولی ونڄݨ آلی فائل دی شناخت کریندا ہے۔ ایں کوں <literal>SF_FileSystem.FileNaming</literal> اشارے دی پیروی کرݨی چاہیدی ہے۔"

#. j2J5e
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id711596555746281\n"
"help.text"
msgid "<emph>registrationname</emph>: The name to use to find the database in the databases register. This argument is ignored if a <literal>filename</literal> is provided."
msgstr "<emph>registrationname</emph>: ڈیٹا بیسز رجسٹر وچ ڈیٹا بیس کوں ڳولݨ کیتے ورتے ونڄݨ آلا ناں۔ اگر <literal>filename</literal> ݙتی ونڄے تاں ایں دلیل کوں نظر انداز کیتا ویندا ہے۔"

#. 2hSHw
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id211599568986329\n"
"help.text"
msgid "<emph>destinationcell</emph>: The destination of the imported data, as a string. If a range is given, only its top-left cell is considered."
msgstr "<emph>destinationcell</emph>: درآمد کیتے ڳئے ڈیٹا دی منزل، سٹرنگ طور تے۔ اگر رینج ݙتی ونڄے، تاں صرف ایں دا اُتے کھٻا سیل گھدا ویندا ہے۔"

#. aMfVw
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id451599489278429\n"
"help.text"
msgid "<emph>sqlcommand</emph>: A table or query name (without surrounding quotes or square brackets) or a SELECT SQL statement in which table and field names may be surrounded by square brackets or quotes to improve its readability."
msgstr "<emph>sqlcommand</emph>: ہک ٹیبل یا استفسار دا ناں (آس پاس آلے واوین یا چوکور قوسین توں بغیر) یا ہک SELECT SQL بیان جیں وچ ٹیبل تے فیلڈاں دے ناں ایں دی پڑھݨ جوگی کوں بہتر بݨاوݨ کیتے چوکور قوسین یا واوین نال گھرے ونڄ سڳدے ہن۔"

#. wFpLr
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id271599489278141\n"
"help.text"
msgid "<emph>directsql</emph>: When <literal>True</literal>, the SQL command is sent to the database engine without pre-analysis. Default is <literal>False</literal>. The argument is ignored for tables. For queries, the applied option is the one set when the query was defined."
msgstr "<emph>directsql</emph>: جݙاں <literal>True</literal> ہووے، تاں SQL کمانڈ کوں بغیر پہلے تجزیے دے ڈیٹا بیس انجن تائیں بھیڄا ویندا ہے۔ طے شدہ <literal>False</literal> ہے۔ ٹیبلاں کیتے دلیل کوں نظر انداز کیتا ویندا ہے۔ استفساراں کیتے، لایا ڳیا اختیار اُو ہے جیڑھا استفسار دی وضاحت کرݨ ویلے سیٹ کیتا ڳیا ہا۔"

#. toj8z
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id121591698472929\n"
"help.text"
msgid "Inserts a new empty sheet before an existing sheet or at the end of the list of sheets."
msgstr "موجودہ شیٹ توں پہلے یا شیٹاں دی تندیر دے آخر وچ ہک نویں خالی شیٹ داخل کریندا ہے۔"

#. Xbm7k
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id941591698472748\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the new sheet."
msgstr "<emph>sheetname</emph>: نویں شیٹ دا ناں۔"

#. XbXNM
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id84159169847269\n"
"help.text"
msgid "<emph>beforesheet</emph>: The name (string) or index (numeric, starting from 1) of the sheet before which to insert the new sheet. This argument is optional and the default behavior is to insert the sheet at the last position."
msgstr "<emph>beforesheet</emph>: اُس شیٹ دا ناں (سٹرنگ) یا انڈیکس (عددی، 1 توں شروع تھیندے ہوئے) جیں توں پہلے نویں شیٹ کوں داخل کرݨا ہے۔ ایہ دلیل اختیاری ہے تے طے شدہ رویہ ایہ ہے کہ شیٹ کوں چھیکڑی جاہ تے جوڑا ونڄے۔"

#. UCmit
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id241611764359510\n"
"help.text"
msgid "The following example inserts a new empty sheet named \"SheetX\" and places it before \"SheetY\":"
msgstr "تھلے ݙتی ڳئی مثال \"SheetX\" ناں آلی نویں خالی شیٹ داخل کریندی ہے تے ایں کوں \"SheetY\" توں پہلے رکھیندی ہے:"

#. Ycwmx
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id121591698472935\n"
"help.text"
msgid "Returns the string representing the intersection between the two input ranges, or a zero-length string when the intersection is empty."
msgstr "ݙوہاں ان پٹ رینجاں دے وچکار تقاطع کوں ݙکھیندی ہوئی سٹرنگ واپس کریندا ہے، یا صفر لمبائی آلی سٹرنگ جݙاں تقاطع خالی ہووے۔"

#. MWg4G
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id94159169572749\n"
"help.text"
msgid "<emph>range1</emph>: The address string of range 1."
msgstr "<emph>range1</emph>: رینج 1 دے پتے دی سٹرنگ۔"

#. 3KE6z
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id86159169847269\n"
"help.text"
msgid "<emph>range2</emph>: The address string of range 2."
msgstr "<emph>range2</emph>: رینج 2 دے پتے دی سٹرنگ۔"

#. DBoWA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id241613764759510\n"
"help.text"
msgid "The following example intersects two ranges, and returns the common range between both of them:"
msgstr "تھلے ݙتی ڳئی مثال ݙوہاں رینجاں کوں تقاطع کریندی ہے، تے ݙوہاں دے وچکار عام رینج واپس کریندی ہے:"

#. C5mcx
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id531755867365961\n"
"help.text"
msgid "Print commonrange ' displays \"$Sheet1.$C$3:$D$4\""
msgstr ""

#. YwWpB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id631755867515226\n"
"help.text"
msgid "print(common_range)  # outputs '$Sheet1.$C$3:$D$4' to the Python shell"
msgstr ""

#. DcrWC
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id6415925694762\n"
"help.text"
msgid "Moves a specified source range to a destination range of cells. The method returns a string representing the modified range of cells. The dimension of the modified area is fully determined by the size of the source area."
msgstr "بیان کیتی ڳئی ماخذ رینج کوں سیلاں دی منزل رینج تائیں منتقل کریندا ہے۔ ایہ طریقہ وٹائے ڳئے سیلاں دی رینج کوں ݙکھیندی ہوئی سٹرنگ واپس کریندا ہے۔ وٹائے ڳئے علاقے دا طول مکمل طور تے ماخذ علاقے دے سائز نال طے تھیندا ہے۔"

#. UqxZv
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id571592569476332\n"
"help.text"
msgid "<emph>source</emph>: The source range of cells, as a string."
msgstr "<emph>source</emph>: سیلاں دی ماخذ رینج، سٹرنگ طور تے۔"

#. G6BSW
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id891592569476362\n"
"help.text"
msgid "<emph>destination</emph>: The destination cell, as a string. If a range is given, its top-left cell is considered as the destination."
msgstr "<emph>destination</emph>: منزل سیل، سٹرنگ طور تے۔ اگر رینج ݙتی ونڄے، تاں ایں دا اُتے کھٻا سیل منزل طور تے گھدا ویندا ہے۔"

#. NorEd
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id831591698903829\n"
"help.text"
msgid "Moves an existing sheet and places it before a specified sheet or at the end of the list of sheets."
msgstr "موجودہ شیٹ کوں منتقل کریندا ہے تے ایں کوں بیان کیتی ڳئی شیٹ توں پہلے یا شیٹاں دی تندیر دے آخر وچ رکھیندا ہے۔"

#. dgAxB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id351591698903911\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the sheet to move. The sheet must exist or an exception is raised."
msgstr "<emph>sheetname</emph>: منتقل کیتی ونڄݨ آلی شیٹ دا ناں۔ شیٹ دا موجود ہووݨا ضروری ہے ورنہ مستثنیٰ اٹھایا ویندا ہے۔"

#. fevuS
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id9159169890334\n"
"help.text"
msgid "<emph>beforesheet</emph>: The name (string) or index (numeric, starting from 1) of the sheet before which the original sheet will be placed. This argument is optional and the default behavior is to move the sheet to the last position."
msgstr "<emph>beforesheet</emph>: اُس شیٹ دا ناں (سٹرنگ) یا انڈیکس (عددی، 1 توں شروع تھیندے ہوئے) جیں توں پہلے اصل شیٹ رکھی ویسی۔ ایہ دلیل اختیاری ہے تے طے شدہ رویہ ایہ ہے کہ شیٹ کوں چھیکڑی جاہ تے منتقل کیتا ونڄے۔"

#. pd5t4
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id951611766058734\n"
"help.text"
msgid "The example below moves the existing sheet \"SheetX\" and places it before \"SheetY\":"
msgstr "تھلے ݙتی ڳئی مثال موجودہ شیٹ \"SheetX\" کوں منتقل کریندی ہے تے ایں کوں \"SheetY\" توں پہلے رکھیندی ہے:"

#. Q9iwN
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id51592233506371\n"
"help.text"
msgid "Returns a new range (as a string) offset by a certain number of rows and columns from a given range."
msgstr "ݙتی ڳئی رینج توں کجھ قطاراں تے کالماں نال وٹائی ڳئی ہک نویں رینج (سٹرنگ طور تے) واپس کریندا ہے۔"

#. AgdZe
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id61611768400376\n"
"help.text"
msgid "This method has the same behavior as the homonymous Calc's <link href=\"text/scalc/01/04060109.xhp\">Offset function</link>."
msgstr "ایں طریقے دا ہکو جہاں رویہ ہے جیویں ہم ناں Calc دے <link href=\"text/scalc/01/04060109.xhp\">Offset فنکشن</link> دا ہے۔"

#. G2oD2
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id901592233506293\n"
"help.text"
msgid "<emph>reference</emph>: The range, as a string, that the method will use as reference to perform the offset operation."
msgstr "<emph>reference</emph>: اُس رینج، سٹرنگ طور تے، جیڑھی طریقہ وٹاؤ عمل کرݨ کیتے حوالے طور تے ورتیسی۔"

#. Ra7aW
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id781592234124856\n"
"help.text"
msgid "<emph>rows</emph>: The number of rows by which the initial range is offset upwards (negative value) or downwards (positive value). Use 0 (default) to stay in the same row."
msgstr "<emph>rows</emph>: قطاراں دی تعداد جیں نال شروعاتی رینج کوں اُتے (منفی قیمت) یا تھلوں (مثبت قیمت) وٹایا ویندا ہے۔ ہکو قطار وچ رہݨ کیتے 0 (طے شدہ) ورتو۔"

#. FvqjV
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id971592234138769\n"
"help.text"
msgid "<emph>columns</emph>: The number of columns by which the initial range is offset to the left (negative value) or to the right (positive value). Use 0 (default) to stay in the same column."
msgstr "<emph>columns</emph>: کالماں دی تعداد جیں نال شروعاتی رینج کوں کھٻے (منفی قیمت) یا سڄے (مثبت قیمت) وٹایا ویندا ہے۔ ہکو کالم وچ رہݨ کیتے 0 (طے شدہ) ورتو۔"

#. VzgGM
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id321592234150061\n"
"help.text"
msgid "<emph>height</emph>: The vertical height for an area that starts at the new range position. Omit this argument when no vertical resizing is needed."
msgstr "<emph>height</emph>: اُس علاقے دی عمودی اچائی جیڑھا نویں رینج دی جاہ توں شروع تھیندا ہے۔ جݙاں کوئی عمودی سائز وٹاوݨ دی ضرورت کو تاں ایں دلیل کوں چھڈ ݙیوو۔"

#. JxENN
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id271592234165247\n"
"help.text"
msgid "<emph>width</emph>: The horizontal width for an area that starts at the new range position. Omit this argument when no horizontal resizing is needed."
msgstr "<emph>width</emph>: اُس علاقے دی افقی چوڑائی جیڑھا نویں رینج دی جاہ توں شروع تھیندا ہے۔ جݙاں کوئی افقی سائز وٹاوݨ دی ضرورت کو تاں ایں دلیل کوں چھڈ ݙیوو۔"

#. t9QDN
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id871592234172652\n"
"help.text"
msgid "Arguments <literal>rows</literal> and <literal>columns</literal> must not lead to zero or negative start row or column."
msgstr "دلیلاں <literal>rows</literal> تے <literal>columns</literal> کوں صفر یا منفی شروعاتی قطار یا کالم تائیں نہیں ݙیوݨا چاہیدا۔"

#. JAxEm
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id211592234180073\n"
"help.text"
msgid "Arguments <literal>height</literal> and <literal>width</literal> must not lead to zero or negative count of rows or columns."
msgstr "دلیلاں <literal>height</literal> تے <literal>width</literal> کوں قطاراں یا کالماں دی صفر یا منفی تعداد تائیں نہیں ݙیوݨا چاہیدا۔"

#. BkCDz
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id651592234465732\n"
"help.text"
msgid "'SheetX.$C$3 (A1 moved by two rows and two columns down)"
msgstr ""

#. 8ukCQ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id521592234478848\n"
"help.text"
msgid "'SheetX.$C$3:$H$7 (A1 offset by two rows and columns with width of 5 rows and 6 columns)"
msgstr ""

#. GwPQh
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id51592233506021\n"
"help.text"
msgid "Opens a non-modal dialog that can be used to select a range in the document and returns a string containing the selected range."
msgstr "ہک غیر موڈل ڈائیلاگ کھولدا ہے جیڑھا دستاویز وچ رینج چُݨݨ کیتے ورتیا ونڄ سڳدا ہے تے چُݨی ڳئی رینج رکھݨ آلی سٹرنگ واپس کریندا ہے۔"

#. CWn2A
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id301637936295380\n"
"help.text"
msgid "This method opens the same dialog that is used by %PRODUCTNAME when the Shrink button is pressed. For example, the <menuitem>Tools - Goal Seek</menuitem> dialog has a Shrink button to the right of the <menuitem>Formula cell</menuitem> field."
msgstr "ایہ طریقہ ہکو جہاں ڈائیلاگ کھولدا ہے جیڑھا %PRODUCTNAME ولوں ورتیا ویندا ہے جݙاں Shrink بٹن دبایا ویندا ہے۔ مثال طور تے، <menuitem>Tools - Goal Seek</menuitem> ڈائیلاگ وچ <menuitem>Formula cell</menuitem> فیلڈ دے سڄے پاسے ہک Shrink بٹن ہے۔"

#. XUoah
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id551637936545121\n"
"help.text"
msgid "This method does not change the current selection."
msgstr "ایہ طریقہ موجودہ چُݨو کوں وٹاوݨا کائنی۔"

#. tAHiV
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id901592233506001\n"
"help.text"
msgid "<emph>title</emph>: The title of the dialog, as a string."
msgstr "<emph>title</emph>: ڈائیلاگ دا عنوان، سٹرنگ طور تے۔"

#. Yyn74
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id781592234124502\n"
"help.text"
msgid "<emph>selection</emph>: An optional range that is initially selected when the dialog is displayed."
msgstr "<emph>selection</emph>: ہک اختیاری رینج جیڑھی شروع وچ چُݨی ڳئی ہوندی ہے جݙاں ڈائیلاگ ݙکھایا ونڄے۔"

#. zo7VK
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id971592234138989\n"
"help.text"
msgid "<emph>singlecell</emph>: When <literal>True</literal> (default) only single-cell selection is allowed. When <literal>False</literal> range selection is allowed."
msgstr "<emph>singlecell</emph>: جݙاں <literal>True</literal> ہووے (طے شدہ) تاں صرف اکیلے سیل دے چُݨو دی اجازت ہے۔ جݙاں <literal>False</literal> ہووے تاں رینج دے چُݨو دی اجازت ہے۔"

#. SqEWv
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id321592234150345\n"
"help.text"
msgid "<emph>closeafterselect</emph>: When <literal>True</literal> (default) the dialog is closed immediately after the selection is made. When <literal>False</literal> the user can change the selection as many times as needed and then manually close the dialog."
msgstr "<emph>closeafterselect</emph>: جݙاں <literal>True</literal> ہووے (طے شدہ) تاں چُݨو کرݨ توں فوراً بعد ڈائیلاگ بند تھی ویندا ہے۔ جݙاں <literal>False</literal> ہووے تاں ورتکار چُݨو کوں جتنی واری ضرورت ہووے اتنی واری وٹا سڳدا ہے تے پھر ہتھ نال ڈائیلاگ بند کر سڳدا ہے۔"

#. yDiCm
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id51592233503441\n"
"help.text"
msgid "Returns the input string after substituting its token characters by their values in a given range."
msgstr "ان پٹ سٹرنگ کوں ݙتی ڳئی رینج وچ ایہناں دیاں قیمتاں نال ٹوکن حرفاں کوں وٹا کے واپس کریندا ہے۔"

#. Qu4DK
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id551637936596521\n"
"help.text"
msgid "This method does not change the current selection."
msgstr "ایہ طریقہ موجودہ چُݨو کوں وٹاوݨا کائنی۔"

#. eEqCY
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id171637938442558\n"
"help.text"
msgid "This method can be used to quickly extract specific parts of a range name, such as the sheet name or first cell column and row, and use them to compose a new range address."
msgstr "ایہ طریقہ رینج دے ناں دے خاص حصیاں کوں جلدی کڈھݨ کیتے ورتیا ونڄ سڳدا ہے، جیویں شیٹ دا ناں یا پہلے سیل دا کالم تے قطار، تے ایہناں کوں نواں رینج پتہ بݨاوݨ کیتے ورتیا ونڄ سڳدا ہے۔"

#. RAAVz
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id901592233506232\n"
"help.text"
msgid "<emph>inputstr</emph>: The string containing the tokens that will be replaced by the corresponding values in <literal>range</literal>."
msgstr "<emph>inputstr</emph>: ٹوکناں رکھݨ آلی سٹرنگ جیڑھے <literal>range</literal> وچ مطابقت رکھݨ آلیاں قیمتاں نال وٹائے ویندے ہن۔"

#. NJdUy
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id781592234161102\n"
"help.text"
msgid "<emph>range</emph>: A <literal>RangeName</literal> from which values will be extracted. If it contains a sheet name, the sheet must exist."
msgstr "<emph>range</emph>: ہک <literal>RangeName</literal> جتھوں قیمتاں کڈھیاں ویندیاں ہن۔ اگر ایں وچ شیٹ دا ناں موجود ہووے، تاں شیٹ دا موجود ہووݨا ضروری ہے۔"

#. BgCCD
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id971592234102889\n"
"help.text"
msgid "<emph>tokencharacter</emph>: Character used to identify tokens. By default \"%\" is the token character. The following tokens are accepted:"
msgstr "<emph>tokencharacter</emph>: ٹوکناں دی شناخت کیتے ورتیا ونڄݨ آلا حرف۔ طے شدہ طور تے \"%\" ٹوکن حرف ہے۔ تھلے ݙتے ڳئے ٹوکن قبول کیتے ویندے ہن:"

#. WTDwR
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id261637943912156\n"
"help.text"
msgid "<emph>%S</emph> - The sheet name containing the range, including single quotes when necessary."
msgstr "<emph>%S</emph> - رینج رکھݨ آلی شیٹ دا ناں، ضرورت ہووݨ تے اکیلے واوین شامل کر کے۔"

#. YHLeU
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id441637943912380\n"
"help.text"
msgid "<emph>%R1</emph> - The row number of the top left cell of the range."
msgstr "<emph>%R1</emph> - رینج دے اُتے کھٻے سیل دی قطار دا نمبر۔"

#. joJi7
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id521637943912620\n"
"help.text"
msgid "<emph>%C1</emph> - The column letter of the top left cell of the range."
msgstr "<emph>%C1</emph> - رینج دے اُتے کھٻے سیل دے کالم دا حرف۔"

#. YAfmV
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id371637943912860\n"
"help.text"
msgid "<emph>%R2</emph> - The row number of the bottom right cell of the range."
msgstr "<emph>%R2</emph> - رینج دے تھلے سڄے سیل دی قطار دا نمبر۔"

#. imuBD
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id291637943913116\n"
"help.text"
msgid "<emph>%C2</emph> - The column letter of the bottom right cell of the range."
msgstr "<emph>%C2</emph> - رینج دے تھلے سڄے سیل دے کالم دا حرف۔"

#. gpmpG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id941637943467476\n"
"help.text"
msgid "The example below extracts each element of the <literal>RangeName</literal> defined in <literal>sRange</literal> and uses them to compose a message."
msgstr "تھلے ݙتی ڳئی مثال <literal>RangeName</literal> دے ہر عنصر کوں کڈھدی ہے جیڑھا <literal>sRange</literal> وچ بیان کیتا ڳیا ہے تے ایہناں کوں سنیہا بݨاوݨ کیتے ورتیندی ہے۔"

#. nbJ59
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id241637944350648\n"
"help.text"
msgid "The <literal>Printf</literal> method can be combined with <literal>SetFormula</literal> to create formulas over multiple cells. For instance, consider a table with numeric values in the range \"A1:E10\" from which formulas are to be created to sum the values in each row and place the results in the range \"F1:F10\":"
msgstr "<literal>Printf</literal> طریقہ <literal>SetFormula</literal> نال ملا کے ورتیا ونڄ سڳدا ہے تاکہ کئی سیلاں تے فارمولے بݨائے ونڄن۔ مثال طور تے، رینج \"A1:E10\" وچ عددی قیمتاں آلی ہک ٹیبل تے غور کرو جتھوں ہر قطار وچ قیمتاں دا مجموعہ کرݨ کیتے فارمولے بݨائے ونڄݨے ہن تے نتیجے رینج \"F1:F10\" وچ رکھے ونڄݨے ہن۔"

#. foAvd
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id371637944971921\n"
"help.text"
msgid "' Note the use of the \"$\" character"
msgstr ""

#. wBpRw
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id156589200121138\n"
"help.text"
msgid "This method sends the contents of the given sheet to the default printer or to the printer defined by the <literal>SetPrinter</literal> method of the <literal>Document</literal> service."
msgstr "ایہ طریقہ ݙتی ڳئی شیٹ دے مواد کوں طے شدہ پرنٹر تائیں یا اُس پرنٹر تائیں بھیڄدا ہے جیڑھا <literal>Document</literal> سروس دے <literal>SetPrinter</literal> طریقے ولوں بیان کیتا ڳیا ہے۔"

#. BaDL9
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id981611169416934\n"
"help.text"
msgid "Returns <literal>True</literal> if the sheet was successfully printed."
msgstr "اگر شیٹ کامیابی نال چھاپی ڳئی ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. CnNEC
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id368519200121646\n"
"help.text"
msgid "<emph>sheetname</emph>: The sheet to print, default is the active sheet."
msgstr "<emph>sheetname</emph>: چھاپݨ آلی شیٹ، طے شدہ فعال شیٹ ہے۔"

#. xk3k3
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id211635436910093\n"
"help.text"
msgid "<emph>pages</emph>: The pages to print as a string, like in the user interface. Example: \"1-4;10;15-18\". Default is all pages."
msgstr "<emph>pages</emph>: چھاپݨ آلے ورقے سٹرنگ طور تے، جیویں ورتکار انٹرفیس وچ۔ مثال: \"1-4;10;15-18\"۔ طے شدہ سارے ورقے ہن۔"

#. DBFDA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id141635436912146\n"
"help.text"
msgid "<emph>copies</emph>: The number of copies. Default is 1."
msgstr "<emph>copies</emph>: کاپیاں دی تعداد۔ طے شدہ 1 ہے۔"

#. 64f3B
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id661591699086251\n"
"help.text"
msgid "Removes duplicate rows from a specified range. The comparison to determine if a given row is a duplicate is done based on a subset of columns in the range."
msgstr "بیان کیتی ڳئی رینج توں نقل قطاراں کوں ہٹا ݙیندا ہے۔ ایہ طے کرݨ کیتے مقابلہ کہ ݙتی ڳئی قطار نقل ہے یا کو، رینج وچ کالماں دے ہک ذیلی سیٹ دی بنیاد تے کیتا ویندا ہے۔"

#. 2Fj4F
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id111674511007536\n"
"help.text"
msgid "This method returns a string containing the resulting range."
msgstr "ایہ طریقہ نتیجے وچ ملݨ آلی رینج رکھݨ آلی سٹرنگ واپس کریندا ہے۔"

#. py5XZ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id831674511881468\n"
"help.text"
msgid "The removal of duplicate rows is done starting at the first row in the range moving downwards, meaning that if two or more rows are duplicates then only the first one is kept."
msgstr "نقل قطاراں کوں ہٹاوݨا رینج وچ پہلی قطار توں شروع کر کے تھلوں ونڄݨ نال کیتا ویندا ہے، ایں دا مطلب ہے کہ اگر ݙو یا ودھ قطاراں نقل ہون تاں صرف پہلی کوں رکھیا ویندا ہے۔"

#. UxCsB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id331591699082900\n"
"help.text"
msgid "<emph>range</emph>: The range from which duplicates will be removed, as a string."
msgstr "<emph>range</emph>: اُس رینج، سٹرنگ طور تے، جتھوں نقل ہٹائے ویندے ہن۔"

#. WBeEc
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id331591699082848\n"
"help.text"
msgid "<emph>columns</emph>: An array containing column numbers indicating which columns will be considered to determine if a row is a duplicate or not. If this argument is left blank, then only the first column is used. Items in this array must be in the interval between 1 and the range width."
msgstr "<emph>columns</emph>: کالماں دے نمبراں رکھݨ آلی صف جیڑھی ݙکھیندی ہے کہ کیڑھے کالم غور کیتے ویندے ہن ایہ طے کرݨ کیتے کہ قطار نقل ہے یا کو۔ اگر ایہ دلیل خالی چھڈ ݙتی ونڄے، تاں صرف پہلا کالم ورتیا ویندا ہے۔ ایں صف وچ موجود چیزاں کوں 1 تے رینج دی چوڑائی دے وچکار وقفے وچ ہووݨا چاہیدا ہے۔"

#. C4DUZ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id331591699082147\n"
"help.text"
msgid "<emph>header</emph>: Specifies whether the first row is a header row (Default = <literal>False</literal>)."
msgstr "<emph>header</emph>: بیان کریندا ہے کہ کیا پہلی قطار ہیڈر قطار ہے (طے شدہ = <literal>False</literal>)۔"

#. sFJ5x
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id331591699082231\n"
"help.text"
msgid "<emph>casesensitive</emph>: Specifies whether string comparisons are case-sensitive (Default = <literal>False</literal>)."
msgstr "<emph>casesensitive</emph>: بیان کریندا ہے کہ کیا سٹرنگاں دے مقابلے کیس حساس ہن (طے شدہ = <literal>False</literal>)۔"

#. zhBuK
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id331591699082446\n"
"help.text"
msgid "<emph>mode</emph>: Specifies what to do with duplicate rows. If <literal>mode = \"CLEAR\"</literal> then duplicates are simply removed from the sheet leaving the cells blank. If <literal>mode = \"COMPACT\"</literal> then duplicates are removed and empty rows are compacted up (Default = <literal>\"COMPACT\"</literal>)."
msgstr "<emph>mode</emph>: بیان کریندا ہے کہ نقل قطاراں نال کیا کرݨا ہے۔ اگر <literal>mode = \"CLEAR\"</literal> ہووے تاں نقلاں کوں شیٹ توں صرف ہٹا ݙتا ویندا ہے تے سیل خالی رہ ویندے ہن۔ اگر <literal>mode = \"COMPACT\"</literal> ہووے تاں نقلاں کوں ہٹا ݙتا ویندا ہے تے خالی قطاراں کوں اُتے گھٹا ݙتا ویندا ہے (طے شدہ = <literal>\"COMPACT\"</literal>)۔"

