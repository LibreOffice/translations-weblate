#. zU2uu
#: sf_datasheet.xhp
msgctxt ""
"sf_datasheet.xhp\n"
"par_id801916099747090\n"
"help.text"
msgid "Removes a menu entry from the data view by its name."
msgstr "Data View وچوں مینیو انٹری کوں اوندے ناں نال ہٹا ݙیندا ہے۔"

#. FhSiD
#: sf_datasheet.xhp
msgctxt ""
"sf_datasheet.xhp\n"
"par_id511671106735805\n"
"help.text"
msgid "This method can remove menus that belong to the standard user interface as well as menus that were programmatically added with the <literal>CreateMenu</literal> method. The removal of standard menus is not permanent and they will reappear after the window is closed and reopened."
msgstr "ایں طریقے نال معیاری ورتکار انٹرفیس نال تعلق رکھݨ آلیاں مینیوآں دے نال نال اوہ مینیوآں وی ہٹائیاں ونڄ سڳدن جیڑھیاں <literal>CreateMenu</literal> طریقے نال پروگرام دے طور تے شامل کیتیاں ڳئیاں ہن۔ معیاری مینیوآں کوں ہٹاوݨ مستقل کائنی تے ونڈو بند کرݨ تے ولا کھولݨ دے بعد اوہ ولا ظاہر تھی ویسن۔"

#. ED3Co
#: sf_datasheet.xhp
msgctxt ""
"sf_datasheet.xhp\n"
"par_id941619079997083\n"
"help.text"
msgid "<emph>menuheader:</emph> The case-sensitive name of the menu to be removed. The name must not include the tilde (\"~\") character."
msgstr "<emph>menuheader:</emph> ہٹاوݨ آلی مینیو دا کیس حساس ناں۔ ناں وچ ٹیلڈ (\"~\") حرف شامل کائنی ہووݨا چاہیدا۔"

#. BC4Sc
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"tit\n"
"help.text"
msgid "SFDialogs.Dialog service"
msgstr "SFDialogs.Dialog سروس"

#. ZQBAD
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"bm_id781582391760253\n"
"help.text"
msgid "<variable id=\"dlg_h1\"><link href=\"text/sbasic/shared/03/sf_dialog.xhp\"><literal>SFDialogs</literal>.<literal>Dialog</literal> service</link></variable>"
msgstr ""

#. tvCua
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id931583589764919\n"
"help.text"
msgid "The <literal>Dialog</literal> service contributes to the management of dialogs created with the Basic <link href=\"text/sbasic/guide/create_dialog.xhp\">Dialog Editor</link> or dialogs created on-the-fly. Each instance of the current class represents a single dialog box displayed to the user."
msgstr "<literal>Dialog</literal> سروس Basic <link href=\"text/sbasic/guide/create_dialog.xhp\">Dialog Editor</link> نال بݨائے ڳئے ڈائیلاگاں یا اُتے دی اُتے بݨائے ڳئے ڈائیلاگاں دے انتظام وچ حصہ پیندی ہے۔ موجودہ کلاس دی ہر مثال ورتکار کوں ݙکھائے ونڄݨ آلے ہک ڈائیلاگ بکس کوں ݙکھیندی ہے۔"

#. vxEvV
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id831598110550771\n"
"help.text"
msgid "A dialog box can be displayed in modal or in non-modal modes."
msgstr "ہک ڈائیلاگ بکس موڈل یا غیر موڈل موڈاں وچ ݙکھایا ونڄ سڳدا ہے۔"

#. LVjBj
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id221598110444025\n"
"help.text"
msgid "In modal mode, the box is displayed and the execution of the macro process is suspended until one of the OK or Cancel buttons is pressed. In the meantime, user actions executed on the box can trigger specific actions."
msgstr "موڈل موڈ وچ، بکس ݙکھایا ویندا ہے تے میکرو عملداری کوں معطل کر ݙتا ویندا ہے جݙاں تائیں OK یا Cancel بٹناں وچوں ہک کوں دبایا کائنی ویندا۔ ایں وچالے، بکس تے کیتیاں ڳئیاں ورتکار کارروائیاں مخصوص کارروائیاں کوں شروع کر سڳدن۔"

#. FFTSj
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id981598110463521\n"
"help.text"
msgid "In non-modal mode, the dialog box is \"floating\" on the user desktop and the execution of the macro process continues normally. A non-modal dialog closes when it is terminated with the <literal>Terminate()</literal> method or when the %PRODUCTNAME session ends. The window close button is inactive in non-modal dialogs."
msgstr "غیر موڈل موڈ وچ، ڈائیلاگ بکس ورتکار ڈیسک ٹاپ تے \"تیرݨ آلا\" ہے تے میکرو عملداری معمول دے مطابق جاری رہندی ہے۔ ہک غیر موڈل ڈائیلاگ بند تھی ویندا ہے جݙاں اونکوں <literal>Terminate()</literal> طریقے نال ختم کیتا ویندا ہے یا جݙاں %PRODUCTNAME سیشن ختم تھی ویندا ہے۔ ونڈو بند کرݨ آلا بٹن غیر موڈل ڈائیلاگاں وچ غیر فعال ہوندا ہے۔"

#. GrpyR
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id721598110472337\n"
"help.text"
msgid "A dialog box disappears from memory after its explicit termination."
msgstr "ہک ڈائیلاگ بکس اپݨے واضح خاتمے دے بعد میموری توں غائب تھی ویندا ہے۔"

#. asacX
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id891598188164936\n"
"help.text"
msgid "The <literal>SFDialogs.Dialog</literal> service is closely related to the <literal>SFDialogs.DialogControl</literal> service."
msgstr "<literal>SFDialogs.Dialog</literal> سروس دا <literal>SFDialogs.DialogControl</literal> سروس نال گہرا تعلق ہے۔"

#. CByHp
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"hd_id581582885621841\n"
"help.text"
msgid "Service invocation and usage"
msgstr "سروس بلاوݨ تے ورتݨ"

#. FfZWj
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id141609955500101\n"
"help.text"
msgid "Before using the <literal>Dialog</literal> service the <literal>ScriptForge</literal> library needs to be loaded or imported:"
msgstr "<literal>Dialog</literal> سروس ورتݨ توں پہلے <literal>ScriptForge</literal> لائبریری کوں لوڈ یا درآمد کرݨا پوندا ہے:"

#. EzMcF
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id361598174756160\n"
"help.text"
msgid "The <literal>Dialog</literal> service is invoked through the <literal>CreateScriptService</literal> method. It requires three supplemental positional arguments to specify the dialog box to activate:"
msgstr "<literal>Dialog</literal> سروس <literal>CreateScriptService</literal> طریقے دے ذریعے بلائی ویندی ہے۔ ایندی وجہ توں ڈائیلاگ بکس کوں فعال کرݨ کیتے ترائے اضافی پوزیشنل دلیلاں دی لوڑ ہے:"

#. KyBGV
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id31612271944733\n"
"help.text"
msgid "<emph>Container</emph>: \"<link href=\"text/sbasic/shared/03131900.xhp\"><literal>GlobalScope</literal></link>\" for preinstalled libraries or a window name as defined by <link href=\"text/sbasic/shared/03/sf_ui.xhp\"><literal>ScriptForge.UI</literal></link> service. Empty string \"\" default value stands for the current document."
msgstr "<emph>Container</emph>: پہلے توں نصب کیتے ڳئے لائبریریاں کیتے \"<link href=\"text/sbasic/shared/03131900.xhp\"><literal>GlobalScope</literal></link>\" یا <link href=\"text/sbasic/shared/03/sf_ui.xhp\"><literal>ScriptForge.UI</literal></link> سروس ولوں بیان کیتی ڳئی ونڈو ناں۔ خالی سٹرنگ \"\" طے شدہ قیمت موجودہ دستاویز کیتے ہے۔"

#. juLgm
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id311612271947124\n"
"help.text"
msgid "<emph>Library</emph>: The case-sensitive name of a library contained in the container. Default value is \"Standard\"."
msgstr "<emph>Library</emph>: کنٹینر وچ موجود لائبریری دا کیس حساس ناں۔ طے شدہ قیمت \"Standard\" ہے۔"

#. FSp5N
#: sf_dialog.xhp
msgctxt ""
"sf_dialog.xhp\n"
"par_id821612271946316\n"
"help.text"
msgid "<emph>DialogName</emph>: A case-sensitive string designating the dialog."
msgstr "<emph>DialogName</emph>: ڈائیلاگ کوں ظاہر کرݨ آلی کیس حساس سٹرنگ۔"

#. L5fJw
