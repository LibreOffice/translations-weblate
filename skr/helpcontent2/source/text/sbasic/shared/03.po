msgctxt ""
"sf_calc.xhp\n"
"bas_id241652271725065\n"
"help.text"
msgid "' Deletes all rows where the sum of values in the row is odd"
msgstr ""

#. zXErV
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id531652271726010\n"
"help.text"
