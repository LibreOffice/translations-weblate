#: sf_ui.xhp
msgctxt ""
"sf_ui.xhp\n"
"par_id381596554849698\n"
"help.text"
msgid "<emph>embeddeddatabase</emph> : Either \"HSQLDB\" (default), \"FIREBIRD\", \"FIREBIRD_EXTERNAL\" or \"CALC\"."
msgstr ""

