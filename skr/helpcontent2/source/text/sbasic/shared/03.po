msgstr "تفصیل"

#. dEUyj
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321612988600163\n"
"help.text"
msgid "The full name of the file including the path without a path separator at the end."
msgstr "فائل دا پورا ناں جیندے وچ راہ شامل ہے تے آخر وچ راہ وکھرا کرݨ آلا کائنی ہے۔"

#. Da76k
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321612988600165\n"
"help.text"
msgid "The full name of the folder including the path. It may or may not contain the ending path separator."
msgstr "فولڈر دا پورا ناں جیندے وچ راہ شامل ہے۔ ایندے وچ چھیکڑی راہ وکھرا کرݨ آلا تھی سڳدا ہے یا کائنی۔"

#. LwB6Z
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321612988600167\n"
"help.text"
msgid "The last component of the <emph>Folder Name</emph> or <emph>File Name</emph> including its extension. This parameter is always expressed using the native format of the operating system."
msgstr "<emph>Folder Name</emph> یا <emph>File Name</emph> دا چھیکڑی جزو جیندے وچ اوندی ایکسٹینشن شامل ہے۔ ایں پیرامیٹر کوں ہر ویلے آپریٹنگ سسٹم دے مقامی فارمیٹ ورتݨ نال ظاہر کیتا ویندا ہے۔"

#. fjYSD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321612988600169\n"
"help.text"
msgid "The last component of the <emph>Folder Name</emph> or <emph>File Name</emph> without its extension."
msgstr "<emph>Folder Name</emph> یا <emph>File Name</emph> دا چھیکڑی جزو جیندے وچ اوندی ایکسٹینشن کائنی ہے۔"

#. 57Aab
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321612988600172\n"
"help.text"
msgid "Any of the above names containing wildcards in its last component. Admitted wildcards are:"
msgstr "اُتے ݙتے ڳئے ناواں وچوں کوئی وی ناں جیندے چھیکڑی جزو وچ وائلڈ کارڈ ہوون۔ منظور شدہ وائلڈ کارڈ ہن:"

#. arzQR
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id851583590809104\n"
"help.text"
msgid "\"?\" represents any single character"
msgstr "\"?\" کِسے ہک حرف کوں ݙکھیندا ہے"

#. wG8Bw
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id161583590819320\n"
"help.text"
msgid "\"*\" represents zero, one, or multiple characters"
msgstr "\"*\" صفر، ہک، یا کئی حرفاں کوں ݙکھیندا ہے"

#. BjZMB
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id911584540527980\n"
"help.text"
msgid "The <literal>FileSystem</literal> service allows to perform operations over multiple files at the same time. By using name patterns, user scripts can copy, move or delete multiple files. Conversely, Basic built-in methods can only handle single files."
msgstr "<literal>FileSystem</literal> سروس ہکے ویلے کئی فائلاں تے کارروائیاں کرݨ دی اجازت ݙیندی ہے۔ ناں نمونے ورتݨ نال، ورتکار سکرپٹ کئی فائلاں دی نقل بݨا سڳدے ہن، اوہناں کوں ہلا سڳدے ہن یا مٹا سڳدے ہن۔ ایندے برعکس، Basic بلٹ ان طریقے صرف ہکلیاں فائلاں کوں سنبھال سڳدے ہن۔"

#. zNCtF
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"hd_id991612918109871\n"
"help.text"
msgid "File Naming Notation"
msgstr "فائل ناں لکھݨ دا طریقہ"

#. ZfsFV
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id791612918141083\n"
"help.text"
msgid "The notation used to express file and folder names, both for arguments and returned values, is defined by the <literal>FileNaming</literal> property of the <literal>FileSystem</literal> service."
msgstr "فائل تے فولڈر ناواں کوں ظاہر کرݨ کیتے ورتی ونڄݨ آلی لکھݨ دا طریقہ، دلیلاں تے واپس کیتیاں ڳئیاں قیمتاں ݙوہاں کیتے، <literal>FileSystem</literal> سروس دی <literal>FileNaming</literal> خصوصیت ولوں بیان کیتی ڳئی ہے۔"

#. wZA9G
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id951612918220255\n"
"help.text"
msgid "In short, the possible representation types are \"URL\" (URL file notation), \"SYS\" (operating system notation) and \"ANY\" (default). See more information <link href=\"text/sbasic/shared/03/sf_filesystem.xhp#properties_toc\">below</link>."
msgstr "مختصر طور تے، ممکن نمائندگی قسماں \"URL\" (URL فائل لکھݨ دا طریقہ)، \"SYS\" (آپریٹنگ سسٹم لکھݨ دا طریقہ) تے \"ANY\" (طے شدہ) ہن۔ ہور معلومات <link href=\"text/sbasic/shared/03/sf_filesystem.xhp#properties_toc\">تھلے</link> ݙیکھو۔"

#. L84BJ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id861583589907100\n"
"help.text"
msgid "An example of the URL notation is <emph>file:///C:/Documents/my_file.odt</emph>. Whenever possible consider using the URL notation because it is a more portable alternative."
msgstr "URL لکھݨ دے طریقے دی ہک مثال <emph>file:///C:/Documents/my_file.odt</emph> ہے۔ جݙاں وی ممکن ہووے URL لکھݨ دے طریقے کوں ورتݨ تے غور کرو کیونکہ ایہ ہک ودھ پورٹیبل متبادل ہے۔"

#. QrDqQ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id931626652451855\n"
"help.text"
msgid "The use of the shortcut \"~\" (tilde), which is common in Linux-based operating systems, is not supported to express a path to a folder and file name. Instead of using <emph>\"~/Documents/my_file.odt\"</emph> use the full path <emph>\"/home/user/Documents/my_file.odt\"</emph>."
msgstr "\"~\" (ٹلڈ) شارٹ کٹ دا ورتݨ، جیڑھا Linux تے مبنی آپریٹنگ سسٹمز وچ عام ہے، ہک فولڈر تے فائل ناں دی راہ ظاہر کرݨ کیتے حمایت کائنی کیتا ویندا۔ <emph>\"~/Documents/my_file.odt\"</emph> ورتݨ دی بجائے پورا راہ <emph>\"/home/user/Documents/my_file.odt\"</emph> ورتو۔"

#. mao7x
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"hd_id581582885621841\n"
"help.text"
msgid "Service invocation"
msgstr "سروس بلاوݨ"

#. Miw3e
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id691612990276070\n"
"help.text"
msgid "The following code snippet invokes the <literal>FileSystem</literal> service. The method <literal>BuildPath</literal> was used as an example."
msgstr "تھلے ݙتا ڳیا کوڈ سنیپٹ <literal>FileSystem</literal> سروس کوں بلیندا ہے۔ <literal>BuildPath</literal> طریقہ مثال دے طور تے ورتیا ڳیا ہا۔"

#. MJbkm
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"hd_id981689594663689\n"
"help.text"
msgid "Accessing the Virtual File System of a Document"
msgstr "ہک دستاویز دے ورچوئل فائل سسٹم تائیں رسائی حاصل کرݨا"

#. LyBAJ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id661689594721047\n"
"help.text"
msgid "%PRODUCTNAME document files are compressed ZIP files that contain the files and folders that represent the actual document contents. While the document is open, it is possible to access this virtual file system, explore its structure, as well as read and create files and folders."
msgstr "%PRODUCTNAME دستاویز فائلاں کمپریسڈ ZIP فائلاں ہن جیڑھیاں اوہ فائلاں تے فولڈر رکھدیاں ہن جیڑھے اصل دستاویز مواد کوں ݙکھیندے ہن۔ جݙاں دستاویز کھلی ہوئی ہووے تاں ایں ورچوئل فائل سسٹم تائیں رسائی حاصل کرݨا، اوندی ساخت کوں ویکھݨا، نال ہی فائلاں تے فولڈراں کوں پڑھݨا تے بݨاوݨا ممکن ہے۔"

#. YHDGU
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id891689594949717\n"
"help.text"
msgid "The following example shows how to create a text file named <literal>myFile.txt</literal> and store it inside the document's virtual file system."
msgstr "تھلے ݙتی ڳئی مثال ݙکھیندی ہے کہ <literal>myFile.txt</literal> ناں دی ہک عبارت فائل کیویں بݨائی ونڄے تے اونکوں دستاویز دے ورچوئل فائل سسٹم اندر محفوظ کیتا ونڄے۔"

#. rsRAs
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"bas_id661689595249846\n"
"help.text"
msgid "' Gets the URL path notation to the root of the virtual file system"
msgstr ""

#. TG5wG
