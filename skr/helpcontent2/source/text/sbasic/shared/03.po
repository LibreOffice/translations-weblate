msgstr "ہا"

#. KsJ8e
#: sf_document.xhp
msgctxt ""
"sf_document.xhp\n"
"par_id941589194571044\n"
"help.text"
msgid "Returns a string with the URL path to the root of the virtual file system of the document. Use the <literal>FileSystem</literal> service to view its contents, as well as to create, open and read files stored in it."
msgstr "دستاویز دے ورچوئل فائل سسٹم دی جڑھ تائیں URL راہ نال ہک سٹرنگ واپس کریندا ہے۔ اوندے مواد کوں ݙیکھݨ کیتے <literal>FileSystem</literal> سروس ورتو، نال ہی اوندے وچ محفوظ کیتیاں ڳئیاں فائلاں بݨاوݨ، کھولݨ تے پڑھݨ کیتے وی۔"

#. kmW9L
#: sf_document.xhp
msgctxt ""
"sf_document.xhp\n"
"par_id941589194576584\n"
"help.text"
msgid "Refer to <link href=\"text/sbasic/shared/03/sf_filesystem.xhp#virtual_fs\">this help page</link> to learn more on how to access and manipulate folders and files in the virtual file system of a %PRODUCTNAME file."
msgstr "<link href=\"text/sbasic/shared/03/sf_filesystem.xhp#virtual_fs\">ایں مدد ورقے</link> کوں ݙیکھو تاں جو %PRODUCTNAME فائل دے ورچوئل فائل سسٹم وچ فولڈراں تے فائلاں تائیں رسائی حاصل کرݨ تے انہاں نال ہیرا پھیری کرݨ بارے ہور سکھ سڳو۔"

#. 7vqDq
#: sf_document.xhp
