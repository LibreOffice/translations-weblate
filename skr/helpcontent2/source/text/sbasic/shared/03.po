msgctxt ""
"sf_form.xhp\n"
"par_id501616860541195\n"
"help.text"
msgid "Closes the form document containing the actual <literal>Form</literal> instance. The <literal>Form</literal> instance is disposed."
msgstr "اوس فارم دستاویز کوں بند کریندا ہے جیندے وچ اصل <literal>Form</literal> مثال موجود ہے۔ <literal>Form</literal> مثال کوں ختم کر ݙتا ویندا ہے۔"

#. a8CxQ
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id161584541257982\n"
"help.text"
msgid "The value returned by the <literal>Controls</literal> method depends on the arguments provided:"
msgstr "<literal>Controls</literal> طریقے ولوں واپس کیتی ڳئی قیمت ݙتیاں ڳئیاں دلیلاں تے منحصر ہے:"

#. VXWwg
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id421598179770993\n"
"help.text"
msgid "If the method is called <emph>without arguments</emph>, then it returns the list of the controls contained in the form. Be aware that the returned list does not contain any subform controls."
msgstr "جے طریقہ <emph>بغیر دلیلاں دے</emph> طلب کیتا ونڄے تاں اوہ فارم وچ موجود کنٹرولز دی تندیر واپس کریندا ہے۔ دھیان دیو جو واپس کیتی ڳئی تندیر وچ کہیں ذیلی فارم دے کنٹرول کائنی ہوندے۔"

#. SsiUX
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id81598185229301\n"
"help.text"
msgid "If the optional <literal>ControlName</literal> argument is provided, the method returns a <literal>FormControl</literal> class instance referring to the specified control."
msgstr "جے اختیاری <literal>ControlName</literal> دلیل ݙتی ڳئی ہووے تاں طریقہ <literal>FormControl</literal> کلاس دی مثال واپس کریندا ہے جیڑھی بیان کیتے ڳئے کنٹرول دا حوالہ ݙیندی ہے۔"

#. 7CFJU
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id1001584541257789\n"
"help.text"
msgid "<emph>controlname</emph> : A valid control name as a case-sensitive string. If absent, the list of control names is returned as a zero-based array."
msgstr "<emph>controlname</emph>: ہک جائز کنٹرول ناں جیڑھا کیس حساس تند ہے۔ جے نہ ہووے تاں کنٹرول ناواں دی تندیر صفر توں شروع تھیوݨ آلی صف دے طور تے واپس کیتی ویندی ہے۔"

#. PTqJ2
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id291616861407907\n"
"help.text"
msgid "Return a <link href=\"text/sbasic/shared/03/sf_database.xhp\"><literal>SFDatabases</literal>.<literal>Database</literal></link> instance giving access to the execution of SQL commands on the database the current form is connected to and/or that is stored in the current Base document."
msgstr "ہک <link href=\"text/sbasic/shared/03/sf_database.xhp\"><literal>SFDatabases</literal>.<literal>Database</literal></link> مثال واپس کریندا ہے جیڑھی اوس ڈیٹا بیس تے SQL کمانڈز انجام ݙیݨ تائیں رسائی ݙیندی ہے جیندے نال موجودہ فارم ڳنڈھیا ہويا ہے تے/یا جیڑھا موجودہ Base دستاویز وچ محفوظ ہے۔"

#. fZRst
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id991616861417207\n"
"help.text"
msgid "Each form has its own database connection, except in Base documents where they all share the same connection."
msgstr "ہر فارم دا آپݨا ڈیٹا بیس کنکشن ہے، سوائے Base دستاویزاں دے جتھاں سارے ہک ہی کنکشن سانجھے کریندے ہن۔"

#. wFSWb
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id701616861134906\n"
"help.text"
msgid "<emph>user, password</emph>: The login optional parameters (Default = \"\")."
msgstr "<emph>user, password</emph>: لاگ ان دے اختیاری پیرامیٹرز (طے شدہ = \"\")۔"

#. 83Jju
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id771616861842867\n"
"help.text"
msgid "The form cursor is positioned on the first record. Returns <literal>True</literal> if successful."
msgstr "فارم کرسر پہلے ریکارڈ تے رکھیا ویندا ہے۔ جے کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. rapRE
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id331616863143187\n"
"help.text"
msgid "The form cursor is positioned on the last record. Returns <literal>True</literal> if successful."
msgstr "فارم کرسر چھیکڑی ریکارڈ تے رکھیا ویندا ہے۔ جے کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. HZELb
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id361616863143954\n"
"help.text"
msgid "The form cursor is positioned on the new record area. Returns <literal>True</literal> if successful."
msgstr "فارم کرسر نویں ریکارڈ آلی جاہ تے رکھیا ویندا ہے۔ جے کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. 2QwcR
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id541616863143461\n"
"help.text"
msgid "The form cursor is positioned on the next record. Returns <literal>True</literal> if successful."
msgstr "فارم کرسر اڳلے ریکارڈ تے رکھیا ویندا ہے۔ جے کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. a2gGn
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id271616863582607\n"
"help.text"
msgid "<emph>offset</emph>: The number of records to go forward (Default = 1)."
msgstr "<emph>offset</emph>: اڳاں ونڄݨ آلے ریکارڈاں دی گݨتری (طے شدہ = 1)۔"

#. e6huC
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id616168637945\n"
"help.text"
msgid "The form cursor is positioned on the previous record. Returns <literal>True</literal> if successful."
msgstr "فارم کرسر پچھلے ریکارڈ تے رکھیا ویندا ہے۔ جے کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. tAnVw
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id751616863794125\n"
"help.text"
msgid "<emph>offset</emph>: The number of records to go backwards (Default = 1)."
msgstr "<emph>offset</emph>: پچھاں ونڄݨ آلے ریکارڈاں دی گݨتری (طے شدہ = 1)۔"

#. Kp4Wo
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id811616864216529\n"
"help.text"
msgid "Reloads the current data from the database and refreshes the form. The cursor is positioned on the first record. Returns <literal>True</literal> if successful."
msgstr "ڈیٹا بیس توں موجودہ ڈیٹا کوں ولا لوڈ کریندا ہے تے فارم کوں تازہ کریندا ہے۔ کرسر پہلے ریکارڈ تے رکھیا ویندا ہے۔ جے کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. 5gBGr
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id891616864510614\n"
"help.text"
msgid "The value returned by the <literal>Subforms</literal> method depends on the arguments provided:"
msgstr "<literal>Subforms</literal> طریقے ولوں واپس کیتی ڳئی قیمت ݙتیاں ڳئیاں دلیلاں تے منحصر ہے:"

#. 4yG2j
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id951616864510585\n"
"help.text"
msgid "If the method is called <emph>without any arguments</emph>, then it returns the list of subforms contained in the current form or subform instance."
msgstr "جے طریقہ <emph>بغیر کہیں دلیل دے</emph> طلب کیتا ونڄے تاں اوہ موجودہ فارم یا ذیلی فارم مثال وچ موجود ذیلی فارم دی تندیر واپس کریندا ہے۔"

#. AD3Q6
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id591616864510445\n"
"help.text"
msgid "If the optional <literal>subform</literal> argument is provided, the method returns a new <literal>SFDocuments</literal>.<literal>Form</literal> instance based on the specified form/subform name or index."
msgstr "جے اختیاری <literal>subform</literal> دلیل ݙتی ڳئی ہووے تاں طریقہ بیان کیتے ڳئے فارم/ذیلی فارم ناں یا انڈیکس دی بنیاد تے ہک نویں <literal>SFDocuments</literal>.<literal>Form</literal> مثال واپس کریندا ہے۔"

#. GCRsS
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id341616864510747\n"
"help.text"
msgid "<emph>subform</emph>: A subform stored in the current <literal>Form</literal> class instance given by its name or index."
msgstr "<emph>subform</emph>: موجودہ <literal>Form</literal> کلاس مثال وچ محفوظ ہک ذیلی فارم جیڑھا اوندے ناں یا انڈیکس نال ݙتا ڳیا ہے۔"

#. uKm6R
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id211618230389251\n"
"help.text"
msgid "When this argument is absent, the method returns a list of available subforms as a zero-based array. If the form has a single subform, you can set <literal>subform = 0</literal> to get access to it."
msgstr "جے ایہ دلیل نہ ہووے تاں طریقہ دستیاب ذیلی فارماں دی تندیر صفر توں شروع تھیوݨ آلی صف دے طور تے واپس کریندا ہے۔ جے فارم وچ ہک ہی ذیلی فارم ہووے تاں اوندے تائیں رسائی حاصل کرݨ کیتے <literal>subform = 0</literal> مقرر کیتا ونڄ سڳدا ہے۔"

#. CfGgB
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"tit\n"
"help.text"
msgid "SFDocuments.FormControl service"
msgstr "SFDocuments.FormControl سروس"

#. U4CgG
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"bm_id781582391760253\n"
"help.text"
msgid "<variable id=\"FormControlService\"><link href=\"text/sbasic/shared/03/sf_formcontrol.xhp\"><literal>SFDocuments</literal>.<literal>FormControl</literal> service</link></variable>"
msgstr ""

#. XFkrG
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id931583589764919\n"
"help.text"
msgid "The <literal>FormControl</literal> service provides access to the controls that belong to a form, a subform or a table control of a <literal>FormDocument</literal>. Each instance of the <literal>FormControl</literal> service refers to a single control in the form. This service allows users to:"
msgstr "<literal>FormControl</literal> سروس اوں کنٹرولز تائیں رسائی ݙیندی ہے جیڑھے ہک فارم، ہک ذیلی فارم یا ہک <literal>FormDocument</literal> دے ٹیبل کنٹرول نال تعلق رکھدے ہن۔ <literal>FormControl</literal> سروس دی ہر مثال فارم وچ ہک کنٹرول دا حوالہ ݙیندی ہے۔ ایہ سروس ورتکاراں کوں ایہ کرݨ ݙیندی ہے:"

#. irNFC
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id451618771561326\n"
"help.text"
msgid "Get and set the properties of the control represented by the <literal>FormControl</literal> instance."
msgstr "<literal>FormControl</literal> مثال ولوں ݙکھائے ڳئے کنٹرول دیاں خصوصیتاں حاصل کرو تے مقرر کرو۔"

#. S5aH9
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id601618771565183\n"
"help.text"
msgid "Access the current value displayed by the control."
msgstr "کنٹرول ولوں ݙکھائی ڳئی موجودہ قیمت تائیں رسائی حاصل کرو۔"

#. P5xzV
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id981618771567951\n"
"help.text"
msgid "Set the focus on the desired control."
msgstr "چاہے ڳئے کنٹرول تے فوکس مقرر کرو۔"

#. LUDRM
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id301616939922857\n"
"help.text"
msgid "To use the <literal>FormControl</literal> service in a particular form, subform or table control, all controls must have unique names."
msgstr "کسے خاص فارم، ذیلی فارم یا ٹیبل کنٹرول وچ <literal>FormControl</literal> سروس ورتݨ کیتے، سارے کنٹرولز دے ناں وکھرے ہوݨے چاہیدے ہن۔"

#. JMFEb
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id541618771629112\n"
"help.text"
msgid "Radio buttons that share the same group name must also have unique control names."
msgstr "ریڈیو بٹناں جیڑھے ہک ہی گروپ ناں سانجھے کریندے ہن، اوندے کنٹرول ناں وی وکھرے ہوݨے چاہیدے ہن۔"

#. mAwyv
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id51618771641273\n"
"help.text"
msgid "The main purpose of the <literal>FormControl</literal> service is setting and getting the properties and values displayed by the controls in a form."
msgstr "<literal>FormControl</literal> سروس دا اصل مقصد اوہ خصوصیتاں تے قیمتاں مقرر کرݨا تے حاصل کرݨا ہے جیڑھیاں فارم وچ کنٹرولز ولوں ݙکھائیاں ویندیاں ہن۔"

#. egjZu
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id81618774023346\n"
"help.text"
msgid "All controls have a <literal>Value</literal> property. However, its contents will vary according to the control type. For more information, read <link href=\"text/sbasic/shared/03/sf_formcontrol.xhp#hd_id81598540704978\">The <literal>Value</literal> Property</link> below."
msgstr "سارے کنٹرولز دی ہک <literal>Value</literal> خصوصیت ہے۔ البتہ اوندی مواد کنٹرول قسم دے مطابق وکھری ہوسی۔ ودھ معلومات کیتے، تھلے <link href=\"text/sbasic/shared/03/sf_formcontrol.xhp#hd_id81598540704978\">The <literal>Value</literal> Property</link> پڑھو۔"

#. kF29h
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id881618771651907\n"
"help.text"
msgid "It is also possible to format the controls via the <literal>XControlModel</literal> and <literal>XControlView</literal> properties."
msgstr "کنٹرولز کوں <literal>XControlModel</literal> تے <literal>XControlView</literal> خصوصیتاں دے ذریعے فارمیٹ کرݨا وی ممکن ہے۔"

#. SGsH8
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id891598188164936\n"
"help.text"
msgid "The <literal>SFDocuments.FormControl</literal> service is closely related to the <link href=\"text/sbasic/shared/03/sf_form.xhp\"><literal>SFDocuments.Form</literal></link> service."
msgstr "<literal>SFDocuments.FormControl</literal> سروس دا <link href=\"text/sbasic/shared/03/sf_form.xhp\"><literal>SFDocuments.Form</literal></link> سروس نال گھاٹا تعلق ہے۔"

#. rUEuw
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"hd_id581582885621841\n"
"help.text"
msgid "Service invocation"
msgstr "سروس طلب"

#. pzkhK
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id141609955500101\n"
"help.text"
msgid "Before using the <literal>FormControl</literal> service the <literal>ScriptForge</literal> library needs to be loaded or imported:"
msgstr "<literal>FormControl</literal> سروس ورتݨ توں پہلے <literal>ScriptForge</literal> لائبریری کوں لوڈ یا درآمد کرݨا ضروری ہے:"

#. BeDqF
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id361598174756160\n"
"help.text"
msgid "The <literal>FormControl</literal> service is invoked from an existing <literal>Form</literal> service instance through its <literal>Controls</literal> method."
msgstr "<literal>FormControl</literal> سروس کوں موجودہ <literal>Form</literal> سروس مثال توں اوندے <literal>Controls</literal> طریقے دے ذریعے طلب کیتا ویندا ہے۔"

#. 56bE7
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"pyc_id721622556808773\n"
"help.text"
msgid "control.Value = 'Current Time = ' + strftime(\"%a, %d %b %Y %H:%M:%S\", localtime())"
msgstr ""

#. LG9Md
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id781618772761258\n"
"help.text"
msgid "To learn more about how to open a <literal>FormDocument</literal> and get access to its forms, refer to the <link href=\"text/sbasic/shared/03/sf_form.xhp\">SFDocuments.Form</link> service help page."
msgstr "اوس بارے ودھ جانݨ کیتے جو ہک <literal>FormDocument</literal> کیویں کھولیا ونڄے تے اوندے فارماں تائیں رسائی کیویں حاصل کیتی ونڄے، <link href=\"text/sbasic/shared/03/sf_form.xhp\">SFDocuments.Form</link> سروس مدد ورقے کوں ݙیکھو۔"

#. qeXCN
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id951598174966322\n"
"help.text"
msgid "Alternatively a <literal>FormControl</literal> instance can be retrieved via the <literal>SFDocuments.FormEvent</literal> service, which returns the <literal>SFDocuments.FormControl</literal> class instance that triggered the event."
msgstr "متبادل طور تے ہک <literal>FormControl</literal> مثال <literal>SFDocuments.FormEvent</literal> سروس دے ذریعے حاصل کیتی ونڄ سڳدی ہے، جیڑھی <literal>SFDocuments.FormControl</literal> کلاس مثال واپس کریندی ہے جیندے واقعہ کوں شروع کیتا ہا۔"

#. bSfxy
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"bas_id801598175242937\n"
"help.text"
msgid "' oControl now represents the instance of the FormControl class that triggered the current event"
msgstr ""

#. EgCtB
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id251598176312571\n"
"help.text"
msgid "Note that in previous examples, the prefix <literal>\"SFDocuments.\"</literal> may be omitted."
msgstr "دھیان دیو جو پچھلیاں مثالاں وچ، اڳیتر <literal>\"SFDocuments.\"</literal> چھڈیا ونڄ سڳدا ہے۔"

#. 7gE8Y
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"par_id951618773412097\n"
"help.text"
msgid "The <literal>FormEvent</literal> service is used exclusively to create instances of the <literal>SFDocuments.Form</literal> and <literal>SFDocuments.FormControl</literal> services when a form or control event takes place."
msgstr "<literal>FormEvent</literal> سروس صرف <literal>SFDocuments.Form</literal> تے <literal>SFDocuments.FormControl</literal> سروساں دیاں مثالاں بݨاوݨ کیتے ورتی ویندی ہے جݙاں کوئی فارم یا کنٹرول واقعہ پیش آوے۔"

#. AppFj
#: sf_formcontrol.xhp
msgctxt ""
"sf_formcontrol.xhp\n"
"hd_id71598455687512\n"
"help.text"
msgid "Control types"
msgstr "کنٹرول قسماں"

