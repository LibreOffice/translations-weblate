#. LJG3Z
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id891582884466217\n"
"help.text"
msgid "A dictionary is a collection of key-item pairs"
msgstr "ہک ڈکشنری کلید-چیز جوڑیاں دا مجموعہ ہے۔"

#. CQUYn
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id861582884516571\n"
"help.text"
msgid "The key is a string. In Basic scripts, the case sensitivity of the key is determined at Dictionary creation. In Python scripts, the key is always case-sensitive."
msgstr "کلید ہک سٹرنگ ہے۔ Basic سکرپٹاں وچ، کلید دی کیس حساسیت Dictionary بݨاوݨ ویلے طے کیتی ویندی ہے۔ Python سکرپٹاں وچ، کلید ہمیشہ کیس حساس ہوندی ہے۔"

#. 2AdDG
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id531582884549542\n"
"help.text"
msgid "Items may be of any type"
msgstr "چیزاں کِسے وی قسم دیاں تھی سڳدیاں ہن۔"

#. Bqyf3
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id891582884593057\n"
"help.text"
msgid "Keys and items can be retrieved, counted, updated, and much more."
msgstr "کلیداں تے چیزاں حاصل کیتیاں ونڄ سڳدیاں ہن، گݨیاں ونڄ سڳدیاں ہن، اپ ڈیٹ کیتیاں ونڄ سڳدیاں ہن، تے ٻہوں کجھ ہور وی۔"

#. oY6bP
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id971582884636922\n"
"help.text"
msgid "The Dictionary service is similar to the built-in %PRODUCTNAME Basic <literal>Collection</literal> object, however with more features. For example, <literal>Collection</literal> objects do not support the retrieval of keys. Moreover, Dictionaries provide additional capabilities as replacing keys, testing if a specific key already exists and converting the Dictionary into an array of PropertyValues or a JSON string."
msgstr "Dictionary سروس بلٹ ان %PRODUCTNAME Basic <literal>Collection</literal> آبجیکٹ ورگی ہے، پر ودھ خصوصیتاں نال۔ مثال دے طور تے، <literal>Collection</literal> آبجیکٹ کلیداں حاصل کرݨ دی حمایت کائنی کریندے۔ ایں توں علاوہ، ڈکشنریاں کلیداں وٹاوݨ، ہک مخصوص کلید پہلے توں موجود ہے یا کو ایہ جانچݨ تے Dictionary کوں PropertyValues دی صف یا JSON سٹرنگ وچ وٹاوݨ ورگیاں اضافی صلاحیتاں ݙیندیاں ہن۔"

