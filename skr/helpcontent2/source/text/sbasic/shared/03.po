#. scaEA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id231635441342284\n"
"help.text"
msgid "To learn more about Pivot Tables in %PRODUCTNAME Calc, read the <link href=\"text/scalc/guide/datapilot.xhp\">Pivot Table</link> help page."
msgstr "%PRODUCTNAME Calc وچ Pivot Tables بارے مزید سکھݨ کیتے <link href=\"text/scalc/guide/datapilot.xhp\">Pivot Table</link> مدد ورقہ پڑھو۔"

#. Af2f6
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id601595777001498\n"
"help.text"
msgid "Apply the functions Average, Count, Max, Min and Sum, respectively, to all the cells containing numeric values on a given range, excluding values from filtered and hidden rows and hidden columns, the same as for the status bar functions."
msgstr "ݙتی ڳئی رینج تے عددی قیمتاں رکھݨ آلے سارے سیلاں تے بالترتیب Average، Count، Max، Min تے Sum فنکشن لاوو، فلٹر کیتیاں ڳئیاں تے لکائی ڳئیاں قطاراں تے لکے ہوئے کالماں توں قیمتاں کوں خارج کر کے، ہکو جہاں اسٹیٹس بار فنکشنز واسطے ہے۔"

#. F2UTC
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id741595777001537\n"
"help.text"
msgid "<emph>range</emph>: The range to which the function will be applied, as a string."
msgstr "<emph>range</emph>: اُس رینج، سٹرنگ طور تے، جیں تے فنکشن لایا ویسی۔"

#. ZhAYY
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id121611752704572\n"
"help.text"
msgid "The example below applies the <literal>Sum</literal> function to the range \"A1:A1000\" of the currently selected sheet:"
msgstr "تھلے ݙتی ڳئی مثال <literal>Sum</literal> فنکشن کوں موجودہ چُݨی ڳئی شیٹ دی رینج \"A1:A1000\" تے لائیندی ہے:"

#. iTEts
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id31611752782288\n"
"help.text"
msgid "Cells in the given range that contain text will be ignored by all of these functions. For example, the <literal>DCount</literal> method will not count cells with text, only numerical cells."
msgstr "ݙتی ڳئی رینج وچ عبارت رکھݨ آلے سیلاں کوں ایہناں سارے فنکشنز ولوں نظر انداز کیتا ویسی۔ مثال طور تے، <literal>DCount</literal> طریقہ عبارت رکھݨ آلے سیلاں کوں شمار کائنی کریسی، صرف عددی سیلاں کوں۔"

#. RBBQB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id471768055753462\n"
"help.text"
msgid "Specify simple and easy properties of the font to be used in a range of cells."
msgstr "سیلاں دی رینج وچ ورتے ونڄݨ آلے فونٹ دیاں سادہ تے آسان خصوصیات بیان کرو۔"

#. W4wNz
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id991768055771625\n"
"help.text"
msgid "The impacted cells may be determined with a filter formula and its scope."
msgstr "متاثر تھیوݨ آلے سیلاں کوں فلٹر فارمولے تے ایں دے دائرے نال طے کیتا ونڄ سڳدا ہے۔"

#. JhBhd
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id931768055801780\n"
"help.text"
msgid "To apply more complex font decorations, apply the usual and numerous <literal>UNO</literal> properties available in the <literal>XCell</literal> or <literal>XCellRange</literal> interfaces."
msgstr "مزید پیچیدہ فونٹ سجاوٹاں لاوݨ کیتے <literal>XCell</literal> یا <literal>XCellRange</literal> انٹرفیسز وچ دستیاب معمول دیاں تے کئی <literal>UNO</literal> خصوصیات لاوو۔"

#. vEJ9i
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id871768056133127\n"
"help.text"
msgid "<emph>targetrange</emph>: The cell or the range as a string in which cell fonts should be re-decorated."
msgstr "<emph>targetrange</emph>: سیل یا رینج سٹرنگ طور تے جیں وچ سیل فونٹاں کوں ولا سجایا ونڄݨا چاہیدا ہے۔"

#. K3Pqw
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id671768056195921\n"
"help.text"
msgid "<emph>fontname</emph>: The name of the font to be used. The name is not checked. Default = no change."
msgstr "<emph>fontname</emph>: ورتے ونڄݨ آلے فونٹ دا ناں۔ ناں دی جانچ کائنی کیتی ویندی۔ طے شدہ = کوئی وٹا کائنی۔"

#. CnZoB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id971768056327357\n"
"help.text"
msgid "<emph>fontsize</emph>: The size of the font in pixels. Default = no change."
msgstr "<emph>fontsize</emph>: فونٹ دا سائز پکسلز وچ۔ طے شدہ = کوئی وٹا کائنی۔"

#. gZXT5
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id711768056157938\n"
"help.text"
msgid "<emph>decoration</emph>: A string combining 1 or more of next upper-case characters (other characters are ignored). Default = no change:"
msgstr "<emph>decoration</emph>: ہک سٹرنگ جیڑھی اڳلے وݙے حرفاں وچوں 1 یا ودھ کوں جوڑدی ہے (ٻئے حرفاں کوں نظر انداز کیتا ویندا ہے)۔ طے شدہ = کوئی وٹا کائنی:"

#. BHQCL
#: sf_calc.xhp
msgctxt ""
