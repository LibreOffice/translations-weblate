"par_id21582649483175\n"
"help.text"
msgid "<emph>sortorder</emph>: It can be either \"ASC\" (default) or \"DESC\"."
msgstr "<emph>sortorder</emph>: ایہ یا تاں \"ASC\" (طے شدہ) یا \"DESC\" تھی سڳدا ہے۔"

#. K4GrR
