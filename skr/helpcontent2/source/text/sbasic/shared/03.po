msgstr ""

#. T5zMp
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id661768057052508\n"
"help.text"
msgid "# Modify the font size and apply bold and underline properties to the numeric cells."
msgstr ""

#. v4Ccg
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id721768057070406\n"
