#. EK2E7
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id231635335826090\n"
"help.text"
msgid "Consider the following data in the range \"A1:B6\" of a sheet named \"Report\"."
msgstr "\"Report\" ناں آلی شیٹ دی رینج \"A1:B6\" وچ تھلے ݙتے ڳئے ڈیٹا تے غور کرو۔"

#. ZSw7Y
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id911635336313498\n"
"help.text"
msgid "The examples below in Basic and Python show how to create a line chart from this data with legends."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں Basic تے Python وچ ݙکھیندیاں ہن کہ ایں ڈیٹا توں لیجنڈز نال لکیر چارٹ کیویں بݨایا ونڄے۔"

#. whbDd
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id931635338174647\n"
"help.text"
msgid "The chart does not need to be created in the same sheet where the data is located. It can be created in any existing sheet in the current file by specifying the sheet name in the second argument of the <literal>CreateChart</literal> method."
msgstr "چارٹ کوں اُسی شیٹ وچ بݨاوݨ دی ضرورت کائنی جتھاں ڈیٹا واقع ہے۔ ایں کوں موجودہ فائل دی کسے وی موجودہ شیٹ وچ <literal>CreateChart</literal> طریقے دی ٻئی دلیل وچ شیٹ دا ناں بیان کر کے بݨایا ونڄ سڳدا ہے۔"

#. RtuMk
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"hd_id501582887473754\n"
"help.text"
msgid "Methods"
msgstr "طریقے"

#. mNZFS
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id891611613601554\n"
"help.text"
msgid "List of Methods in the Chart Service"
msgstr "Chart سروس وچ طریقاں دی تندیر"

#. WfVxL
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id93158919969864\n"
"help.text"
msgid "Saves the chart as an image file in a specified location. Returns <literal>True</literal> if the image file could be successfully created."
msgstr "چارٹ کوں بیان کیتے ڳئے مقام تے تصویر فائل طور تے محفوظ کریندا ہے۔ اگر تصویر فائل کامیابی نال بݨائی ونڄ سڳی ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. SAtUt
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id821591631203996\n"
"help.text"
msgid "<emph>filename</emph>: Identifies the path and file name where the image will be saved. It must follow the notation defined in <literal>SF_FileSystem.FileNaming</literal>."
msgstr "<emph>filename</emph>: تصویر محفوظ کیتی ونڄݨ آلے پاتھ تے فائل دے ناں دی شناخت کریندا ہے۔ ایں کوں <literal>SF_FileSystem.FileNaming</literal> وچ بیان کیتی ڳئی اشارے دی پیروی کرݨی چاہیدی ہے۔"

#. 2YEEE
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id821591631203116\n"
"help.text"
msgid "<emph>imagetype</emph>: The name of the image type to be created. The following values are accepted: \"gif\", \"jpeg\", \"png\" (default), \"svg\" and \"tiff\"."
msgstr "<emph>imagetype</emph>: بݨائی ونڄݨ آلی تصویر دی قسم دا ناں۔ تھلے ݙتیاں ڳئیاں قیمتاں قبول کیتیاں ویندیاں ہن: \"gif\" ، \"jpeg\" ، \"png\" (طے شدہ)، \"svg\" تے \"tiff\"۔"

#. XRASx
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id821591631203133\n"
"help.text"
msgid "<emph>overwrite</emph>: Specifies if the destination file can be overwritten (Default = <literal>False</literal>)."
msgstr "<emph>overwrite</emph>: بیان کریندا ہے کہ کیا منزل فائل کوں وٹایا ونڄ سڳدا ہے (طے شدہ = <literal>False</literal>)۔"

#. MCGBa
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id93158919969165\n"
"help.text"
msgid "Changes the position of the chart in the current sheet and modifies its width and height. Returns <literal>True</literal> if resizing was successful."
msgstr "موجودہ شیٹ وچ چارٹ دی جاہ تے ایں دی چوڑائی تے اچائی کوں وٹاوݨا ہے۔ اگر سائز وٹاوݨا کامیاب تھیا ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. aMKE5
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id821591631200626\n"
"help.text"
msgid "<emph>xpos, ypos:</emph> Specify the new X and Y positions of the chart. If any of these values are omitted or if negative values are provided, the corresponding positions are left unchanged."
msgstr "<emph>xpos, ypos:</emph> چارٹ دیاں نویاں X تے Y جاہیں بیان کرو۔ اگر ایہناں قیمتاں وچوں کوئی وی چھڈ ݙتی ونڄے یا منفی قیمتاں ݙتیاں ونڄن، تاں مطابقت رکھݨ آلیاں جاہیں بے وٹا چھڈ ݙتیاں ویندیاں ہن۔"

#. qvsYR
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id821591631204288\n"
"help.text"
msgid "<emph>width:</emph> Specify the new width of the chart. If this argument is omitted or if a negative value is provided, the chart width is left unchanged."
msgstr "<emph>width:</emph> چارٹ دی نویں چوڑائی بیان کرو۔ اگر ایہ دلیل چھڈ ݙتی ونڄے یا منفی قیمت ݙتی ونڄے، تاں چارٹ دی چوڑائی بے وٹا چھڈ ݙتی ویندی ہے۔"

#. nGioo
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id821591631203208\n"
"help.text"
msgid "<emph>height:</emph> Specify the new height of the chart. If this argument is omitted or if a negative value is provided, the chart height is left unchanged."
msgstr "<emph>height:</emph> چارٹ دی نویں اچائی بیان کرو۔ اگر ایہ دلیل چھڈ ݙتی ونڄے یا منفی قیمت ݙتی ونڄے، تاں چارٹ دی اچائی بے وٹا چھڈ ݙتی ویندی ہے۔"

#. EyY7j
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"par_id301635340527472\n"
"help.text"
msgid "All arguments are provided as integer values that correspond to 1/100 of a millimeter."
msgstr "ساریاں دلیلاں عددی قیمتاں طور تے ݙتیاں ویندیاں ہن جیڑھیاں ملی میٹر دے 1/100 حصے نال مطابقت رکھدیاں ہن۔"

#. h7zov
#: sf_chart.xhp
msgctxt ""
"sf_chart.xhp\n"
"bas_id431635340711712\n"
"help.text"
msgid "' Changes only X and Y position"
msgstr ""

#. VHc2V
