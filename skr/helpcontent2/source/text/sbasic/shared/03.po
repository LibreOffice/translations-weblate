msgctxt ""
"sf_l10n.xhp\n"
"par_id171585843652545\n"
"help.text"
msgid "It is recommended to free resources after use:"
msgstr "ورتݨ دے بعد وسائل کوں آزاد کرݨ دی سفارش کیتی ویندی ہے:"

