#. efEEX
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id651598718179382\n"
"help.text"
msgid "Displays the console messages in a modal or non-modal dialog. In both modes, all the past messages issued by a <literal>DebugPrint()</literal> method or resulting from an exception are displayed. In non-modal mode, subsequent entries are added automatically."
msgstr "کنسول سنیہے ہک موڈل یا غیر موڈل ڈائیلاگ وچ ݙکھیندا ہے۔ ݙوہاں موڈاں وچ، <literal>DebugPrint()</literal> طریقے ولوں جاری کیتے ڳئے یا ہک مستثنیٰ دے نتیجے وچ ملݨ آلے سارے پچھلے سنیہے ݙکھائے ویندے ہن۔ غیر موڈل موڈ وچ، بعد آلیاں اندراجاں خود بخود شامل کیتیاں ویندیاں ہن۔"

#. KKgdp
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id161598718286205\n"
"help.text"
msgid "If the console is already open, when non-modal, it is brought to the front."
msgstr "جے کنسول پہلے توں کھلا ہووے، جݙاں غیر موڈل ہووے، تاں اونکوں اڳوں لیایا ویندا ہے۔"

#. ypzYc
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id801598718629151\n"
"help.text"
msgid "A modal console can only be closed by the user. A non-modal console can either be closed by the user or upon macro termination."
msgstr "ہک موڈل کنسول صرف ورتکار ولوں بند کیتا ونڄ سڳدا ہے۔ ہک غیر موڈل کنسول یا تاں ورتکار ولوں بند کیتا ونڄ سڳدا ہے یا میکرو دے خاتمے تے۔"

#. HUgnb
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id511598718179819\n"
"help.text"
msgid "<emph>modal</emph>: Determine if the console window is modal (<literal>True</literal>) or non-modal (<literal>False</literal>). Default value is <literal>True</literal>."
msgstr "<emph>modal</emph>: تعین کرو کہ آیا کنسول ونڈو موڈل (<literal>True</literal>) ہے یا غیر موڈل (<literal>False</literal>)۔ طے شدہ قیمت <literal>True</literal> ہے۔"

#. xu6FA
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id641587215098903\n"
"help.text"
msgid "Clears the console keeping an optional number of recent messages. If the console is activated in non-modal mode, it is refreshed."
msgstr "کنسول کوں صاف کریندا ہے تے حالیہ سنیہاں دی ہک اختیاری تعداد رکھدا ہے۔ جے کنسول غیر موڈل موڈ وچ فعال کیتا ڳیا ہووے تاں اونکوں ولا تازہ کیتا ویندا ہے۔"

#. SE7ei
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id351587215098527\n"
"help.text"
msgid "<emph>keep</emph>: The number of recent messages to be kept. Default value is 0."
msgstr "<emph>keep</emph>: رکھے ونڄݨ آلے حالیہ سنیہاں دی تعداد۔ طے شدہ قیمت 0 ہے۔"

#. GLEVv
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id521610655023824\n"
"help.text"
msgid "The following example clears the console keeping the 10 most recent messages."
msgstr "تھلے ݙتی ڳئی مثال کنسول کوں صاف کریندی ہے تے 10 سب توں حالیہ سنیہے رکھدی ہے۔"

#. 4LD2d
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id281587218077400\n"
"help.text"
msgid "Exports the contents of the console to a text file. If the file already exists and the console is not empty, it will be overwritten without warning. Returns <literal>True</literal> if successful."
msgstr "کنسول دے مواد کوں ہک عبارت فائل تے برآمد کریندا ہے۔ جے فائل پہلے توں موجود ہووے تے کنسول خالی کائنی ہووے تاں اونکوں بغیر انتباہ دے اوور رائٹ کیتا ونڄسی۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. cAusu
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id851587218077862\n"
"help.text"
msgid "<emph>filename</emph>: The name of the text file the console should be dumped into. The name is expressed according to the current <literal>FileNaming</literal> property of the <literal>SF_FileSystem</literal> service. By default, <link href=\"text/sbasic/shared/00000002.xhp\">URL notation</link> and the native operating system's format are both admitted."
msgstr "<emph>filename</emph>: اوں عبارت فائل دا ناں جیندے وچ کنسول کوں ڈالیا ونڄݨا چاہیدا ہے۔ ناں موجودہ <literal>FileNaming</literal> خصوصیت دے مطابق ظاہر کیتا ویندا ہے جیڑھی <literal>SF_FileSystem</literal> سروس دی ہے۔ طے شدہ طور تے، <link href=\"text/sbasic/shared/00000002.xhp\">URL notation</link> تے مقامی آپریٹنگ سسٹم دا فارمیٹ ݙوہاں منظور ہن۔"

#. F3tVM
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id701621043185177\n"
"help.text"
msgid "Concatenates all the arguments into a single human-readable string and displays it in a <literal>MsgBox</literal> with an Information icon and an OK button."
msgstr "سارے دلیلاں کوں ہک ہکلی انسان ولوں پڑھݨ دے قابل سٹرنگ وچ جوڑ ݙیندا ہے تے اونکوں ہک <literal>MsgBox</literal> وچ ہک Information آئیکن تے ہک OK بٹن نال ݙکھیندا ہے۔"

#. KaGM6
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id791621097689492\n"
"help.text"
msgid "The final string is also added to the Console."
msgstr "آخری سٹرنگ وی کنسول وچ شامل کیتی ویندی ہے۔"

#. QhRgF
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id481587218636884\n"
"help.text"
msgid "<emph>arg0[, arg1, ...]</emph>: Any number of arguments of any type."
msgstr "<emph>arg0[, arg1, ...]</emph>: کِسے وی قسم دے دلیلاں دی کوئی وی تعداد۔"

#. 2qser
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id281587218637490\n"
"help.text"
msgid "Assembles all the given arguments into a single human-readable string and adds it as a new entry in the console."
msgstr "سارے ݙتے ڳئے دلیلاں کوں ہک ہکلی انسان ولوں پڑھݨ دے قابل سٹرنگ وچ جوڑ ݙیندا ہے تے اونکوں کنسول وچ ہک نویں اندراج دے طور تے شامل کریندا ہے۔"

#. mUSEP
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id481587218637988\n"
"help.text"
msgid "<emph>arg0[, arg1, ...]</emph>: Any number of arguments of any type."
msgstr "<emph>arg0[, arg1, ...]</emph>: کِسے وی قسم دے دلیلاں دی کوئی وی تعداد۔"

#. sCSES
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id111621624672183\n"
"help.text"
msgid "Displays the list of arguments in a readable form in the platform console. Arguments are separated by a TAB character (simulated by spaces)."
msgstr "دلیلاں دی تندیر کوں پلیٹ فارم کنسول وچ پڑھݨ دے قابل شکل وچ ݙکھیندا ہے۔ دلیلاں ہک TAB حرف نال وکھریاں کیتیاں ویندیاں ہن (خالی جاء نال نقل کیتا ڳیا)۔"

#. ujSFu
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id841621426229467\n"
"help.text"
msgid "The same string is added to the ScriptForge debug console."
msgstr "ایہو جیہی سٹرنگ ScriptForge ڈی بگ کنسول وچ وی شامل کیتی ویندی ہے۔"

#. kzBDb
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id551655563148866\n"
"help.text"
msgid "If <link href=\"https://extensions.libreoffice.org/en/extensions/show/apso-alternative-script-organizer-for-python\">Python shell (APSO)</link> is active, <literal>PythonPrint</literal> content is written to APSO console in place of the platform console."
msgstr "جے <link href=\"https://extensions.libreoffice.org/en/extensions/show/apso-alternative-script-organizer-for-python\">Python shell (APSO)</link> فعال ہووے تاں <literal>PythonPrint</literal> مواد APSO کنسول وچ پلیٹ فارم کنسول دی جاء تے لکھیا ویندا ہے۔"

#. ixNfF
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id391126449167833\n"
"help.text"
msgid "<emph>arg0[, arg1, ...]</emph>: Any number of arguments of any type. The maximum length of each individual argument is 1024 characters."
msgstr "<emph>arg0[, arg1, ...]</emph>: کِسے وی قسم دے دلیلاں دی کوئی وی تعداد۔ ہر ہکلی دلیل دی ودھ توں ودھ لمبائی 1024 حرف ہے۔"

#. U88JC
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id261123015276160\n"
"help.text"
msgid "In Python use a <literal>print</literal> statement to print to the APSO console or use the <literal>DebugPrint</literal> method to print to ScriptForge's console."
msgstr "Python وچ APSO کنسول تے چھاپݨ کیتے ہک <literal>print</literal> بیان ورتو یا ScriptForge دے کنسول تے چھاپݨ کیتے <literal>DebugPrint</literal> طریقہ ورتو۔"

#. CUoch
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id111621426672183\n"
"help.text"
msgid "Opens an APSO Python shell as a non-modal window. The Python script keeps running after the shell is opened. The output from <literal>print</literal> statements inside the script are shown in the shell."
msgstr "ہک APSO Python شیل کوں ہک غیر موڈل ونڈو دے طور تے کھولدا ہے۔ شیل کھلݨ توں بعد Python سکرپٹ چلدی رہندی ہے۔ سکرپٹ دے اندر <literal>print</literal> بیاناں دا آؤٹ پٹ شیل وچ ݙکھایا ویندا ہے۔"

#. f9ZzM
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id841621426922467\n"
"help.text"
msgid "Only a single instance of the APSO Python shell can be opened at any time. Hence, if a Python shell is already open, then calling this method will have no effect."
msgstr "کِسے وی ویلے APSO Python شیل دی صرف ہک مثال کھولی ونڄ سڳدی ہے۔ ایں کیتے، جے ہک Python شیل پہلے توں کھلا ہووے تاں ایں طریقے کوں بلاوݨ دا کوئی اثر کائنی تھیسی۔"

#. KGi8B
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id391621449167833\n"
"help.text"
msgid "<emph>variables</emph>: a Python dictionary with variable names and values that will be passed on to the APSO Python shell. By default all local variables are passed using Python's builtin <literal>locals()</literal> function."
msgstr "<emph>variables</emph>: متغیر ناواں تے قیمتاں رکھݨ آلی ہک Python ڈکشنری جیڑھی APSO Python شیل کوں ݙتی ونڄسی۔ طے شدہ طور تے سارے مقامی متغیر Python دے بلٹ ان <literal>locals()</literal> فنکشن ورتݨ نال ݙتے ویندے ہن۔"

#. dEdrj
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id402621449167833\n"
"help.text"
msgid "<emph>background</emph>: Background color of the console specified as <link href=\"text/sbasic/shared/03/sf_basic.xhp#RGB\">RGB 24 bits integer value</link>. Default background is that of APSO."
msgstr "<emph>background</emph>: کنسول دا پس منظر رنگ جیڑھا <link href=\"text/sbasic/shared/03/sf_basic.xhp#RGB\">RGB 24 bits integer value</link> دے طور تے بیان کیتا ڳیا ہے۔ طے شدہ پس منظر APSO دا ہے۔"

#. GNfJ9
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id513621449167833\n"
"help.text"
msgid "<emph>foreground</emph>: Foreground color of the console specified as <link href=\"text/sbasic/shared/03/sf_basic.xhp#RGB\">RGB 24 bits integer value</link>. Default foreground is that of APSO."
msgstr "<emph>foreground</emph>: کنسول دا اڳلا رنگ جیڑھا <link href=\"text/sbasic/shared/03/sf_basic.xhp#RGB\">RGB 24 bits integer value</link> دے طور تے بیان کیتا ڳیا ہے۔ طے شدہ اڳلا رنگ APSO دا ہے۔"

#. 5HDY8
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id991621449657850\n"
"help.text"
msgid "The example below opens the APSO Python shell passing all global and local variables considering the context where the script is running. Console is displayed with white characters on a black background."
msgstr "تھلے ݙتی ڳئی مثال APSO Python شیل کوں کھولدی ہے تے سارے عالمی تے مقامی متغیر ݙیندی ہے، اوں سیاق و سباق کوں دھیان وچ رکھݨ نال جتھاں سکرپٹ چل رہی ہے۔ کنسول کالے پس منظر تے چٹے حرفاں نال ݙکھایا ویندا ہے۔"

#. yUoFK
#: sf_exception.xhp
msgctxt ""
"sf_exception.xhp\n"
"par_id521621449800348\n"
"help.text"
msgid "When the APSO Python shell is open, any subsequent output printed by the script will be shown in the shell. Hence, the string printed in the example below will be displayed in the Python shell."
msgstr "جݙاں APSO Python شیل کھلا ہووے تاں سکرپٹ ولوں چھاپیا ڳیا کوئی وی بعد آلا آؤٹ پٹ شیل وچ ݙکھایا ونڄسی۔ ایں کیتے، تھلے ݙتی ڳئی مثال وچ چھاپی ڳئی سٹرنگ Python شیل وچ ݙکھائی ونڄسی۔"

