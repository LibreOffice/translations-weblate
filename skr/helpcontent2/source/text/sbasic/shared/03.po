msgid "'Adds some properties to the dictionary"
msgstr ""

#. 84fn2
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id791601391980978\n"
"help.text"
msgid "Adds the content of a <link href=\"https://en.wikipedia.org/wiki/JSON\">JSON (JavaScript Object Notation)</link> string into the current dictionary. Returns <literal>True</literal> if successful."
msgstr "ہک <link href=\"https://en.wikipedia.org/wiki/JSON\">JSON (JavaScript Object Notation)</link> سٹرنگ دے مواد کوں موجودہ ڈکشنری وچ شامل کریندا ہے۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. NtQCD
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"hd_id961601392113644\n"
"help.text"
msgid "Limitations"
msgstr "حداں"

#. dGRph
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id481601392181131\n"
"help.text"
msgid "The JSON string may contain numbers, text, booleans, null values and arrays containing those types. It must not contain JSON objects namely sub-dictionaries."
msgstr "JSON سٹرنگ وچ عدد، عبارت، بولین، نل قیمتاں تے اوہناں قسماں رکھݨ آلیاں صفاں تھی سڳدیاں ہن۔ ایندے وچ JSON آبجیکٹ یعنی ذیلی ڈکشنریاں کائنی ہووݨے چاہیدے۔"

#. LyxQD
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id511601392205908\n"
"help.text"
msgid "An attempt is made to convert text to date if the item matches one of these patterns: YYYY-MM-DD, HH:MM:SS or YYYY-MM-DD HH:MM:SS."
msgstr "عبارت کوں تریخ وچ وٹاوݨ دی کوشش کیتی ویندی ہے جے چیز انہاں نمونیاں وچوں ہک نال میل کھاندی ہووے: YYYY-MM-DD، HH:MM:SS یا YYYY-MM-DD HH:MM:SS۔"

#. 5cknM
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id69160139198061\n"
"help.text"
msgid "<emph>inputstr</emph>: The string to import."
msgstr "<emph>inputstr</emph>: درآمد کرݨ آلی سٹرنگ۔"

#. eCfBF
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id201601391980268\n"
"help.text"
msgid "<emph>overwrite</emph>: When <literal>True</literal>, entries with same name may exist in the dictionary and their values are overwritten. When <literal>False</literal> (default), repeated keys will raise an error. Be aware that dictionary keys are not case-sensitive while names are case-sensitive in JSON strings."
msgstr "<emph>overwrite</emph>: جݙاں <literal>True</literal> ہووے تاں ہکے ناں آلیاں اندراجاں ڈکشنری وچ موجود تھی سڳدیاں ہن تے انہاں دیاں قیمتاں اوور رائٹ کر ݙتیاں ویندیاں ہن۔ جݙاں <literal>False</literal> (طے شدہ) ہووے تاں ݙہرائی ڳئیاں کلیداں غلطی اٹھیسن۔ ایہ ڳالھ دھیان وچ رکھو کہ ڈکشنری دیاں کلیداں کیس حساس کائنی ہوندیاں جݙاں جو JSON سٹرنگاں وچ ناں کیس حساس ہوندے ہن۔"

#. aBFC5
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"bas_id521601393254694\n"
"help.text"
msgid "'The (sub)-dictionaries \"address\" and \"phoneNumbers\" (0) and (1) are imported as Empty values."
msgstr ""

#. 9j5u2
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id651588941968228\n"
"help.text"
msgid "Inserts the contents of an array of <literal>PropertyValue</literal> objects into the current dictionary. <literal>PropertyValue</literal> Names are used as Keys in the dictionary, whereas Values contain the corresponding values. Returns <literal>True</literal> if successful."
msgstr "<literal>PropertyValue</literal> آبجیکٹاں دی صف دے مواد کوں موجودہ ڈکشنری وچ داخل کریندا ہے۔ <literal>PropertyValue</literal> دے ناں ڈکشنری وچ کلیداں دے طور تے ورتے ویندے ہن، جݙاں جو قیمتاں وچ متعلقہ قیمتاں ہوندیاں ہن۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. BQybf
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id751588941968522\n"
"help.text"
msgid "<emph>propertyvalues</emph>: A zero-based 1-dimensional array containing <literal>com.sun.star.beans.PropertyValue</literal> objects. This parameter may also be a single <literal>PropertyValue</literal> object not contained in an Array."
msgstr "<emph>propertyvalues</emph>: <literal>com.sun.star.beans.PropertyValue</literal> آبجیکٹ رکھݨ آلی صفر توں شروع تھیوݨ آلی ہک جہتی صف۔ ایہ پیرامیٹر ہک ہکلہ <literal>PropertyValue</literal> آبجیکٹ وی تھی سڳدا ہے جیڑھا صف وچ شامل کائنی۔"

#. g5bHm
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id21588941968131\n"
"help.text"
msgid "<emph>overwrite</emph>: When <literal>True</literal>, entries with same name may exist in the dictionary and their values are overwritten. When <literal>False</literal> (default), repeated keys will raise an error. Note that dictionary keys are not case-sensitive in Basic, whereas names are case-sensitive in sets of property values and in Python dictionaries."
msgstr "<emph>overwrite</emph>: جݙاں <literal>True</literal> ہووے تاں ہکے ناں آلیاں اندراجاں ڈکشنری وچ موجود تھی سڳدیاں ہن تے انہاں دیاں قیمتاں اوور رائٹ کر ݙتیاں ویندیاں ہن۔ جݙاں <literal>False</literal> (طے شدہ) ہووے تاں ݙہرائی ڳئیاں کلیداں غلطی اٹھیسن۔ نوٹ کرو کہ Basic وچ ڈکشنری دیاں کلیداں کیس حساس کائنی ہوندیاں، جݙاں جو ناں پراپرٹی قیمتاں دے سیٹاں وچ تے Python ڈکشنریاں وچ کیس حساس ہوندے ہن۔"

#. GKtsH
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id641626703615898\n"
"help.text"
msgid "The examples below first create an array with two <literal>PropertyValue</literal> objects and then convert it to a dictionary."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں پہلے <literal>PropertyValue</literal> دے ݙو آبجیکٹ رکھݨ آلی صف بݨیندیاں ہن تے ول اونکوں ہک ڈکشنری وچ وٹا ݙیندیاں ہن۔"

#. 3rJRP
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id891582890366737\n"
"help.text"
msgid "Retrieves an existing dictionary entry based on its key. Returns the value of the item if successful, otherwise returns <literal>Empty</literal>."
msgstr "موجودہ ڈکشنری اندراج کوں اوندی کلید دی بنیاد تے حاصل کریندا ہے۔ جے کامیاب تھیوے تاں چیز دی قیمت واپس کریندا ہے، ݙوجھی صورت وچ <literal>Empty</literal> واپس کریندا ہے۔"

#. dGCvf
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id551582890399669\n"
"help.text"
msgid "<emph>key</emph>: If it does not exist, the <literal>Empty</literal> value is returned."
msgstr "<emph>key</emph>: جے ایہ موجود کائنی تاں <literal>Empty</literal> قیمت واپس کیتی ویندی ہے۔"

#. rGqyT
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id181610395933967\n"
"help.text"
msgid "The following example iterates over all keys in the dictionary and uses the <literal>Item</literal> method to access their values."
msgstr "تھلے ݙتی ڳئی مثال ڈکشنری دیاں ساریاں کلیداں تے چکر لیندی ہے تے انہاں دیاں قیمتاں تائیں رسائی حاصل کرݨ کیتے <literal>Item</literal> طریقہ ورتیندی ہے۔"

#. QJTte
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id891582890388737\n"
"help.text"
msgid "Removes an existing dictionary entry based on its key. Returns <literal>True</literal> if successful."
msgstr "موجودہ ڈکشنری اندراج کوں اوندی کلید دی بنیاد تے ہٹا ݙیندا ہے۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. QR5yu
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id551582890366999\n"
"help.text"
msgid "<emph>key</emph>: Must exist in the dictionary, otherwise an <literal>UNKNOWNKEYERROR</literal> error is raised."
msgstr "<emph>key</emph>: ڈکشنری وچ ضرور موجود ہووݨی چاہیدی ہے، ݙوجھی صورت وچ <literal>UNKNOWNKEYERROR</literal> غلطی اٹھائی ویندی ہے۔"

#. GyK3j
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id921582896275624\n"
"help.text"
msgid "Removes all the entries from the dictionary. Returns <literal>True</literal> if successful."
msgstr "ڈکشنری دیاں ساریاں اندراجاں کوں ہٹا ݙیندا ہے۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. GSzP5
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id281582895615444\n"
"help.text"
msgid "Replaces an existing item value based on its key. Returns <literal>True</literal> if successful."
msgstr "موجودہ چیز دی قیمت کوں اوندی کلید دی بنیاد تے وٹا ݙیندا ہے۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. R9YRt
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id991582895615535\n"
"help.text"
msgid "<emph>key</emph>: String value representing the key whose value will be replaced. If the key does not exist in the dictionary, an <literal>UNKNOWNKEYERROR</literal> error is raised."
msgstr "<emph>key</emph>: سٹرنگ قیمت جیڑھی اوں کلید کوں ݙکھیندی ہے جیندے قیمت وٹائی ونڄسی۔ جے کلید ڈکشنری وچ موجود کائنی تاں <literal>UNKNOWNKEYERROR</literal> غلطی اٹھائی ویندی ہے۔"

#. FA4hz
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id721582895615186\n"
"help.text"
msgid "<emph>value</emph>: The new value of the item referred to with the <literal>key</literal> parameter."
msgstr "<emph>value</emph>: <literal>key</literal> پیرامیٹر نال اشارہ کیتی ڳئی چیز دی نویں قیمت۔"

#. Y46D4
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id571582896597766\n"
"help.text"
msgid "Replaces an existing key in the dictionary by a new key. The item value is left unchanged. Returns <literal>True</literal> if successful."
msgstr "ڈکشنری وچ موجودہ کلید کوں ہک نویں کلید نال وٹا ݙیندا ہے۔ چیز دی قیمت بے وٹا چھڈ ݙتی ویندی ہے۔ <literal>True</literal> واپس کریندا ہے جے کامیاب تھیوے۔"

#. dPmwA
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id911582896597619\n"
"help.text"
msgid "<emph>key</emph>: String value representing the key to be replaced. If the key does not exist in the dictionary, a <literal>UNKNOWNKEYERROR</literal> error is raised."
msgstr "<emph>key</emph>: سٹرنگ قیمت جیڑھی وٹائی ونڄݨ آلی کلید کوں ݙکھیندی ہے۔ جے کلید ڈکشنری وچ موجود کائنی تاں <literal>UNKNOWNKEYERROR</literal> غلطی اٹھائی ویندی ہے۔"

#. 7YTCi
#: sf_dictionary.xhp
msgctxt ""
"sf_dictionary.xhp\n"
"par_id531582896597989\n"
"help.text"
msgid "<emph>value</emph>: String value for the new key. If the new key already exists in the dictionary, a <literal>DUPLICATEKEYERROR</literal> error is raised."
msgstr "<emph>value</emph>: نویں کلید کیتے سٹرنگ قیمت۔ جے نویں کلید پہلے توں ڈکشنری وچ موجود ہووے تاں <literal>DUPLICATEKEYERROR</literal> غلطی اٹھائی ویندی ہے۔"

