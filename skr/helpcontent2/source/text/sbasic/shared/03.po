#: sf_ui.xhp
msgctxt ""
"sf_ui.xhp\n"
"par_id31776429301152\n"
"help.text"
msgid "<emph>datafilename</emph> : Only when <literal>embeddeddatabase</literal> = \"CALC\" or \"FIREBIRD_EXTERNAL\", <literal>datafilename</literal> represents the file containing the tables as Calc sheets or as database tables. The file must exist or an error is raised."
msgstr ""

