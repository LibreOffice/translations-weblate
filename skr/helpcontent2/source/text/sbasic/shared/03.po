#. Dis6i
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id93158919969228\n"
"help.text"
msgid "Returns a range address as a string based on sheet coordinates, i.e. row and column numbers."
msgstr "شیٹ دے کوآرڈینیٹس دی بنیاد تے رینج دا پتہ سٹرنگ طور تے واپس کریندا ہے، یعنی قطار تے کالم دے نمبر۔"

#. 4TBiF
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id21635434153216\n"
"help.text"
msgid "If only a pair of coordinates is given, then an address to a single cell is returned. Additional arguments can specify the bottom-right cell of a rectangular range."
msgstr "اگر صرف کوآرڈینیٹس دا ہک جوڑا ݙتا ونڄے، تاں ہک اکیلے سیل دا پتہ واپس کیتا ویندا ہے۔ وݙھیک دلیلاں ہک مستطیل رینج دے تھلے سڄے سیل کوں بیان کر سڳدیاں ہن۔"

#. 2BuFG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id821591631203080\n"
"help.text"
msgid "<emph>row1, column1</emph>: Specify the row and column numbers of the top-left cell in the range to be considered. Row and column numbers start at 1."
msgstr "<emph>row1, column1</emph>: غور کیتے ونڄݨ آلی رینج وچ اُتے کھٻے سیل دی قطار تے کالم دے نمبر بیان کرو۔ قطار تے کالم دے نمبر 1 توں شروع تھیندے ہن۔"

#. i7N7S
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id821591631203212\n"
"help.text"
msgid "<emph>row2, column2</emph>: Specify the row and column numbers of the bottom-right cell in the range to be considered. If these arguments are not provided, or if values smaller than <literal>row1</literal> and <literal>column1</literal> are given, then the address of the single cell range represented by <literal>row1</literal> and <literal>column1</literal> is returned."
msgstr "<emph>row2, column2</emph>: غور کیتے ونڄݨ آلی رینج وچ تھلے سڄے سیل دی قطار تے کالم دے نمبر بیان کرو۔ اگر ایہ دلیلاں ݙتیاں کائنی ڳئیاں، یا اگر <literal>row1</literal> تے <literal>column1</literal> توں چھوٹیاں قیمتاں ݙتیاں ڳئیاں ہن، تاں <literal>row1</literal> تے <literal>column1</literal> ولوں ݙکھائے ڳئے اکیلے سیل رینج دا پتہ واپس کیتا ویندا ہے۔"

#. Egj6k
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id821591631203336\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the sheet to be appended to the returned range address. The sheet must exist. The default value is \"~\" corresponding to the currently active sheet."
msgstr "<emph>sheetname</emph>: واپس کیتے ڳئے رینج دے پتے نال جوڑی ونڄݨ آلی شیٹ دا ناں۔ شیٹ دا موجود ہووݨا ضروری ہے۔ طے شدہ قیمت \"-\" ہے جیڑھی موجودہ فعال شیٹ نال مطابقت رکھدی ہے۔"

#. idfEg
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id131611616623705\n"
"help.text"
msgid "The examples below in Basic and Python consider that \"Sheet1\" is the currently active sheet."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں Basic تے Python وچ ایہ سمجھدیاں ہن کہ \"Sheet1\" موجودہ فعال شیٹ ہے۔"

#. eXJNG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id501611617808112\n"
"help.text"
msgid "The method <literal>A1Style</literal> can be combined with any of the many properties and methods of the Calc service that require a range as argument, such as <literal>GetValue</literal>, <literal>GetFormula</literal>, <literal>ClearAll</literal>, etc."
msgstr "طریقہ <literal>A1Style</literal> Calc سروس دیاں کئی خصوصیات تے طریقاں وچوں کسے وی نال جوڑیا ونڄ سڳدا ہے جیڑھے رینج کوں دلیل طور تے منگدے ہن، جیویں <literal>GetValue</literal>، <literal>GetFormula</literal>، <literal>ClearAll</literal> وغیرہ۔"

#. Hfeug
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id93158919969864\n"
"help.text"
msgid "If the argument <literal>sheetname</literal> is provided, the given sheet is activated and it becomes the currently selected sheet. If the argument is absent, then the document window is activated."
msgstr "اگر دلیل <literal>sheetname</literal> ݙتی ونڄے، تاں ݙتی ڳئی شیٹ فعال تھی ویندی ہے تے ایہ موجودہ چُݨی ڳئی شیٹ بݨ ویندی ہے۔ اگر دلیل موجود کو، تاں دستاویز دی ونڈو فعال تھی ویندی ہے۔"

#. EhMzz
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id821591631203996\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the sheet to be activated in the document. The default value is an empty string, meaning that the document window will be activated without changing the active sheet."
msgstr "<emph>sheetname</emph>: دستاویز وچ فعال کیتی ونڄݨ آلی شیٹ دا ناں۔ طے شدہ قیمت ہک خالی سٹرنگ ہے، جیں دا مطلب ہے کہ دستاویز دی ونڈو فعال شیٹ کوں وٹائے بغیر فعال تھیسی۔"

#. 2cgiA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id131611616623714\n"
"help.text"
msgid "The example below activates the sheet named \"Sheet4\" in the currently active document."
msgstr "تھلے ݙتی ڳئی مثال موجودہ فعال دستاویز وچ \"Sheet4\" ناں آلی شیٹ کوں فعال کریندی ہے۔"

#. LRebz
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id501611617808220\n"
"help.text"
msgid "Activating a sheet makes sense only if it is performed on a Calc document. To make sure you have a Calc document at hand you can use the <literal>isCalc</literal> property of the document object, which returns <literal>True</literal> if it is a Calc document and <literal>False</literal> otherwise."
msgstr "شیٹ کوں فعال کرݨا صرف اوں ویلے سمجھ وچ آندا ہے اگر ایہ Calc دستاویز تے کیتا ونڄے۔ ایہ یقینی بݨاوݨ کیتے کہ تہاکوں کول ہک Calc دستاویز موجود ہے تساں دستاویز آبجیکٹ دی <literal>isCalc</literal> خصوصیت ورت سڳدے ہو، جیڑھی <literal>True</literal> واپس کریندی ہے اگر ایہ ہک Calc دستاویز ہووے تے <literal>False</literal> ورنہ۔"

#. fVyBd
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id241767804819943\n"
"help.text"
msgid "Align horizontally or vertically a range of cells."
msgstr "سیلاں دی رینج کوں افقی یا عمودی طور تے ترتیب ݙیوو۔"

#. GE9mT
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id361767804834191\n"
"help.text"
msgid "A filter formula can be specified to determine which cells shall be affected."
msgstr "ہک فلٹر فارمولا بیان کیتا ونڄ سڳدا ہے تاکہ ایہ طے کیتا ونڄے کہ کیڑھے سیل متاثر تھیسن۔"

#. nPgLg
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id691767804870278\n"
"help.text"
msgid "<emph>targetrange</emph>: The cell or the range as a string in which cells should be re-aligned."
msgstr "<emph>targetrange</emph>: سیل یا رینج سٹرنگ طور تے جیں وچ سیلاں کوں ولا ترتیب ݙتا ونڄݨا چاہیدا ہے۔"

#. om3C3
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id191767876299030\n"
"help.text"
msgid "<emph>alignment</emph>: a string combining 1 or 2 of next upper-case characters (other characters are ignored):"
msgstr "<emph>alignment</emph>: ہک سٹرنگ جیڑھی اڳلے وݙے حرفاں وچوں 1 یا 2 کوں جوڑدی ہے (ٻئے حرفاں کوں نظر انداز کیتا ویندا ہے):"

#. zMMu9
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id861767876487227\n"
"help.text"
msgid "L, R or C: left, right or center horizontally."
msgstr "L, R یا C: افقی طور تے کھٻا، سڄا یا وچکار۔"

#. BB9As
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id1001767881841565\n"
"help.text"
msgid "B, T or M: bottom, top or center vertically (middle)."
msgstr "B, T یا M: عمودی طور تے تھلا، اُتے یا وچکار (وچکارلا)۔"

#. iAYrD
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id41176780499844\n"
"help.text"
