#. rpvtx
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id891611613601554\n"
"help.text"
msgid "List of Methods in the FileSystem Service"
msgstr "FileSystem سروس وچ طریقاں دی تندیر"

#. EgkPG
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id871583933076448\n"
"help.text"
msgid "Joins a folder path and the name of a file and returns the full file name with a valid path separator. The path separator is added only if necessary."
msgstr "ہک فولڈر راہ تے ہک فائل دے ناں کوں جوڑدا ہے تے پورا فائل ناں ہک جائز راہ وکھرا کرݨ آلے نال واپس کریندا ہے۔ راہ وکھرا کرݨ آلا صرف اوں ویلے شامل کیتا ویندا ہے جے لوڑ ہووے۔"

#. 2pwBF
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id90158393307695\n"
"help.text"
msgid "<emph>foldername</emph>: The path with which <literal>name</literal> will be combined. The specified path does not need to be an existing folder."
msgstr "<emph>foldername</emph>: اوہ راہ جیندے نال <literal>name</literal> کوں جوڑیا ونڄسی۔ بیان کیتی ڳئی راہ دا موجودہ فولڈر ہووݨ ضروری کائنی۔"

#. xFCWJ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id891583933076975\n"
"help.text"
msgid "<emph>name</emph>: The name of the file to be appended to <literal>foldername</literal>. This parameter uses the notation of the current operating system."
msgstr "<emph>name</emph>: اوں فائل دا ناں جیڑھی <literal>foldername</literal> نال جوڑی ونڄݨی ہے۔ ایہ پیرامیٹر موجودہ آپریٹنگ سسٹم دے لکھݨ دا طریقہ ورتیندا ہے۔"

#. DwTpc
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id33160111891079\n"
"help.text"
msgid "Compares two files and returns <literal>True</literal> when they seem identical."
msgstr "ݙو فائلاں دا موازنہ کریندا ہے تے <literal>True</literal> واپس کریندا ہے جݙاں اوہ ہک جیہاں لڳدیاں ہن۔"

#. 6A5Da
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id631601119001315\n"
"help.text"
msgid "Depending on the value of the <literal>comparecontents</literal> argument, the comparison between both files can be either based only on file attributes (such as the last modified date), or based on the file contents."
msgstr "<literal>comparecontents</literal> دلیل دی قیمت تے منحصر، ݙوہاں فائلاں دے وچکار موازنہ یا تاں صرف فائل وصفاں (جیویں چھیکڑی وٹائی ڳئی تریخ) تے مبنی تھی سڳدا ہے، یا فائل مواد تے مبنی۔"

#. MGA4A
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id481601118910755\n"
"help.text"
msgid "<emph>filename1, filename2</emph>: The files to compare."
msgstr "<emph>filename1, filename2</emph>: موازنہ کرݨ آلیاں فائلاں۔"

#. aKfwh
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id111601118910848\n"
"help.text"
msgid "<emph>comparecontents</emph>: When <literal>True</literal>, the contents of the files are compared (default = <literal>False</literal>)."
msgstr "<emph>comparecontents</emph>: جݙاں <literal>True</literal> ہووے تاں فائلاں دے مواد دا موازنہ کیتا ویندا ہے (طے شدہ = <literal>False</literal>)۔"

#. EZNG5
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id161584541257982\n"
"help.text"
msgid "Copies one or more files from one location to another. Returns <literal>True</literal> if at least one file has been copied or <literal>False</literal> if an error occurred."
msgstr "ہک یا کئی فائلاں کوں ہک جاء توں ݙوجھی جاء تے نقل کریندا ہے۔ <literal>True</literal> واپس کریندا ہے جے گھٹ توں گھٹ ہک فائل نقل کیتی ڳئی ہووے یا <literal>False</literal> جے کوئی غلطی تھیئی ہووے۔"

#. xE9SU
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id401612998805699\n"
"help.text"
msgid "An error will also occur if the <literal>source</literal> parameter uses wildcard characters and does not match any files."
msgstr "ہک غلطی وی تھیسی جے <literal>source</literal> پیرامیٹر وائلڈ کارڈ حرف ورتیندا ہے تے کِسے وی فائل نال میل کائنی کھاندا۔"

#. AZCsn
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id331612998814805\n"
"help.text"
msgid "The method stops immediately after it encounters an error. The method does not roll back nor does it undo changes made before the error occurred."
msgstr "ایہ طریقہ غلطی دا سامھݨا تھیوݨ توں فوراً بعد رک ونڄدا ہے۔ ایہ طریقہ نہ تاں واپس ولدا ہے تے نہ ہی غلطی تھیوݨ توں پہلے کیتیاں ڳئیاں وٹاواں کوں واپس کریندا ہے۔"

#. aVGzZ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id1001584541257789\n"
"help.text"
msgid "<emph>source</emph>: It can be a <literal>FileName</literal> or a <literal>NamePattern</literal> indicating one or more files to be copied."
msgstr "<emph>source</emph>: ایہ ہک <literal>FileName</literal> یا ہک <literal>NamePattern</literal> تھی سڳدا ہے جیڑھا نقل کیتیاں ونڄݨ آلیاں ہک یا کئی فائلاں کوں ݙکھیندا ہے۔"

#. ycEpt
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id111584542310166\n"
"help.text"
msgid "<emph>destination</emph>: It can be either a <literal>FileName</literal> specifying where the single <literal>source</literal> file is to be copied, or a <literal>FolderName</literal> into which the multiple files from <literal>source</literal> are to be copied."
msgstr "<emph>destination</emph>: ایہ یا تاں ہک <literal>FileName</literal> تھی سڳدا ہے جیڑھا بیان کریندا ہے کہ ہکلی <literal>source</literal> فائل کتھاں نقل کیتی ونڄݨی ہے، یا ہک <literal>FolderName</literal> جیندے وچ <literal>source</literal> توں کئی فائلاں نقل کیتیاں ونڄݨیاں ہن۔"

#. frwD2
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id491612999134752\n"
"help.text"
msgid "If <literal>destination</literal> does not exist, it is created."
msgstr "جے <literal>destination</literal> موجود کائنی تاں ایہ بݨائی ویندی ہے۔"

#. z3Tok
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id591612999166788\n"
"help.text"
msgid "Wildcard characters are not allowed in <literal>destination</literal>."
msgstr "وائلڈ کارڈ حرف <literal>destination</literal> وچ منظور کائنی ہن۔"

#. zFyVX
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id251584542431558\n"
"help.text"
msgid "<emph>overwrite</emph>: If <literal>True</literal> (default), files may be overwritten. The method will fail if <literal>destination</literal> is readonly, regardless of the value specified in <literal>overwrite</literal>."
msgstr "<emph>overwrite</emph>: جے <literal>True</literal> ہووے (طے شدہ)، تاں فائلاں اوور رائٹ کیتیاں ونڄ سڳدیاں ہن۔ جے <literal>destination</literal> صرف پڑھݨ آلا ہووے تاں ایہ طریقہ ناکام تھیسی، بھاویں <literal>overwrite</literal> وچ کیڑھی وی قیمت بیان کیتی ڳئی ہووے۔"

#. uRMe8
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id691626216252568\n"
"help.text"
msgid "In the examples below the first line copies a single file whereas the second line copies multiple files using wildcards."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ پہلی لکیر ہک ہکلی فائل دی نقل کریندی ہے جݙاں جو ݙوجھی لکیر وائلڈ کارڈ ورتݨ نال کئی فائلاں دی نقل کریندی ہے۔"

#. 7xndg
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id411626216328023\n"
"help.text"
msgid "Be aware that subfolders and their contents are not copied when wildcards are used in the <emph>source</emph> argument."
msgstr "ایہ ڳالھ دھیان وچ رکھو کہ ذیلی فولڈر تے انہاں دے مواد دی نقل کائنی کیتی ویندی جݙاں <emph>source</emph> دلیل وچ وائلڈ کارڈ ورتے ونڄن۔"

#. TdGi7
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id731584544734412\n"
"help.text"
msgid "Copies one or more folders from one location to another. Returns <literal>True</literal> if at least one folder has been copied or <literal>False</literal> if an error occurred."
msgstr "ہک یا کئی فولڈراں کوں ہک جاء توں ݙوجھی جاء تے نقل کریندا ہے۔ <literal>True</literal> واپس کریندا ہے جے گھٹ توں گھٹ ہک فولڈر نقل کیتا ڳیا ہووے یا <literal>False</literal> جے کوئی غلطی تھیئی ہووے۔"

#. TSLCU
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id21612999775377\n"
"help.text"
msgid "An error will also occur if the <literal>source</literal> parameter uses wildcard characters and does not match any folders."
msgstr "ہک غلطی وی تھیسی جے <literal>source</literal> پیرامیٹر وائلڈ کارڈ حرف ورتیندا ہے تے کِسے وی فولڈر نال میل کائنی کھاندا۔"

#. m3Hzh
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id701612999808912\n"
"help.text"
msgid "The method stops immediately after it encounters an error. The method does not roll back nor does it undo changes made before the error occurred."
msgstr "ایہ طریقہ غلطی دا سامھݨا تھیوݨ توں فوراً بعد رک ونڄدا ہے۔ ایہ طریقہ نہ تاں واپس ولدا ہے تے نہ ہی غلطی تھیوݨ توں پہلے کیتیاں ڳئیاں وٹاواں کوں واپس کریندا ہے۔"

#. GCCf3
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id851584544734202\n"
"help.text"
msgid "<emph>source</emph>: It can be a <literal>FolderName</literal> or a <literal>NamePattern</literal> indicating one or more folders to be copied."
msgstr "<emph>source</emph>: ایہ ہک <literal>FolderName</literal> یا ہک <literal>NamePattern</literal> تھی سڳدا ہے جیڑھا نقل کیتے ونڄݨ آلے ہک یا کئی فولڈراں کوں ݙکھیندا ہے۔"

#. msqGq
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id321584544734273\n"
"help.text"
msgid "<emph>destination</emph>: Specifies the <literal>FolderName</literal> into which the single or multiple folders defined in <literal>source</literal> are to be copied."
msgstr "<emph>destination</emph>: اوہ <literal>FolderName</literal> بیان کریندا ہے جیندے وچ <literal>source</literal> وچ بیان کیتے ڳئے ہکلی یا کئی فولڈر نقل کیتے ونڄݨے ہن۔"

#. iLKYc
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id491612999134762\n"
"help.text"
msgid "If <literal>destination</literal> does not exist, it is created."
msgstr "جے <literal>destination</literal> موجود کائنی تاں ایہ بݨائی ویندی ہے۔"

#. TvYDS
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id591612999166740\n"
"help.text"
msgid "Wildcard characters are not allowed in <literal>destination</literal>."
msgstr "وائلڈ کارڈ حرف <literal>destination</literal> وچ منظور کائنی ہن۔"

#. 3A2C2
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id251584542431525\n"
"help.text"
msgid "<emph>overwrite</emph>: If <literal>True</literal> (default), files may be overwritten. The method will fail if <literal>destination</literal> is readonly, regardless of the value specified in <literal>overwrite</literal>."
msgstr "<emph>overwrite</emph>: جے <literal>True</literal> ہووے (طے شدہ)، تاں فائلاں اوور رائٹ کیتیاں ونڄ سڳدیاں ہن۔ جے <literal>destination</literal> صرف پڑھݨ آلا ہووے تاں ایہ طریقہ ناکام تھیسی، بھاویں <literal>overwrite</literal> وچ کیڑھی وی قیمت بیان کیتی ڳئی ہووے۔"

#. 7CxBB
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id751626216627481\n"
"help.text"
msgid "In the examples below all files, folders and subfolders are copied."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ ساریاں فائلاں، فولڈراں تے ذیلی فولڈراں دی نقل کیتی ویندی ہے۔"

#. fNBgH
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id31158454067562\n"
"help.text"
msgid "Creates the specified <literal>FolderName</literal>. Returns <literal>True</literal> if the folder could be successfully created."
msgstr "بیان کیتے ڳئے <literal>FolderName</literal> کوں بݨیندا ہے۔ <literal>True</literal> واپس کریندا ہے جے فولڈر کامیابی نال بݨایا ونڄ سڳیا ہووے۔"

#. 9H3cp
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id431613000475359\n"
"help.text"
msgid "If the specified folder has a parent folder that does not exist, it is created."
msgstr "جے بیان کیتے ڳئے فولڈر دا ہک مادری فولڈر ہووے جیڑھا موجود کائنی تاں ایہ بݨایا ویندا ہے۔"

#. 7gTts
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id491584540675469\n"
"help.text"
msgid "<emph>foldername</emph>: A string representing the folder to be created. If the folder already exists, an exception will be raised."
msgstr "<emph>foldername</emph>: ہک سٹرنگ جیڑھی بݨائے ونڄݨ آلے فولڈر کوں ݙکھیندی ہے۔ جے فولڈر پہلے توں موجود ہووے تاں ہک مستثنیٰ اٹھایا ونڄسی۔"

#. 2zcfH
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id731585322689518\n"
"help.text"
msgid "Creates a specified file and returns a <literal>TextStream</literal> service instance that can be used to write to the file."
msgstr "بیان کیتی ڳئی فائل کوں بݨیندا ہے تے ہک <literal>TextStream</literal> سروس مثال واپس کریندا ہے جیڑھی فائل وچ لکھݨ کیتے ورتی ونڄ سڳدی ہے۔"

#. YMZDA
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id821613001057759\n"
"help.text"
msgid "The method returns a <literal>Null</literal> object if an error occurred."
msgstr "جے کوئی غلطی تھیوے تاں طریقہ ہک <literal>Null</literal> آبجیکٹ واپس کریندا ہے۔"

#. 2NPVD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id901585322689715\n"
"help.text"
msgid "<emph>filename</emph>: The name of the file to be created."
msgstr "<emph>filename</emph>: بݨائی ونڄݨ آلی فائل دا ناں۔"

#. gEJA4
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id501585322689209\n"
"help.text"
msgid "<emph>overwrite</emph>: Boolean value that determines if <literal>filename</literal> can be overwritten (default = <literal>True</literal>)."
msgstr "<emph>overwrite</emph>: بولین قیمت جیڑھی ایہ طے کریندی ہے جو <literal>filename</literal> کوں ولا لکھیا ونڄ سڳدا ہے یا کائنی (طے شدہ = <literal>True</literal>)۔"

#. CkbhC
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id551585322689192\n"
"help.text"
msgid "<emph>encoding</emph>: The character set to be used. The default encoding is \"UTF-8\"."
msgstr "<emph>encoding</emph>: ورتیا ونڄݨ آلا حرفاں دا سیٹ۔ طے شدہ انکوڈنگ \"UTF-8\" ہے۔"

#. z3d9F
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id141613001281573\n"
"help.text"
msgid "To learn more about the names of character sets, visit <link href=\"https://www.iana.org/assignments/character-sets/character-sets.xhtml\">IANA's Character Set</link> page. Be aware that %PRODUCTNAME does not implement all existing character sets."
msgstr "حرفاں دے سیٹاں دے ناواں بارے ودھ جانݨ کیتے، <link href=\"https://www.iana.org/assignments/character-sets/character-sets.xhtml\">IANA's Character Set</link> ورقہ ݙیکھو۔ خبردار رہو جو %PRODUCTNAME سارے موجودہ حرف سیٹاں کوں لاڳو کائنی کریندا۔"

#. DVGxr
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id11584882040881\n"
"help.text"
msgid "Deletes one or more files. Returns <literal>True</literal> if at least one file has been deleted or <literal>False</literal> if an error occurred."
msgstr "ہک یا ودھ فائلاں کوں مٹا ݙیندا ہے۔ جے گھٹ توں گھٹ ہک فائل مٹائی ڳئی ہووے تاں <literal>True</literal> واپس کریندا ہے یا جے کوئی غلطی تھیوے تاں <literal>False</literal>۔"

#. y69YZ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id21612999775356\n"
"help.text"
msgid "An error will also occur if the <literal>filename</literal> parameter uses wildcard characters and does not match any files."
msgstr "جے <literal>filename</literal> پیرامیٹر وائلڈ کارڈ حرف ورتیندے تے کہیں فائل نال میل کائنی کھاندا تاں غلطی وی تھیسی۔"

#. TWJRd
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id21613001848493\n"
"help.text"
msgid "The files to be deleted must not be readonly."
msgstr "مٹائیاں ونڄݨ آلیاں فائلاں صرف پڑھݨ آلیاں کائنی ہوݨیاں چاہیدیاں۔"

#. PEFBq
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id701612999808832\n"
"help.text"
msgid "The method stops immediately after it encounters an error. The method does not roll back nor does it undo changes made before the error occurred."
msgstr "جݙاں طریقے کوں غلطی مِلدی ہے تاں اوہ فوراً رک ویندا ہے۔ طریقہ نہ تاں واپس ویندا ہے تے نہ ہی غلطی توں پہلے کیتیاں ڳئیاں تبدیلیاں کوں واپس کریندا ہے۔"

#. DkCdk
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id441584882040860\n"
"help.text"
msgid "<emph>filename</emph>: It can be a <literal>FileName</literal> or a <literal>NamePattern</literal> indicating one or more files to be deleted."
msgstr "<emph>filename</emph>: ایہ ہک <literal>FileName</literal> یا ہک <literal>NamePattern</literal> تھی سڳدا ہے جیڑھا مٹائیاں ونڄݨ آلیاں ہک یا ودھ فائلاں کوں ݙکھیندا ہے۔"

#. FnaSi
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id851626217167909\n"
"help.text"
msgid "In the examples below only files are deleted, subfolders are not deleted."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ صرف فائلاں مٹائیاں ویندیاں ہن، ذیلی فولڈر مٹائے کائنی ویندے۔"

#. c9ZCd
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id11584882015881\n"
"help.text"
msgid "Deletes one or more folders. Returns <literal>True</literal> if at least one folder has been deleted or <literal>False</literal> if an error occurred."
msgstr "ہک یا ودھ فولڈراں کوں مٹا ݙیندا ہے۔ جے گھٹ توں گھٹ ہک فولڈر مٹایا ڳیا ہووے تاں <literal>True</literal> واپس کریندا ہے یا جے کوئی غلطی تھیوے تاں <literal>False</literal>۔"

#. bGmGo
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id21612999775346\n"
"help.text"
msgid "An error will also occur if the <literal>foldername</literal> parameter uses wildcard characters and does not match any folders."
msgstr "جے <literal>foldername</literal> پیرامیٹر وائلڈ کارڈ حرف ورتیندے تے کہیں فولڈر نال میل کائنی کھاندا تاں غلطی وی تھیسی۔"

#. GsqDD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id21613001848853\n"
"help.text"
msgid "The folders to be deleted must not be readonly."
msgstr "مٹائے ونڄݨ آلے فولڈر صرف پڑھݨ آلے کائنی ہوݨے چاہیدے۔"

#. kRSqe
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id701612999808842\n"
"help.text"
msgid "The method stops immediately after it encounters an error. The method does not roll back nor does it undo changes made before the error occurred."
msgstr "جݙاں طریقے کوں غلطی مِلدی ہے تاں اوہ فوراً رک ویندا ہے۔ طریقہ نہ تاں واپس ویندا ہے تے نہ ہی غلطی توں پہلے کیتیاں ڳئیاں تبدیلیاں کوں واپس کریندا ہے۔"

#. 7YCXM
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id451584882542247\n"
"help.text"
msgid "<emph>foldername</emph>: It can be a <literal>FolderName</literal> or a <literal>NamePattern</literal> indicating one or more folders to be deleted."
msgstr "<emph>foldername</emph>: ایہ ہک <literal>FolderName</literal> یا ہک <literal>NamePattern</literal> تھی سڳدا ہے جیڑھا مٹائے ونڄݨ آلے ہک یا ودھ فولڈراں کوں ݙکھیندا ہے۔"

#. cCnG9
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id651626217314709\n"
"help.text"
msgid "In the examples below only folders and their contents are deleted. Files in the parent folder \"C:\\Temp\" are not deleted."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ صرف فولڈر تے انہاں دا مواد مٹایا ویندا ہے۔ ماپی فولڈر \"C:\\Temp\" وچ موجود فائلاں مٹائیاں کائنی ویندیاں۔"

#. gSG9s
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id11584882015025\n"
"help.text"
msgid "Returns a string containing the folder where the specified extension package is installed."
msgstr "اوہ فولڈر رکھݨ آلی ہک تند واپس کریندا ہے جتھاں بیان کیتی ڳئی ایکسٹینشن پیکج انسٹال کیتی ڳئی ہے۔"

#. pJWi2
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id711658780480236\n"
"help.text"
msgid "The current value of the property <literal>SF_FileSystem.FileNaming</literal> is used to determine the notation of the returned string."
msgstr "خصوصیت <literal>SF_FileSystem.FileNaming</literal> دی موجودہ قیمت واپس کیتی ڳئی تند دے لکھݨ دا طریقہ طے کرݨ کیتے ورتی ویندی ہے۔"

#. 3R4jx
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id891644442917193\n"
"help.text"
msgid "Use the property <link href=\"text/sbasic/shared/03/sf_platform.xhp#hd_id711600788076834\"><literal>Extensions</literal></link> from the <literal>Platform</literal> service to get string array with the IDs of all installed extensions."
msgstr "ساریاں انسٹال کیتیاں ڳئیاں ایکسٹینشنز دیاں IDs آلی تنداں دی صف حاصل کرݨ کیتے <literal>Platform</literal> سروس دی <link href=\"text/sbasic/shared/03/sf_platform.xhp#hd_id711600788076834\"><literal>Extensions</literal></link> خصوصیت ورتو۔"

#. w9vDF
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id451584882542121\n"
"help.text"
msgid "<emph>extension</emph>: A string value with the ID of the extension. If the extension is not installed, an exception is raised."
msgstr "<emph>extension</emph>: ایکسٹینشن دی ID آلی ہک تند قیمت۔ جے ایکسٹینشن انسٹال کائنی تھئی تاں مستثنیٰ اٹھایا ویندا ہے۔"

#. YhQmv
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id651626217313369\n"
"help.text"
msgid "The examples below in Basic and Python return the folder where the APSO extension is installed."
msgstr "تھلے Basic تے Python وچ ݙتیاں ڳئیاں مثالاں اوہ فولڈر واپس کریندیاں ہن جتھاں APSO ایکسٹینشن انسٹال کیتی ڳئی ہے۔"

#. ZbyLn
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id161583764426709\n"
"help.text"
msgid "Returns <literal>True</literal> if a given file name is valid and exists, otherwise the method returns <literal>False</literal>."
msgstr "جے ݙتی ڳئی فائل دا ناں درست ہووے تے موجود ہووے تاں <literal>True</literal> واپس کریندا ہے، ݙوجھی صورت وچ طریقہ <literal>False</literal> واپس کریندا ہے۔"

#. 7j5TN
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id91613003122613\n"
"help.text"
msgid "If the <literal>filename</literal> parameter is actually an existing folder name, the method returns <literal>False</literal>."
msgstr "جے <literal>filename</literal> پیرامیٹر اصل وچ موجود فولڈر دا ناں ہووے تاں طریقہ <literal>False</literal> واپس کریندا ہے۔"

#. fr2Ei
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id361583764426547\n"
"help.text"
msgid "<emph>filename</emph>: A string representing the file to be tested."
msgstr "<emph>filename</emph>: جانچݨ آلی فائل کوں ݙکھیندڑی ہک تند۔"

#. Cpp7b
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id11158394432779\n"
"help.text"
msgid "Returns a zero-based array (BASIC) or tuple (Python) of the files stored in a given folder. Each entry in the array or tuple is a string containing the full path and file name."
msgstr "ݙتے ڳئے فولڈر وچ محفوظ فائلاں دی صفر توں شروع تھیوݨ آلی صف (BASIC) یا ٹپل (Python) واپس کریندا ہے۔ صف یا ٹپل دی ہر انٹری ہک تند ہے جیندے وچ مکمل پاتھ تے فائل دا ناں ہوندا ہے۔"

#. JVjE3
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id641613003790120\n"
"help.text"
msgid "If the argument <literal>foldername</literal> specifies a folder that does not exist, an exception is raised."
msgstr "جے دلیل <literal>foldername</literal> کہیں اینجھے فولڈر کوں بیان کریندی ہے جیڑھا موجود کائنی تاں مستثنیٰ اٹھایا ویندا ہے۔"

#. nFaPD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id821613003779799\n"
"help.text"
msgid "The resulting list may be filtered with wildcards."
msgstr "نتیجے وچ آوݨ آلی تندیر کوں وائلڈ کارڈز نال فلٹر کیتا ونڄ سڳدا ہے۔"

#. bq6vD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id731583944543140\n"
"help.text"
msgid "<emph>foldername</emph>: A string representing a folder. The folder must exist. This argument must not designate a file."
msgstr "<emph>foldername</emph>: ہک فولڈر کوں ݙکھیندڑی ہک تند۔ فولڈر ضرور موجود ہووے۔ ایہ دلیل کہیں فائل دی نشاندہی کائنی کرݨی چاہیدی۔"

#. EM5cJ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id591585648450060\n"
"help.text"
msgid "<emph>filter</emph>: A string containing wildcards (\"?\" and \"*\") that will be applied to the resulting list of files (default = \"\")."
msgstr "<emph>filter</emph>: وائلڈ کارڈز (\"?\" تے \"*\") رکھݨ آلی ہک تند جیڑھی فائلاں دی نتیجے والی تندیر تے لاڳو کیتی ویسی (طے شدہ = \"\")۔"

#. DpWGe
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id731583944543907\n"
"help.text"
msgid "<emph>includesubfolders</emph>: Set this argument to <literal>True</literal> to include the contents of subfolders (Default = <literal>False</literal>)."
msgstr "<emph>includesubfolders</emph>: ذیلی فولڈراں دا مواد شامل کرݨ کیتے ایہ دلیل <literal>True</literal> تے مقرر کرو (طے شدہ = <literal>False</literal>)۔"

#. snMqC
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"bas_id901701437618763\n"
"help.text"
msgid "' Returns all files matching the \"*.txt\" filter, including files in subfolders"
msgstr ""

#. zG7ec
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id51583765642590\n"
"help.text"
msgid "Returns <literal>True</literal> if the specified <literal>FolderName</literal> is valid and exists, otherwise the method returns <literal>False</literal>."
msgstr "جے بیان کیتا ڳیا <literal>FolderName</literal> درست ہووے تے موجود ہووے تاں <literal>True</literal> واپس کریندا ہے، ݙوجھی صورت وچ طریقہ <literal>False</literal> واپس کریندا ہے۔"

#. 9xtCG
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id151613004111990\n"
"help.text"
msgid "If the <literal>foldername</literal> parameter is actually an existing file name, the method returns <literal>False</literal>."
msgstr "جے <literal>foldername</literal> پیرامیٹر اصل وچ موجود فائل دا ناں ہووے تاں طریقہ <literal>False</literal> واپس کریندا ہے۔"

#. qrf4A
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id1001583765642211\n"
"help.text"
msgid "<emph>foldername</emph>: A string representing the folder to be tested."
msgstr "<emph>foldername</emph>: جانچݨ آلے فولڈر کوں ݙکھیندڑی ہک تند۔"

#. eAFVs
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id521584110618989\n"
"help.text"
msgid "Returns the <literal>BaseName</literal> (equal to the last component) of a folder or file name, without its extension."
msgstr "فولڈر یا فائل دے ناں دا <literal>BaseName</literal> (چھیکڑے جزو دے برابر) واپس کریندا ہے، بغیر اوندے ایکسٹینشن دے۔"

#. YnBXv
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id731613004316790\n"
"help.text"
msgid "The method does not check if the specified file or folder exists."
msgstr "طریقہ ایہ جانچ کائنی کریندا جو بیان کیتی ڳئی فائل یا فولڈر موجود ہے۔"

#. 3FPjB
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id691584110618308\n"
"help.text"
msgid "<emph>filename</emph>: A string representing the file name and its path."
msgstr "<emph>filename</emph>: فائل دا ناں تے اوندا پاتھ ݙکھیندڑی ہک تند۔"

#. jwFaP
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id1001626271201609\n"
"help.text"
msgid "In the examples below, the first <literal>GetBaseName</literal> method call corresponds to a folder, so the function returns the last component of the path. The second call receives a file name as input, so the name of the file is returned without its extension."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ، پہلی <literal>GetBaseName</literal> طریقہ کال ہک فولڈر نال میل کھاندی ہے، تاں فنکشن پاتھ دا چھیکڑا جزو واپس کریندا ہے۔ ݙوجھی کال ان پٹ دے طور تے ہک فائل دا ناں لیندی ہے، تاں فائل دا ناں بغیر اوندے ایکسٹینشن دے واپس کیتا ویندا ہے۔"

#. A56XC
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id831584032680866\n"
"help.text"
msgid "Returns the extension part of a file or folder name without the dot \".\" character."
msgstr "فائل یا فولڈر دے ناں دا ایکسٹینشن والا حصہ واپس کریندا ہے، بغیر نقطہ \".\" حرف دے۔"

#. pdCJv
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id941613060736524\n"
"help.text"
msgid "The method does not check for the existence of the specified file or folder."
msgstr "طریقہ بیان کیتی ڳئی فائل یا فولڈر دے وجود دی جانچ کائنی کریندا۔"

#. Aqvwt
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id561613060896361\n"
"help.text"
msgid "If this method is applied to a folder name or to a file without an extension, then an empty string is returned."
msgstr "جے ایہ طریقہ کہیں فولڈر دے ناں تے یا بغیر ایکسٹینشن آلی فائل تے لاڳو کیتا ونڄے تاں ہک خالی تند واپس کیتی ویندی ہے۔"

#. NzK5z
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id821584032680311\n"
"help.text"
msgid "<emph>filename</emph>: A string representing the file name and its path."
msgstr "<emph>filename</emph>: فائل دا ناں تے اوندا پاتھ ݙکھیندڑی ہک تند۔"

#. Am6Bu
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id48160068505010\n"
"help.text"
msgid "The builtin <literal>FileLen</literal> Basic function returns the number of bytes contained in a file as a <literal>Long</literal> value, i.e. up to 2GB."
msgstr "بلٹ ان <literal>FileLen</literal> Basic فنکشن ہک فائل وچ موجود بائٹس دی گݨتری کوں <literal>Long</literal> قیمت دے طور تے واپس کریندا ہے، یعنی 2GB تائیں۔"

#. 2FHpa
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id571613061005426\n"
"help.text"
msgid "The <literal>GetFileLen</literal> method can handle files with much larger sizes by returning a <literal>Currency</literal> value."
msgstr "<literal>GetFileLen</literal> طریقہ <literal>Currency</literal> قیمت واپس کر کے بوہت وڈے سائز آلیاں فائلاں کوں سنبھال سڳدا ہے۔"

#. PK2Fo
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id161600685050367\n"
"help.text"
msgid "<emph>filename</emph>: A string representing an existing file."
msgstr "<emph>filename</emph>: موجود فائل کوں ݙکھیندڑی ہک تند۔"

#. o2GGJ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id191584811478936\n"
"help.text"
msgid "Returns the last modified date of a given file."
msgstr "ݙتی ڳئی فائل دی چھیکڑی وار وٹائی ڳئی تریخ واپس کریندا ہے۔"

#. VMB4i
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id25158481147822\n"
"help.text"
msgid "<emph>filename</emph>: A string representing an existing file."
msgstr "<emph>filename</emph>: موجود فائل کوں ݙکھیندڑی ہک تند۔"

#. VEZR6
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id711584032366587\n"
"help.text"
msgid "Returns the last component of a file or folder name in native operating system format."
msgstr "فائل یا فولڈر دے ناں دا چھیکڑا جزو مقامی آپریٹنگ سسٹم دے فارمیٹ وچ واپس کریندا ہے۔"

#. 4vAvz
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id541613061300811\n"
"help.text"
msgid "The method does not check if the specified file or folder exists."
msgstr "طریقہ ایہ جانچ کائنی کریندا جو بیان کیتی ڳئی فائل یا فولڈر موجود ہے۔"

#. iajZD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id671584032366193\n"
"help.text"
msgid "<emph>filename</emph>: A string representing the file name and its path."
msgstr "<emph>filename</emph>: فائل دا ناں تے اوندا پاتھ ݙکھیندڑی ہک تند۔"

#. ffxFe
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id871584113432747\n"
"help.text"
msgid "Returns a string containing the name of the parent folder of a specified file or folder name."
msgstr "بیان کیتی ڳئی فائل یا فولڈر دے ناں دے ماپی فولڈر دا ناں رکھݨ آلی ہک تند واپس کریندا ہے۔"

#. 2eBgA
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id611613061603039\n"
"help.text"
msgid "The method does not check if the specified file or folder exists."
msgstr "طریقہ ایہ جانچ کائنی کریندا جو بیان کیتی ڳئی فائل یا فولڈر موجود ہے۔"

#. YUAQ3
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id471584113432231\n"
"help.text"
msgid "<emph>filename</emph>: A string with the file or folder name to be analyzed."
msgstr "<emph>filename</emph>: تجزیہ کرݨ آلی فائل یا فولڈر دے ناں آلی ہک تند۔"

#. Uc93M
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id82158385117289\n"
"help.text"
msgid "Returns a randomly generated temporary file name that is useful for performing operations that require a temporary file."
msgstr "بے ترتیب طور تے بݨایا ڳیا ہک عارضی فائل دا ناں واپس کریندا ہے جیڑھا اینجھے کم کرݨ کیتے کارآمد ہے جیندے کیتے عارضی فائل دی لوڑ ہووے۔"

#. 7saEX
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id391613061770924\n"
"help.text"
msgid "By default, the returned file name does not have an extension. Use the <literal>extension</literal> parameter to specify the extension of the file name to be generated."
msgstr "طے شدہ طور تے، واپس کیتے ڳئے فائل دے ناں دی کوئی ایکسٹینشن کائنی ہوندی۔ بݨائی ونڄݨ آلے فائل دے ناں دی ایکسٹینشن بیان کرݨ کیتے <literal>extension</literal> پیرامیٹر ورتو۔"

#. FTQwD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id251689599133544\n"
"help.text"
msgid "The folder part of the returned string is the system's temporary folder."
msgstr "واپس کیتی ڳئی تند دا فولڈر والا حصہ سسٹم دا عارضی فولڈر ہے۔"

#. W7gF7
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id971613061774934\n"
"help.text"
msgid "The method does not create the temporary file."
msgstr "طریقہ عارضی فائل کائنی بݨیندا۔"

#. pDA3H
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id471584113435991\n"
"help.text"
msgid "<emph>extension</emph>: The extension of the temporary file name (Default = \"\")."
msgstr "<emph>extension</emph>: عارضی فائل دے ناں دی ایکسٹینشن (طے شدہ = \"\")۔"

#. ch2AJ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id58160104251423\n"
"help.text"
msgid "Hash functions are used by some cryptographic algorithms, in digital signatures, message authentication codes, fraud detection, fingerprints, checksums (message integrity check), hash tables, password storage and much more."
msgstr "ہیش فنکشنز کجھ کرپٹوگرافک الگورتھمز وچ ورتے ویندے ہن، ڈیجیٹل دستخطاں وچ، سنیہا تصدیق کوڈاں وچ، فراڈ دی ڳول وچ، فنگر پرنٹس وچ، چیک سمز (سنیہے دی سالمیت دی جانچ) وچ، ہیش ٹیبلز وچ، پاس ورڈ محفوظ کرݨ وچ تے ٻہوں کجھ ہور وچ۔"

#. qxDnP
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id301601042791356\n"
"help.text"
msgid "The <literal>HashFile</literal> method returns the result of a hash function, applied on a given file and using a specified algorithm. The returned value is a string of lower-case hexadecimal digits."
msgstr "<literal>HashFile</literal> طریقہ ہک ہیش فنکشن دا نتیجہ واپس کریندا ہے، جیڑھا ݙتی ڳئی فائل تے بیان کیتے ڳئے الگورتھم نال لاڳو کیتا ڳیا ہووے۔ واپس کیتی ڳئی قیمت چھوٹے حرفاں والے ہیکساڈیسیمل ہندسیاں دی ہک تند ہے۔"

#. eAW33
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id861601043268484\n"
"help.text"
msgid "The hash algorithms supported are: <literal>MD5</literal>, <literal>SHA1</literal>, <literal>SHA224</literal>, <literal>SHA256</literal>, <literal>SHA384</literal> and <literal>SHA512</literal>."
msgstr "مدد کیتے ونڄݨ آلے ہیش الگورتھم ایہ ہن: <literal>MD5</literal>، <literal>SHA1</literal>، <literal>SHA224</literal>، <literal>SHA256</literal>، <literal>SHA384</literal> تے <literal>SHA512</literal>۔"

#. s5ZiA
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id28160104251451\n"
"help.text"
msgid "<emph>filename</emph>: A string representing an existing file."
msgstr "<emph>filename</emph>: موجود فائل کوں ݙکھیندڑی ہک تند۔"

#. Eomhm
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id71601042959846\n"
"help.text"
msgid "<emph>algorithm</emph>: One of the supported algorithms."
msgstr "<emph>algorithm</emph>: مدد کیتے ونڄݨ آلے الگورتھمز وچوں ہک۔"

#. HzFs2
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id51584791330688\n"
"help.text"
msgid "Moves one or more files from one location to another. Returns <literal>True</literal> if at least one file has been moved or <literal>False</literal> if an error occurred."
msgstr "ہک یا ودھ فائلاں کوں ہک جاہ توں ݙوجھی جاہ تے منتقل کریندا ہے۔ جے گھٹ توں گھٹ ہک فائل منتقل کیتی ڳئی ہووے تاں <literal>True</literal> واپس کریندا ہے یا جے کوئی غلطی تھیوے تاں <literal>False</literal>۔"

#. RFrNE
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id631613062890648\n"
"help.text"
msgid "An error will also occur if the <literal>source</literal> parameter uses wildcard characters and does not match any files."
msgstr "جے <literal>source</literal> پیرامیٹر وائلڈ کارڈ حرف ورتیندے تے کہیں فائل نال میل کائنی کھاندا تاں غلطی وی تھیسی۔"

#. ETmEP
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id241613062902777\n"
"help.text"
msgid "The method stops immediately after it encounters an error. The method does not roll back nor does it undo changes made before the error occurred."
msgstr "جݙاں طریقے کوں غلطی مِلدی ہے تاں اوہ فوراً رک ویندا ہے۔ طریقہ نہ تاں واپس ویندا ہے تے نہ ہی غلطی توں پہلے کیتیاں ڳئیاں تبدیلیاں کوں واپس کریندا ہے۔"

#. DbC6F
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id721584791330406\n"
"help.text"
msgid "<emph>source</emph>: It can be a <literal>FileName</literal> or <literal>NamePattern</literal> to designate one or more files to be moved."
msgstr "<emph>source</emph>: ایہ ہک <literal>FileName</literal> یا <literal>NamePattern</literal> تھی سڳدا ہے جیڑھا منتقل کیتیاں ونڄݨ آلیاں ہک یا ودھ فائلاں کوں بیان کریندا ہے۔"

#. BHa7Y
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id291584791330181\n"
"help.text"
msgid "<emph>destination</emph>: If <literal>source</literal> is a <literal>FileName</literal> then this parameter indicates the new path and file name of the moved file."
msgstr "<emph>destination</emph>: جے <literal>source</literal> ہک <literal>FileName</literal> ہووے تاں ایہ پیرامیٹر منتقل کیتی ڳئی فائل دا نواں پاتھ تے فائل دا ناں ݙکھیندا ہے۔"

#. ZzA3Y
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id31613063334246\n"
"help.text"
msgid "If the move operation involves multiple files, then <literal>destination</literal> must be a folder name. If it does not exist, it is created."
msgstr "جے منتقل کرݨ دے کم وچ ہک توں ودھ فائلاں شامل ہوون تاں <literal>destination</literal> ہک فولڈر دا ناں ہوݨا چاہیدا ہے۔ جے اوہ موجود کائنی تاں اوہ بݨا ݙتا ویندا ہے۔"

#. 39oR8
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id391613063494599\n"
"help.text"
msgid "If <literal>source</literal> and <literal>destination</literal> have the same parent folder, the method will rename the <literal>source</literal>."
msgstr "جے <literal>source</literal> تے <literal>destination</literal> دا ماپی فولڈر ہکو ہووے تاں طریقہ <literal>source</literal> دا ناں بدل ݙیسی۔"

#. 7bzK4
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id941613063476533\n"
"help.text"
msgid "Wildcard characters are not allowed in <literal>destination</literal>."
msgstr "وائلڈ کارڈ حرف <literal>destination</literal> وچ اجازت کائنی رکھدے۔"

#. Bysqd
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id91626272612758\n"
"help.text"
msgid "In the following examples only files are moved, subfolders are not."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں وچ صرف فائلاں منتقل کیتیاں ویندیاں ہن، ذیلی فولڈر منتقل کائنی کیتے ویندے۔"

#. iYBMe
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id301584791330868\n"
"help.text"
msgid "Moves one or more folders from one location to another. Returns <literal>True</literal> if at least one folder has been moved or <literal>False</literal> if an error occurred."
msgstr "ہک یا ودھ فولڈراں کوں ہک جاہ توں ݙوجھی جاہ تے منتقل کریندا ہے۔ جے گھٹ توں گھٹ ہک فولڈر منتقل کیتا ڳیا ہووے تاں <literal>True</literal> واپس کریندا ہے یا جے کوئی غلطی تھیوے تاں <literal>False</literal>۔"

#. RHjYG
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id411613072570664\n"
"help.text"
msgid "An error will also occur if the <literal>source</literal> parameter uses wildcard characters and does not match any folders."
msgstr "جے <literal>source</literal> پیرامیٹر وائلڈ کارڈ حرف ورتیندے تے کہیں فولڈر نال میل کائنی کھاندا تاں غلطی وی تھیسی۔"

#. F2DaD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id601613072595264\n"
"help.text"
msgid "The method stops immediately after it encounters an error. The method does not roll back nor does it undo changes made before the error occurred."
msgstr "جݙاں طریقے کوں غلطی مِلدی ہے تاں اوہ فوراً رک ویندا ہے۔ طریقہ نہ تاں واپس ویندا ہے تے نہ ہی غلطی توں پہلے کیتیاں ڳئیاں تبدیلیاں کوں واپس کریندا ہے۔"

#. xVGBy
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id541584791330777\n"
"help.text"
msgid "<emph>source</emph>: It can be a <literal>FolderName</literal> or <literal>NamePattern</literal> to designate one or more folders to be moved."
msgstr "<emph>source</emph>: ایہ ہک <literal>FolderName</literal> یا <literal>NamePattern</literal> تھی سڳدا ہے جیڑھا منتقل کیتے ونڄݨ آلے ہک یا ودھ فولڈراں کوں بیان کریندا ہے۔"

#. 4Ampu
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id551584791330279\n"
"help.text"
msgid "<emph>destination</emph>: If the move operation involves a single folder, then <literal>destination</literal> is the name and path of the moved folder and it must not exist."
msgstr "<emph>destination</emph>: جے منتقل کرݨ دے کم وچ ہک فولڈر شامل ہووے تاں <literal>destination</literal> منتقل کیتے ڳئے فولڈر دا ناں تے پاتھ ہے تے اوہ موجود کائنی ہوݨا چاہیدا۔"

#. dD7SB
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id11613072890641\n"
"help.text"
msgid "If multiple folders are being moved, then <literal>destination</literal> designates where the folders in <literal>source</literal> will be moved into. If <literal>destination</literal> does not exist, it is created."
msgstr "جے ہک توں ودھ فولڈر منتقل کیتے ونڄݨے ہوون تاں <literal>destination</literal> ایہ ݙکھیندا ہے جو <literal>source</literal> وچ موجود فولڈر کتھاں منتقل کیتے ونڄݨے ہن۔ جے <literal>destination</literal> موجود کائنی تاں اوہ بݨا ݙتا ویندا ہے۔"

#. A69QS
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id301613072928159\n"
"help.text"
msgid "Wildcard characters are not allowed in <literal>destination</literal>."
msgstr "وائلڈ کارڈ حرف <literal>destination</literal> وچ اجازت کائنی رکھدے۔"

#. DqpaF
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id871583670342051\n"
"help.text"
msgid "Returns a string containing the normalized path name by collapsing redundant separators and up-level references."
msgstr "وادھو وکھرا کرݨ آلے تے اُتے والے درجے دے حوالے سمیٹ کر کے معمول مطابق پاتھ دا ناں رکھݨ آلی ہک تند واپس کریندا ہے۔"

#. heCzw
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id541658780038027\n"
"help.text"
msgid "For instance, the path names <literal>A//B</literal>, <literal>A/B/</literal>, <literal>A/./B</literal> and <literal>A/foo/../B</literal> are all normalized to <literal>A/B</literal>."
msgstr "مثال دے طور تے، پاتھ دے ناں <literal>A//B</literal>، <literal>A/B/</literal>، <literal>A/./B</literal> تے <literal>A/foo/../B</literal> سارے <literal>A/B</literal> وچ معمول مطابق بݨا ݙتے ویندے ہن۔"

#. A6mAb
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id881613074436118\n"
"help.text"
msgid "On Windows, forward slashes \"/\" are converted to backward slashes \"\\\"."
msgstr "Windows تے، اڳوں والے سلیش \"/\" پچھوں والے سلیش \"\\\" وچ بدل ݙتے ویندے ہن۔"

#. 56xkN
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id381658780455018\n"
"help.text"
msgid "The current value of the property <literal>SF_FileSystem.FileNaming</literal> is used to determine the notation of the <literal>filename</literal> argument as well as the format of the returned string."
msgstr "خصوصیت <literal>SF_FileSystem.FileNaming</literal> دی موجودہ قیمت <literal>filename</literal> دلیل دے لکھݨ دا طریقہ تے واپس کیتی ڳئی تند دا فارمیٹ طے کرݨ کیتے ورتی ویندی ہے۔"

#. G9ARW
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id481583670340107\n"
"help.text"
msgid "<emph>filename</emph>: a string representing a valid path name. The file or directory represented by this argument may not exist."
msgstr "<emph>filename</emph>: ہک درست پاتھ دے ناں کوں ݙکھیندڑی ہک تند۔ ایہ دلیل جیڑھی فائل یا ڈائریکٹری کوں ݙکھیندی ہے، اوہ موجود کائنی تھی سڳدی۔"

#. JNTia
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id121585320922117\n"
"help.text"
msgid "Opens a file and returns a <literal>TextStream</literal> object that can be used to read from, write to, or append to the file."
msgstr "ہک فائل کوں کھولیندا ہے تے ہک <literal>TextStream</literal> آبجیکٹ واپس کریندا ہے جیڑھا فائل توں پڑھݨ، اوندے وچ لکھݨ یا اوندے وچ ودھاوݨ کیتے ورتیا ونڄ سڳدا ہے۔"

#. ePMpQ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id591613073104711\n"
"help.text"
msgid "Note that the method does not check if the given file is really a text file."
msgstr "دھیان دیو جو طریقہ ایہ جانچ کائنی کریندا جو ݙتی ڳئی فائل واقعی ہک عبارت فائل ہے۔"

#. SGJCd
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id951613073135036\n"
"help.text"
msgid "The method returns a <literal>Null</literal> object (in Basic) or <literal>None</literal> (in Python) if an error occurred."
msgstr "جے کوئی غلطی تھیوے تاں طریقہ ہک <literal>Null</literal> آبجیکٹ (Basic وچ) یا <literal>None</literal> (Python وچ) واپس کریندا ہے۔"

#. mxuwo
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id551585320922678\n"
"help.text"
msgid "<emph>filename</emph>: Identifies the file to open."
msgstr "<emph>filename</emph>: کھولݨ آلی فائل دی نشاندہی کریندا ہے۔"

#. tsRLR
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id671585320922388\n"
"help.text"
msgid "<emph>iomode</emph>: Indicates the input/output mode. It can be one of three constants: <literal>svc.ForReading</literal> (default), <literal>svc.ForWriting</literal>, or <literal>svc.ForAppending</literal>."
msgstr "<emph>iomode</emph>: ان پٹ/آؤٹ پٹ موڈ کوں ݙکھیندا ہے۔ ایہ تِناں مستقلاں وچوں ہک تھی سڳدا ہے: <literal>svc.ForReading</literal> (طے شدہ)، <literal>svc.ForWriting</literal>، یا <literal>svc.ForAppending</literal>۔"

#. z27vT
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id21585321398586\n"
"help.text"
msgid "<emph>create</emph>: Boolean value that indicates whether a new file can be created if the specified <literal>filename</literal> doesn't exist:"
msgstr "<emph>create</emph>: بولین قیمت جیڑھی ایہ ݙکھیندی ہے جو جے بیان کیتی ڳئی <literal>filename</literal> موجود کائنی تاں نویں فائل بݨائی ونڄ سڳدی ہے یا کائنی:"

#. VDFAi
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id721613073434797\n"
"help.text"
msgid "If <literal>True</literal> a new file and its parent folders will be created if they do not exist;"
msgstr "جے <literal>True</literal> ہووے تاں ہک نویں فائل تے اوندے ماپی فولڈر بݨا ݙتے ونڄݨے جے اوہ موجود کائنی ہون۔"

#. EypVC
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id201613073469289\n"
"help.text"
msgid "If <literal>False</literal> then new files are not created (default)."
msgstr "جے <literal>False</literal> ہووے تاں نویاں فائلاں بݨائیاں کائنی ویندیاں (طے شدہ)۔"

#. wjGYH
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id771585321576210\n"
"help.text"
msgid "<emph>encoding</emph>: The character set to be used. The default encoding is \"UTF-8\"."
msgstr "<emph>encoding</emph>: ورتیا ونڄݨ آلا حرفاں دا سیٹ۔ طے شدہ انکوڈنگ \"UTF-8\" ہے۔"

#. FuYwe
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id871583670342501\n"
"help.text"
msgid "Opens a dialog box to open or save files."
msgstr "فائلاں کوں کھولݨ یا محفوظ کرݨ کیتے ہک ڈائیلاگ بکس کھولیندا ہے۔"

#. SjDBv
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id881613074436979\n"
"help.text"
msgid "If the <literal>SAVE</literal> mode is set and the picked file exists, a warning message will be displayed."
msgstr "جے <literal>SAVE</literal> موڈ مقرر کیتا ڳیا ہووے تے چُݨی ڳئی فائل موجود ہووے تاں خبرداری آلا ہک سنیہا ݙکھایا ویسی۔"

#. YgsLZ
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id481583670342502\n"
"help.text"
msgid "<emph>defaultfile</emph>: This argument is a string composed of a folder and file name:"
msgstr "<emph>defaultfile</emph>: ایہ دلیل ہک فولڈر تے فائل دے ناں تے مشتمل ہک تند ہے:"

#. fyVCs
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id511613074665951\n"
"help.text"
msgid "The folder part indicates the folder that will be shown when the dialog opens (default = the last selected folder)."
msgstr "فولڈر والا حصہ اوہ فولڈر ݙکھیندا ہے جیڑھا ڈائیلاگ کھلݨ ویلے ݙکھایا ویسی (طے شدہ = چھیکڑی چُݨیا ڳیا فولڈر)۔"

#. xs5hU
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id631613074685308\n"
"help.text"
msgid "The file part designates the default file to open or save."
msgstr "فائل والا حصہ کھولݨ یا محفوظ کرݨ آلی طے شدہ فائل دی نشاندہی کریندا ہے۔"

#. fBHyg
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id981583670342502\n"
"help.text"
msgid "<emph>mode</emph>: A string value that can be either \"OPEN\" (for input files) or \"SAVE\" (for output files). The default value is \"OPEN\"."
msgstr "<emph>mode</emph>: ہک تند قیمت جیڑھی یا تاں \"OPEN\" (ان پٹ فائلاں کیتے) یا \"SAVE\" (آؤٹ پٹ فائلاں کیتے) تھی سڳدی ہے۔ طے شدہ قیمت \"OPEN\" ہے۔"

#. uvwDP
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id31583670342502\n"
"help.text"
msgid "<emph>filter</emph>: The extension of the files displayed when the dialog is opened (default = no filter)."
msgstr "<emph>filter</emph>: ڈائیلاگ کھلݨ ویلے ݙکھائیاں ونڄݨ آلیاں فائلاں دی ایکسٹینشن (طے شدہ = کوئی فلٹر کائنی)۔"

#. niaGR
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id881626276134300\n"
"help.text"
msgid "The examples below open a file picker with the \"txt\" filter applied."
msgstr "تھلے ݙتیاں ڳئیاں مثالاں \"txt\" فلٹر لاڳو کر کے ہک فائل چُݨݨ آلا کھولیندیاں ہن۔"

#. HkwaR
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id521583671701777\n"
"help.text"
msgid "Opens a dialog box to select a folder."
msgstr "ہک فولڈر چُݨݨ کیتے ہک ڈائیلاگ بکس کھولیندا ہے۔"

#. mG6QD
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id951583671701872\n"
"help.text"
msgid "<emph>defaultfolder</emph>: A string containing the folder name that will be displayed when the dialog is opened (default = the last selected folder)."
msgstr "<emph>defaultfolder</emph>: ڈائیلاگ کھلݨ ویلے ݙکھایا ونڄݨ آلے فولڈر دا ناں رکھݨ آلی ہک تند (طے شدہ = چھیکڑی چُݨیا ڳیا فولڈر)۔"

#. Bq4ZM
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id561776091933025\n"
"help.text"
msgid "<emph>title</emph>: Text to display in the dialog header. The default is set by the desktop environment."
msgstr "<emph>title</emph>: ڈائیلاگ ہیڈر وچ ݙکھاوݨ آلی عبارت۔ طے شدہ ڈیسک ٹاپ ماحول ولوں مقرر کیتی ویندی ہے۔"

#. jUosF
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id821583671701764\n"
"help.text"
msgid "<emph>freetext</emph>: Text to display in the dialog (default = \"\"). This parameter is deprecated."
msgstr "<emph>freetext</emph>: ڈائیلاگ وچ ݙکھاوݨ آلی عبارت (طے شدہ = \"\")۔ ایہ پیرامیٹر متروک ہے۔"

#. 4FFby
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"bas_id921583671701610\n"
"help.text"
msgid "aFolder = FSO.PickFolder(\"C:\\Documents\", \"Choose a folder or press Cancel\")"
msgstr ""

#. nW8Rx
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"pyc_id631626276402296\n"
"help.text"
msgid "aFolder = fs.PickFolder(r\"C:\\Documents\", \"Choose a folder or press Cancel\")"
msgstr ""

#. xdfBh
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id431584016761996\n"
"help.text"
msgid "Returns a zero-based array of strings corresponding to the folders stored in a given <literal>foldername</literal>."
msgstr "ݙتے ڳئے <literal>foldername</literal> وچ محفوظ فولڈراں نال میل کھاندڑی تنداں دی صفر توں شروع تھیوݨ آلی صف واپس کریندا ہے۔"

#. LVNZq
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id431613075267241\n"
"help.text"
msgid "The list may be filtered with wildcards."
msgstr "تندیر کوں وائلڈ کارڈز نال فلٹر کیتا ونڄ سڳدا ہے۔"

#. 7pDiA
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id701584016761945\n"
"help.text"
msgid "<emph>foldername</emph>: A string representing a folder. The folder must exist. <literal>foldername</literal> must not designate a file."
msgstr "<emph>foldername</emph>: ہک فولڈر کوں ݙکھیندڑی ہک تند۔ فولڈر ضرور موجود ہووے۔ <literal>foldername</literal> کہیں فائل دی نشاندہی کائنی کرݨی چاہیدی۔"

#. Xmg8b
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id471585648674921\n"
"help.text"
msgid "<emph>filter</emph>: A string containing wildcards (\"?\" and \"*\") that will be applied to the resulting list of folders (default = \"\")."
msgstr "<emph>filter</emph>: وائلڈ کارڈز (\"?\" تے \"*\") رکھݨ آلی ہک تند جیڑھی فولڈراں دی نتیجے والی تندیر تے لاڳو کیتی ویسی (طے شدہ = \"\")۔"

#. WCB4h
#: sf_filesystem.xhp
msgctxt ""
"sf_filesystem.xhp\n"
"par_id731583944548857\n"
"help.text"
msgid "<emph>includesubfolders</emph>: Set this argument to <literal>True</literal> to include the contents of subfolders (Default = <literal>False</literal>)."
msgstr "<emph>includesubfolders</emph>: ذیلی فولڈراں دا مواد شامل کرݨ کیتے ایہ دلیل <literal>True</literal> تے مقرر کرو (طے شدہ = <literal>False</literal>)۔"

#. XQG8t
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"tit\n"
"help.text"
msgid "SFDocuments.Form service"
msgstr "SFDocuments.Form سروس"

#. cFDGc
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"bm_id781582391760253\n"
"help.text"
msgid "<variable id=\"FormService\"><link href=\"text/sbasic/shared/03/sf_form.xhp\"><literal>SFDocuments</literal>.<literal>Form</literal> service</link></variable>"
msgstr ""

#. LDpRB
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id931583589764919\n"
"help.text"
msgid "The <literal>Form</literal> service provides methods and properties to manage forms in %PRODUCTNAME documents. This service supports forms in Base, Calc and Writer documents and allows to:"
msgstr "<literal>Form</literal> سروس %PRODUCTNAME دستاویزاں وچ فارماں دا انتظام کرݨ کیتے طریقے تے خصوصیات ݙیندی ہے۔ ایہ سروس Base، Calc تے Writer دستاویزاں وچ فارماں دی مدد کریندی ہے تے ایہ اجازت ݙیندی ہے:"

#. U3zGB
#: sf_form.xhp
msgctxt ""
"sf_form.xhp\n"
"par_id381618172063851\n"
"help.text"
msgid "Open and activate forms."
msgstr "فارم کھولو تے چالو کرو۔"

#. SC6Yb
#: sf_form.xhp
msgctxt ""
