#. dn344
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id961767883490277\n"
"help.text"
msgid "Apply within and around a range of cells a set of line borders."
msgstr "سیلاں دی رینج دے اندر تے آس پاس لکیراں دے کنارےآں دا ہک سیٹ لاوو۔"

#. CRMw2
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id881767883501990\n"
"help.text"
msgid "The impacted cells may be determined with a filter formula and its scope."
msgstr "متاثر تھیوݨ آلے سیلاں کوں فلٹر فارمولے تے ایں دے دائرے نال طے کیتا ونڄ سڳدا ہے۔"

#. wXMGo
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id21767883519188\n"
"help.text"
msgid "All the borders have the same standard width, style and color. Pre-existing border lines in the impacted cells, rows or columns are first cleared. Other cells in the range are left untouched."
msgstr "سارے کنارےآں دی ہکو جہی معیاری چوڑائی، انداز تے رنگ ہے۔ متاثر سیلاں، قطاراں یا کالماں وچ پہلے توں موجود کنارے دیاں لکیراں پہلے صاف کیتیاں ویندیاں ہن۔ رینج وچ ٻئے سیل بے وٹا چھڈ ݙتے ویندے ہن۔"

#. CYQgM
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id511767883610363\n"
"help.text"
msgid "To clear the full range set <literal>border</literal> to \"\" and skip the <literal>filterformula</literal> argument."
msgstr "پوری رینج کوں صاف کرݨ کیتے <literal>border</literal> کوں \"\" تے سیٹ کرو تے <literal>filterformula</literal> دلیل کوں چھڈ ݙیوو۔"

#. E4BZB
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id811767884294334\n"
"help.text"
msgid "<emph>targetrange</emph>: The cell or the range as a string on which borders should be applied."
msgstr "<emph>targetrange</emph>: سیل یا رینج سٹرنگ طور تے جیں تے کنارے لائے ونڄݨے چاہیدے ہن۔"

#. Mng3D
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id511767884331312\n"
"help.text"
msgid "<emph>border</emph>: A string combining next upper-case characters (other characters are ignored):"
msgstr "<emph>border</emph>: ہک سٹرنگ جیڑھی اڳلے وݙے حرفاں کوں جوڑدی ہے (ٻئے حرفاں کوں نظر انداز کیتا ویندا ہے):"

#. MgE8h
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id641767884455599\n"
"help.text"
msgid "B, L, T, R: bottom, left, top, right outer lines."
msgstr "B, L, T, R: تھلا، کھٻی، اُتے، سڄی ٻاہرلیاں لکیراں۔"

#. yFMUC
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id531767884469933\n"
"help.text"
msgid "H, V: horizontal, vertical inner lines."
msgstr "H, V: افقی، عمودی اندرلیاں لکیراں۔"

#. QUkhv
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id91767884600419\n"
"help.text"
msgid "U, D: bottom-up, top-down diagonals."
msgstr "U, D: تھلوں اُتے، اُتوں تھلے ترچھیاں لکیراں۔"

#. mD7DR
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id671767884770350\n"
"help.text"
msgid "' Border all numeric cells with a bottom line, including the horizontal inner lines."
msgstr ""

#. ARwoe
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id741767884782255\n"
"help.text"
msgid "doc.BorderRange(\"SheetX.A1:J30\", \"HB\", filterformula := \"=IsNumeric(A1)\", filterscope := \"CELL\")"
msgstr ""

#. FydrE
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"pyc_id891767884794918\n"
"help.text"
msgid "# Border all numeric cells with a bottom line, including the horizontal inner lines."
msgstr ""

