"help.text"
msgid "<emph>sortorder</emph>: It can be either \"ASC\" (default) or \"DESC\"."
msgstr "<emph>sortorder</emph>: ایہ یا تاں \"ASC\" (طے شدہ) یا \"DESC\" تھی سڳدا ہے۔"

#. BFduL
#: sf_array.xhp
msgctxt ""
"sf_array.xhp\n"
"par_id91158265018699\n"
"help.text"
msgid "<emph>casesensitive</emph>: Only for string comparisons (Default = <literal>False</literal>)."
msgstr "<emph>casesensitive</emph>: صرف سٹرنگ موازنہ کیتے (طے شدہ = <literal>False</literal>)۔"

#. 7GkBx
#: sf_array.xhp
