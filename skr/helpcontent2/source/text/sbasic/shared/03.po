msgctxt ""
"sf_calc.xhp\n"
"par_id571591019367284\n"
"help.text"
msgid "Within a <emph>specific</emph> <literal>Calc</literal> <emph>instance</emph>, sheets and ranges are given as strings such as \"Sheet1\" and \"D2:F6\"."
