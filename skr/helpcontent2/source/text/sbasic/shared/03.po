msgstr "مینیو تے ذیلی مینیو"

#. 8TjxT
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id741636719725402\n"
"help.text"
msgid "To create a context menu with submenus, use the character defined in the <literal>SubmenuCharacter</literal> property while creating the menu entry to define where it will be placed. For instance, consider the following menu/submenu hierarchy."
msgstr "ذیلی مینیو رکھݨ آلا سیاق و سباق مینیو بݨاوݨ کیتے، مینیو انٹری بݨاوݨ ویلے <literal>SubmenuCharacter</literal> خصوصیت وچ بیان کیتے ڳئے حرف کوں ورتو تاکہ ایہ بیان کیتا ونڄے کہ ایں کوں کتھاں رکھیا ویسی۔ مثال طور تے، تھلے ݙتی ڳئی مینیو/ذیلی مینیو درجہ بندی تے غور کرو۔"

#. KnTJY
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id211636720111489\n"
"help.text"
msgid "The code below uses the default submenu character <literal>></literal> to create the menu/submenu hierarchy defined above:"
msgstr "تھلے ݙتا ڳیا کوڈ اُتے بیان کیتی ڳئی مینیو/ذیلی مینیو درجہ بندی بݨاوݨ کیتے طے شدہ ذیلی مینیو حرف <literal>></literal> ورتیندا ہے:"

#. fTwMB
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id121636721243578\n"
"help.text"
msgid "The string <literal>---</literal> is used to define separator lines in menus or submenus."
msgstr "مینیو یا ذیلی مینیو وچ وکھرا کرݨ آلیاں لکیراں کوں بیان کرݨ کیتے <literal>---</literal> سٹرنگ ورتی ویندی ہے۔"

#. SA2cX
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"hd_id211636723438558\n"
"help.text"
msgid "Using icons"
msgstr "آئیکنز ورتݨ"

#. EUFs9
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id981636723485402\n"
"help.text"
msgid "Unlike popup menus, context menu items must not contain any icons."
msgstr "پاپ اپ مینیو توں وکھ، سیاق و سباق مینیو دیاں چیزاں وچ کوئی آئیکن کائنی ہووݨا چاہیدا۔"

#. nr4Dw
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"hd_id501582887473754\n"
"help.text"
msgid "Methods"
msgstr "طریقے"

#. tDvjd
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id891611613601554\n"
"help.text"
msgid "List of Methods in the ContextMenu Service"
msgstr "ContextMenu سروس وچ طریقاں دی تندیر"

#. JhCRr
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id93158919969864\n"
"help.text"
msgid "Make the <emph>added items</emph> of the <emph>context menu stored in the document</emph> available for execution, or, at the opposite, disable them, depending on the argument."
msgstr "دستاویز وچ محفوظ کیتے ڳئے <emph>سیاق و سباق مینیو</emph> دیاں <emph>جوڑیاں ڳئیاں چیزاں</emph> کوں عملداری کیتے دستیاب بݨاؤ، یا، ایں دے برعکس، دلیل تے منحصر، ایہناں کوں غیر فعال کرو۔"

#. Didmr
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id821591631203996\n"
"help.text"
msgid "<emph>enable:</emph> When <literal>True</literal> (default), the local menu stored in the document is made active. When <literal>False</literal>, the local menu is ignored and the global menu defined at %PRODUCTNAME level takes the precedence."
msgstr "<emph>enable:</emph> جݙاں <literal>True</literal> ہووے (طے شدہ)، تاں دستاویز وچ محفوظ کیتا ڳیا مقامی مینیو فعال بݨایا ویندا ہے۔ جݙاں <literal>False</literal> ہووے، تاں مقامی مینیو کوں نظر انداز کیتا ویندا ہے تے %PRODUCTNAME سطح تے بیان کیتا ڳیا عالمی مینیو ترجیح گھندا ہے۔"

#. Ek9UR
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id93158919963364\n"
"help.text"
msgid "Inserts a menu entry in the context menu."
msgstr "سیاق و سباق مینیو وچ ہک مینیو انٹری داخل کریندا ہے۔"

#. 8RExm
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id821591631203021\n"
"help.text"
msgid "<emph>menuitem:</emph> Defines the text to be displayed in the menu. This argument also defines the hierarchy of the item inside the menu by using the submenu character. Set the last component to <literal>\"---\"</literal> to define a line separator."
msgstr "<emph>menuitem:</emph> مینیو وچ ݙکھائے ونڄݨ آلے عبارت کوں بیان کریندا ہے۔ ایہ دلیل مینیو دے اندر چیز دی درجہ بندی کوں وی ذیلی مینیو حرف ورت کے بیان کریندی ہے۔ لکیر وکھرا کرݨ آلا بیان کرݨ کیتے چھیکڑی جزو کوں <literal>\"---\"</literal> تے سیٹ کرو۔"

#. LKYs2
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id821591631203026\n"
"help.text"
msgid "<emph>command:</emph> The name of the UNO command that will be run when the item is clicked, without the <literal>.uno:</literal> prefix. If the command name does not exist or is not applicable, nothing will happen."
msgstr "<emph>command:</emph> اُس UNO کمانڈ دا ناں جیڑھی چیز تے کلک کرݨ تے چلائی ویسی، <literal>.uno:</literal> اڳواݨ توں بغیر۔ اگر کمانڈ دا ناں موجود کو یا لاگو کائنی تھیندا، تاں کجھ وی کائنی تھیندا۔"

#. Q5w45
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id11636721652886\n"
"help.text"
msgid "<emph>script:</emph> The URI for a Basic or Python script that will be executed when the item is clicked. Note that the given script will not get any argument."
msgstr "<emph>script:</emph> Basic یا Python سکرپٹ کیتے URI جیڑھی چیز تے کلک کرݨ تے چلائی ویسی۔ نوٹ کرو کہ ݙتی ڳئی سکرپٹ کوں کوئی دلیل کائنی ملسی۔"

#. rto8C
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"bas_id41158919969106\n"
"help.text"
msgid "menu.AddItem(\"Menu top>Item 1\", command := \"About\")"
msgstr ""

#. AF6DS
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"pyc_id321621534170554\n"
"help.text"
msgid "menu.AddItem('Menu top>Item 1', command = 'About')"
msgstr ""

#. pM7aY
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id93158919963279\n"
"help.text"
msgid "Remove all items, both"
msgstr ""

#. YSkCR
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id221767624286826\n"
"help.text"
msgid "predefined with <literal>Tools + Customize</literal> and saved in the document"
msgstr ""

#. W6dCT
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id241767624361262\n"
"help.text"
msgid "added with <literal>contextmenu.AddItem()</literal>"
msgstr ""

#. G4RyK
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id131767624674146\n"
"help.text"
msgid "This action cannot be reverted except by closing and reopening the document."
msgstr "ایہ عمل دستاویز کوں بند کر کے تے ولا کھولݨ توں علاوہ واپس کائنی کیتا ونڄ سڳدا۔"

#. t5rAC
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id351767624521068\n"
"help.text"
msgid "Afterwards, when relevant, use AddItem() to insert new menu items."
msgstr "ایں توں بعد، جݙاں متعلقہ ہووے، تاں نویاں مینیو چیزاں داخل کرݨ کیتے AddItem() ورتو۔"

#. T9Cvr
#: sf_contextmenu.xhp
msgctxt ""
"sf_contextmenu.xhp\n"
"par_id51636726671698\n"
"help.text"
msgid "Associate next <literal>Sub/def</literal> with the on-right-click event of a sheet. The custom menu appears when right-clicking in column C of the Calc sheet, otherwise the normal behaviour is preserved."
msgstr "اڳلا <literal>Sub/def</literal> کوں شیٹ دے سڄا کلک واقعے نال جوڑو۔ اپنی مرضی مطابق مینیو جݙاں Calc شیٹ دے کالم C وچ سڄا کلک کیتا ونڄے تاں ظاہر تھیندا ہے، ورنہ عام رویہ محفوظ رہندا ہے۔"

#. zNFY6
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"tit\n"
"help.text"
msgid "SFDatabases.Database service"
msgstr "SFDatabases.Database سروس"

#. pc2rX
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"hd_id371587913266310\n"
"help.text"
msgid "<variable id=\"DatabaseService\"><link href=\"text/sbasic/shared/03/sf_database.xhp\"><literal>SFDatabases</literal>.<literal>Database</literal> service</link></variable>"
msgstr ""

#. RByov
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id891599407198144\n"
"help.text"
msgid "The <literal>Database</literal> service provides access to databases either embedded or described in Base documents. This service provides methods to:"
msgstr "<literal>Database</literal> سروس ڈیٹا بیسز تائیں رسائی ݙیندی ہے جیڑھے یا تاں سرایت کیتے ڳئے ہن یا Base دستاویزاں وچ بیان کیتے ڳئے ہن۔ ایہ سروس طریقے ݙیندی ہے:"

#. 7dqXS
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id551615386924481\n"
"help.text"
msgid "Get access to data in database tables."
msgstr "ڈیٹا بیس ٹیبلاں وچ ڈیٹا تائیں رسائی حاصل کرو۔"

#. 29pT5
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id551615386924285\n"
"help.text"
msgid "Run <literal>SELECT</literal> queries and perform aggregate functions."
msgstr "<literal>SELECT</literal> استفسار چلاؤ تے مجموعی فنکشنز انجام ݙیوو۔"

#. LYsPD
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id551615386924111\n"
"help.text"
msgid "Run SQL action statements such as <literal>INSERT</literal>, <literal>UPDATE</literal>, <literal>DELETE</literal>, etc."
msgstr "SQL عمل بیانات چلاؤ جیویں <literal>INSERT</literal>، <literal>UPDATE</literal>، <literal>DELETE</literal>، وغیرہ۔"

#. 7CSTo
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id811599407236602\n"
"help.text"
msgid "Each instance of the <literal>Database</literal> service represents a single database and gives access to its tables, queries and data."
msgstr "<literal>Database</literal> سروس دی ہر مثال ہک اکیلے ڈیٹا بیس کوں ݙکھیندی ہے تے ایں دیاں ٹیبلاں، استفساراں تے ڈیٹا تائیں رسائی ݙیندی ہے۔"

#. kAfCA
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id111625692871642\n"
"help.text"
msgid "This service does not provide access to forms or reports in the Base document that contains the database. To access forms in a Base document, refer to the method <link href=\"text/sbasic/shared/03/sf_base.xhp#FormDocuments\"><literal>FormDocuments</literal></link> of the <literal>Base</literal> service."
msgstr "ایہ سروس Base دستاویز وچ فارماں یا رپورٹاں تائیں رسائی کائنی ݙیندی جیں وچ ڈیٹا بیس موجود ہے۔ Base دستاویز وچ فارماں تائیں رسائی حاصل کرݨ کیتے، <literal>Base</literal> سروس دے <link href=\"text/sbasic/shared/03/sf_base.xhp#FormDocuments\"><literal>FormDocuments</literal></link> طریقے دا حوالہ ݙیکھو۔"

#. Snu6R
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id231615386789950\n"
"help.text"
msgid "All exchanges between this service and the database are done using SQL only."
msgstr "ایں سروس تے ڈیٹا بیس دے وچکار سارے تبادلے صرف SQL ورت کے کیتے ویندے ہن۔"

#. MiGUE
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id121599407322804\n"
"help.text"
msgid "SQL statements may be run in <emph>direct</emph> or <emph>indirect</emph> mode. In direct mode the statement is transferred to the database engine without any syntax checking or review."
msgstr "SQL بیانات <emph>سدھے</emph> یا <emph>بالواسطہ</emph> موڈ وچ چلائے ونڄ سڳدے ہن۔ سدھے موڈ وچ بیان کوں بغیر کسے ترکیب دی جانچ یا جائزے دے ڈیٹا بیس انجن تائیں بھیڄا ویندا ہے۔"

#. Kg5Cn
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id681599407189019\n"
"help.text"
msgid "The provided interfaces include simple tables and queries lists, as well as access to database data."
msgstr "ݙتے ڳئے انٹرفیسز وچ سادہ ٹیبلاں تے استفساراں دیاں تندیراں شامل ہن، نال ہی ڈیٹا بیس ڈیٹا تائیں رسائی وی۔"

#. 644XA
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id891599407280007\n"
"help.text"
msgid "To make SQL statements more readable, you may use square brackets \"[ ]\" to enclose names of tables, queries and fields instead of using other enclosing characters that may be exclusive to certain Relational Database Management Systems (RDBMS). But beware that enclosing characters are mandatory in this context."
msgstr "SQL بیانات کوں ودھیک پڑھݨ جوڳا بݨاوݨ کیتے، تساں ٹیبلاں، استفساراں تے فیلڈاں دے ناواں کوں گھیرݨ کیتے چوکور قوسین \"[ ]\" ورت سڳدے ہو، ٻئے گھیرݨ آلے حرفاں دی جاء تے جیڑھے کجھ خاص Relational Database Management Systems (RDBMS) کیتے مخصوص ہو سڳدے ہن۔ پر خبردار رہو کہ گھیرݨ آلے حرف ایں سیاق و سباق وچ لازمی ہن۔"

#. Xcc8E
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"hd_id461701357494930\n"
"help.text"
msgid "Transaction handling"
msgstr "ٹرانزیکشن سنبھالݨا"

#. 9is6W
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"bm_id121701365380522\n"
"help.text"
msgid "<bookmark_value>Database service; Transaction handling</bookmark_value>"
msgstr ""

#. kEjYS
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id71701357507703\n"
"help.text"
msgid "By default the database handles transactions in auto-commit mode, meaning that a commit is done after every SQL statement."
msgstr "طے شدہ طور تے ڈیٹا بیس ٹرانزیکشنز کوں آٹو کمیٹ موڈ وچ سنبھالدا ہے، ایں دا مطلب ہے کہ ہر SQL بیان توں بعد ہک کمیٹ کیتا ویندا ہے۔"

#. dHSK7
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id321701357603871\n"
"help.text"
msgid "Use the <literal>SetTransactionMode</literal> method to change the default behavior, which allows for manual commits and rollbacks."
msgstr "<literal>SetTransactionMode</literal> طریقہ ورت کے طے شدہ رویے کوں وٹاؤ، جیڑھا دستی کمیٹس تے رول بیکس دی اجازت ݙیندا ہے۔"

#. WXGcE
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id431701443412927\n"
"help.text"
msgid "The methods <literal>Commit</literal> and <literal>Rollback</literal> are used to delimit transactions."
msgstr "<literal>Commit</literal> تے <literal>Rollback</literal> طریقے ٹرانزیکشنز دیاں حداں بیان کرݨ کیتے ورتے ویندے ہن۔"

#. 4UBP5
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id531701365474516\n"
"help.text"
msgid "In %PRODUCTNAME, there are five types of transaction isolation modes, as defined in the <link href=\"https://api.libreoffice.org/docs/idl/ref/namespacecom_1_1sun_1_1star_1_1sdbc_1_1TransactionIsolation.html\">com.sun.star.sdbc.TransactionIsolation</link> constant group:"
msgstr "%PRODUCTNAME وچ ٹرانزیکشن آئسولیشن موڈ دیاں پنج قسماں ہن، جیویں <link href=\"https://api.libreoffice.org/docs/idl/ref/namespacecom_1_1sun_1_1star_1_1sdbc_1_1TransactionIsolation.html\">com.sun.star.sdbc.TransactionIsolation</link> مستقل گروپ وچ بیان کیتا ڳیا ہے:"

#. 7zGGY
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id631701441607725\n"
"help.text"
msgid "Constant"
msgstr "مستقل"

#. 7n7YU
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id671701441607725\n"
"help.text"
msgid "Value"
msgstr "قیمت"

#. YJ7FT
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id441701441607725\n"
"help.text"
msgid "Interpretation"
msgstr "تشریح"

#. HKAzv
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441607725\n"
"help.text"
msgid "Transaction handling is disabled and the database is set to the default auto-commit mode."
msgstr "ٹرانزیکشن سنبھالݨا غیر فعال ہے تے ڈیٹا بیس کوں طے شدہ آٹو کمیٹ موڈ تے سیٹ کیتا ڳیا ہے۔"

#. aAAV4
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441607099\n"
"help.text"
msgid "Dirty reads, non-repeatable reads and phantom reads can occur."
msgstr "گندے پڑھݨ، ناقابل تکرار پڑھݨ تے فینٹم پڑھݨ تھی سڳدے ہن۔"

#. XefrK
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441603205\n"
"help.text"
msgid "If a row is changed by a transaction, another transaction will be able to read these changes even if they have not been committed."
msgstr "اگر ہک قطار کوں ہک ٹرانزیکشن ولوں وٹایا ونڄے، تاں ٻئی ٹرانزیکشن ایہناں وٹاواں کوں پڑھ سڳسی بھاویں ایہ کمیٹ کائنی کیتے ڳئے ہوون۔"

#. uNAxC
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441607012\n"
"help.text"
msgid "Dirty reads are prevented, however non-repeatable reads and phantom reads can occur."
msgstr "گندے پڑھݨ روکے ویندے ہن، پر ناقابل تکرار پڑھݨ تے فینٹم پڑھݨ تھی سڳدے ہن۔"

#. dieTe
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441608244\n"
"help.text"
msgid "This level prevents that rows with uncommitted changes are read."
msgstr "ایہ سطح روکدی ہے کہ غیر کمیٹ شدہ وٹاواں آلیاں قطاراں پڑھیاں ونڄن۔"

#. Bpi2d
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441607300\n"
"help.text"
msgid "Dirty reads and non-repeatable reads are prevented. However, phantom reads can occur."
msgstr "گندے پڑھݨ تے ناقابل تکرار پڑھݨ روکے ویندے ہن۔ پر فینٹم پڑھݨ تھی سڳدے ہن۔"

#. jbJiF
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441608161\n"
"help.text"
msgid "Besides preventing uncommitted data from being read, it also prevents that two read operations in the same transaction return different results."
msgstr "غیر کمیٹ شدہ ڈیٹا کوں پڑھے ونڄݨ توں روکݨ دے علاوہ، ایہ ایہ وی روکدی ہے کہ ہکو ٹرانزیکشن وچ ݙو پڑھݨ دے عمل وکھرے نتیجے واپس کرن۔"

#. Yxxsv
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441607896\n"
"help.text"
msgid "Dirty reads, non-repeatable reads and phantom reads are prevented."
msgstr "گندے پڑھݨ، ناقابل تکرار پڑھݨ تے فینٹم پڑھݨ روکے ویندے ہن۔"

#. rJaPT
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id601701441607117\n"
"help.text"
msgid "In addition to the constraints of the previous level, it also ensures that the set of records that match a <literal>WHERE</literal> clause remains unchanged inside the same transaction."
msgstr "پچھلی سطح دیاں پابندیاں دے علاوہ، ایہ ایہ وی یقینی بݨاوݨا ہے کہ ریکارڈاں دا سیٹ جیڑھا <literal>WHERE</literal> شق نال میل کھندا ہے، ہکو ٹرانزیکشن دے اندر بے وٹا رہندا ہے۔"

#. 8GoMd
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id991701357744355\n"
"help.text"
msgid "Read the Wikipedia page on <link href=\"https://en.wikipedia.org/wiki/Isolation_(database_systems)\">Isolation in Database Systems</link> to learn more about transaction integrity."
msgstr "ٹرانزیکشن دی سالمیت بارے مزید سکھݨ کیتے <link href=\"https://en.wikipedia.org/wiki/Isolation_(database_systems)\">Isolation in Database Systems</link> تے Wikipedia ورقہ پڑھو۔"

#. CAFnK
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"hd_id91587913266988\n"
"help.text"
msgid "Service invocation"
msgstr "سروس بلاوݨ"

#. 8ASCW
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id141609955500101\n"
"help.text"
msgid "Before using the <literal>Database</literal> service the <literal>ScriptForge</literal> library needs to be loaded or imported:"
msgstr "<literal>Database</literal> سروس ورتݨ توں پہلے <literal>ScriptForge</literal> لائبریری کوں لوڈ یا درآمد کرݨا پوندا ہے:"

#. Cr4oo
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id541599408159668\n"
"help.text"
msgid "To create a instance of the <literal>Database</literal> service you can use the <literal>CreateScriptService</literal> method:"
msgstr "<literal>Database</literal> سروس دی مثال بݨاوݨ کیتے تساں <literal>CreateScriptService</literal> طریقہ ورت سڳدے ہو:"

#. ArhV5
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id551625693442959\n"
"help.text"
msgid "In the syntax described above you can use either \"SFDatabases.Database\" or simply \"Database\" as the first argument of the <literal>CreateScriptService</literal> method."
msgstr "اُتے بیان کیتی ڳئی ترکیب وچ تساں <literal>CreateScriptService</literal> طریقے دی پہلی دلیل طور تے یا تاں \"SFDatabases.Database\" یا صرف \"Database\" ورت سڳدے ہو۔"

#. S7oNc
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id111615146818256\n"
"help.text"
msgid "<emph>filename</emph>: The name of the Base file. Must be expressed using <literal>SF_FileSystem.FileNaming</literal> notation."
msgstr "<emph>filename</emph>: Base فائل دا ناں۔ ایں کوں <literal>SF_FileSystem.FileNaming</literal> اشارے ورت کے بیان کیتا ونڄݨا چاہیدا ہے۔"

#. fUxEZ
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id771615146944307\n"
"help.text"
msgid "<emph>registrationname</emph>: The name of a registered database. If <literal>filename</literal> is provided, this argument should not be used."
msgstr "<emph>registrationname</emph>: رجسٹر کیتے ڳئے ڈیٹا بیس دا ناں۔ اگر <literal>filename</literal> ݙتی ونڄے، تاں ایں دلیل کوں ورتݨا کائنی چاہیدا۔"

#. J2NA3
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id491615147048748\n"
"help.text"
msgid "Conversely, if a <literal>registrationname</literal> is specified, the <literal>filename</literal> parameter should not be defined."
msgstr "ایں دے برعکس، اگر <literal>registrationname</literal> بیان کیتی ونڄے، تاں <literal>filename</literal> پیرامیٹر بیان کائنی کیتا ونڄݨا چاہیدا۔"

#. YQF4D
#: sf_database.xhp
msgctxt ""
"sf_database.xhp\n"
"par_id841615147168279\n"
"help.text"
msgid "<emph>readonly</emph>: Determines if the database will be opened as readonly (Default = <literal>True</literal>)."
msgstr "<emph>readonly</emph>: ایہ طے کریندا ہے کہ کیا ڈیٹا بیس صرف پڑھݨ کیتے کھولی ویسی (طے شدہ = <literal>True</literal>)۔"

