#. hQ3hK
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id321692486382326\n"
"help.text"
msgid "The <literal>FormDocument</literal> service allows to access form documents stored in %PRODUCTNAME Base documents."
msgstr "<literal>FormDocument</literal> سروس %PRODUCTNAME Base دستاویزاں وچ محفوظ فارم دستاویزاں تائیں رسائی ݙیندی ہے۔"

#. zQHTF
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id621692487292145\n"
"help.text"
msgid "In a Base document, existing form documents can be viewed by selecting <menuitem>View - Forms</menuitem> in the user interface. Each form document may be composed of one or more forms, including the main form and other sub-forms."
msgstr "Base دستاویز وچ، موجودہ فارم دستاویزاں کوں ورتکار انٹرفیس وچ <menuitem>View - Forms</menuitem> منتخب کر کے ݙٹھا ونڄ سڳدا ہے۔ ہر فارم دستاویز ہک یا ہک توں ودھ فارماں تے مشتمل ہو سڳدی ہے، جنہاں وچ اصل فارم تے ٻئے ذیلی فارم شامل ہن۔"

#. uNbgU
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id891692486448415\n"
"help.text"
msgid "This service inherits methods and properties from the <literal>Document</literal> service and is often used alongside the <literal>Base</literal> and <literal>Database</literal> services."
msgstr "ایہ سروس <literal>Document</literal> سروس توں طریقے تے خصوصیات ورثے وچ لیندی ہے تے اکثر <literal>Base</literal> تے <literal>Database</literal> سروساں دے نال ورتی ویندی ہے۔"

#. gGFFZ
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id241619032941497\n"
"help.text"
msgid "Refer to the <link href=\"text/sbasic/shared/03/sf_document.xhp\"><literal>Document</literal> service</link> to learn more about methods and properties that can be used to manage %PRODUCTNAME documents."
msgstr "اوہ طریقاں تے خصوصیتاں بارے ودھ جانݨ کیتے جیڑھے %PRODUCTNAME دستاویزاں کوں سنبھالݨ کیتے ورتے ونڄ سڳدے ہن، <link href=\"text/sbasic/shared/03/sf_document.xhp\"><literal>Document</literal> سروس</link> کوں ݙیکھو۔"

#. 3jTab
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"hd_id581582885621841\n"
"help.text"
msgid "Service invocation"
msgstr "سروس طلب"

#. KxGkv
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id141609955500101\n"
"help.text"
msgid "Before using the <literal>FormDocument</literal> service the <literal>ScriptForge</literal> library needs to be loaded or imported:"
msgstr "<literal>FormDocument</literal> سروس ورتݨ توں پہلے <literal>ScriptForge</literal> لائبریری کوں لوڈ یا درآمد کرݨا ضروری ہے:"

#. 99UBC
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id991692486784449\n"
"help.text"
msgid "A <literal>FormDocument</literal> service instance can be created by calling the method <literal>OpenFormDocument</literal> that exists both in the <literal>Base</literal> and <literal>Database</literal> services."
msgstr "ہک <literal>FormDocument</literal> سروس مثال <literal>OpenFormDocument</literal> طریقے کوں طلب کر کے بݨائی ونڄ سڳدی ہے جیڑھا <literal>Base</literal> تے <literal>Database</literal> ݙوہاں سروساں وچ موجود ہے۔"

#. txPPF
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id381692486890118\n"
"help.text"
msgid "The example below uses the <literal>UI</literal> service to open a Base document and then retrieve a form document. Note that in this example both the Base document and the form document will be opened and displayed on the screen."
msgstr "تھلے ݙتی ڳئی مثال <literal>UI</literal> سروس کوں Base دستاویز کھولݨ تے پھر ہک فارم دستاویز حاصل کرݨ کیتے ورتدی ہے۔ دھیان دیو جو ایں مثال وچ Base دستاویز تے فارم دستاویز ݙوہاں کھولیاں ونڄݨ گیاں تے سکرین تے ݙکھائیاں ونڄݨ گیاں۔"

#. ZRxCq
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id591692487747857\n"
"help.text"
msgid "The following example uses the <literal>Database</literal> service to open the form document. In this case, the Base file will not be opened and only the form document will be shown."
msgstr "تھلے ݙتی ڳئی مثال <literal>Database</literal> سروس کوں فارم دستاویز کھولݨ کیتے ورتدی ہے۔ ایں صورت وچ، Base فائل کائنی کھولی ونڄݨی تے صرف فارم دستاویز ݙکھائی ونڄݨی ہے۔"

#. qkQZ7
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id151692489140384\n"
"help.text"
msgid "Calling <literal>OpenFormDocument</literal> for a form document that is already open will activate the document window and bring it to focus."
msgstr "<literal>OpenFormDocument</literal> کوں طلب کرݨ نال، جے فارم دستاویز پہلے توں کھلی ہوئی ہے تاں دستاویز ونڈو فعال تھی ویندی ہے تے اونکوں فوکس وچ لیایا ویندا ہے۔"

#. vEFGV
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id871623102536956\n"
"help.text"
msgid "The examples above can be translated to Python as follows:"
msgstr "اُتے ݙتیاں ڳئیاں مثالاں کوں Python وچ ایں طرحاں ترجمہ کیتا ونڄ سڳدا ہے:"

#. wxdh6
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id451619034669263\n"
"help.text"
msgid "List of Methods in the FormDocument Service"
msgstr "FormDocument سروس وچ طریقاں دی تندیر"

#. jY8vp
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id801916099743199\n"
"help.text"
msgid "Closes the form document referred to by the <literal>FormDocument</literal> instance. Returns <literal>True</literal> if the form document was successfully closed."
msgstr "اوس فارم دستاویز کوں بند کریندا ہے جیندے دا <literal>FormDocument</literal> مثال حوالہ ݙیندی ہے۔ جے فارم دستاویز کامیابی نال بند تھئی ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. wN7iT
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id481619036833610\n"
"help.text"
msgid "Returns either an array with the names of the main forms contained in the form document or a <literal>Form</literal> service instance referring to a specific form."
msgstr "فارم دستاویز وچ موجود اصل فارماں دے ناواں تے مشتمل ہک صف یا کسے خاص فارم دا حوالہ ݙیݨ آلی ہک <literal>Form</literal> سروس مثال واپس کریندا ہے۔"

#. RuFja
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id311692532433990\n"
"help.text"
msgid "Call this method without arguments to obtain a zero-based string array with the names of all forms contained in the form document."
msgstr "فارم دستاویز وچ موجود سارے فارماں دے ناواں تے مشتمل صفر توں شروع تھیوݨ آلی تنداں دی صف حاصل کرݨ کیتے ایہ طریقہ بغیر دلیلاں دے طلب کرو۔"

#. qg4FH
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id491692532525080\n"
"help.text"
msgid "Provide a form name or index as argument to obtain a <literal>Form</literal> service instance corresponding to the specified form."
msgstr "بیان کیتے ڳئے فارم دے مطابق <literal>Form</literal> سروس مثال حاصل کرݨ کیتے دلیل دے طور تے ہک فارم ناں یا انڈیکس ݙیو۔"

#. GbkH9
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id281692532725116\n"
"help.text"
msgid "A form document has at least one main form. More complex form documents may be composed of more than one form and sub-forms."
msgstr "ہک فارم دستاویز وچ گھٹ توں گھٹ ہک اصل فارم ہوندا ہے۔ ودھ پیچیدہ فارم دستاویزاں ہک توں ودھ فارم تے ذیلی فارماں تے مشتمل ہو سڳدیاں ہن۔"

#. 23Cgd
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id211692538352686\n"
"help.text"
msgid "<emph>form</emph>: This argument can be either a string with the name of a form that exists in the form document or the zero-based index of the form that shall be returned. If this argument is not specific, then an array with the name of all available forms is returned."
msgstr "<emph>form</emph>: ایہ دلیل یا تاں فارم دستاویز وچ موجود فارم دے ناں تے مشتمل ہک تند ہو سڳدی ہے یا اوس فارم دا صفر توں شروع تھیوݨ آلا انڈیکس جیڑھا واپس کیتا ونڄݨا ہے۔ جے ایہ دلیل بیان نہ کیتی ڳئی ہووے تاں سارے دستیاب فارماں دے ناواں تے مشتمل ہک صف واپس کیتی ویندی ہے۔"

#. wktWB
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id151692537703209\n"
"help.text"
msgid "The following example checks if the form document contains a form named \"MainForm\":"
msgstr "تھلے ݙتی ڳئی مثال جانچدی ہے جو آیا فارم دستاویز وچ \"MainForm\" ناں دا ہک فارم ہے یا کو:"

#. nNdtW
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id661692537831637\n"
"help.text"
msgid "The example below retrieves the form named \"MainForm\" and moves it to the last record:"
msgstr "تھلے ݙتی ڳئی مثال \"MainForm\" ناں دے فارم کوں حاصل کریندی ہے تے اونکوں چھیکڑی ریکارڈ تے لے ویندی ہے۔"

#. Nw4c6
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id921619036922844\n"
"help.text"
msgid "To learn more about form methods and properties, refer to the <link href=\"text/sbasic/shared/03/sf_form.xhp\"><literal>Form</literal> service help page</link>."
msgstr "فارم طریقاں تے خصوصیتاں بارے ودھ جانݨ کیتے، <link href=\"text/sbasic/shared/03/sf_form.xhp\"><literal>Form</literal> سروس مدد ورقہ</link> کوں ݙیکھو۔"

#. 5SoGW
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id156589200121138\n"
"help.text"
msgid "This method sends the contents form document to the default printer or to the printer defined by the <literal>SetPrinter()</literal> method."
msgstr "ایہ طریقہ فارم دستاویز دیاں مواداں کوں طے شدہ پرنٹر یا <literal>SetPrinter()</literal> طریقے ولوں بیان کیتے ڳئے پرنٹر تے بھیجدا ہے۔"

#. hQ6GC
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id981611169416934\n"
"help.text"
msgid "Returns <literal>True</literal> if the document was successfully sent to the printer."
msgstr "جے دستاویز کامیابی نال پرنٹر تے بھیجی ڳئی ہووے تاں <literal>True</literal> واپس کریندا ہے۔"

#. 2qnYG
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id211635436910093\n"
"help.text"
msgid "<emph>pages</emph>: The pages to print as a string. This argument should be specified in the same manner as in the user interface (see <menuitem>File - Print</menuitem> dialog). Example: \"1-4;10;15-18\". The default value is an empty string \"\" which will cause all pages to be printed."
msgstr "<emph>pages</emph>: چھاپݨ آلے ورقیاں کوں ہک تند دے طور تے۔ ایہ دلیل ورتکار انٹرفیس وچ ہک ہی طریقے نال بیان کیتی ونڄݨی چاہیدی ہے (<menuitem>File - Print</menuitem> ڈائیلاگ ݙیکھو)۔ مثال: \"1-4;10;15-18\"۔ طے شدہ قیمت ہک خالی تند \"\" ہے جیڑھی سارے ورقیاں کوں چھاپݨ دا باعث بݨسی۔"

#. mxFXk
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id141635436912146\n"
"help.text"
msgid "<emph>copies</emph>: The number of copies to be printed (Default = 1)."
msgstr "<emph>copies</emph>: چھاپݨ آلیاں نقلاں دی گݨتری (طے شدہ = 1)۔"

#. nr7DR
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id871692539875337\n"
"help.text"
msgid "<emph>printbackground</emph>: specifies whether the background image should be printed (Default = True)."
msgstr "<emph>printbackground</emph>: بیان کریندا ہے جو آیا پس منظر تصویر چھاپی ونڄݨی چاہیدی ہے یا کو (طے شدہ = True)۔"

#. dDtPU
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id661692539947123\n"
"help.text"
msgid "<emph>printblankpages</emph>: specifies whether blank pages should be printed (Default = False)."
msgstr "<emph>printblankpages</emph>: بیان کریندا ہے جو آیا خالی ورقے چھاپے ونڄݨے چاہیدے ہن یا کو (طے شدہ = False)۔"

#. hJvtc
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id661692539947144\n"
"help.text"
msgid "<emph>printevenpages</emph>: specifies whether even pages should be printed (Default = True)."
msgstr "<emph>printevenpages</emph>: بیان کریندا ہے جو آیا جفت ورقے چھاپے ونڄݨے چاہیدے ہن یا کو (طے شدہ = True)۔"

#. 7tyim
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id661692539947875\n"
"help.text"
msgid "<emph>printoddpages</emph>: specifies whether odd pages should be printed (Default = True)."
msgstr "<emph>printoddpages</emph>: بیان کریندا ہے جو آیا طاق ورقے چھاپے ونڄݨے چاہیدے ہن یا کو (طے شدہ = True)۔"

#. BxCRK
#: sf_formdocument.xhp
msgctxt ""
"sf_formdocument.xhp\n"
"par_id661692539947323\n"
"help.text"
msgid "<emph>printimages</emph>: specifies whether images should be printed (Default = True)."
msgstr "<emph>printimages</emph>: بیان کریندا ہے جو آیا تصویراں چھاپیاں ونڄݨیاں چاہیدیاں ہن یا کو (طے شدہ = True)۔"

#. czP76
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"tit\n"
"help.text"
msgid "Creating Python Scripts with ScriptForge"
msgstr "ScriptForge نال Python سکرپٹس بݨاوݨا"

#. QFG5C
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"hd_id461623364876507\n"
"help.text"
msgid "<variable id=\"title\"><link href=\"text/sbasic/shared/03/sf_intro.xhp\">Creating Python Scripts with <literal>ScriptForge</literal></link></variable>"
msgstr ""

#. 6JuA3
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"hd_id361623410405420\n"
"help.text"
msgid "Differences between Basic and Python"
msgstr "Basic تے Python وچ فرق"

#. GwT9x
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id41623410443946\n"
"help.text"
msgid "The <link href=\"text/sbasic/shared/03/lib_ScriptForge.xhp\">ScriptForge library</link> is available both for Basic and Python. Most services, methods and properties work identically in both programming languages. However, due to differences in how each language works, <literal>ScriptForge</literal> users must be aware of some characteristics of the library when using Python:"
msgstr "The <link href=\"text/sbasic/shared/03/lib_ScriptForge.xhp\">ScriptForge library</link> Basic تے Python ݙوہاں کیتے دستیاب ہے۔ ودھتر سروساں، طریقے تے خصوصیات ݙوہاں پروگرامنگ زباناں وچ ہک جہے طریقے نال کم کریندے ہن۔ البتہ، ہر زبان دے کم کرݨ دے طریقے وچ فرق دی وجہ توں، <literal>ScriptForge</literal> ورتکاراں کوں Python ورتݨ ویلے لائبریری دیاں کجھ خصوصیات توں آگاہ ہوݨا چاہیدا ہے:"

#. HsKzK
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id551623410718241\n"
"help.text"
msgid "<emph>Methods and Property names:</emph> In Python, all methods and properties can be used in lowercased, ProperCased or camelCased formats."
msgstr "<emph>طریقاں تے خصوصیتاں دے ناں:</emph> Python وچ، سارے طریقے تے خصوصیات lowercased، ProperCased یا camelCased فارمیٹس وچ ورتے ونڄ سڳدے ہن۔"

#. DGDDY
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id741623411104308\n"
"help.text"
msgid "<emph>Arguments:</emph> All keyword arguments passed on to methods are lowercased."
msgstr "<emph>دلیلاں:</emph> طریقاں تے بھیجیاں ڳئیاں ساریاں کلیدی لفظ دلیلاں چھوٹے حرفاں وچ لکھیاں ویندیاں ہن۔"

#. C6VCu
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id441623411216354\n"
"help.text"
msgid "<emph>Dates:</emph> All date objects are passed and returned as <literal>datetime.datetime</literal> native Python objects."
msgstr "<emph>تریخاں:</emph> سارے تریخ آبجیکٹس <literal>datetime.datetime</literal> مقامی Python آبجیکٹس دے طور تے بھیجے تے واپس کیتے ویندے ہن۔"

#. FcX93
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id891623411367669\n"
"help.text"
msgid "<emph>Arrays:</emph> One-dimensional arrays are passed and returned as tuples (which is an immutable object). Two-dimensional arrays are passed and returned as tuples of tuples."
msgstr "<emph>صفاں:</emph> ہک جہتی صفاں ٹپلز دے طور تے بھیجیاں تے واپس کیتیاں ویندیاں ہن (جیڑھا ہک ناقابل تبدیل آبجیکٹ ہے)۔ ݙو جہتی صفاں ٹپلز دے ٹپلز دے طور تے بھیجیاں تے واپس کیتیاں ویندیاں ہن۔"

#. S6wwX
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id981623411507442\n"
"help.text"
msgid "<emph>None:</emph> Python's <literal>None</literal> keyword is equivalent to Basic's <literal>Null</literal>, <literal>Empty</literal> or <literal>Nothing</literal>."
msgstr "<emph>None:</emph> Python دا <literal>None</literal> کلیدی لفظ Basic دے <literal>Null</literal>، <literal>Empty</literal> یا <literal>Nothing</literal> دے برابر ہے۔"

#. 2G2uk
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id21623411611447\n"
"help.text"
msgid "<emph>UNO objects:</emph> All UNO structures are exchanged between Basic and Python without any changes."
msgstr "<emph>UNO آبجیکٹس:</emph> سارے UNO ڈھانچے Basic تے Python وچکار بغیر کہیں وٹے دے بدلے ویندے ہن۔"

#. WFDrN
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id651623412069496\n"
"help.text"
msgid "<emph>Debugging:</emph> Whenever an error occurs in Python scripts that use <literal>ScriptForge</literal>, the error message provided by the Python execution stack displays the line of code that triggered the error. In Basic error messages do not display this information."
msgstr "<emph>ڈیبگنگ:</emph> جݙاں وی Python سکرپٹس وچ کوئی غلطی تھیوے جیڑھے <literal>ScriptForge</literal> ورتدے ہن، Python عملداری اسٹیک ولوں ݙتا ڳیا غلطی سنیہا کوڈ دی اوہ لکیر ݙکھیندا ہے جیندے توں غلطی تھی۔ Basic وچ غلطی سنیہے ایہ معلومات کائنی ݙکھیندے۔"

#. 9zGtM
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id31623411828158\n"
"help.text"
msgid "Visit <link href=\"text/sbasic/python/main0000.xhp#\">%PRODUCTNAME Python Scripts Help</link> for more information on Python scripting using %PRODUCTNAME."
msgstr "%PRODUCTNAME ورتݨ نال Python سکرپٹنگ بارے ودھ معلومات کیتے، <link href=\"text/sbasic/python/main0000.xhp#\">%PRODUCTNAME Python Scripts Help</link> ݙیکھو۔"

#. EoMaa
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"hd_id402623411150191\n"
"help.text"
msgid "Editing Python scripts in IDEs"
msgstr "IDEs وچ Python سکرپٹس دی تدوین"

#. XkqnA
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id111733745619796\n"
"help.text"
msgid "Python typing hints - relating to <literal>ScriptForge</literal> services public methods and properties - can be obtained from IDEs that support such facility. Visually, while editing a user script:"
msgstr "Python ٹائپنگ اشارے - جیڑھے <literal>ScriptForge</literal> سروساں دے عوامی طریقاں تے خصوصیتاں نال تعلق رکھدے ہن - ایہ IDEs توں حاصل کیتے ونڄ سڳدے ہن جیڑھے ایں سہولت کوں سپورٹ کریندے ہن۔ بصری طور تے، ورتکار سکرپٹ دی تدوین کرݨ ویلے:"

#. 7DEkG
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id471733745941570\n"
"help.text"
msgid "hovering an object instance, a method or a property displays its detailed description."
msgstr "کسی آبجیکٹ مثال، طریقے یا خصوصیت تے ہوور کرݨ نال اوندی تفصیلی تفصیل ݙکھائی ویندی ہے۔"

#. Uw8cF
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id631733745943026\n"
"help.text"
msgid "a \".\" after an object instance displays a drop-down box listing all available interfaces."
msgstr "کسی آبجیکٹ مثال دے بعد \".\" لکھݨ نال ہک ڈراپ ڈاؤن بکس ݙکھایا ویندا ہے جیڑھا سارے دستیاب انٹرفیسز دی تندیر ݙیندا ہے۔"

#. jkdzA
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id471733745961810\n"
"help.text"
msgid "brackets after a method-name start code-completion by displaying its arguments."
msgstr "کسی طریقے دے ناں دے بعد بریکٹس لکھݨ نال اوندیاں دلیلاں ݙکھا کے کوڈ مکمل کرݨ شروع تھی ویندا ہے۔"

#. AQp6q
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"par_id571733746663339\n"
"help.text"
msgid "Typing hints are displayed when editing methods and properties with propercase letters."
msgstr "طریقاں تے خصوصیتاں دی تدوین کرݨ ویلے propercase حرفاں نال ٹائپنگ اشارے ݙکھائے ویندے ہن۔"

#. CZiTF
#: sf_intro.xhp
msgctxt ""
"sf_intro.xhp\n"
"hd_id391623411150080\n"
"help.text"
msgid "Running Python scripts on %PRODUCTNAME"
msgstr "%PRODUCTNAME تے Python سکرپٹس چلاوݨا"

#. VCRTD
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"tit\n"
"help.text"
msgid "ScriptForge.L10N service"
msgstr "ScriptForge.L10N سروس"

#. 5kFM4
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"hd_id521585843652750\n"
"help.text"
msgid "<variable id=\"L10NService\"><link href=\"text/sbasic/shared/03/sf_l10n.xhp\"><literal>ScriptForge</literal>.<literal>L10N</literal> service</link></variable>"
msgstr ""

#. FRAiJ
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id411585843652556\n"
"help.text"
msgid "This service provides a number of methods related to the translation of strings with minimal impact on the program's source code. The methods provided by the <literal>L10N</literal> service can be used mainly to:"
msgstr "ایہ سروس تنداں دے ترجمے نال تعلق رکھݨ آلے کئی طریقے ݙیندی ہے جیندے نال پروگرام دے سورس کوڈ تے گھٹ توں گھٹ اثر پوندا ہے۔ <literal>L10N</literal> سروس ولوں ݙتے ڳئے طریقے بنیادی طور تے ایندے کیتے ورتے ونڄ سڳدے ہن:"

#. gw2rW
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id601614351922212\n"
"help.text"
msgid "Create POT files that can be used as templates for translation of all strings in the program."
msgstr "POT فائلز بݨاؤ جیڑھیاں پروگرام وچ ساریاں تنداں دے ترجمے کیتے سانچیاں دے طور تے ورتیاں ونڄ سڳدیاں ہن۔"

#. sbVQL
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id131614352196513\n"
"help.text"
msgid "Get translated strings at runtime for the language defined in the <literal>Locale</literal> property."
msgstr "<literal>Locale</literal> خصوصیت وچ بیان کیتی ڳئی زبان کیتے رن ٹائم تے ترجمہ کیتیاں ڳئیاں تنداں حاصل کرو۔"

#. kCrgU
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id971614966420419\n"
"help.text"
msgid "The acronym <literal>L10N</literal> stands for Localization and refers to a set of procedures for translating software to a specific country or region."
msgstr "مخفف <literal>L10N</literal> دا مطلب Localization ہے تے ایہ سافٹ ویئر کوں کسی خاص ملک یا علاقے کیتے ترجمہ کرݨ دے طریقہ کاراں دے سیٹ دی طرف اشارہ کریندا ہے۔"

#. supr5
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id291585843652438\n"
"help.text"
msgid "PO files have long been promoted in the free software community as a means to providing multilingual user interfaces. This is accomplished through the use of human-readable text files with a well defined structure that specifies, for any given language, the source language string and the localized string."
msgstr "PO فائلز کوں مفت سافٹ ویئر برادری وچ کئی عرصے توں کئی زباناں آلے ورتکار انٹرفیسز ݙیوݨ دے ذریعے دے طور تے فروغ ݙتا ویندا رہیا ہے۔ ایہ انسان ولوں پڑھݨ دے قابل عبارت فائلز دے ورتݨ نال حاصل کیتا ویندا ہے جنہاں دی چنڳی طرحاں بیان کیتی ڳئی ساخت ہووے جیڑھی، کہیں وی ݙتی ڳئی زبان کیتے، ماخذ زبان دی تند تے مقامی بنائی ڳئی تند کوں بیان کریندی ہے۔"

#. j6xsd
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id181585843652814\n"
"help.text"
msgid "The main advantage of the PO format is dissociation of the programmer and the translator. PO files are independent text files, so the programmer can send POT template files to translators, who will then translate their contents and return the translated PO files for each supported language."
msgstr "PO فارمیٹ دا اہم فائدہ پروگرامر تے مترجم دی علیحدگی ہے۔ PO فائلز آزاد عبارت فائلز ہن، تاں پروگرامر POT سانچہ فائلز مترجماں کوں بھیج سڳدا ہے، جیڑھے پھر اوناں دیاں مواداں دا ترجمہ کریسوں تے ہر سپورٹ کیتی ڳئی زبان کیتے ترجمہ کیتیاں ڳئیاں PO فائلز واپس کریسوں۔"

#. vdQwG
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id811614352321187\n"
"help.text"
msgid "The <literal>L10N</literal> service is based on the GNU implementation of PO (portable object) files. To learn more about this file format, visit <link href=\"https://www.gnu.org/software/gettext/manual/html_node/PO-Files.html\">GNU gettext Utilities: PO Files</link>."
msgstr "The <literal>L10N</literal> سروس PO (portable object) فائلز دے GNU نفاذ تے مبنی ہے۔ ایں فائل فارمیٹ بارے ودھ جانݨ کیتے، <link href=\"https://www.gnu.org/software/gettext/manual/html_node/PO-Files.html\">GNU gettext Utilities: PO Files</link> ݙیکھو۔"

#. DGiG9
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id91585843652832\n"
"help.text"
msgid "This service implements the methods listed below:"
msgstr "ایہ سروس تھلے ݙتے ڳئے طریقے لاڳو کریندی ہے:"

#. fBXDW
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id1158584365237\n"
"help.text"
msgid "<emph>AddText</emph>: Used by the programmer to build a set of strings that will be translated later."
msgstr "<emph>AddText</emph>: پروگرامر ولوں تنداں دا ہک سیٹ بݨاوݨ کیتے ورتیا ویندا ہے جیڑھا بعد وچ ترجمہ کیتا ونڄݨا ہے۔"

#. BtuQ3
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id81637866601151\n"
"help.text"
msgid "<emph>AddTextsFromDialog</emph>: Extracts all strings from a <literal>Dialog</literal> service instance."
msgstr "<emph>AddTextsFromDialog</emph>: ہک <literal>Dialog</literal> سروس مثال وچوں ساریاں تنداں کڈھ ݙیندا ہے۔"

#. cm7fq
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id681585843652331\n"
"help.text"
msgid "<emph>ExportToPOTFile</emph>: Exports the strings added by the <literal>AddText</literal> method to a POT file."
msgstr "<emph>ExportToPOTFile</emph>: <literal>AddText</literal> طریقے ولوں شامل کیتیاں ڳئیاں تنداں کوں ہک POT فائل وچ برآمد کریندا ہے۔"

#. Z7dU5
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id531585843652697\n"
"help.text"
msgid "<emph>GetText</emph>: Gets the translated strings at runtime."
msgstr "<emph>GetText</emph>: رن ٹائم تے ترجمہ کیتیاں ڳئیاں تنداں حاصل کریندا ہے۔"

#. D4Fyf
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id361614361362393\n"
"help.text"
msgid "Note that the first two methods are used to build a set of translatable strings and export them to a POT file. However, it is not mandatory to create POT files using these methods. Since they are text files, the programmer could have created them using any text editor."
msgstr "دھیان دیو جو پہلے ݙو طریقے ترجمہ کرݨ دے قابل تنداں دا ہک سیٹ بݨاوݨ تے اونکوں ہک POT فائل وچ برآمد کرݨ کیتے ورتے ویندے ہن۔ البتہ، ایں طریقاں نال POT فائلز بݨاوݨا لازمی کائنی۔ چونکہ ایہ عبارت فائلز ہن، پروگرامر اونکوں کہیں وی عبارت ایڈیٹر ورت کے بݨا سڳدا ہئی۔"

#. Rn7FL
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"hd_id351585843652312\n"
"help.text"
msgid "Service invocation"
msgstr "سروس طلب"

#. 2WXAQ
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id141609955500101\n"
"help.text"
msgid "Before using the <literal>L10N</literal> service the <literal>ScriptForge</literal> library needs to be loaded or imported:"
msgstr "<literal>L10N</literal> سروس ورتݨ توں پہلے <literal>ScriptForge</literal> لائبریری کوں لوڈ یا درآمد کرݨا ضروری ہے:"

#. 9xE8t
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id421614353247163\n"
"help.text"
msgid "There are several ways to invoke the <literal>L10N</literal> service using up to five optional arguments that specify the folder where PO files are stored, the locale and encoding to be used, as well as a fallback PO file and its encoding."
msgstr "<literal>L10N</literal> سروس کوں طلب کرݨ دے کئی طریقے ہن جنہاں وچ پنج تائیں اختیاری دلیلاں ورتیاں ویندیاں ہن جیڑھیاں اوہ فولڈر بیان کریندیاں ہن جتھاں PO فائلز محفوظ کیتیاں ویندیاں ہن، ورتݨ آلا لوکیل تے انکوڈنگ، نال ہی ہک فال بیک PO فائل تے اوندی انکوڈنگ۔"

#. cCwBS
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id331585843652877\n"
"help.text"
msgid "<emph>foldername</emph>: The folder containing the PO files. It must be expressed in the <literal>FileSystem.FileNaming</literal> notation."
msgstr "<emph>foldername</emph>: PO فائلز رکھݨ آلا فولڈر۔ ایہ <literal>FileSystem.FileNaming</literal> لکھݨ دے طریقے وچ بیان کیتا ونڄݨا چاہیدا ہے۔"

#. oQD4m
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id581585843652789\n"
"help.text"
msgid "<emph>locale</emph>: A string in the form \"la-CO\" (language-COUNTRY) or in the form \"la\" (language) only."
msgstr "<emph>locale</emph>: \"la-CO\" (زبان-ملک) دی شکل وچ ہک تند یا صرف \"la\" (زبان) دی شکل وچ۔"

#. gswGR
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id591646219881864\n"
"help.text"
msgid "<emph>encoding</emph>: The character set to be used. The default encoding is \"UTF-8\"."
msgstr "<emph>encoding</emph>: ورتݨ آلا حرف سیٹ۔ طے شدہ انکوڈنگ \"UTF-8\" ہے۔"

#. CXd3e
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id281646219882464\n"
"help.text"
msgid "<emph>locale2</emph>: A string specifying the fallback locale to be used in case the PO file corresponding to the locale defined the <literal>locale</literal> parameter does not exist. This parameter is expressed in the form \"la-CO\" (language-COUNTRY) or \"la\" (language) only."
msgstr "<emph>locale2</emph>: ہک تند جیڑھی فال بیک لوکیل کوں بیان کریندی ہے جیڑھا اوں صورت وچ ورتیا ونڄݨا ہے جے <literal>locale</literal> پیرامیٹر وچ بیان کیتے ڳئے لوکیل نال تعلق رکھݨ آلی PO فائل موجود کائنی۔ ایہ پیرامیٹر \"la-CO\" (زبان-ملک) یا صرف \"la\" (زبان) دی شکل وچ بیان کیتا ویندا ہے۔"

#. TaFFX
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id881646219882951\n"
"help.text"
msgid "<emph>encoding2</emph>: The character set of the fallback PO file corresponding to the <literal>locale2</literal> argument. The default encoding is \"UTF-8\"."
msgstr "<emph>encoding2</emph>: <literal>locale2</literal> دلیل نال تعلق رکھݨ آلی فال بیک PO فائل دا حرف سیٹ۔ طے شدہ انکوڈنگ \"UTF-8\" ہے۔"

#. 6cmQr
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id141613001281573\n"
"help.text"
msgid "To learn more about the names of character sets, visit <link href=\"https://www.iana.org/assignments/character-sets/character-sets.xhtml\">IANA's Character Set</link> page. Be aware that %PRODUCTNAME does not implement all existing character sets."
msgstr "حرف سیٹاں دے ناواں بارے ودھ جانݨ کیتے، <link href=\"https://www.iana.org/assignments/character-sets/character-sets.xhtml\">IANA's Character Set</link> ورقہ ݙیکھو۔ دھیان دیو جو %PRODUCTNAME سارے موجود حرف سیٹاں کوں لاڳو کائنی کریندا۔"

#. 3ApdD
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id891614358528334\n"
"help.text"
msgid "The following example instantiates the <literal>L10N</literal> service without any optional arguments. This will only enable the <literal>AddText</literal> and <literal>ExportToPOTFile</literal> methods, which is useful for creating POT files."
msgstr "تھلے ݙتی ڳئی مثال بغیر کہیں اختیاری دلیل دے <literal>L10N</literal> سروس دی ہک مثال بݨیندی ہے۔ ایں نال صرف <literal>AddText</literal> تے <literal>ExportToPOTFile</literal> طریقے فعال تھیسوں، جیڑھا POT فائلز بݨاوݨ کیتے مفید ہے۔"

#. FaDSa
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id611614358672609\n"
"help.text"
msgid "The example below specifies the folder containing the PO files. Because the locale is not defined, the service instance will use the locale defined for the %PRODUCTNAME user interface, which is the same locale defined in the <literal>OfficeLocale</literal> property of the <link href=\"text/sbasic/shared/03/sf_platform.xhp\">Platform</link> service."
msgstr "تھلے ݙتی ڳئی مثال PO فائلز رکھݨ آلا فولڈر بیان کریندی ہے۔ چونکہ لوکیل بیان کائنی کیتا ڳیا، سروس مثال اوہ لوکیل ورتیسی جیڑھا %PRODUCTNAME ورتکار انٹرفیس کیتے بیان کیتا ڳیا ہے، جیڑھا اوہو ہی لوکیل ہے جیڑھا <literal>OfficeLocale</literal> خصوصیت وچ بیان کیتا ڳیا ہے، جیڑھی <link href=\"text/sbasic/shared/03/sf_platform.xhp\">Platform</link> سروس دی ہے۔"

#. FewYJ
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id391625855630975\n"
"help.text"
msgid "The example above will result in an runtime error if the PO file corresponding to the <literal>OfficeLocale</literal> locale does not exist in the specified folder."
msgstr "اُتے ݙتی ڳئی مثال رن ٹائم غلطی دا سبب بݨسی جے <literal>OfficeLocale</literal> لوکیل نال تعلق رکھݨ آلی PO فائل بیان کیتے ڳئے فولڈر وچ موجود کائنی۔"

#. gSzLN
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id321614358809763\n"
"help.text"
msgid "In the example below, the locale is explicitly defined to be Belgian French (\"fr-BE\"), hence the service will load the file \"fr-BE.po\" from the folder \"C:\\myPOFiles\". If the file does not exist, an error will occur."
msgstr "تھلے ݙتی ڳئی مثال وچ، لوکیل واضح طور تے بیلجیئم فرانسیسی (\"fr-BE\") ہووݨ بیان کیتا ڳیا ہے، ایں کیتے سروس \"C:\\myPOFiles\" فولڈر توں \"fr-BE.po\" فائل لوڈ کریسی۔ جے فائل موجود کائنی تاں غلطی تھیسی۔"

#. WpYLF
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id271646220649616\n"
"help.text"
msgid "To avoid errors, it is possible to specify a preferred and a fallback locale and encoding. The following example will first try to load the file \"fr-BE.po\" from the specified folder and if it does not exist, the file \"en-US.po\" will be loaded."
msgstr "غلطیاں توں بچݨ کیتے، ہک پسندیدہ تے ہک فال بیک لوکیل تے انکوڈنگ بیان کرݨا ممکن ہے۔ تھلے ݙتی ڳئی مثال پہلے بیان کیتے ڳئے فولڈر توں \"fr-BE.po\" فائل لوڈ کرݨ دی کوشش کریسی تے جے ایہ موجود کائنی تاں \"en-US.po\" فائل لوڈ کیتی ونڄسی۔"

#. UGFWB
#: sf_l10n.xhp
msgctxt ""
"sf_l10n.xhp\n"
"par_id411585843652496\n"
"help.text"
msgid "PO files must be named in the form \"la-CO.po\" or \"la.po\", where \"la\" refers to the language and \"CO\" is the country. Some examples are: \"en-US.po\", \"fr-BE.po\" or \"fr.po\"."
msgstr "PO فائلز دا ناں \"la-CO.po\" یا \"la.po\" دی شکل وچ ہووݨا چاہیدا ہے، جتھاں \"la\" زبان دی طرف اشارہ کریندا ہے تے \"CO\" ملک ہے۔ کجھ مثالاں ہن: \"en-US.po\"، \"fr-BE.po\" یا \"fr.po\"۔"

#. zQhHX
