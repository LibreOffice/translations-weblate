#: sf_ui.xhp
msgctxt ""
"sf_ui.xhp\n"
"par_id181629364905056\n"
"help.text"
msgid "<emph>calcfilename</emph> : Only when <literal>embeddeddatabase</literal> = \"CALC\", <literal>calcfilename</literal> represents the file containing the tables as Calc sheets. The file must exist or an error is raised. The parameter is deprecated."
msgstr ""

