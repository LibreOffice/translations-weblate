#. n6vJD
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id591591631693816\n"
"help.text"
msgid "Copies a specified sheet before an existing sheet or at the end of the list of sheets. The sheet to be copied may be contained inside any <emph>open</emph> Calc document. Returns <literal>True</literal> if successful."
msgstr "بیان کیتی ڳئی شیٹ کوں موجودہ شیٹ توں پہلے یا شیٹاں دی تندیر دے آخر وچ نقل کریندا ہے۔ نقل کیتی ونڄݨ آلی شیٹ کسے وی <emph>کھلی</emph> Calc دستاویز دے اندر موجود ہو سڳدی ہے۔ کامیابی تے <literal>True</literal> واپس کریندا ہے۔"

#. YqGL2
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id871591631693741\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the sheet to be copied as a string or its reference as an object."
msgstr "<emph>sheetname</emph>: نقل کیتی ونڄݨ آلی شیٹ دا ناں سٹرنگ طور تے یا ایں دا حوالہ آبجیکٹ طور تے۔"

#. 5cEGG
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id351591632126180\n"
"help.text"
msgid "<emph>newname</emph>: The name of the sheet to insert. The name must not be in use in the document."
msgstr "<emph>newname</emph>: داخل کیتی ونڄݨ آلی شیٹ دا ناں۔ ناں دستاویز وچ ورتیا کائنی ہووݨا چاہیدا ہے۔"

#. 8sSno
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id211591632192379\n"
"help.text"
msgid "<emph>beforesheet</emph>: The name (string) or index (numeric, starting from 1) of the sheet before which to insert the copied sheet. This argument is optional and the default behavior is to add the copied sheet at the last position."
msgstr "<emph>beforesheet</emph>: اُس شیٹ دا ناں (سٹرنگ) یا انڈیکس (عددی، 1 توں شروع تھیندے ہوئے) جیں توں پہلے نقل کیتی ڳئی شیٹ کوں داخل کرݨا ہے۔ ایہ دلیل اختیاری ہے تے طے شدہ رویہ ایہ ہے کہ نقل کیتی ڳئی شیٹ کوں چھیکڑی جاہ تے جوڑا ونڄے۔"

#. yuvEn
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id961591632309410\n"
"help.text"
msgid "The following example makes a copy of the sheet \"SheetX\" and places it as the last sheet in the current document. The name of the copied sheet is \"SheetY\"."
msgstr "تھلے ݙتی ڳئی مثال شیٹ \"SheetX\" دی نقل بݨیندی ہے تے ایں کوں موجودہ دستاویز وچ چھیکڑی شیٹ طور تے رکھیندی ہے۔ نقل کیتی ڳئی شیٹ دا ناں \"SheetY\" ہے۔"

#. pqVdW
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id231611706034607\n"
"help.text"
msgid "'Gets the Document object of the active window"
msgstr ""

#. xUG9G
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id461591632297415\n"
"help.text"
msgid "The example below copies \"SheetX\" from \"FileA.ods\" and pastes it at the last position of \"FileB.ods\" with the name \"SheetY\":"
msgstr "تھلے ݙتی ڳئی مثال \"FileA.ods\" توں \"SheetX\" دی نقل بݨیندی ہے تے ایں کوں \"SheetY\" ناں نال \"FileB.ods\" دی چھیکڑی جاہ تے چپکیندی ہے۔"

#. 2AAEx
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id801595695285478\n"
"help.text"
msgid "To copy sheets between <emph>open</emph> documents, use <literal>CopySheet</literal>. To copy sheets from documents that are <emph>closed</emph>, use <literal>CopySheetFromFile</literal>."
msgstr "<emph>کھلیاں</emph> دستاویزاں دے وچکار شیٹاں دی نقل کرݨ کیتے <literal>CopySheet</literal> ورتو۔ <emph>بند</emph> دستاویزاں توں شیٹاں دی نقل کرݨ کیتے <literal>CopySheetFromFile</literal> ورتو۔"

#. 5fctt
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id931591714614755\n"
"help.text"
msgid "Copies a specified sheet from a <emph>closed</emph> Calc document and pastes it before an existing sheet or at the end of the list of sheets of the file referred to by a <literal>Document</literal> object."
msgstr "بند Calc دستاویز توں بیان کیتی ڳئی شیٹ دی نقل بݨیندا ہے تے ایں کوں موجودہ شیٹ توں پہلے یا اُس فائل دیاں شیٹاں دی تندیر دے آخر وچ چپکیندا ہے جیں دا حوالہ <literal>Document<literal/> آبجیکٹ ݙیندا ہے۔"

#. M9mDA
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id271611706609445\n"
"help.text"
msgid "If the file does not exist, an error is raised. If the file is not a valid Calc file, a blank sheet is inserted. If the source sheet does not exist in the input file, an error message is inserted at the top of the newly pasted sheet."
msgstr "اگر فائل موجود کو، تاں غلطی اٹھائی ویندی ہے۔ اگر فائل درست Calc فائل کو، تاں ہک خالی شیٹ داخل کیتی ویندی ہے۔ اگر ماخذ شیٹ ان پٹ فائل وچ موجود کو، تاں نویں چپکائی ڳئی شیٹ دے اُتے ہک غلطی دا سنیہا داخل کیتا ویندا ہے۔"

#. tCseT
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id471591714947181\n"
"help.text"
msgid "<emph>filename</emph>: Identifies the file to open. It must follow the <literal>SF_FileSystem.FileNaming</literal> notation. The file must not be protected with a password."
msgstr "<emph>filename</emph>: کھولی ونڄݨ آلی فائل دی شناخت کریندا ہے۔ ایں کوں <literal>SF_FileSystem.FileNaming</literal> اشارے دی پیروی کرݨی چاہیدی ہے۔ فائل پاس ورڈ نال محفوظ کائنی ہووݨی چاہیدی ہے۔"

#. gHjz6
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id9915917146142\n"
"help.text"
msgid "<emph>sheetname</emph>: The name of the sheet to be copied as a string."
msgstr "<emph>sheetname</emph>: نقل کیتی ونڄݨ آلی شیٹ دا ناں سٹرنگ طور تے۔"

#. PeZ4F
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id71591714614904\n"
"help.text"
msgid "<emph>newname</emph>: The name of the copied sheet to be inserted in the document. The name must not be in use in the document."
msgstr "<emph>newname</emph>: دستاویز وچ داخل کیتی ونڄݨ آلی نقل کیتی ڳئی شیٹ دا ناں۔ ناں دستاویز وچ ورتیا کائنی ہووݨا چاہیدا ہے۔"

#. 2niVz
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id601591714614407\n"
"help.text"
msgid "<emph>beforesheet</emph>: The name (string) or index (numeric, starting from 1) of the sheet before which to insert the copied sheet. This argument is optional and the default behavior is to add the copied sheet at the last position."
msgstr "<emph>beforesheet</emph>: اُس شیٹ دا ناں (سٹرنگ) یا انڈیکس (عددی، 1 توں شروع تھیندے ہوئے) جیں توں پہلے نقل کیتی ڳئی شیٹ کوں داخل کرݨا ہے۔ ایہ دلیل اختیاری ہے تے طے شدہ رویہ ایہ ہے کہ نقل کیتی ڳئی شیٹ کوں چھیکڑی جاہ تے جوڑا ونڄے۔"

#. iEHJy
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id981611707192039\n"
"help.text"
msgid "The following example copies \"SheetX\" from \"myFile.ods\" and pastes it into the document referred to by \"oDoc\" as \"SheetY\" at the first position."
msgstr "تھلے ݙتی ڳئی مثال \"myFile.ods\" توں \"SheetX\" دی نقل بݨیندی ہے تے ایں کوں \"SheetY\" طور تے پہلی جاہ تے اُس دستاویز وچ چپکیندی ہے جیں دا حوالہ \"oDoc\" ݙیندا ہے۔"

#. kELHv
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id91592558768804\n"
"help.text"
msgid "Copies a specified source range (values, formulas and formats) to a destination range or cell. The method reproduces the behaviour of a Copy/Paste operation from a range to a single cell."
msgstr "بیان کیتی ڳئی ماخذ رینج (قیمتاں، فارمولے تے فارمیٹاں) دی نقل ݙتی ڳئی منزل رینج یا سیل تائیں کریندا ہے۔ ایہ طریقہ رینج توں ہک اکیلے سیل تائیں کاپی/پیسٹ عمل دے رویے کوں دہراندا ہے۔"

#. KixB2
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id831611707431984\n"
"help.text"
msgid "It returns a string representing the modified range of cells. The size of the modified area is fully determined by the size of the source area."
msgstr "ایہ وٹائے ڳئے سیلاں دی رینج کوں ݙکھیندی ہوئی سٹرنگ واپس کریندا ہے۔ وٹائے ڳئے علاقے دا سائز مکمل طور تے ماخذ علاقے دے سائز نال طے تھیندا ہے۔"

#. KCiyF
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id681592558768463\n"
"help.text"
msgid "The source range may belong to another <emph>open</emph> document."
msgstr "ماخذ رینج کسے ٻئے <emph>کھلے</emph> دستاویز نال تعلق رکھ سڳدی ہے۔"

#. RBQG9
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id761592558768578\n"
"help.text"
msgid "<emph>sourcerange</emph>: The source range as a string when it belongs to the same document or as a reference when it belongs to another open Calc document."
msgstr "<emph>sourcerange</emph>: ماخذ رینج سٹرنگ طور تے جݙاں ایہ ہکو دستاویز نال تعلق رکھدی ہووے یا حوالے طور تے جݙاں ایہ کسے ٻئے کھلے Calc دستاویز نال تعلق رکھدی ہووے۔"

#. 3MUwk
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id711592558768466\n"
"help.text"
msgid "<emph>destinationcell</emph>: The destination cell where the copied range of cells will be pasted, as a string. If a range is given, only its top-left cell is considered."
msgstr "<emph>destinationcell</emph>: منزل سیل جتھاں نقل کیتی ڳئی سیلاں دی رینج چپکائی ویسی، سٹرنگ طور تے۔ اگر رینج ݙتی ونڄے، تاں صرف ایں دا اُتے کھٻا سیل گھدا ویندا ہے۔"

#. FbkjF
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id431592904964362\n"
"help.text"
msgid "Next is an example where the source and destination are in the same file:"
msgstr "اگلی مثال وچ ماخذ تے منزل ہکو فائل وچ ہن:"

#. Zh3Wp
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id751592905035452\n"
"help.text"
msgid "The example below illustrates how to copy a range from another open Calc document:"
msgstr "تھلے ݙتی ڳئی مثال ݙکھیندی ہے کہ کسے ٻئے کھلے Calc دستاویز توں رینج دی نقل کیویں بݨائی ونڄے:"

#. uFAEe
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id351592558768880\n"
"help.text"
msgid "'Open the source document in the background (hidden)"
msgstr ""

#. PBgwL
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"bas_id1001611708508251\n"
"help.text"
msgid "'Do not forget to close the source document because it was opened as hidden"
msgstr ""

#. ZzDAQ
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id61592905442071\n"
"help.text"
msgid "To simulate a Copy/Paste from a range to a single cell, use <literal>CopyToCell</literal>. To simulate a Copy/Paste from a range to a larger range (with the same cells being replicated several times), use <literal>CopyToRange</literal>."
msgstr "رینج توں ہک اکیلے سیل تائیں کاپی/پیسٹ کوں دہرانݨ کیتے <literal>CopyToCell</literal> ورتو۔ رینج توں ہک وݙی رینج تائیں کاپی/پیسٹ کوں دہرانݨ کیتے (ہکو جہے سیلاں کوں کئی واری نقل کیتے ونڄݨ نال)، <literal>CopyToRange</literal> ورتو۔"

#. maHke
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id1615929031212\n"
"help.text"
msgid "Copies downwards and/or rightwards a specified source range (values, formulas and formats) to a destination range. The method imitates the behaviour of a Copy/Paste operation from a source range to a larger destination range."
msgstr "بیان کیتی ڳئی ماخذ رینج (قیمتاں، فارمولے تے فارمیٹاں) دی نقل تھلوں تے/یا سڄوں منزل رینج تائیں کریندا ہے۔ ایہ طریقہ ماخذ رینج توں وݙی منزل رینج تائیں کاپی/پیسٹ عمل دے رویے دی نقل کریندا ہے۔"

#. G4qky
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id271592904084534\n"
"help.text"
msgid "If the height (or width) of the destination area is > 1 row (or column) then the height (or width) of the source must be <= the height (or width) of the destination. Otherwise nothing happens."
msgstr "اگر منزل علاقے دی اچائی (یا چوڑائی) 1 قطار (یا کالم) توں ودھ ہووے تاں ماخذ دی اچائی (یا چوڑائی) منزل دی اچائی (یا چوڑائی) توں گھٹ یا برابر ہووݨی چاہیدی ہے۔ ورنہ کجھ وی کائنی تھیندا۔"

#. Pko2R
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id131592904286834\n"
"help.text"
msgid "If the height (or width) of the destination is = 1 then the destination is expanded downwards (or rightwards) up to the height (or width) of the source range."
msgstr "اگر منزل دی اچائی (یا چوڑائی) = 1 ہووے تاں منزل کوں ماخذ رینج دی اچائی (یا چوڑائی) تائیں تھلوں (یا سڄوں) پھیلایا ویندا ہے۔"

#. jYha4
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id661592904348877\n"
"help.text"
msgid "The method returns a string representing the modified range of cells."
msgstr "ایہ طریقہ وٹائے ڳئے سیلاں دی رینج کوں ݙکھیندی ہوئی سٹرنگ واپس کریندا ہے۔"

#. wfzcw
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id41592903121807\n"
"help.text"
msgid "The source range may belong to another <emph>open</emph> document."
msgstr "ماخذ رینج کسے ٻئے <emph>کھلے</emph> دستاویز نال تعلق رکھ سڳدی ہے۔"

#. CEaED
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id841592903121145\n"
"help.text"
msgid "<emph>sourcerange</emph>: The source range as a string when it belongs to the same document or as a reference when it belongs to another open Calc document."
msgstr "<emph>sourcerange</emph>: ماخذ رینج سٹرنگ طور تے جݙاں ایہ ہکو دستاویز نال تعلق رکھدی ہووے یا حوالے طور تے جݙاں ایہ کسے ٻئے کھلے Calc دستاویز نال تعلق رکھدی ہووے۔"

#. v3d3d
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id5515929031211000\n"
"help.text"
msgid "<emph>destinationrange</emph>: The destination of the copied range of cells, as a string."
msgstr "<emph>destinationrange</emph>: نقل کیتی ڳئی سیلاں دی رینج دی منزل، سٹرنگ طور تے۔"

#. LsHF6
#: sf_calc.xhp
msgctxt ""
"sf_calc.xhp\n"
"par_id461592905128991\n"
"help.text"
msgid "Copy within the same document:"
msgstr "ہکو دستاویز وچ نقل:"

#. dNdmJ
