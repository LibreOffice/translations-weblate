"help.text"
msgid "<variable id=\"main0503\"><link href=\"text/sdraw/main0503.xhp\">$[officename] Draw Features</link></variable>"
msgstr "<variable id=\"main0503\"><link href=\"text/sdraw/main0503.xhp\">$[officename] Draw خصوصیات</link></variable>"

#. VMQj3
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"par_id3146975\n"
"help.text"
msgid "$[officename] Draw lets you create simple and complex drawings and export them in a number of common image formats. You can also insert tables, charts, formulas and other items created in $[officename] programs into your drawings."
msgstr "$[officename] Draw تہاکوں سادہ تے پیچیدہ ڈرائنگز بݨاو݊ݨ تے اوہناں کوں کئی عام تصویری فارمیٹس وچ برآمد کر݊ݨ دی اجازت ݙیندا ہے۔ تسی آپݨیاں ڈرائنگز وچ ٹیبلز، چارٹس، فارمولے تے ݙوجھے آئٹمز وی داخل کر سڳدے ہو جیڑھے $[officename] پروگراماں وچ بݨائے ڳئے ہن۔"

#. dTRFJ
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"hd_id3147435\n"
"help.text"
msgid "Vector Graphics"
msgstr "ویکٹر گرافکس"

#. xACf7
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"par_id3153142\n"
"help.text"
msgid "$[officename] Draw creates vector graphics using lines and curves defined by mathematical vectors. Vectors describe lines, ellipses, and polygons according to their geometry."
msgstr "$[officename] Draw ریاضیاتی ویکٹرز نال بیان کیتیاں ڳئیاں لکیراں تے وکراں استعمال کر کے ویکٹر گرافکس بݨاو݊دا ہے۔ ویکٹرز لکیراں، بیضویاں تے کثیر الاضلاع کوں اوہناں دی جیومیٹری دے مطابق بیان کریندے ہن۔"

#. RETRQ
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"hd_id3154320\n"
"help.text"
msgid "Creating 3D Objects"
msgstr "3D آبجیکٹس بݨاو݊ݨا"

#. vdToT
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"par_id3145251\n"
"help.text"
msgid "You can create simple 3D objects such as cubes, spheres, and cylinders in $[officename] Draw and even modify the light source of the objects."
msgstr "تسی $[officename] Draw وچ کیوبز، کرے تے سلنڈرز جیہے سادہ 3D آبجیکٹس بݨا سڳدے ہو تے آبجیکٹس دے روشنی دے ماخذ کوں وی تبدیل کر سڳدے ہو۔"

#. ZuG9S
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"hd_id3154491\n"
"help.text"
msgid "Grids and Snap Lines"
msgstr "گرڈز تے سناپ لکیراں"

#. 3DMuZ
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"par_id3149379\n"
"help.text"
msgid "Grids and snap lines provide a visual cue to help you align objects in your drawing. You can also choose to snap an object to a grid line, snap line or to the edge of another object."
msgstr "گرڈز تے سناپ لکیراں تہاکوں آپݨی ڈرائنگ وچ آبجیکٹس کوں الائن کر݊ݨ وچ مدد کر݊ݨ کیتے ہک بصری اشارہ ݙیندیاں ہن۔ تسی ہک آبجیکٹ کوں گرڈ لکیر، سناپ لکیر یا ݙوجھے آبجیکٹ دے کنارے نال چپکاو݊ݨ دا چݨاو وی کر سڳدے ہو۔"

#. 3fX6X
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"hd_id3155601\n"
"help.text"
msgid "Connecting Objects to Show Relationships"
msgstr "تعلقات ݙکھاو݊ݨ کیتے آبجیکٹس کوں جوڑ݊ݨا"

#. jDxCD
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"par_id3149124\n"
"help.text"
msgid "You can connect objects in $[officename] Draw with special lines called \"connectors\" to show the relationship between objects. Connectors attach to gluepoints on drawing objects and remain attached when the connected objects are moved. Connectors are useful for creating organization charts and technical diagrams."
msgstr "تسی $[officename] Draw وچ آبجیکٹس کوں \"connectors\" آکھیاں ڳئیاں خاص لکیراں نال جوڑ سڳدے ہو تاں جو آبجیکٹس دے وچکار تعلق ݙکھاو݊و۔ \"connectors\" ڈرائنگ آبجیکٹس تے گلو پوائنٹس نال جُڑدے ہن تے جُڑے رہندے ہن جݙاں جوڑے ہوئے آبجیکٹس کوں گھمایا ونڄے۔ \"connectors\" تنظیمی چارٹس تے تکنیکی ڈایا گرامز بݨاو݊ݨ کیتے کارآمد ہن۔"

#. pLaMp
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"hd_id3155764\n"
"help.text"
msgid "Displaying Dimensions"
msgstr "جہتاں ݙکھاو݊ݨا"

#. bkUkB
#: main0503.xhp
msgctxt ""
"main0503.xhp\n"
"par_id3155333\n"
"help.text"
msgid "Technical diagrams often show the dimensions of objects in the drawing. In $[officename] Draw, you can use dimension lines to calculate and display linear dimensions."
msgstr "تکنیکی ڈایا گرامز وچ اکثر ڈرائنگ وچ آبجیکٹس دیاں جہتاں ݙکھائیاں ویندیاں ہن۔ $[officename] Draw وچ، تسی لکیری جہتاں دا حساب کر݊ݨ تے ݙکھاو݊ݨ کیتے جہت لکیراں استعمال کر سڳدے ہو۔"

