#. ziZQj
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3154766\n"
"help.text"
msgid "Moves the cursor leftward to the start and end of cell blocks with data. If the cell to the left of the cursor is empty or the cell with the cursor is empty, the cursor moves leftward in the current row until it reaches the next cell with contents. If all cells in the same row to the left of the cursor are empty, the cursor moves to the first cell in the row."
msgstr "کرسر کوں ڈیٹا والے سیل بلاکس دے شروع تے انت تائیں کھٻے پاسے گھماو݊ݨا ہے۔ جے کرسر دے کھٻے پاسے آلا سیل خالی ہووے یا کرسر آلا سیل خالی ہووے تاں کرسر موجودہ قطار وچ کھٻے پاسے چلا ویندا ہے جݙاں تائیں اوہ مواد والے اڳلے سیل تائیں نہ پہنچے۔ جے کرسر دے کھٻے پاسے اوہو قطار وچ سارے سیلز خالی ہوون تاں کرسر قطار دے پہلے سیل تائیں چلا ویندا ہے۔"

#. dXFKv
#: 01020000.xhp
msgctxt ""
