msgstr ""

#. UV76n
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3153076\n"
"help.text"
msgid "Moves the cursor upward to the start and end of cell blocks with data. If the cell above the cursor is empty or the cell with the cursor is empty, the cursor moves upward in the current column until it reaches the next cell with contents. If all cells in the same column above the cursor are empty, the cursor moves to the first cell in the column."
msgstr "کرسر کوں ڈیٹا والے سیل بلاکس دے شروع تے انت تائیں اُتے گھماو݊ݨا ہے۔ جے کرسر دے اُتے آلا سیل خالی ہووے یا کرسر آلا سیل خالی ہووے تاں کرسر موجودہ کالم وچ اُتے چلا ویندا ہے جݙاں تائیں اوہ مواد والے اڳلے سیل تائیں نہ پہنچے۔ جے کرسر دے اُتے اوہو کالم وچ سارے سیلز خالی ہوون تاں کرسر کالم دے پہلے سیل تائیں چلا ویندا ہے۔"

#. R9tmv
#: 01020000.xhp
