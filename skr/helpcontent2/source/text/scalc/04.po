#. QdGma
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id561750170306423\n"
"help.text"
msgid "To fill a selected cell range with formula"
msgstr "چݨی ڳئی سیل رینج کوں فارمولے نال بھر݊ݨ کیتے"

#. mFCF5
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3155067\n"
"help.text"
msgid "To fill a selected cell range with the formula that you entered on the <emph>Input line</emph>, press <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Option</keycode></caseinline><defaultinline><keycode>Alt</keycode></defaultinline></switchinline>+<keycode>Enter</keycode>."
msgstr "چݨی ڳئی سیل رینج کوں اوہ فارمولے نال بھر݊ݨ کیتے جیڑھا تُساں <emph>Input line</emph> تے داخل کیتا ہے، <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Option</keycode></caseinline><defaultinline><keycode>Alt</keycode></defaultinline></switchinline>+<keycode>Enter</keycode> دٻاؤ۔"

#. N6VVE
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id681750170342342\n"
"help.text"
msgid "To enter an array formula"
msgstr "صف فارمولا داخل کر݊ݨ کیتے"

#. xS56j
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3153967\n"
"help.text"
msgid "To create a matrix in which all the cells contain the same information as what you entered on the <emph>Input line</emph>, press <keycode>Shift</keycode>+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline>+<keycode>Enter</keycode>. You cannot edit the components of the matrix."
msgstr "ہک میٹرکس بݨاو݊ݨ کیتے جیندے وچ سارے سیلز اوہو معلومات رکھدے ہن جیڑھی تُساں <emph>Input line</emph> تے داخل کیتی ہے، <keycode>Shift</keycode>+<switchinline select=\"sys\"><caseinline select=\"MAC\">Command</caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline>+<keycode>Enter</keycode> دٻاؤ۔ تُساں میٹرکس دے جزواں کوں ایڈٹ نئیں کر سڳدے۔"

#. YCFRQ
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id251750170391165\n"
"help.text"
msgid "To select multiple cells"
msgstr "کئی سیلز چݨݨ کیتے"

#. hdzVu
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3166426\n"
"help.text"
msgid "To select multiple cells in different areas of a sheet, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline> and drag in the different areas."
msgstr "شیٹ دے وکھرے علاقیاں وچ کئی سیلز چݨݨ کیتے، <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline> دٻا کے رکھو تے وکھرے علاقیاں وچ گھسیٹو۔"

#. G63XL
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id501750170411796\n"
"help.text"
msgid "To select multiple sheets"
msgstr "کئی شیٹاں چݨݨ کیتے"

#. N6mXs
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3150207\n"
"help.text"
msgid "To select multiple sheets in a spreadsheet, hold down <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline>, and then click the name tabs at the lower edge of the workspace. To select only one sheet in a selection, hold down <keycode>Shift</keycode>, and then click the name tab of the sheet."
msgstr "سپریڈ شیٹ وچ کئی شیٹاں چݨݨ کیتے، <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline> دٻا کے رکھو، تے ول ورک اسپیس دے ہیٹھلے کنارے تے ناں والے ٹیبز تے کلک کرو۔ چݨاو وچ صرف ہک شیٹ چݨݨ کیتے، <keycode>Shift</keycode> دٻا کے رکھو، تے ول شیٹ دے ناں والے ٹیب تے کلک کرو۔"

#. 7njen
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id601750170435076\n"
"help.text"
msgid "To insert a manual break"
msgstr "دستی وقفہ داخل کر݊ݨ کیتے"

#. zcLvD
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3166432\n"
"help.text"
msgid "To insert a manual line break in a cell, click in the cell, and then press <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline>+<keycode>Enter</keycode>."
msgstr "سیل وچ دستی لکیر وقفہ داخل کر݊ݨ کیتے، سیل وچ کلک کرو، تے ول <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline>+<keycode>Enter</keycode> دٻاؤ۔"

#. m4QcG
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id221750170454547\n"
"help.text"
msgid "To delete contents"
msgstr "مواد حذف کر݊ݨ کیتے"

#. XcsXs
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3146978\n"
"help.text"
msgid "To delete the contents of selected cells, press <keycode>Backspace</keycode>. This opens the <link href=\"text/scalc/01/02150000.xhp\">Delete Contents</link> dialog, where you choose which contents of the cell you want to delete. To delete the contents of selected cells without a dialog, press the <keycode>Delete</keycode> key."
msgstr "چݨے ہوئے سیلز دے مواد کوں حذف کر݊ݨ کیتے، <keycode>Backspace</keycode> دٻاؤ۔ ایہہ <link href=\"text/scalc/01/02150000.xhp\">Delete Contents</link> ڈائیلاگ کھول݊ا ہے، جتھاں تُساں چݨدے ہو جو سیل دے مواد وچوں تُساں کیڑھا مواد حذف کر݊ݨا چاہندے ہو۔ بغیر ڈائیلاگ دے چݨے ہوئے سیلز دے مواد کوں حذف کر݊ݨ کیتے، <keycode>Delete</keycode> کی دٻاؤ۔"

#. wFTZK
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"hd_id541750170879864\n"
"help.text"
msgid "To cut contents without removing the source cells format"
msgstr "ماخذ سیلز دا فارمیٹ ہٹائے بغیر مواد کٹ݊ݨ کیتے"

#. 5jD8X
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id431750170896895\n"
"help.text"
msgid "To cut contents without removing the source cells format, press <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline><keycode> + Shift + X</keycode>."
msgstr "ماخذ سیلز دا فارمیٹ ہٹائے بغیر مواد کٹ݊ݨ کیتے، <switchinline select=\"sys\"><caseinline select=\"MAC\"><keycode>Command</keycode></caseinline><defaultinline><keycode>Ctrl</keycode></defaultinline></switchinline><keycode>+ Shift + X</keycode> دٻاؤ۔"

