msgstr ""

#. x95TY
#: 01020000.xhp
msgctxt ""
"01020000.xhp\n"
"par_id3149054\n"
"help.text"
msgid "Moves the cursor downward to the start and end of cell blocks with data. If the cell below the cursor is empty or the cell with the cursor is empty, the cursor moves downward in the current column until it reaches the next cell with contents. If all cells in the same column below the cursor are empty, the cursor moves to the last cell in the column."
msgstr "کرسر کوں ڈیٹا والے سیل بلاکس دے شروع تے انت تائیں ہیٹھاں گھماو݊ݨا ہے۔ جے کرسر دے ہیٹھاں آلا سیل خالی ہووے یا کرسر آلا سیل خالی ہووے تاں کرسر موجودہ کالم وچ ہیٹھاں چلا ویندا ہے جݙاں تائیں اوہ مواد والے اڳلے سیل تائیں نہ پہنچے۔ جے کرسر دے ہیٹھاں اوہو کالم وچ سارے سیلز خالی ہوون تاں کرسر کالم دے چھیکڑی سیل تائیں چلا ویندا ہے۔"

